  <!-- DASHBOARD GERENCIAL -->
  <div class="tab-content" id="tab-mando">
    <div style="padding:1.5rem;">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:24px;">
        <div>
          <p style="font-size:12px;color:var(--text-hint);margin:0 0 2px;">Blue Logistics</p>
          <p style="font-size:20px;font-weight:600;color:var(--text);margin:0;">Centro de Mando</p>
        </div>
        <div style="display:flex;align-items:center;gap:10px;">
          <p style="font-size:12px;color:var(--text-hint);margin:0;" id="mando-hora">—</p>
          <button onclick="generarReporteMando()" class="btn btn-ghost" style="height:28px;font-size:11px;padding:0 12px;">📄 Reporte</button>
        </div>
      </div>

      <p style="font-size:10px;font-weight:600;letter-spacing:0.1em;color:var(--text-hint);margin:0 0 10px;">EQUIPOS EN TRÁNSITO</p>
      <div id="mando-grid-ingresos" style="display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:10px;"></div>
      <div style="margin-bottom:20px;">
        <button id="mando-btn-ruta" class="btn btn-ghost" style="font-size:11px;height:28px;padding:0 14px;color:#185FA5;border-color:#B5D4F4;">🌊 Mostrar En ruta</button>
      </div>
      <div id="mando-ruta-section" style="display:none;margin-bottom:20px;">
        <div id="mando-grid-ruta" style="display:grid;grid-template-columns:repeat(4,1fr);gap:10px;"></div>
      </div>

      <p style="font-size:10px;font-weight:600;letter-spacing:0.1em;color:var(--text-hint);margin:0 0 10px;">DESPACHOS</p>
      <div id="mando-grid-despachos" style="display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:20px;"></div>

      <div id="mando-detalle" style="display:none;background:var(--surface);border:1px solid var(--border);border-radius:10px;padding:16px;margin-bottom:16px;">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;">
          <p style="font-size:13px;font-weight:600;color:var(--text);margin:0;" id="mando-detalle-titulo">—</p>
          <button onclick="document.getElementById('mando-detalle').style.display='none'" class="btn btn-ghost" style="height:26px;font-size:11px;padding:0 10px;">✕ Cerrar</button>
        </div>
        <div id="mando-detalle-lista" style="font-size:12px;font-family:var(--mono);color:var(--text-muted);line-height:1.9;"></div>
      </div>

      <div id="mando-reporte" style="display:none;background:var(--surface);border:1px solid var(--border);border-radius:10px;padding:16px;">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;">
          <p style="font-size:13px;font-weight:600;color:var(--text);margin:0;">Reporte operativo</p>
          <button onclick="copiarReporteMando()" class="btn btn-ghost" style="height:26px;font-size:11px;padding:0 10px;" id="mando-btn-copiar">📋 Copiar</button>
        </div>
        <pre id="mando-reporte-txt" style="font-size:11px;font-family:var(--mono);color:var(--text);margin:0;white-space:pre-wrap;line-height:1.9;"></pre>
      </div>
    </div>
  </div>

  <!-- RESUMEN OPERATIVO -->
  <div class="tab-content" id="tab-resumen">
    <div class="pg-head"><div><h2>Resumen operativo</h2><p>Lo que pasó en la operación, contado en palabras: descargas, despachos, pallets y tiempos del rango de fechas que elijas.</p></div>
      <div class="pg-act"><button class="btn btn-sm" onclick="roCopiar()">Copiar texto</button><button class="btn btn-sm btn-accent" onclick="roImprimir()">Imprimir / PDF</button></div></div>
    <div class="filters ro-filtros">
      <div class="ro-presets" id="ro-presets"><button data-p="hoy" onclick="roPreset('hoy')">Hoy</button><button data-p="ayer" onclick="roPreset('ayer')">Ayer</button><button data-p="semana" onclick="roPreset('semana')">Esta semana</button><button data-p="semana_ant" onclick="roPreset('semana_ant')">Semana pasada</button><button data-p="mes" onclick="roPreset('mes')">Este mes</button><button data-p="mes_ant" onclick="roPreset('mes_ant')">Mes pasado</button></div>
      <label class="seg-corte">Desde <input type="date" id="ro-desde" onchange="roRender()"></label>
      <label class="seg-corte">Hasta <input type="date" id="ro-hasta" onchange="roRender()"></label>
      <select id="ro-pais" onchange="roRender(true)"><option value="">Todos los destinos</option><option value="EL SALVADOR">El Salvador</option><option value="GUATEMALA">Guatemala</option><option value="HONDURAS">Honduras</option><option value="NICARAGUA">Nicaragua</option><option value="COSTA RICA">Costa Rica</option><option value="PANAMA">Panamá</option></select>
    </div>
    <div class="dg-kpis" id="ro-kpis"></div>
    <div class="dg-grid">
      <div class="dg-card"><header><h3 id="ro-t-dia">Movimiento por día</h3><p>Pedidos que salieron y contenedores que se descargaron</p></header><div class="dg-legend ro-leg" id="ro-leg"></div><div class="dg-plot"><canvas id="ro-c-dia"></canvas></div></div>
      <div class="dg-card"><header><h3>Pallets despachados por destino</h3><p>Pase el cursor para ver pedidos y viajes</p></header><div class="dg-plot"><canvas id="ro-c-pais"></canvas></div></div>
    </div>
    <article class="ro-doc" id="ro-doc"></article>
  </div>

  <!-- BUSCAR PEDIDO -->
  <div class="tab-content" id="tab-buscar">
    <div class="pg-head"><div><h2>Buscar pedido</h2><p>Escribe un número de pedido o un DT y ve su historia completa: ingreso, despacho y lo facturado. Incluye años anteriores.</p></div></div>
    <form class="bp-form" onsubmit="event.preventDefault();bpBuscar();"><input id="bp-q" type="search" placeholder="Pedido o DT · ej. 4505787653 o DT-0002-01-25" autocomplete="off"><button class="btn btn-accent" type="submit">Buscar</button></form>
    <div id="bp-out"></div>
  </div>

  <!-- REPORTE PARA SEGURO -->
  <div class="tab-content" id="tab-seguro">
    <div class="pg-head"><div><h2>Reporte para seguro</h2><p>Pedidos bajo custodia de Blue en este momento: desde que el contenedor se posiciona en Blue hasta que el pedido sale (incluye cargado sin despachar).</p></div>
      <div class="pg-act"><span class="seg-gen" id="seg-gen"></span><button class="btn btn-sm" onclick="segExcel()">Excel</button><button class="btn btn-sm btn-accent" onclick="segImprimir()">Imprimir / PDF</button></div></div>
    <div class="stat-strip">
      <div class="st"><span>Valor de factura</span><b id="seg-k-valor">—</b></div>
      <div class="st"><span>Pedidos</span><b id="seg-k-n">0</b></div>
      <div class="st"><span>Sin valor de factura</span><b id="seg-k-sin">0</b></div>
    </div>
    <div class="filters">
      <input type="text" id="seg-q" placeholder="Pedido, DT, contenedor, país…" oninput="segRender()" style="width:260px;">
    </div>
    <div class="table-card">
      <div class="table-header"><span class="table-title">Pedidos en custodia</span><span class="table-count" id="seg-count">0</span></div>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Pedido</th><th>DT</th><th>País</th><th>Contenedor</th><th>Fecha de ingreso</th><th class="num">Valor factura</th></tr></thead>
          <tbody id="seg-body"></tbody>
        </table>
      </div>
    </div>
  </div>

  <div class="tab-content" id="tab-dashboard">

    <div class="dg-head">
      <div>
        <h2 class="dg-title">Reporte ejecutivo</h2>
        <div class="dg-sub" id="dg-sub">Operación Unilever</div>
        <div class="dg-costos-info" id="dg-costos-info"></div>
      </div>
      <div class="dg-actions">
        <input type="file" id="dg-costos-file" accept=".xlsx,.xls" style="display:none" onchange="dgImportarCostos(this)">
        <button class="btn" id="dg-btn-costos" onclick="dgElegirArchivoCostos()">Importar costos</button>
        <button class="btn" onclick="dgAbrirTarifas()">Tarifas de flete</button>
        <button class="btn btn-accent" onclick="dashInit()">↻ Actualizar</button>
      </div>
    </div>

    <div class="dg-filters" role="toolbar" aria-label="Filtros del reporte">
      <div class="dg-chips" id="dg-paises"></div>
      <div class="dg-sels">
        <label class="dg-mes">
          <span>Origen</span>
          <select id="dg-origen" onchange="dgSetOrigen(this.value)"></select>
        </label>
        <label class="dg-mes">
          <span>Periodo</span>
          <select id="dg-mes" onchange="dgSetMes(this.value)"></select>
        </label>
      </div>
    </div>

    <div class="dg-kpis" id="dg-kpis"></div>

    <div class="dg-grid">
      <section class="dg-card">
        <header><h3>Pedidos despachados por mes</h3><p id="dg-n-desp">Pedidos cargados o despachados</p></header>
        <div class="dg-legend" id="dg-l-desp"></div>
        <div class="dg-plot"><canvas id="dg-c-desp" role="img" aria-label="Pedidos despachados por mes"></canvas></div>
      </section>
      <section class="dg-card">
        <header><h3 id="dg-t-ing">Contenedores ingresados por mes</h3><p id="dg-n-ing">Equipos recibidos en Blue</p></header>
        <div class="dg-plot"><canvas id="dg-c-ing" role="img" aria-label="Contenedores ingresados por mes"></canvas></div>
      </section>
      <section class="dg-card">
        <header><h3>Toneladas por mes</h3><p>Lo que entra contra lo que sale</p></header>
        <div class="dg-legend" id="dg-l-tn"></div>
        <div class="dg-plot"><canvas id="dg-c-tn" role="img" aria-label="Toneladas ingresadas y despachadas por mes"></canvas></div>
      </section>
      <section class="dg-card">
        <header><h3>Truck fill promedio por mes</h3><p id="dg-n-tf">Llenado de cada viaje contra la meta</p></header>
        <div class="dg-plot"><canvas id="dg-c-tf" role="img" aria-label="Truck fill promedio por mes"></canvas></div>
        <div class="dg-buckets" id="dg-buckets"></div>
      </section>
      <section class="dg-card">
        <header><h3>Días en bodega por mes</h3><p>Promedio por pedido despachado, de la descarga a la salida</p></header>
        <div class="dg-plot"><canvas id="dg-c-dias" role="img" aria-label="Días promedio en bodega por mes"></canvas></div>
        <div class="dg-buckets" id="dg-dias-buckets"></div>
      </section>
      <section class="dg-card">
        <header><h3>En bodega hoy</h3><p id="dg-n-aging">Antigüedad de los pedidos que aún no salen</p></header>
        <div class="dg-pipe" id="dg-aging"></div>
      </section>
      <section class="dg-card">
        <header class="dg-hdr-row"><div><h3 id="dg-t-cost">Costo por mes</h3><p id="dg-n-cost">USD</p></div><div class="dg-vista" id="dg-vista-1"></div></header>
        <div class="dg-legend" id="dg-l-cost"></div>
        <div class="dg-plot"><canvas id="dg-c-cost" role="img" aria-label="Costo por mes"></canvas></div>
      </section>
      <section class="dg-card">
        <header class="dg-hdr-row"><div><h3>¿En qué se va el costo?</h3><p id="dg-n-comp">Por grupo de rubro facturado</p></div><div class="dg-vista" id="dg-vista-2"></div></header>
        <div class="dg-comp" id="dg-comp"></div>
      </section>
      <section class="dg-card dg-wide">
        <header class="dg-hdr-row"><div><h3>Origen de la carga</h3><p id="dg-n-orig">De dónde viene lo que entra a Blue</p></div><div class="dg-orig-hint" id="dg-orig-hint"></div></header>
        <div class="dg-orig">
          <div class="dg-plot dg-plot-orig"><canvas id="dg-c-orig" role="img" aria-label="Toneladas ingresadas por origen"></canvas></div>
          <div class="dg-orig-tab"><table><thead><tr><th>Origen</th><th class="num">Tn</th><th class="num">%</th><th class="num">Pedidos</th><th class="num" id="dg-orig-th-cont">Cont.</th><th>Va más a</th></tr></thead><tbody id="dg-orig-body"></tbody></table></div>
        </div>
      </section>
      <section class="dg-card dg-wide">
        <header><h3>Equipos en patio hoy</h3><p id="dg-n-pipe">Contenedores activos por estado</p></header>
        <div class="dg-pipe" id="dg-pipe"></div>
      </section>
    </div>

    <section class="table-card dg-table">
      <div class="table-header">
        <span class="table-title">Resumen por país</span>
        <span class="table-count" id="dg-pais-count">Clic en un país para filtrar</span>
      </div>
      <div class="table-wrap">
        <table style="min-width:1120px;">
          <thead id="dg-pais-thead"></thead>
          <tbody id="dg-pais-tbody"></tbody>
        </table>
      </div>
    </section>

    <section class="table-card dg-table">
      <div class="table-header">
        <span class="table-title">Últimos despachos</span>
        <span class="table-count" id="dg-ult-count">—</span>
      </div>
      <div class="table-wrap">
        <table style="min-width:900px;">
          <thead><tr>
            <th>Mes</th><th>Referencia</th><th>No. pedido</th><th>Destino</th>
            <th class="num">Pallets</th><th class="num">Peso kg</th><th>Truck fill del viaje</th><th class="num">Días en bodega</th><th class="num">Costo</th><th>Estado</th>
          </tr></thead>
          <tbody id="dg-ult-tbody"></tbody>
        </table>
      </div>
    </section>

  </div>
</div><!-- /main -->

<!-- MODAL TARIFAS DE FLETE (Dashboard) -->
<!-- MODAL REQUISICIÓN DE CHEQUE -->
<div class="modal-bg" id="modal-rc">
  <div class="modal rc-modal">
    <div class="rc-mh">
      <div><h3 id="rc-m-tit">Nueva requisición de cheque</h3><p>Agrega los manifiestos/BL con su factura. Los contenedores, PO y valores se toman del HUB.</p></div>
      <div class="rc-mtotal"><span>Total RC</span><b id="rc-m-total">$ 0.00</b></div>
    </div>
    <div class="rc-grid">
      <div class="form-group"><label>No. RC *</label><input id="rc-m-num" placeholder="Ej. 82226" inputmode="numeric" oninput="rcNumCambio()" onchange="rcNumCambio(true)"></div>
      <div class="form-group"><label>Fecha</label><input id="rc-m-fecha" type="date"></div>
      <div class="form-group"><label>Beneficiario</label><input id="rc-m-benef" list="rc-dl-benef" placeholder="Naviera / proveedor"></div>
      <div class="form-group"><label>Concepto</label><input id="rc-m-concepto" list="rc-dl-concepto" value="Flete marítimo"></div>
    </div>
    <datalist id="rc-dl-benef"></datalist>
    <datalist id="rc-dl-concepto"><option>Flete marítimo</option><option>Naviera / THC</option><option>Cargos portuarios</option><option>Transporte terrestre</option><option>Almacenaje</option></datalist>
    <div class="rc-add">
      <input id="rc-m-man" list="rc-dl-man" placeholder="Manifiesto / BL" onkeydown="if(event.key==='Enter'){event.preventDefault();rcAgregarBL();}">
      <datalist id="rc-dl-man"></datalist>
      <button class="btn btn-sm" type="button" onclick="rcAgregarBL()">+ Agregar manifiesto</button>
      <small id="rc-m-msg"></small>
    </div>
    <div id="rc-m-bls" class="rc-bls"></div>
    <div class="form-group"><label>Notas</label><input id="rc-m-notas" placeholder="Opcional"></div>
    <div class="modal-footer">
      <button class="btn" onclick="closeModals()">Cancelar</button>
      <button class="btn" onclick="rcGuardar(false)">Guardar</button>
      <button class="btn btn-accent" onclick="rcGuardar(true)">Guardar e imprimir</button>
    </div>
  </div>
</div>

<div class="modal-bg" id="modal-tarifas">
  <div class="modal" style="width:560px;">
    <h3>Tarifas de flete</h3>
    <p style="font-size:13px;color:var(--text-muted);margin:-6px 0 16px;line-height:1.5;">Se usan solo para estimar mientras no hayas importado tu reporte de facturación. Costo por viaje desde Blue, en USD; se reparte entre los pedidos del viaje según sus pallets, con la tarifa más alta de la ruta.</p>
    <div class="dg-tar-grid" id="dg-tar-rows"></div>
    <div class="form-group" style="margin-top:14px;max-width:220px;">
      <label>Meta de truck fill (%)</label>
      <input id="dg-tar-meta" type="number" min="1" max="100" step="1">
    </div>
    <div class="modal-footer">
      <button class="btn" onclick="closeModals()">Cancelar</button>
      <button class="btn btn-accent" onclick="dgGuardarTarifas()">Guardar tarifas</button>
    </div>
  </div>
</div>

<!-- MODAL COSTOS POR REFERENCIA -->
<div class="modal-bg" id="modal-costos">
  <div class="modal" style="width:1180px;">
    <h3 id="cst-titulo">Costos</h3>
    <div class="paste-box">
      <label for="cst-paste">Pegar cuadro de costos</label>
      <textarea id="cst-paste" rows="3" placeholder="Copia el cuadro con su encabezado (Condición / Rubro · PO … ) y pégalo aquí" oninput="clearTimeout(window._cstT);window._cstT=setTimeout(costAnalizar,250)"></textarea>
    </div>
    <div id="cst-msg"></div>
    <div class="cst-prev" id="cst-prev"></div>
    <div class="modal-footer">
      <button class="btn" onclick="closeModals()">Cerrar</button>
      <button class="btn btn-accent" id="cst-guardar" onclick="costGuardar()" disabled>Guardar costos</button>
    </div>
  </div>
</div>

<!-- MODAL CUADROS PARA CORREO -->
<!-- MODAL ARCHIVO HISTÓRICO -->
<div class="modal-bg" id="modal-arch">
  <div class="modal" style="width:1000px;">
    <h3>Años anteriores · solo para reportes</h3>
    <input type="file" id="arch-file" accept=".xlsx,.xlsm,.xls" style="display:none" onchange="archLeer(this)">
    <div id="arch-body"></div>
    <div class="modal-footer"><button class="btn" onclick="closeModals()">Cerrar</button><button class="btn btn-accent" id="arch-guardar" onclick="archGuardar()" style="display:none">Guardar años marcados</button></div>
  </div>
</div>

<!-- MODAL VALOR EN ADUANAS HONDURAS -->
<div class="modal-bg" id="modal-vhn">
  <div class="modal" style="width:980px;">
    <h3 id="vhn-tit">Valor en aduanas · Honduras</h3>
    <div id="vhn-body"></div>
    <div class="modal-footer" id="vhn-btns"></div>
  </div>
</div>

<!-- MODAL POSICIONAMIENTO SEMANAL -->
<div class="modal-bg" id="modal-pos">
  <div class="modal" style="width:1000px;max-width:96vw;">
    <div class="pos-head"><h3>Posicionamiento semanal</h3>
      <div class="pos-nav"><button class="btn btn-sm" onclick="posMover(-1)" aria-label="Semana anterior">‹</button><span id="pos-sem"></span><button class="btn btn-sm" id="pos-sig" onclick="posMover(1)" aria-label="Semana siguiente">›</button></div></div>
    <iframe id="pos-frame" title="Reporte de posicionamiento" style="width:100%;height:62vh;border:1px solid var(--border);border-radius:14px;background:#fff;"></iframe>
    <div class="modal-footer"><button class="btn" onclick="closeModals()">Cerrar</button><button class="btn" onclick="posCopiarRico()">Copiar para correo</button><button class="btn btn-accent" onclick="posImprimir()">Imprimir / PDF</button></div>
  </div>
</div>

<div class="modal-bg" id="modal-cuadros">
  <div class="modal" style="width:1040px;">
    <h3 id="cq-titulo">Cuadros para correo</h3>
    <p class="cq-sub">Completa lo que falte y copia. Se pega en el correo como tabla con formato.</p>
    <div class="cq-edit-wrap">
      <table class="cq-edit-t">
        <thead><tr><th>PO</th><th>DT/ONL/OT</th><th>Factura</th><th>BL / CP / AWB</th><th>Cajas</th><th>Pallets</th><th class="num">Peso kg</th><th>Valor factura $</th></tr></thead>
        <tbody id="cq-edit"></tbody>
      </table>
    </div>
    <div class="cq-flete"><label for="cq-flete">Flete total de la referencia (USD)</label><input id="cq-flete" type="number" min="0" step="0.01" placeholder="0.00" oninput="cqSetFlete(this.value)"><span id="cq-base"></span></div>
    <div class="cq-prev">
      <section><header><b>Para bodega</b><button class="btn btn-accent" id="cq-btn-bod" onclick="cqCopiar('bodega')">Copiar cuadro de bodega</button></header><div class="cq-box" id="cq-prev-bod"></div></section>
      <section><header><b>Para transporte</b><button class="btn btn-accent" id="cq-btn-tra" onclick="cqCopiar('transporte')">Copiar cuadro de transporte</button></header><div class="cq-box" id="cq-prev-tra"></div></section>
    </div>
    <div class="modal-footer"><button class="btn" onclick="closeModals()">Cerrar</button></div>
  </div>
</div>

<!-- MODAL CORTINA AL LLEGAR A BLUE -->
<div class="modal-bg" id="modal-cont-cortina">
  <div class="modal" style="width:520px;">
    <h3 id="cc-titulo">Contenedor llegó a Blue</h3>
    <p class="cc-info" id="cc-info"></p>
    <div class="form-grid">
      <div class="form-group"><label for="cc-edif">Edificio</label><select id="cc-edif" onchange="ccEdifChange()"></select></div>
      <div class="form-group"><label for="cc-cortina">Cortina</label><select id="cc-cortina"></select></div>
      <div class="form-group" style="grid-column:1/-1;"><label for="cc-operador">Operador (opcional)</label><input id="cc-operador" type="text" placeholder="Quién descarga"></div>
    </div>
    <p class="cc-msg" id="cc-msg"></p>
    <div class="modal-footer">
      <button class="btn" onclick="ccDespues()" style="margin-right:auto;">Después</button>
      <button class="btn" onclick="ccCola()">Mandar a cola</button>
      <button class="btn btn-accent" id="cc-asignar" onclick="ccAsignar()">Asignar y descargar</button>
    </div>
  </div>
</div>

<!-- MODAL IMPORTAR INGRESOS -->
<div class="modal-bg" id="modal-import">
  <div class="modal" style="width:1100px;">
    <h3>Importar ingresos</h3>
    <p class="imp-sub" id="imp-archivo"></p>
    <div class="imp-rango">
      <label>Arribo desde <select id="imp-desde" onchange="impRender()"></select></label>
      <label>hasta <select id="imp-hasta" onchange="impRender()"></select></label>
    </div>
    <div class="imp-resumen" id="imp-resumen"></div>
    <div class="imp-tabla">
      <table>
        <thead><tr><th>Arribo</th><th>Manifiesto</th><th>Placa</th><th>Pedidos (país · número)</th><th class="num">Peso kg</th><th>Va a</th><th>Observaciones</th></tr></thead>
        <tbody id="imp-tbody"></tbody>
      </table>
    </div>
    <div class="imp-errores" id="imp-errores"></div>
    <p class="imp-nota">Cada fila del Excel es un pedido; se agrupan por Manifiesto + placa en un contenedor. Los pedidos o DT que ya están en el HUB se omiten. Los contenedores cuyos pedidos ya salieron van al Historial de Ingreso.</p>
    <div class="modal-footer">
      <button class="btn" onclick="closeModals()">Cancelar</button>
      <button class="btn btn-accent" id="imp-btn" onclick="impConfirmar()">Importar</button>
    </div>
  </div>
</div>

<!-- MODAL NUEVO/EDITAR CONTENEDOR -->
<div class="modal-bg" id="modal-cont">
  <div class="modal" style="width:720px;max-height:90vh;overflow-y:auto;">
    <h3 id="cont-modal-title">Nuevo Contenedor</h3>
    <div class="paste-box" id="c-paste-box">
      <label for="c-paste">Pegar aviso de embarque</label>
      <textarea id="c-paste" rows="3" placeholder="Copia las filas del Excel con su encabezado (OT, PO, Manifiesto, Contenedor, Consignatario, ETA…) y pégalas aquí" oninput="pasteAnalizarDiferido()"></textarea>
      <div id="c-paste-res"></div>
    </div>
    <div class="form-grid">
      <div class="form-group"><label>Doc. de Transporte</label><input id="c-doc" type="text" placeholder="259551790"></div>
      <div class="form-group"><label>Contenedor</label><input id="c-cont" type="text" placeholder="MRKU0000000"></div>
      <div class="form-group"><label>ETA Puerto</label><input id="c-eta-pto" type="date"></div>
      <div class="form-group"><label>ETA Blue</label><input id="c-eta-blue" type="date"></div>
      <div class="form-group"><label>Equipos / Cantidad</label><input id="c-cant" type="number" min="0" placeholder="0"></div>
      <div class="form-group"><label>Peso (kg)</label><input id="c-peso" type="number" step="0.001" placeholder="0.000" oninput="contPedTotales()"></div>
      <div class="form-group">
        <label>Origen</label>
        <select id="c-origen">
          <option value="">— Seleccionar —</option>
          <option>BRASIL</option><option>COLOMBIA</option><option>ALEMANIA</option>
          <option>ARGENTINA</option><option>USA</option><option>MEXICO</option>
          <option>HONDURAS</option><option>ITALIA</option><option>MALASYA</option>
          <option>REP. DOMINICANA</option><option>PERU</option><option>OTRO</option>
        </select>
      </div>
      <div class="form-group">
        <label>Estado Contenedor</label>
        <select id="c-estado">
          <option value="">— Seleccionar —</option>
          <option>01-TRÁNSITO MARÍTIMO</option>
          <option>02-TRAMITANDO EN PUERTO</option>
          <option>03-EN TRÁNSITO TERRESTRE</option>
          <option>04-POSICIONADO EN BLUE</option>
          <option>05-EN DESCARGA</option>
          <option>06-DESCARGADO</option>
          <option>07-NOTIFICADO VACÍO</option>
        </select>
        <small id="c-estado-lock" class="cc-lock"></small>
      </div>
      <div class="form-group">
        <label>Flete Marítimo</label>
        <select id="c-flete">
          <option value="">— Seleccionar —</option>
          <option>01-NO PAGADO</option>
          <option>02-PAGO SOLICITADO</option>
          <option>03-EN PROCESO DE PAGO</option>
          <option>04-PAGADO</option>
        </select>
      </div>
      <div class="form-group">
        <label>BL Original</label>
        <select id="c-bl">
          <option value="">— Seleccionar —</option>
          <option>01-NO ENTREGADO</option>
          <option>02-ENTREGADO</option>
          <option>DETALLE</option>
        </select>
      </div>
      <div class="form-group"><label>RG</label><input id="c-rc" type="text" placeholder="Ej: 00468-25-LS"></div>
      <div class="form-group"><label>RC</label><input id="c-rcnum" type="text" placeholder="No. de RC"></div>
      <div class="form-group"><label>REPORT ESA</label><input id="c-rg" type="text" placeholder="01-NO / 02-SI / 03-NO APLICA / 04-ENVIADO"></div>
      <div class="form-group"><label>Fecha Descarga</label><input id="c-fdesc" type="date"></div>
      <div class="form-group"><label>Mes</label>
        <select id="c-mes">
          <option value="">— Seleccionar —</option>
          <option>enero</option><option>febrero</option><option>marzo</option><option>abril</option>
          <option>mayo</option><option>junio</option><option>julio</option><option>agosto</option>
          <option>septiembre</option><option>octubre</option><option>noviembre</option><option>diciembre</option>
        </select>
      </div>
      <div class="cped">
        <div class="cped-head"><span>Pedidos del contenedor</span><button type="button" class="btn btn-sm" onclick="contPedAgregar()">+ Agregar pedido</button></div>
        <div class="cped-grid cped-cols"><span>País</span><span>DT</span><span>No. pedido</span><span>Bultos</span><span>Peso kg</span><span></span></div>
        <div id="c-ped-rows" style="display:flex;flex-direction:column;gap:6px;"></div>
        <div class="cped-grid cped-total"><span>Total</span><span></span><span id="c-ped-msg" style="font-weight:600;"></span><span id="c-ped-bultos">0</span><span id="c-ped-peso">0.00</span><span></span></div>
      </div>
    </div>
    <div class="modal-footer">
      <button class="btn btn-danger" id="cont-delete-btn" style="margin-right:auto;display:none;" onclick="eliminarCont()">Eliminar</button>
      <button class="btn" onclick="closeModals()">Cancelar</button>
      <button class="btn btn-accent" onclick="guardarCont()">Guardar</button>
    </div>
  </div>
</div>

<!-- MODAL ASIGNAR CORTINA -->
<div class="modal-bg" id="modal-edif-asignar">
  <div class="modal" style="width:520px;">
    <h3 id="edif-modal-title">Asignar a Cortina</h3>
    <div class="form-grid">
      <div class="form-group" style="grid-column:1/-1;">
        <label>Tipo de operación</label>
        <select id="edif-f-tipo" onchange="edifTipoChange()">
          <option value="">Selecciona tipo...</option>
          <option value="carga">🔼 Carga (Despacho)</option>
          <option value="descarga">🔽 Descarga (Contenedor)</option>
        </select>
      </div>
      <div class="form-group" style="grid-column:1/-1;">
        <label>Seleccionar registro</label>
        <select id="edif-f-registro">
          <option value="">Primero selecciona tipo...</option>
        </select>
      </div>
      <div class="form-group">
        <label>Cortina</label>
        <select id="edif-f-cortina">
          <option value="1">Cortina 1</option>
          <option value="2">Cortina 2</option>
          <option value="3">Cortina 3</option>
        </select>
      </div>
      <div class="form-group">
        <label>Operador</label>
        <input id="edif-f-operador" type="text" placeholder="Nombre del operador">
      </div>
      <div class="form-group" style="grid-column:1/-1;">
        <label>Notas</label>
        <input id="edif-f-notas" type="text" placeholder="Observaciones opcionales...">
      </div>
    </div>
    <div class="modal-footer">
      <button class="btn" onclick="closeModals()">Cancelar</button>
      <button class="btn btn-accent" onclick="edifConfirmarAsignar()">✓ Asignar</button>
    </div>
  </div>
</div>

<!-- MODAL LIBERAR CORTINA -->
<div class="modal-bg" id="modal-edif-liberar">
  <div class="modal" style="width:420px;">
    <h3 id="edif-lib-title">Liberar Cortina</h3>
    <p style="font-size:14px;color:var(--text-muted);margin-bottom:1rem;">¿Confirmas que la operación en esta cortina ha finalizado?</p>
    <div id="edif-lib-info" style="background:var(--bg);border-radius:8px;padding:12px 14px;font-size:13px;margin-bottom:1rem;"></div>
    <div class="modal-footer">
      <button class="btn" onclick="closeModals()">Cancelar</button>
      <button class="btn btn-accent" onclick="edifLiberarConfirmar()">✓ Liberar cortina</button>
    </div>
  </div>
</div>

</div><!-- /main -->

  </div><!-- /content-col -->
</div><!-- /layout -->

<div class="footer">
  <span><span id="last-update">—</span><span id="file-name"></span><span id="footer-data" hidden></span></span>
  <span>HUB UL · Blue Logistics <button class="foot-link" onclick="gsTest()">Probar conexión</button></span>
</div>

<!-- MODAL DESPACHO -->
<!-- MODAL TRANSPORTE (por referencia) -->
<div class="modal-bg" id="modal-transp">
  <div class="modal" style="max-width:520px;">
    <h3>🚚 Datos de transporte — <span id="tp-ref"></span></h3>
    <p class="desp-fijo-nota">Se aplica a todos los pedidos de la referencia (<span id="tp-n"></span>). Si la referencia sale en más de un camión, edita cada pedido con "editar".</p>
    <div class="form-grid">
