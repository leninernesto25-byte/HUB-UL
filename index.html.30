  <!-- HISTORIAL TAB -->
  <div class="tab-content" id="tab-historial">

    <div class="pg-head"><div><h2>Historial de despachos</h2><p>Pedidos despachados con su costo. Solo consulta; puedes restaurar una referencia si hubo un error.</p></div><div class="pg-act"><button class="btn btn-sm" onclick="exportHistCSV()">Exportar CSV</button></div></div>
