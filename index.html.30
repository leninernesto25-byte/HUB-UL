// ── GS Connection Test ──
function gsTest(){
  const cbName = 'gsTestCb_'+Date.now();
  const script = document.createElement('script');
  const json = JSON.stringify({accion:'guardar',hoja:'TEST',filas:[['TEST_OK',new Date().toLocaleString()]]});
  const bytes = new TextEncoder().encode(json);
  let binary = ''; bytes.forEach(b=>binary+=String.fromCharCode(b));
  const payload = btoa(binary);
  const timeout = setTimeout(()=>{
    delete window[cbName];
    try{script.parentNode&&script.parentNode.removeChild(script);}catch(e){}
    alert('❌ Timeout — Google Sheets no respondió.');
  }, 10000);
  window[cbName] = (data)=>{
    clearTimeout(timeout);
    delete window[cbName];
    try{script.parentNode&&script.parentNode.removeChild(script);}catch(e){}
    if(data && data.ok){
      alert('✅ ¡CONEXIÓN OK! Google Sheets guarda correctamente.\n\nEl sistema está listo para usar. 🎉');
    } else {
      alert('❌ Error: '+JSON.stringify(data));
    }
  };
  script.src = GS_URL+'?action=save&payload='+encodeURIComponent(payload)+'&callback='+cbName;
  script.onerror = ()=>{ clearTimeout(timeout); delete window[cbName]; alert('❌ Error de red'); };
  document.body.appendChild(script);
}

async function limpiarDespachos(){
  if(!confirm('⚠️ Esto borrará TODOS los registros de:\n\n• Pedidos en Despacho\n• Historial de Despachos\n• Historial de Ingresos\n\nEn Google Sheets y en pantalla.\n\n¿Continuar?')) return;
  despachos.length=0;
  historial.length=0;
  historialCont.length=0;
  renderDespachos();
  renderHistorial();
  renderHistorialCont();
  const [r1,r2,r3] = await Promise.all([
    gsSave('PedidosDespacho', [], GS_CAMPOS.PedidosDespacho),
    gsSave('HistorialDespachos', [], GS_CAMPOS.HistorialDespachos),
    gsSave('HistorialContenedores', [], GS_CAMPOS.HistorialContenedores)
  ]);
  if(r1 && r2 && r3){
    alert('✅ Pedidos en Despacho, Historial de Despachos e Historial de Ingresos limpiados correctamente.');
  } else {
    alert('⚠️ Limpieza local OK, pero hubo un problema al guardar en Google Sheets.\nIntenta presionar ☁️ Guardar.');
  }
}



let despachos=[], noProg=[], editDespachoIdx=null, editNpIdx=null;

const STATUS_LIST=['NO PROGRAMADO','PROGRAMADO','EN PROCESO DE CARGA','CARGADO','DESPACHADO'];
const STATUS_CLASS={'NO PROGRAMADO':'s-noprog','PROGRAMADO':'s-prog','EN PROCESO DE CARGA':'s-enproceso','CARGADO':'s-cargado','DESPACHADO':'s-despachado'};
const STATUS_LABEL={'NO PROGRAMADO':'No programado','PROGRAMADO':'Programado','EN PROCESO DE CARGA':'En proceso de carga','CARGADO':'Cargado','DESPACHADO':'Despachado'};

function statusBadge(s){
  return `<span class="badge ${STATUS_CLASS[s]||'s-noprog'}">${STATUS_LABEL[s]||s||'No programado'}</span>`;
}
function prioBadge(p){
  const cls=p==='URGENTE'?'s-prio-urg':p==='ALTA'?'s-prio-alta':'s-prog';
  return `<span class="badge ${cls}">${p}</span>`;
}
function destClass(d){
  return {'COSTA RICA':'dest-cr','NICARAGUA':'dest-ni','GUATEMALA':'dest-gt','HONDURAS':'dest-hn','PANAMA':'dest-pa','EL SALVADOR':'dest-sv'}[d]||'';
}

function switchTab(tab,el){
  document.querySelectorAll('.op-tab').forEach(t=>t.classList.remove('active'));
  el.classList.add('active');
  document.querySelectorAll('.tab-content').forEach(c=>c.classList.remove('active'));
  document.getElementById('tab-'+tab).classList.add('active');
  const isMI=tab.startsWith('mi-');
  const isDesp=tab==='despachos';
  const isCont=tab==='contenedores';
  const isEdif = tab==='edif12'||tab==='edif6';
  const hideBtnNuevo=isCont||isMI||isEdif;
  const _bn=document.getElementById('btn-nuevo'); if(_bn) _bn.style.display=hideBtnNuevo?'none':'inline-flex';
  if(!hideBtnNuevo){
    (document.getElementById('btn-nuevo')||{}).textContent =isDesp?'+ Nuevo registro':'+ No programado';
    if(_bn) _bn.onclick=isDesp?()=>openDespachoModal(null):()=>openNpModal(null);
  }
  // Always re-render MI tabs when switching to them
  if(tab==='noprog'){ renderNp(); npRenderPaisesBtns(); }
  if(tab==='edif12') edifRenderAll(12);
  if(tab==='edif6')  edifRenderAll(6);
  if(tab==='historial') renderHistorial();
  if(tab==='historial-cont') renderHistorialCont();
  if(tab==='rc') rcRender();
  if(tab==='tramites') tramRender();
  if(tab==='seguro') segRender();
  if(tab==='resumen') roRender(true);
  if(tab==='resumen'||tab==='dashboard'||tab==='buscar') archAsegurar();
  if(tab==='buscar') setTimeout(()=>{ const i=document.getElementById('bp-q'); if(i) i.focus(); },50);
  if(tab==='dashboard') dashInit();
}

function toggleOpGroup(id){
  document.getElementById(id).classList.toggle('collapsed');
}

function goToTab(name){
  const el=document.querySelector('.op-tab[data-tab="'+name+'"]');
  if(el) switchTab(name,el);
}

// CSV
const csvInput=document.getElementById('csv-input');
const dropZone=document.getElementById('drop-zone');
csvInput.addEventListener('change',e=>{if(e.target.files[0])loadCSV(e.target.files[0]);});
dropZone.addEventListener('dragover',e=>{e.preventDefault();dropZone.classList.add('dragover');});
dropZone.addEventListener('dragleave',()=>dropZone.classList.remove('dragover'));
dropZone.addEventListener('drop',e=>{
  e.preventDefault();dropZone.classList.remove('dragover');
  const f=e.dataTransfer.files[0];if(f)loadCSV(f);
});

function mapStatus(raw){
  const s=(raw||'').toUpperCase().trim();
  if(STATUS_LIST.includes(s))return s;
  if(s.includes('NO')&&s.includes('PROG'))return'NO PROGRAMADO';
  if(s.includes('EN')&&s.includes('PROC'))return'EN PROCESO DE CARGA';
  if(s.includes('PROG'))return'PROGRAMADO';
  if(s.includes('CARG'))return'CARGADO';
  if(s.includes('DESP'))return'DESPACHADO';
  return'NO PROGRAMADO';
}

function loadCSV(file){
  (document.getElementById('file-name')||{}).textContent ='✓ '+file.name;
  const reader=new FileReader();
  reader.onload=e=>{
    const rows=e.target.result.trim().split('\n');
    const headers=rows[0].split(',').map(h=>h.replace(/"/g,'').trim().toLowerCase());
    const map={
      mes:findCol(headers,['mes']),ref:findCol(headers,['referencia','ref']),
      dt:findCol(headers,['dt']),no_pedido:findCol(headers,['no. pedido','numero de pedido','no pedido','pedido']),
      dest:findCol(headers,['destino','dest']),pallets:findCol(headers,['pallets']),
      remolque:findCol(headers,['remolque']),regimen:findCol(headers,['regimen','régimen']),
      edif:findCol(headers,['edificio','edif']),fcarga:findCol(headers,['fecha de carga','fecha carga','fcarga']),
      fsalida:findCol(headers,['fecha de salida','fecha salida','fsalida']),
      status:findCol(headers,['estatus','status']),
      peso:findCol(headers,['peso']),vol:findCol(headers,['volumen','vol'])
    };
    despachos=rows.slice(1).filter(r=>r.trim()).map(row=>{
      const cols=parseCSVRow(row);
      return{mes:get(cols,map.mes),ref:get(cols,map.ref),dt:get(cols,map.dt),
        no_pedido:get(cols,map.no_pedido),dest:get(cols,map.dest),pallets:get(cols,map.pallets),
        remolque:get(cols,map.remolque),regimen:get(cols,map.regimen),edif:get(cols,map.edif),
        fcarga:get(cols,map.fcarga),fsalida:get(cols,map.fsalida),
        status:mapStatus(get(cols,map.status)),
        peso:parseFloat(get(cols,map.peso).replace(/,/g,''))||0,
        vol:parseFloat(get(cols,map.vol).replace(/,/g,''))||0};
    });
    const now=new Date();
    (document.getElementById('last-update')||{}).textContent ='Actualizado: '+now.toLocaleDateString('es-SV')+' '+now.toLocaleTimeString('es-SV',{hour:'2-digit',minute:'2-digit'});
    (document.getElementById('footer-data')||{}).textContent =file.name+' · '+despachos.length+' registros';
    populateFilters();renderDespachos();renderNp();
  };
  reader.readAsText(file,'UTF-8');
}

function findCol(headers,names){for(const n of names){const i=headers.findIndex(h=>h.includes(n));if(i>=0)return i;}return -1;}
function get(cols,idx){return idx>=0&&cols[idx]?cols[idx].replace(/^"|"$/g,'').trim():'';}
function parseCSVRow(row){
  const result=[];let cur='';let inQ=false;
  for(let i=0;i<row.length;i++){const c=row[i];if(c==='"'){inQ=!inQ;}else if(c===','&&!inQ){result.push(cur);cur='';}else{cur+=c;}}
  result.push(cur);return result;
}

function getFiltered(){
  const mes=document.getElementById('filter-mes').value;
  const dest=document.getElementById('filter-dest').value;
  const status=document.getElementById('filter-status').value;
  const q=document.getElementById('filter-q').value.toLowerCase();
  return despachos.filter(r=>{
    if(mes&&r.mes!==mes)return false;
    if(dest&&r.dest!==dest)return false;
    if(status&&r.status!==status)return false;
    if(q&&![r.ref,r.dt,r.no_pedido||'',r.dest].some(v=>v.toLowerCase().includes(q)))return false;
    return true;
  });
}

// ============================================================
// COSTOS POR REFERENCIA (se pegan una vez y se asignan a cada PO)
// Cada rubro guarda su condición del cliente (ZFA1/ZIA1/ZPB1)
// y su grupo Blue (servicio Blue / reintegro · categoría)
// ============================================================
const COND_INFO={ZFA1:'Reintegro de fletes + cargos a naviera',ZIA1:'Demás rubros',ZPB1:'Almacenaje'};
const COND_ORDEN=['ZFA1','ZIA1','ZPB1'];
function costCondRubro(rubro){
  const r=dgNorm(rubro);
  if(r.includes('FLETE MARITIMO')||r.includes('CARGOS DE NAVIERA')) return 'ZFA1';
  if(r.startsWith('ALMACENAMIENTO')) return 'ZPB1';
  return 'ZIA1';
}
function costLista(r){
  if(Array.isArray(r.costos)) return r.costos;
  if(r.costos_json){ try{ const a=JSON.parse(r.costos_json); if(Array.isArray(a)){ r.costos=a; return a; } }catch(e){} }
  return null;
}
function costSet(r,lista){ r.costos=lista; r.costos_json=JSON.stringify(lista); r.costo_total=Math.round(lista.reduce((a,c)=>a+c.monto,0)*100)/100; }
function costResumen(lista){
  const o={total:0,serv:0,reint:0,conds:{},cats:{}};
  (lista||[]).forEach(c=>{ const m=+c.monto||0; o.total+=m; if(dgEsReintegro(c.rubro)) o.reint+=m; else o.serv+=m;
    o.conds[c.cond||costCondRubro(c.rubro)]=(o.conds[c.cond||costCondRubro(c.rubro)]||0)+m; const k=dgCatRubro(c.rubro); o.cats[k]=(o.cats[k]||0)+m; });
  return o;
}
// Lee el cuadro pegado: "Condición / Rubro | PO xxx (CR) | …", secciones Zxxx, rubros y totales
function costParse(txt){
  const lineas=txt.replace(/\r/g,'').split('\n').filter(l=>l.trim());
  const sep=lineas.some(l=>l.includes('\t'))?'\t':/\s{2,}/;
  const filas=lineas.map(l=>l.split(sep));
  const h=filas.findIndex(f=>f.some(c=>/PO\s*\d{6,}/i.test(c)));
  if(h<0) return {error:'No encontré el encabezado con las columnas "PO …".'};
  const cols=[]; filas[h].forEach((c,i)=>{ const m=String(c).match(/PO\s*(\d{6,})\s*(?:\(([A-Z]{2})\))?/i); if(m) cols.push({i,po:m[1],pais:(m[2]||'').toUpperCase()}); });
  let cond='ZIA1'; const rubros=[], totales={};
  filas.slice(h+1).forEach(f=>{
    const c0=String(f[0]||'').trim(); if(!c0) return;
    const m=c0.match(/^(Z[A-Z0-9]{3})\b/i);
    if(m){ cond=m[1].toUpperCase(); return; }
    const t=c0.match(/^total\s+(general|Z[A-Z0-9]{3})/i);
    const vals=cols.map(c=>pasteNum(f[c.i]));
    if(t){ totales[t[1].toUpperCase()]=vals; return; }
    rubros.push({cond,rubro:c0,montos:vals});
  });
  // Validación contra los totales del cuadro
  const avisos=[];
  cols.forEach((c,j)=>{
    COND_ORDEN.concat(Object.keys(totales).filter(k=>k!=='GENERAL'&&!COND_ORDEN.includes(k))).forEach(k=>{
      if(!totales[k]) return; const s=rubros.filter(r=>r.cond===k).reduce((a,r)=>a+r.montos[j],0);
      if(Math.abs(s-totales[k][j])>0.02) avisos.push(`PO ${c.po}: el Total ${k} dice ${dgUsd(totales[k][j],2)} y los rubros suman ${dgUsd(s,2)}`);
    });
    if(totales.GENERAL){ const s=rubros.reduce((a,r)=>a+r.montos[j],0); if(Math.abs(s-totales.GENERAL[j])>0.02) avisos.push(`PO ${c.po}: el Total general dice ${dgUsd(totales.GENERAL[j],2)} y los rubros suman ${dgUsd(s,2)}`); }
  });
  return {cols,rubros,totales,avisos};
}
// ---------- ventana ----------
let cstRef='', cstRecs=[], cstParsed=null;
function costAbrir(ref,fuente){
  cstRef=ref; cstParsed=null;
  cstRecs=(fuente==='hist'?historial:despachos).filter(r=>(r.ref||'SIN REF')===ref);
  if(!cstRecs.length) return;
  document.getElementById('cst-titulo').textContent=`Costos · ${ref} · ${cstRecs.length} pedido${cstRecs.length>1?'s':''}`;
  document.getElementById('cst-paste').value='';
  costRender();
  document.getElementById('modal-costos').classList.add('open');
}
function costAnalizar(){
  const t=document.getElementById('cst-paste').value;
  cstParsed=t.trim()?costParse(t):null;
  costRender();
}
// Montos por pedido: del cuadro pegado (si hay) o de lo guardado
function costPorPedido(){
  return cstRecs.map(r=>{
    const po=hubNormPed(r.no_pedido);
    if(cstParsed&&cstParsed.cols){
      const j=cstParsed.cols.findIndex(c=>c.po===po);
      if(j<0) return {r,lista:null,nuevo:false};
      return {r,lista:cstParsed.rubros.filter(x=>x.montos[j]).map(x=>({cond:x.cond,rubro:x.rubro,monto:Math.round(x.montos[j]*100)/100})),nuevo:true};
    }
    return {r,lista:costLista(r),nuevo:false};
  });
}
function costRender(){
  const msg=document.getElementById('cst-msg'), prev=document.getElementById('cst-prev'), btn=document.getElementById('cst-guardar');
  const avisos=[];
  if(cstParsed&&cstParsed.error) avisos.push(cstParsed.error);
  if(cstParsed&&cstParsed.cols){
    const pos=new Set(cstRecs.map(r=>hubNormPed(r.no_pedido)));
    cstParsed.cols.filter(c=>!pos.has(c.po)).forEach(c=>avisos.push(`PO ${c.po} no es de ${cstRef}: se ignora`));
    cstRecs.filter(r=>!cstParsed.cols.some(c=>c.po===hubNormPed(r.no_pedido))).forEach(r=>avisos.push(`El pedido ${r.no_pedido} de ${cstRef} no viene en el cuadro: queda sin cambios`));
    avisos.push(...cstParsed.avisos);
  }
  msg.innerHTML=avisos.length?`<div class="paste-msg err">${avisos.map(impEsc).join('<br>')}</div>`:(cstParsed&&cstParsed.cols?'<div class="paste-msg ok">✓ Totales verificados. Revisa y guarda.</div>':'');
  const data=costPorPedido();
  btn.disabled=!(cstParsed&&cstParsed.cols&&data.some(d=>d.nuevo));
  if(!data.some(d=>d.lista)){ prev.innerHTML='<div class="dg-empty" style="min-height:120px"><strong>Sin costos registrados</strong><span>Pega el cuadro de costos de esta referencia.</span></div>'; return; }
  const res=data.map(d=>d.lista?costResumen(d.lista):null);
  const celda=(v,b)=>`<td class="num${b?' b':''}">${v==null?'<span class="cst-na">—</span>':dgUsd(v,2)}</td>`;
  const fila=(lab,fn,cls)=>`<tr class="${cls||''}"><td>${lab}</td>${res.map(x=>celda(x?fn(x):null,cls==='tot')).join('')}<td class="num b">${dgUsd(res.reduce((a,x)=>a+(x?fn(x):0),0),2)}</td></tr>`;
  const det=COND_ORDEN.map(k=>{
    const rub=[...new Set(data.flatMap(d=>(d.lista||[]).filter(c=>(c.cond||costCondRubro(c.rubro))===k).map(c=>c.rubro)))];
    return rub.map(rb=>`<tr class="det"><td>${impEsc(rb)}</td>${data.map(d=>{ if(!d.lista) return celda(null); const v=d.lista.filter(c=>c.rubro===rb).reduce((a,c)=>a+c.monto,0); return `<td class="num">${v?dgUsd(v,2):''}</td>`; }).join('')}<td></td></tr>`).join('');
  }).join('');
  prev.innerHTML=`<table class="cst-t"><thead><tr><th>Condición / grupo</th>${data.map(d=>`<th class="num">${impEsc(d.r.no_pedido)}${d.nuevo?' <em>nuevo</em>':''}</th>`).join('')}<th class="num">Total ${impEsc(cstRef)}</th></tr></thead><tbody>
    <tr class="sec"><td colspan="${data.length+2}">Por condición (cliente)</td></tr>
    ${COND_ORDEN.map(k=>fila(`${k} · ${COND_INFO[k]}`,x=>x.conds[k]||0)).join('')}
    <tr class="sec"><td colspan="${data.length+2}">Por grupo Blue</td></tr>
    ${fila('Costo Blue (servicios)',x=>x.serv)}
    ${fila('Reintegros (flete, naviera, terceros)',x=>x.reint)}
    ${fila('Total general',x=>x.total,'tot')}
    </tbody></table>
    <details class="cst-det"><summary>Ver detalle por rubro</summary><table class="cst-t"><tbody>${det}</tbody></table></details>`;
}
function costGuardar(){
  const data=costPorPedido().filter(d=>d.nuevo);
  if(!data.length) return;
  const reempl=data.filter(d=>costLista(d.r)&&costLista(d.r).length).length;
  if(reempl&&!confirm(`${reempl} pedido${reempl>1?'s ya tienen':' ya tiene'} costos. ¿Reemplazarlos con este cuadro?`)) return;
  data.forEach(d=>costSet(d.r,d.lista));
  closeModals();
  try{ renderDespachos(); }catch(e){} try{ renderHistorial(); }catch(e){}
  setTimeout(gsSaveAll,500);
  alert(`✅ Costos guardados en ${data.length} pedido${data.length>1?'s':''} de ${cstRef}\n\nTotal: ${dgUsd(data.reduce((a,d)=>a+d.lista.reduce((x,c)=>x+c.monto,0),0),2)}`);
}
function costTotalRef(rows){ const t=rows.reduce((a,r)=>a+(costLista(r)?pasteNum(r.costo_total):0),0); return t; }

// ============================================================
// DESPACHAR REFERENCIA (CARGADO → DESPACHADO → Historial)
// No se archiva un pedido sin costos registrados
// ============================================================
function despTieneCostos(r){ const l=costLista(r); return !!(l&&l.length); }
function despPuedeDespachar(){ return !window.HUB_ONLINE || (typeof hubPuede==='function' && hubPuede('despacho')); }
function despDespacharRef(ref){
  if(!despPuedeDespachar()){ alert('Solo tráfico puede despachar.'); return; }
  const rows=despachos.filter(r=>(r.ref||'SIN REF')===ref);
  if(!rows.length) return;
  const noCarg=rows.filter(r=>r.status!=='CARGADO');
  if(noCarg.length){ alert(`🔒 ${ref}: todos los pedidos deben estar CARGADOS para despachar.\n\nFaltan: ${noCarg.map(r=>r.no_pedido||r.dt||'—').join(', ')}`); return; }
  const sinCosto=rows.filter(r=>!despTieneCostos(r));
  if(sinCosto.length){ alert(`🔒 ${ref} no puede pasar al archivo.\n\n${sinCosto.length} pedido${sinCosto.length>1?'s':''} sin costos:\n• ${sinCosto.map(r=>r.no_pedido||r.dt||'—').join('\n• ')}\n\nRegistra los costos de cada pedido antes de despachar.`); return; }
  if(!confirm(`🚚 Despachar ${ref}\n\n${rows.length} pedido${rows.length>1?'s':''} · ${rows[0].dest||'—'}\n\nPasan a DESPACHADO y se archivan en el Historial.`)) return;
  const hoy=new Date().toLocaleDateString('es-SV');
  rows.forEach(r=>{
    r.status='DESPACHADO';
    if(!r.fsalida) r.fsalida=hoy;
    r.fechaArchivo=hoy;
    if(!r.factura) r.factura='NO ENVIADA';
    if(!r.gr) r.gr='NO RECIBIDO';
    if(!r.scan_id) r.scan_id='NO ENVIADO';
    historial.push(r);
  });
  rows.map(r=>despachos.indexOf(r)).sort((a,b)=>b-a).forEach(i=>{ if(i>=0) despachos.splice(i,1); });
  populateFilters(); renderDespachos(); renderHistorial(); setTimeout(gsSaveAll,500);
  alert(`✅ ${ref} despachada: ${rows.length} pedido${rows.length>1?'s':''} archivados en el Historial.`);
}

function renderDespachos(){
  try{ posMarcar(); }catch(e){}
  const filtered=getFiltered();
  const counts={};STATUS_LIST.forEach(s=>counts[s]=0);
  despachos.forEach(r=>{if(counts[r.status]!==undefined)counts[r.status]++;});
  (document.getElementById('m-total')||{}).textContent =filtered.length;
  (document.getElementById('m-noprog')||{}).textContent =counts['NO PROGRAMADO'];
  (document.getElementById('m-prog')||{}).textContent =counts['PROGRAMADO'];
  (document.getElementById('m-enproceso')||{}).textContent =counts['EN PROCESO DE CARGA'];
  (document.getElementById('m-cargado')||{}).textContent =counts['CARGADO'];
  (document.getElementById('m-despachado')||{}).textContent =counts['DESPACHADO'];
  const peso=filtered.reduce((a,r)=>a+r.peso,0);
  const vol=filtered.reduce((a,r)=>a+r.vol,0);
  (document.getElementById('m-peso')||{}).textContent =peso.toLocaleString('es-SV',{minimumFractionDigits:2,maximumFractionDigits:2});
  (document.getElementById('m-vol')||{}).textContent =vol.toFixed(2);
  (document.getElementById('count-label')||{}).textContent =filtered.length+' de '+despachos.length+' registros';
  (document.getElementById('tab-count-despachos')||{}).textContent =despachos.length;
  const tbody=document.getElementById('tbody');
  if(!filtered.length){tbody.innerHTML='<tr><td colspan="15"><div class="empty"><strong>Sin resultados</strong>Ajusta los filtros para ver registros</div></td></tr>';return;}

  // Group by ref
  const groups={}, order=[];
  filtered.forEach(r=>{
    const ref=r.ref||'SIN REF';
    if(!groups[ref]){groups[ref]=[];order.push(ref);}
    groups[ref].push(r);
  });
  const dColor=dest=>dest==='EL SALVADOR'?'#A32D2D':dest==='COSTA RICA'?'#185FA5':dest==='NICARAGUA'?'#3B6D11':dest==='HONDURAS'?'#7A1F5A':dest==='GUATEMALA'?'#854F0B':'#374151';
  let html='';
  order.forEach(ref=>{
    const rows=groups[ref];
    const dest=rows[0].dest||'';
    const status=rows[0].status||'';
    const color=dColor(dest);
    html+=`<tr class="desp-grp">
      <td colspan="16">
        <div class="desp-grp-in">
          <span style="font-size:13px;font-weight:700;color:${color};">${ref}</span>
          <span style="font-size:11px;color:#6B7280;">${rows.length} pedido${rows.length>1?'s':''} · ${dest}</span>
          <span>${statusBadge(status)}</span>
          ${typeof tramChips==='function'?tramChips(ref):''}
          <span class="desp-grp-act">
          ${transpBoton(ref, rows)}
          ${typeof ocBoton==='function'?ocBoton(ref):''}
          ${typeof hubEsAdmin==='function'&&(hubEsAdmin()||!window.HUB_ONLINE)?`<button class="edit-btn" onclick="despCorregirEstado('${ref}')" title="Solo administrador: corregir el estado de toda la referencia">↺ Estado</button>`:''}
          ${(()=>{ const con=rows.filter(x=>despTieneCostos(x)).length, t=costTotalRef(rows);
            return `<button class="edit-btn cst-btn ${con===rows.length?'ok':''}" onclick="costAbrir('${ref}')" title="${con} de ${rows.length} pedidos con costos">💲 ${con?dgUsd(t,2)+(con<rows.length?` (${con}/${rows.length})`:''):'Costos'}</button>`; })()}
          ${(()=>{
            const cargado=rows.every(x=>x.status==='CARGADO');
            if(!cargado) return !despPuedeCortina() ? '' : `<button class="edit-btn" onclick="despAsignarEdifBloque('${ref}')" style="color:#059669;border-color:#6EE7B7;font-weight:600;">🏭 Asignar cortina</button>`;
            const sinC=rows.filter(x=>!despTieneCostos(x)).length;
            return sinC
              ? `<span class="desp-lock" title="Registra los costos para poder archivar">🔒 ${sinC} sin costos</span>${despPuedeDespachar()?'<button class="desp-go" disabled>🚚 Despachar</button>':''}`
              : (despPuedeDespachar()?`<button class="desp-go" onclick="despDespacharRef('${ref}')">🚚 Despachar ${ref}</button>`:'');
          })()}
          </span>
        </div>
      </td>
    </tr>`;
    rows.forEach(r=>{
      const ri=despachos.indexOf(r);
      html+=`<tr style="background:#FAFAFA;">
        <td style="padding-left:24px;color:#6B7280;font-size:12px;">${r.mes}</td>
        <td></td>
        <td class="mono" style="font-size:11px;">${r.dt||'—'}</td>
        <td class="mono">${r.no_pedido||'—'}</td>
        <td class="${destClass(r.dest)}">${r.dest}</td>
        <td class="num">${r.pallets||'—'}${+r.cajas>0?`<small class="pal-cj">${Number(r.cajas).toLocaleString('es-SV')} cj</small>`:''}</td>
        <td class="mono">${(r.camion||r.remolque)?[r.camion,r.remolque].filter(Boolean).join(' · '):'—'}${r.piloto?`<small class="desp-piloto">${r.piloto}${r.licencia?' · Lic. '+r.licencia:''}</small>`:''}</td>
        <td>${r.regimen}</td>
        <td>${r.edif||'—'}</td>
        <td style="text-align:center;font-weight:600;color:${r.cortina?'#1D4ED8':'var(--text-hint)'}">${r.cortina?'C'+r.cortina:'—'}</td>
        <td class="mono">${r.fcarga||'—'}</td>
        <td class="mono">${r.fsalida||'—'}</td>
        <td>${statusBadge(r.status)}</td>
        <td class="num">${r.peso.toLocaleString('es-SV',{minimumFractionDigits:2,maximumFractionDigits:2})}</td>
        <td class="num">${r.vol.toFixed(2)}</td>
        <td style="display:flex;gap:4px;padding:9px 12px;">
          <button class="edit-btn" onclick="openDespachoModal(${ri})">editar</button>
          <button class="edit-btn" onclick="despRetornarNP(${ri})" style="color:#7C3AED;border-color:#C4B5FD;">↩ NP</button>
        </td>
      </tr>`;
    });
  });
  tbody.innerHTML=html;
  // Sync top scrollbar width after render
  setTimeout(()=>{
    const wrap = tbody.closest('.table-wrap');
    if(wrap){
      const prev = wrap.previousElementSibling;
      if(prev && prev.dataset.topScrollAdded!=='1'){
        const inner = prev.querySelector('div');
        if(inner) inner.style.width = (wrap.querySelector('table')||{}).scrollWidth+'px';
      }
    }
  }, 50);
}

function populateFilters(){
  const meses=[...new Set(despachos.map(r=>r.mes))];
  const dests=[...new Set(despachos.map(r=>r.dest))];
  const mSel=document.getElementById('filter-mes'),dSel=document.getElementById('filter-dest');
  const cm=mSel.value,cd=dSel.value;
  mSel.innerHTML='<option value="">Todos los meses</option>'+meses.map(m=>`<option${m===cm?' selected':''}>${m}</option>`).join('');
  dSel.innerHTML='<option value="">Todos los destinos</option>'+dests.map(d=>`<option${d===cd?' selected':''}>${d}</option>`).join('');
}

function clearFilters(){
  ['filter-mes','filter-dest','filter-status','filter-q'].forEach(id=>document.getElementById(id).value='');
  renderDespachos();
}

function openDespachoModal(idx){
  editDespachoIdx=idx;
  (document.getElementById('modal-title')||{}).textContent =idx===null?'Nuevo despacho':'Editar despacho';
  if(idx!==null){
    const r=despachos[idx];
    document.getElementById('f-mes').value=r.mes;document.getElementById('f-ref').value=r.ref;
    document.getElementById('f-dt').value=r.dt;document.getElementById('f-nopedido').value=r.no_pedido||'';
    document.getElementById('f-dest').value=r.dest;document.getElementById('f-pallets').value=r.pallets;
    document.getElementById('f-remolque').value=r.remolque||'';document.getElementById('f-regimen').value=r.regimen;
    document.getElementById('f-camion').value=r.camion||'';document.getElementById('f-piloto').value=r.piloto||'';document.getElementById('f-licencia').value=r.licencia||'';
    // Edif: normalize to select value
    const edifVal=r.edif&&r.edif.includes('6')?'EDIF 6':r.edif&&r.edif.includes('12')?'EDIF 12':r.edif||'';
    document.getElementById('f-edif').value=edifVal;
    document.getElementById('f-fcarga').value=r.fcarga;
    document.getElementById('f-fsalida').value=r.fsalida;
    document.getElementById('f-status').value=r.status||'PROGRAMADO';
    document.getElementById('f-peso').value=r.peso;document.getElementById('f-vol').value=r.vol;
    despEdifChange(); // populate cortinas
    if(r.cortina) document.getElementById('f-cortina').value=r.cortina;
    despStatusChange();
  }else{
    ['f-ref','f-dt','f-nopedido','f-pallets','f-remolque','f-camion','f-piloto','f-licencia','f-regimen','f-fcarga','f-fsalida','f-peso','f-vol'].forEach(id=>document.getElementById(id).value='');
    document.getElementById('f-mes').value=new Date().toLocaleString('es-SV',{month:'long'});
    document.getElementById('f-dest').value='COSTA RICA';
    document.getElementById('f-status').value='PROGRAMADO';
    document.getElementById('f-edif').value='';
    document.getElementById('f-cortina').value='';
    document.getElementById('f-cortina-group').style.display='none';
  }
  // Datos fijos desde Ingreso/NP: en un despacho existente solo se digitan remolque y fechas
  const fijo=idx!==null;
  ['f-mes','f-ref','f-dt','f-nopedido','f-dest','f-pallets','f-regimen','f-edif','f-cortina','f-status','f-peso','f-vol'].forEach(id=>{
    const el=document.getElementById(id); if(!el) return; el.disabled=fijo; el.classList.toggle('campo-fijo',fijo);
  });
  const nota=document.getElementById('desp-fijo-nota'); if(nota) nota.hidden=!fijo;
  ['f-camion','f-remolque','f-piloto','f-licencia','f-fcarga','f-fsalida'].forEach(id=>{ const g=document.getElementById(id)?.closest('.form-group'); if(g) g.classList.add('fg-edit'); });
  document.getElementById('modal-despacho').classList.toggle('modo-fijo',fijo);
  document.getElementById('modal-despacho').classList.add('open');
  if(fijo) setTimeout(()=>{ const r=document.getElementById('f-camion'); if(r) r.focus(); },60);
}


// ── Despacho modal: status change handler ──
function despStatusChange(){
  const status=document.getElementById('f-status').value;
  const cortinaGroup=document.getElementById('f-cortina-group');
  if(cortinaGroup) cortinaGroup.style.display=(status==='EN PROCESO DE CARGA')?'flex':'none';
  if(status!=='EN PROCESO DE CARGA'){
    const cs=document.getElementById('f-cortina');
    if(cs) cs.value='';
  }
}

// ── Despacho modal: edificio change → populate cortinas ──
function despEdifChange(){
  const edifVal=document.getElementById('f-edif').value;
  const cortinaGroup=document.getElementById('f-cortina-group');
  const cortinaSel=document.getElementById('f-cortina');
  const status=document.getElementById('f-status').value;
  if(!edifVal||status!=='EN PROCESO DE CARGA'){
    if(cortinaGroup) cortinaGroup.style.display='none';
    return;
  }
  if(cortinaGroup) cortinaGroup.style.display='flex';
  const edifNum=edifVal.includes('6')?6:12;
  const nCortinas=EDIFICIOS[edifNum]?EDIFICIOS[edifNum].cortinas:0;
  let opts='<option value="">— Sin cortina —</option>';
  for(let i=1;i<=nCortinas;i++){
    const cx=edifState[edifNum]&&edifState[edifNum].cortinas[i];
    const libre=!cx||cx.estado==='libre';
    const ocupInfo=libre?'':'⚠️ OCUPADA';
    opts+=`<option value="${i}"${!libre?' style="color:#DC2626;"':''}> Cortina ${i} ${ocupInfo}</option>`;
  }
  cortinaSel.innerHTML=opts;
}

// ── Despacho modal: cortina change → live preview ──
function despCortinaChange(){
  const edifVal=document.getElementById('f-edif').value;
  const cortinaVal=parseInt(document.getElementById('f-cortina').value);
  if(!edifVal||!cortinaVal) return;
  const edifNum=edifVal.includes('6')?6:12;
  const cx=edifState[edifNum]&&edifState[edifNum].cortinas[cortinaVal];
  if(cx&&cx.estado!=='libre'){
    alert(`⚠️ Cortina ${cortinaVal} — Edificio ${edifNum} está OCUPADA con:\n"${cx.label||'—'}"\n\nAl guardar se agregará a la cola de espera.`);
  }
}

function saveDespacho(){
  const edifVal=document.getElementById('f-edif').value;
  const cortinaVal=document.getElementById('f-cortina').value;
  const statusVal=document.getElementById('f-status').value;
  const prevRecord=editDespachoIdx!==null?despachos[editDespachoIdx]:null;
  const r={...(prevRecord||{}),mes:document.getElementById('f-mes').value,ref:document.getElementById('f-ref').value,
    dt:document.getElementById('f-dt').value,no_pedido:document.getElementById('f-nopedido').value,
    dest:document.getElementById('f-dest').value,pallets:document.getElementById('f-pallets').value,
    remolque:document.getElementById('f-remolque').value.trim().toUpperCase(),regimen:document.getElementById('f-regimen').value,
    camion:document.getElementById('f-camion').value.trim().toUpperCase(),piloto:document.getElementById('f-piloto').value.trim(),licencia:document.getElementById('f-licencia').value.trim().toUpperCase(),
    edif:edifVal,cortina:cortinaVal,
    fcarga:document.getElementById('f-fcarga').value,
    fsalida:document.getElementById('f-fsalida').value,status:statusVal,
    peso:parseFloat(document.getElementById('f-peso').value)||0,vol:parseFloat(document.getElementById('f-vol').value)||0};
  {
    // ¿Es otra unidad del mismo DT y pedido? → ofrecer DT con letra (-A, -B…)
    const dN=hubNormDT(r.dt), pN=hubNormPed(r.no_pedido);
    if(dN){
      const mismo=hubRegistro().find(e=>['desp','hist'].includes(e.etapa)&&e.obj!==prevRecord&&e.dt===dN);
      if(mismo&&(!pN||mismo.pedido===pN)){
        const nuevoDT=hubSiguienteUnidad(r.dt);
        if(nuevoDT&&confirm(`El DT ${r.dt} ya está en ${mismo.donde}.\n\n¿Es otra unidad del mismo pedido?\nSe registrará como DT ${nuevoDT}.`)){
          r.dt=nuevoDT; const el=document.getElementById('f-dt'); if(el) el.value=nuevoDT;
        }
      }
    }
    const it=[{pedido:r.no_pedido,dt:r.dt}];
    let dups=hubDuplicados(it,['desp','hist'],e=>prevRecord&&e.obj===prevRecord);
    const esUnidad=/-[A-Z]$/.test(hubNormDT(r.dt));
    dups=dups.concat(hubDuplicados(hubCambiados(it,prevRecord?[{pedido:prevRecord.no_pedido,dt:prevRecord.dt}]:[]).map(x=>esUnidad?{pedido:'',dt:x.dt}:x),['ingreso','np']));
    if(dups.length){ hubAvisoDup([...new Set(dups)],'No se puede guardar el despacho'); return; }
  }
  // ── Live update edificio cortina ──
  if(statusVal==='EN PROCESO DE CARGA'&&edifVal&&cortinaVal){
    const edifNum=edifVal.includes('6')?6:12;
    const cortinaNum=parseInt(cortinaVal);
    // Release previous cortina if changed
    if(prevRecord&&prevRecord.cortina&&(prevRecord.edif!==edifVal||prevRecord.cortina!==cortinaVal)){
      const prevEdif=prevRecord.edif&&prevRecord.edif.includes('6')?6:12;
      const prevCortina=parseInt(prevRecord.cortina);
      if(edifState[prevEdif]&&edifState[prevEdif].cortinas[prevCortina]&&
         edifState[prevEdif].cortinas[prevCortina].despRef===r.ref){
        edifState[prevEdif].cortinas[prevCortina]={estado:'libre',tipo:null,ref:null,label:null,inicio:null,operador:'',notas:'',minutos:0,docId:null};
      }
    }
    // Assign cortina
    if(edifState[edifNum]&&edifState[edifNum].cortinas[cortinaNum]){
      if(edifState[edifNum].cortinas[cortinaNum].estado!=='libre'&&
         edifState[edifNum].cortinas[cortinaNum].despRef!==r.ref){
        if(!confirm(`⚠️ Cortina ${cortinaNum} del Edificio ${edifNum} está OCUPADA.\n¿Agregar a cola de espera?`)){
          return;
        }
        edifState[edifNum].cola.push({tipo:'carga',ref:r.ref,label:`${r.ref} — ${r.dt} → ${r.dest}`,equipo:r.remolque||'',destOrig:r.dest||'',operador:'',notas:'',despRef:r.ref});
      } else {
        edifState[edifNum].cortinas[cortinaNum]={
          estado:'ocupada',tipo:'carga',
          ref:r.ref,label:`${r.ref} — ${r.dt||''} → ${r.dest||''}`,
          inicio:edifState[edifNum].cortinas[cortinaNum].inicio||Date.now(),
          operador:'',notas:'',minutos:0,docId:r.dt||'',despRef:r.ref
        };
      }
      edifRenderAll(edifNum);
    }
  } else if(prevRecord&&prevRecord.cortina&&prevRecord.status==='EN PROCESO DE CARGA'&&statusVal!=='EN PROCESO DE CARGA'){
    // Releasing from EN PROCESO DE CARGA
    const prevEdif=prevRecord.edif&&prevRecord.edif.includes('6')?6:12;
    const prevCortina=parseInt(prevRecord.cortina);
    if(edifState[prevEdif]&&edifState[prevEdif].cortinas[prevCortina]){
      edifState[prevEdif].cortinas[prevCortina]={estado:'libre',tipo:null,ref:null,label:null,inicio:null,operador:'',notas:'',minutos:0,docId:null};
      edifRenderAll(prevEdif);
    }
  }
  // ── Archive if DESPACHADO ──
  if(r.status==='DESPACHADO'){
    if(prevRecord&&prevRecord.status!=='CARGADO'){ alert('🔒 Solo un pedido CARGADO puede pasar a DESPACHADO.'); return; }
    if(!despTieneCostos(r)){ alert(`🔒 El pedido ${r.no_pedido||r.dt||''} no tiene costos registrados.\n\nNo puede pasar al archivo sin costos.`); return; }
    const msg=`¿Archivar este despacho en el Historial?\n\nRef: ${r.ref||'—'} · DT: ${r.dt||'—'}\nDestino: ${r.dest||'—'}\n\n⚠️ Se moverá al historial y no podrá editarse.\nPuedes restaurarlo si hay un error.`;
    if(!confirm(msg)) return;
    r.fechaArchivo=new Date().toLocaleDateString('es-SV');
    if(!r.factura)  r.factura  = 'NO ENVIADA';
    if(!r.gr)       r.gr       = 'NO RECIBIDO';
    if(!r.scan_id)  r.scan_id  = 'NO ENVIADO';
    historial.push(r);
    // Remove from despachos if editing existing
    if(editDespachoIdx!==null) despachos.splice(editDespachoIdx,1);
    closeModals();populateFilters();renderDespachos();renderHistorial();
    const now=new Date();
    (document.getElementById('last-update')||{}).textContent ='Actualizado: '+now.toLocaleDateString('es-SV')+' '+now.toLocaleTimeString('es-SV',{hour:'2-digit',minute:'2-digit'});
    alert('✅ Despacho archivado en Historial.');
    return;
  }
  if(editDespachoIdx===null)despachos.push(r);else despachos[editDespachoIdx]=r;
  closeModals();populateFilters();renderDespachos();setTimeout(gsSaveAll,500);
  const now=new Date();
  (document.getElementById('last-update')||{}).textContent ='Actualizado: '+now.toLocaleDateString('es-SV')+' '+now.toLocaleTimeString('es-SV',{hour:'2-digit',minute:'2-digit'});
}

function openNpModal(idx){
  editNpIdx=idx;
  (document.getElementById('np-modal-title')||{}).textContent =idx===null?'Nuevo pedido no programado':'Editar pedido no programado';
  document.getElementById('np-delete-btn').style.display=(idx!==null && (!window.HUB_ONLINE || (typeof hubEsAdmin==='function' && hubEsAdmin())))?'inline-flex':'none';
  if(idx!==null){
    const r=noProg[idx];
    document.getElementById('np-doc').value=r.doc||'';
    document.getElementById('np-rc').value=r.dt||'';
    document.getElementById('np-origen').value=r.origen||'';
    // pais: use stored pais (abbrev) or derive from dest
    const paisAbbrev=r.pais||Object.keys(NP_ABBREV).find(k=>NP_ABBREV[k]===(r.dest||'')&&k.length===2)||'';
    document.getElementById('np-pais').value=paisAbbrev;
    document.getElementById('np-pedido').value=r.pedido||'';
    // Show only the number part (strip UL- prefix for the input)
    const refVal=r.ref||'';
    document.getElementById('np-ref').value=refVal.startsWith('UL-')?refVal.slice(3):refVal;
    document.getElementById('np-prio').value=r.prio||'NORMAL';
    document.getElementById('np-pallets').value=r.pallets||'';
    document.getElementById('np-cajas').value=r.cajas||'';
    document.getElementById('np-peso').value=r.peso||'';
    document.getElementById('np-proveedor').value=r.proveedor||'';
    document.getElementById('np-fsolicitud').value=r.fsolicitud||'';
    document.getElementById('np-fdescarga').value=r.fdescarga||'';
    document.getElementById('np-notas').value=r.notas||'';
  }else{
    ['np-doc','np-rc','np-origen','np-pedido','np-ref','np-pallets','np-cajas','np-peso','np-proveedor','np-fsolicitud','np-fdescarga','np-notas'].forEach(id=>document.getElementById(id).value='');
    document.getElementById('np-pais').value='';
    document.getElementById('np-prio').value='NORMAL';
  }
  npModoFijo(idx);
  document.getElementById('modal-np').classList.add('open');
}

// Al editar: los datos que vienen del ingreso no se muestran (van en el resumen de arriba); solo quedan los campos a digitar.
// Si alguno de esos datos viene vacío, el campo sí aparece para poder completarlo.
const NP_FIJOS=[['np-pedido','Pedido'],['np-rc',''],['np-pais',''],['np-doc','BL'],['np-origen',''],['np-cajas',''],['np-peso',''],['np-fdescarga','Descarga']];
function npModoFijo(idx){
  const sub=document.getElementById('np-modal-sub'); const chips=[];
  NP_FIJOS.forEach(([id,et])=>{
    const el=document.getElementById(id), g=el&&el.closest('.form-group'); if(!g) return;
    let v=String(el.value||'').trim();
    const fijo=idx!==null&&v!=='';
    g.style.display=fijo?'none':'';
    if(fijo){
      if(id==='np-peso') v=Number(v).toLocaleString('es-SV',{maximumFractionDigits:1})+' kg';
      if(id==='np-cajas') v=Number(v).toLocaleString('es-SV')+' cajas';
      if(id==='np-fdescarga'){ const m=v.match(/^(\d{4})-(\d{2})-(\d{2})$/); if(m) v=m[3]+'/'+m[2]+'/'+m[1]; }
      chips.push((id==='np-pedido'?'<b>':'')+(et?et+' ':'')+v.replace(/</g,'&lt;')+(id==='np-pedido'?'</b>':''));
    }
  });
  sub.innerHTML=chips.join('<i>·</i>'); sub.style.display=chips.length?'':'none';
  const granel=+document.getElementById('np-cajas').value>0, pl=document.getElementById('np-pal-label'), pi=document.getElementById('np-pallets');
  pl.innerHTML=granel?'Pallets armados <span class="np-granel-tag">granel</span>':'Pallets';
  pi.placeholder=granel?'¿Cuántos pallets quedaron?':'0';
}

function saveNp(){
  const today=new Date().toLocaleDateString('es-SV');
  const paisVal=document.getElementById('np-pais').value;
  const palletsVal=document.getElementById('np-pallets').value;
  const pesoVal=document.getElementById('np-peso').value;
  // Calculate equipo and truck fill
  const pal=parseInt(palletsVal)||0;
  const kg=parseFloat(pesoVal)||0;
  let equipo='—', truckFill='—';
  if(pal>0||kg>0){
    const excNormal=(kg>21000);
    const exc3Ejes=(kg>23000);
    if(exc3Ejes){ equipo='EXCEDE 3 EJES'; truckFill='—'; }
    else if(excNormal){
      equipo='53 FT 3 EJES';
      const fillP=Math.round((pal/30)*100);
      const fillW=Math.round((kg/23000)*100);
      truckFill=Math.max(fillP,fillW)+'%';
    } else {
      equipo='53 FT';
      const fillP=pal>0?Math.round((pal/30)*100):0;
      const fillW=kg>0?Math.round((kg/21000)*100):0;
      truckFill=Math.max(fillP,fillW)+'%';
    }
  }
  const prev=editNpIdx!==null?noProg[editNpIdx]:{};
  const r={
    ...prev, // conserva campos que no están en el formulario (RG, RC, etc.)
    fecha:editNpIdx!==null?prev.fecha:today,
    doc:document.getElementById('np-doc').value,
    dt:document.getElementById('np-rc').value,
    rc:prev.rc||'',
    origen:document.getElementById('np-origen').value,
    pais:paisVal,
    dest:npNormPais(paisVal)||prev.dest||'',
    pedido:document.getElementById('np-pedido').value,
    ref:(()=>{
      const raw=(document.getElementById('np-ref').value||'').trim();
      return raw?'UL-'+raw.replace(/^UL-/i,''):'';
    })(),
    prio:document.getElementById('np-prio').value,
    pallets:palletsVal,
    cajas:document.getElementById('np-cajas').value,
    peso:pesoVal,
    proveedor:document.getElementById('np-proveedor').value,
    fsolicitud:document.getElementById('np-fsolicitud').value,
    fdescarga:document.getElementById('np-fdescarga').value,
    notas:document.getElementById('np-notas').value,
    equipo,
    truckFill,
    contIdx:editNpIdx!==null?prev.contIdx:null,
    programado:editNpIdx!==null?prev.programado:false,
    equipoAsignado:editNpIdx!==null?prev.equipoAsignado:''
  };
  {
    const prevNp=editNpIdx!==null?noProg[editNpIdx]:null;
    const it=[{pedido:r.pedido,dt:r.dt}];
    let dups=hubDuplicados(it,['np','desp','hist'],e=>prevNp&&e.obj===prevNp);
    dups=dups.concat(hubDuplicados(hubCambiados(it,prevNp?[{pedido:prevNp.pedido,dt:prevNp.dt}]:[]),['ingreso']));
    if(dups.length){ hubAvisoDup([...new Set(dups)],'No se puede guardar el pedido'); return; }
  }
  // Save checked state before re-render
  // Validate correlativo — permitir duplicados en NP, bloquear solo si ya está en Despachos o Historial
  const rawRef2=(document.getElementById('np-ref').value||'').trim();
  if(rawRef2){
    const fullRef2='UL-'+rawRef2.replace(/^UL-/i,'');
    const inDesp = despachos.findIndex(r=>r.ref===fullRef2);
    const inHist = historial.findIndex(r=>r.ref===fullRef2);
    if(inDesp>=0||inHist>=0){
      const donde = inDesp>=0?'Pedidos en Despacho':'Historial';
      alert('⚠️ El correlativo '+fullRef2+' ya existe en '+donde+'.\n\nNo se puede reutilizar un correlativo que ya fue despachado.');
      return;
    }
  }
  const checkedIdxs=new Set([...document.querySelectorAll('.np-chk:checked')].map(c=>parseInt(c.dataset.idx)));
  if(editNpIdx===null){
    noProg.push(r);
    closeModals();
    renderNp();
    setTimeout(()=>{ gsSaveAll(); sheetdbAppendRow('PedidosNoProgramados', GS_CAMPOS.PedidosNoProgramados, r); }, 500);
  } else {
    noProg[editNpIdx]=r;
    closeModals();
    renderNp();
    setTimeout(()=>{ gsSaveAll(); gsSaveNoProg(); }, 500);
  }
  // Restore checked state
  document.querySelectorAll('.np-chk').forEach(c=>{
    const idx=parseInt(c.dataset.idx);
    if(checkedIdxs.has(idx)) c.checked=true;
  });
  npOnCheck();
}

function deleteNp(){
  if(window.HUB_ONLINE && !(typeof hubEsAdmin==='function' && hubEsAdmin())){ alert('Solo el administrador puede eliminar pedidos.'); return; }
  if(editNpIdx!==null&&confirm('¿Eliminar este pedido no programado?')){noProg.splice(editNpIdx,1);closeModals();renderNp();}
}

function closeModals(){document.querySelectorAll('.modal-bg').forEach(m=>m.classList.remove('open'));}

function exportCSV(){
  if(!despachos.length){alert('No hay datos para exportar');return;}
  const header='MES,Referencia,DT,No. Pedido,Destino,Pallets,Remolque,Regimen,Edificio,Fecha de Carga,Fecha de Salida,Estatus,Peso,Volumen';
  const rows=despachos.map(r=>[r.mes,r.ref,r.dt,r.no_pedido||'',r.dest,r.pallets,r.remolque,r.regimen,r.edif,r.fcarga,r.fsalida,r.status,r.peso,r.vol].map(v=>`"${v}"`).join(','));
  const blob=new Blob(['\uFEFF'+header+'\n'+rows.join('\n')],{type:'text/csv;charset=utf-8'});
  const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='despachos_'+new Date().toISOString().slice(0,10)+'.csv';a.click();
}

// PROMOTE NP → DESPACHO
let promoteNpIdx=null;
const PAIS_TO_DEST={'SV':'EL SALVADOR','HN':'HONDURAS','CR':'COSTA RICA','NI':'NICARAGUA','GT':'GUATEMALA','PA':'PANAMA'};

function openPromoteModal(idx){
  promoteNpIdx=idx;
  const r=noProg[idx];
  const destDerivada=r.dest||PAIS_TO_DEST[r.pais]||'—';
  (document.getElementById('pm-pedido')||{}).textContent =r.pedido||'—';
  (document.getElementById('pm-ref')||{}).textContent =r.ref||'—';
  (document.getElementById('pm-dest')||{}).textContent =destDerivada;
  (document.getElementById('pm-doc')||{}).textContent =r.doc||'—';
  (document.getElementById('pm-rc')||{}).textContent =r.rc||'—';
  (document.getElementById('pm-origen')||{}).textContent =r.origen||'—';
  // Clear fields
  ['pm-mes','pm-dt','pm-remolque','pm-regimen','pm-edif','pm-fcarga','pm-fsalida','pm-pallets','pm-peso','pm-vol'].forEach(id=>{
    const el=document.getElementById(id);
    if(el.tagName==='SELECT') el.selectedIndex=0; else el.value='';
  });
  // Pre-fill pallets/peso from NP if present
  if(r.pallets) document.getElementById('pm-pallets').value=r.pallets;
  if(r.peso) document.getElementById('pm-peso').value=r.peso;
  document.getElementById('pm-status').value='PROGRAMADO';
  document.getElementById('modal-promote').classList.add('open');
}
function savePromote(){
  const r=noProg[promoteNpIdx];
  const destDerivada=r.dest||PAIS_TO_DEST[r.pais]||'COSTA RICA';
  const despacho={
    mes:document.getElementById('pm-mes').value,
    ref:r.ref||'',
    dt:document.getElementById('pm-dt').value,
    no_pedido:r.pedido||'',
    dest:destDerivada,
    pallets:document.getElementById('pm-pallets').value,
    remolque:document.getElementById('pm-remolque').value,
    regimen:document.getElementById('pm-regimen').value,
    edif:document.getElementById('pm-edif').value,
    fcarga:document.getElementById('pm-fcarga').value,
    fsalida:document.getElementById('pm-fsalida').value,
    status:document.getElementById('pm-status').value,
    peso:parseFloat(document.getElementById('pm-peso').value)||0,
    vol:parseFloat(document.getElementById('pm-vol').value)||0,
    fingreso:r.fdescarga||'', fromNP:true, equipo:r.equipo||'',
    fsolicitud:r.fsolicitud||'', proveedor:r.proveedor||'',
    ot:r.ot||'', cajas:r.cajas||'', valor:r.valor||'', fact_ul:r.fact_ul||'', bl_cp:r.bl_cp||r.doc||'', flete:r.flete||'',
    np_json:npCopia(r)
  };
  {
    let dups=hubDuplicados([{pedido:despacho.no_pedido,dt:despacho.dt}],['desp','hist']);
    dups=dups.concat(hubDuplicados(hubCambiados([{pedido:despacho.no_pedido,dt:despacho.dt}],[{pedido:r.pedido,dt:r.dt}]),['ingreso','np'],e=>e.obj===r));
    if(dups.length){ hubAvisoDup([...new Set(dups)],'No se puede pasar a Despacho'); return; }
  }
  despachos.push(despacho);
  noProg.splice(promoteNpIdx,1);
  closeModals();
  populateFilters();renderDespachos();renderNp();
  // Switch to despachos tab
  goToTab('despachos');
  const now=new Date();
  (document.getElementById('last-update')||{}).textContent ='Actualizado: '+now.toLocaleDateString('es-SV')+' '+now.toLocaleTimeString('es-SV',{hour:'2-digit',minute:'2-digit'});
}


document.getElementById('filter-mes').addEventListener('change',renderDespachos);
document.getElementById('filter-dest').addEventListener('change',renderDespachos);
document.getElementById('filter-status').addEventListener('change',renderDespachos);
document.getElementById('filter-q').addEventListener('input',renderDespachos);
document.querySelectorAll('.modal-bg').forEach(m=>m.addEventListener('click',e=>{if(e.target===m)closeModals();}));

// ============================================================
// NO PROGRAMADOS — PLANIFICADOR 53 FT
// ============================================================
const NP_MAX_PALLETS = 30;
const NP_MAX_PESO    = 21000;

const NP_PAISES = ['EL SALVADOR','HONDURAS','COSTA RICA','NICARAGUA','GUATEMALA','PANAMA'];
const NP_PAIS_COLOR = {
  'EL SALVADOR':'#A32D2D','HONDURAS':'#7A1F5A','COSTA RICA':'#185FA5',
  'NICARAGUA':'#3B6D11','GUATEMALA':'#854F0B','PANAMA':'#0F6E56'
};
const NP_PAIS_BG = {
  'EL SALVADOR':'#FDECEA','HONDURAS':'#F5EAF5','COSTA RICA':'#E6F0FA',
  'NICARAGUA':'#EBF3E6','GUATEMALA':'#FBF0E6','PANAMA':'#E6F3F0'
};
// Map abbreviations → full name
const NP_ABBREV = {
  'SV':'EL SALVADOR','HN':'HONDURAS','CR':'COSTA RICA',
  'NI':'NICARAGUA','GT':'GUATEMALA','PA':'PANAMA',
  'EL SALVADOR':'EL SALVADOR','HONDURAS':'HONDURAS','COSTA RICA':'COSTA RICA',
  'NICARAGUA':'NICARAGUA','GUATEMALA':'GUATEMALA','PANAMA':'PANAMA'
};
// Normalize a country value to full name
function npNormPais(v){ return NP_ABBREV[(v||'').trim().toUpperCase()]||v||''; }
function npGetPais(r){ return npNormPais(r.dest||r.pais||''); }

let npPaisActivo = '';

function npRenderPaisesBtns(){
  const cont = document.getElementById('np-paises-btns');
  if(!cont) return;
  const counts = {};
  NP_PAISES.forEach(p=>counts[p]=0);
  noProg.forEach(r=>{ const p=npGetPais(r); if(counts[p]!==undefined) counts[p]++; });
  let html = `<button onclick="npFiltrarPais('')" style="height:28px;padding:0 12px;border-radius:999px;font-size:11px;font-weight:600;border:1.5px solid ${npPaisActivo===''?'var(--text)':'var(--border)'};background:${npPaisActivo===''?'var(--text)':'var(--surface)'};color:${npPaisActivo===''?'var(--surface)':'var(--text-muted)'};cursor:pointer;font-family:var(--sans);">Todos (${noProg.length})</button>`;
  NP_PAISES.forEach(p=>{
    const active=npPaisActivo===p;
    const col=NP_PAIS_COLOR[p]; const bg=NP_PAIS_BG[p];
    const lbl=p==='EL SALVADOR'?'El Salv.':p==='COSTA RICA'?'C. Rica':p.charAt(0)+p.slice(1).toLowerCase();
    html+=`<button onclick="npFiltrarPais('${p}')" style="height:28px;padding:0 12px;border-radius:999px;font-size:11px;font-weight:600;border:1.5px solid ${active?col:'var(--border)'};background:${active?col:'var(--surface)'};color:${active?'#fff':col};cursor:pointer;font-family:var(--sans);">${lbl}${counts[p]>0?' ('+counts[p]+')':''}</button>`;
  });
  cont.innerHTML=html;
}

function npFiltrarPais(pais){ npPaisActivo=pais; npRenderPaisesBtns(); renderNp(); npClearSel(); const btn=document.getElementById('np-btn-sugerir'); if(btn) btn.style.opacity=pais?'1':'0.4'; }
function npGetFiltered(){
  const q=(document.getElementById('np-q')?.value||'').toLowerCase().trim();
  let res=npPaisActivo?noProg.filter(r=>npGetPais(r)===npPaisActivo):noProg;
  if(q) res=res.filter(r=>
    String(r.pedido||'').toLowerCase().includes(q)||
    String(r.doc||'').toLowerCase().includes(q)||
    String(r.rg||'').toLowerCase().includes(q)||
    String(r.dt||r.rc||'').toLowerCase().includes(q)||
    String(r.origen||'').toLowerCase().includes(q)||
    String(r.ref||'').toLowerCase().includes(q)
  );
  return res;
}

// ============================================================
// NP: PROGRAMAR POR REFERENCIA
// Requisitos por pedido: referencia, fecha de solicitud y proveedor.
// Al programar una referencia pasan juntos TODOS sus pedidos.
// ============================================================
function npRefNorm(v){ const s=String(v||'').trim(); return s?('UL-'+s.replace(/^UL-/i,'')).toUpperCase():''; }
// Carga a granel (cajas): Colombia siempre; otros orígenes si traen más de 60 bultos
function npEsGranelOrigen(o){ return /COLOMBIA/i.test(String(o||'')); }
function npPalCell(r){
  const cj=+r.cajas>0?Number(r.cajas).toLocaleString('es-SV'):'';
  if(+r.pallets>0) return r.pallets+(cj?`<small class="pal-cj">${cj} cj</small>`:'');
  if(cj) return `<span class="np-granel-pend" title="Carga a granel: falta digitar los pallets armados">${cj} cj · sin pallets</span>`;
  return r.pallets||'—';
}
function npFaltantes(r){
  const f=[];
  if(!npRefNorm(r.ref)) f.push('referencia');
  if(contVacio(r.fsolicitud)) f.push('fecha de solicitud');
  if(contVacio(r.proveedor)) f.push('proveedor');
  if(+r.cajas>0&&!(+r.pallets>0)) f.push('pallets (granel)');
  return f;
}
function npGrupoRef(ref){ const k=npRefNorm(ref); return k?noProg.filter(r=>npRefNorm(r.ref)===k):[]; }
function npEstadoGrupo(peds){
  const ref=npRefNorm(peds[0]&&peds[0].ref);
  const faltan={}; peds.forEach(r=>npFaltantes(r).filter(x=>x!=='referencia').forEach(x=>faltan[x]=(faltan[x]||0)+1));
  const paises=[...new Set(peds.map(r=>npGetPais(r)).filter(Boolean))];
  const pal=peds.reduce((a,r)=>a+(parseInt(r.pallets)||0),0), kg=peds.reduce((a,r)=>a+(parseFloat(r.peso)||0),0);
  const eq=npCalcEquipo(pal,kg);
  const problemas=Object.entries(faltan).map(([c,n])=>`${n} pedido${n>1?'s':''} sin ${c}`);
  if(paises.length>1) problemas.push(`mezcla países (${paises.join(', ')})`);
  if(eq.equipo==='EXCEDE 3 EJES') problemas.push(`excede el peso de 3 ejes (${Math.round(kg).toLocaleString('es-SV')} kg de 23,000)`);
  if(ref&&(despachos.some(r=>npRefNorm(r.ref)===ref)||historial.some(r=>npRefNorm(r.ref)===ref))) problemas.push(`la referencia ${ref} ya se usó en Despacho o Historial`);
  return {ref,peds,pal,kg,eq,paises,problemas,ok:!problemas.length};
}
function npProgramarReferencia(ref){
  const k=npRefNorm(ref);
  if(!k){ alert('🔒 Este pedido no tiene referencia.\n\nAsígnale una referencia UL con "editar" para poder programarlo.'); return; }
  const peds=npGrupoRef(k);
  if(!peds.length){ alert(`No hay pedidos con la referencia ${k}.`); return; }
  const g=npEstadoGrupo(peds);
  if(!g.ok){ alert(`🔒 No se puede programar ${k}\n\n• ${g.problemas.join('\n• ')}\n\nCompleta los datos con "editar".`); return; }
  const dups=hubDuplicados(peds.map(r=>({pedido:r.pedido,dt:r.dt})),['desp','hist']);
  if(dups.length){ hubAvisoDup(dups,`No se puede programar ${k}`); return; }
  const equipoFinal=g.eq.equipo==='53 FT 3 EJES'?'53 FT 3 EJES':'53 FT';
  if(!confirm(`✅ Programar ${k}\n\n${peds.length} pedido${peds.length>1?'s':''} · ${g.paises[0]||'—'}\n${g.pal} pallets · ${Math.round(g.kg).toLocaleString('es-SV')} kg · ${equipoFinal} · truck fill ${g.eq.truckFill}${g.pal>30?`\n⚠ ${g.pal} pallets: pasa de 30, verifica que quepan en la unidad.`:''}\n\n${peds.map(r=>`• ${r.pedido||'—'}  ·  DT ${r.dt||'—'}  ·  ${r.proveedor}`).join('\n')}\n\nPasan juntos a Pedidos en Despacho como PROGRAMADO.`)) return;
  const mes=new Date().toLocaleString('es-SV',{month:'long'});
  peds.forEach(r=>{
    despachos.push({
      mes, ref:k, dt:r.dt||r.rc||r.doc||'', no_pedido:r.pedido||'', dest:r.dest||npGetPais(r)||'',
      pallets:r.pallets||'', remolque:'', regimen:'DT', edif:'', fcarga:'', fsalida:'',
      status:'PROGRAMADO', peso:parseFloat(r.peso)||0, vol:0, equipo:equipoFinal, fprog:dgIso(dgHoy()),
      fsolicitud:r.fsolicitud||'', proveedor:r.proveedor||'', fingreso:r.fdescarga||'', fromNP:true,
      ot:r.ot||'', cajas:r.cajas||'', valor:r.valor||'', fact_ul:r.fact_ul||'', bl_cp:r.bl_cp||r.doc||'', flete:r.flete||'',
      np_json:npCopia(r)
    });
  });
  peds.map(r=>noProg.indexOf(r)).sort((a,b)=>b-a).forEach(i=>{ if(i>=0) noProg.splice(i,1); });
  npClearSel(); renderNp(); populateFilters(); renderDespachos();
  if(confirm(`✅ ${k} programada: ${peds.length} pedido${peds.length>1?'s':''} en Pedidos en Despacho con ${equipoFinal}.\n\n¿Abrir los cuadros para correo (bodega y transporte)?`)) cqAbrir(k,'desp');
}
// Tabla NP agrupada por referencia
function npHTMLAgrupado(filtrados,rowHTML){
  const grupos={}, orden=[];
  filtrados.forEach(r=>{ const k=npRefNorm(r.ref)||'~SIN'; if(!grupos[k]){ grupos[k]=[]; orden.push(k); } grupos[k].push(r); });
  const num=k=>parseInt(k.replace(/\D/g,''))||0;
  orden.sort((a,b)=>a==='~SIN'?1:b==='~SIN'?-1:num(a)-num(b));
  return orden.map(k=>{
    const rows=grupos[k].map(rowHTML).join('');
    if(k==='~SIN') return `<tr class="np-grp sin"><td colspan="18"><div class="np-grp-in"><span class="np-grp-ref">Sin referencia</span><span class="np-grp-dat">${grupos[k].length} pedido${grupos[k].length>1?'s':''} · asígnales una referencia UL para programarlos</span></div></td></tr>`+rows;
    const g=npEstadoGrupo(npGrupoRef(k));
    const fuera=g.peds.length-grupos[k].length;
    const acc=g.ok
      ? `<button class="np-grp-btn" onclick="npProgramarReferencia('${k}')">✓ Programar ${k}</button>`
      : `<span class="np-grp-lock" title="${impEsc(g.problemas.join(' · '))}">🔒 ${impEsc(g.problemas.join(' · '))}</span>`;
    return `<tr class="np-grp ${g.ok?'ok':'lock'}"><td colspan="18"><div class="np-grp-in">
      <span class="np-grp-ref">${k}</span>
      ${acc}
      <button class="np-grp-mail" onclick="cqAbrir('${k}')" title="Cuadros para bodega y transporte">✉ Cuadros</button>
      <span class="np-grp-dat">${g.paises.join(', ')||'—'} · ${g.peds.length} pedido${g.peds.length>1?'s':''}${fuera?` (${fuera} fuera del filtro)`:''} · ${g.pal} pallets · ${Math.round(g.kg).toLocaleString('es-SV')} kg · ${g.eq.equipo} · ${g.eq.truckFill}</span></div></td></tr>`+rows;
  }).join('');
}
const npFalta=v=>`<span class="np-falta">falta</span>`;

// ============================================================
// CUADROS PARA CORREO (Bodega y Transporte) por referencia
// Se copian como tabla con formato para pegar en Outlook / Gmail
// Flete: el total de la referencia se reparte según el valor de factura
// ============================================================
let cqRecs=[], cqRef='', cqFleteTotal=0;
const CQ_PAIS_NOM={'COSTA RICA':'Costa Rica','EL SALVADOR':'El Salvador','GUATEMALA':'Guatemala','HONDURAS':'Honduras','NICARAGUA':'Nicaragua','PANAMA':'Panamá'};
const CQ_PAIS_COD={'COSTA RICA':'CR','EL SALVADOR':'SV','GUATEMALA':'GT','HONDURAS':'HN','NICARAGUA':'NI','PANAMA':'PA'};
function cqNum(v){ return pasteNum(v); }
function cqPed(r){ return r.pedido||r.no_pedido||''; }
function cqPais(r){ return npNormPais(r.dest||r.pais||''); }
function cqFmt(n,d){ return Number(n||0).toLocaleString('en-US',{minimumFractionDigits:d,maximumFractionDigits:d}); }
function cqFletes(){
  const tot=cqFleteTotal||0;
  const val=cqRecs.reduce((a,r)=>a+cqNum(r.valor),0), kg=cqRecs.reduce((a,r)=>a+cqNum(r.peso),0);
  const base=cqRecs.every(r=>cqNum(r.valor)>0)?'valor':'peso';
  return cqRecs.map(r=>!tot?0:base==='valor'?(val?tot*cqNum(r.valor)/val:0):(kg?tot*cqNum(r.peso)/kg:0));
}
// ---- HTML con estilos en línea (seguros para correo) ----
const CQ_ST={
  tbl:'border-collapse:collapse;font-family:Arial,Helvetica,sans-serif;font-size:10pt;color:#14213A;',
  th:'background:#1D4E8C;color:#FFFFFF;font-weight:bold;padding:6px 12px;border:1px solid #1D4E8C;text-align:center;',
  thDark:'background:#0E2D57;color:#FFFFFF;font-weight:bold;padding:6px 12px;border:1px solid #0E2D57;text-align:center;',
  td:'padding:5px 12px;border:1px solid #BFC9D6;text-align:center;',
  tdN:'padding:5px 12px;border:1px solid #BFC9D6;text-align:right;',
  tdPte:'padding:5px 12px;border:1px solid #BFC9D6;text-align:center;color:#A4251B;font-weight:bold;',
  tot:'padding:5px 12px;border-top:2px solid #0E2D57;border-bottom:1px solid #BFC9D6;text-align:right;font-weight:bold;background:#EAF2FC;',
  totL:'padding:5px 12px;border-top:2px solid #0E2D57;text-align:right;font-weight:bold;',
  cap:'font-family:Arial,Helvetica,sans-serif;font-size:10.5pt;color:#14213A;margin:0 0 6px 0;'
};
function cqCjPal(){ const cj=cqRecs.reduce((a,r)=>a+cqNum(r.cajas),0), pl=cqRecs.reduce((a,r)=>a+cqNum(r.pallets),0); return `${cqFmt(cj,0)} cajas / ${cqFmt(pl,0)} pallets`; }
function cqTitulo(){ const ps=[...new Set(cqRecs.map(r=>CQ_PAIS_NOM[cqPais(r)]||cqPais(r)))].join(', '); return `<p style="${CQ_ST.cap}"><b>Referencia ${impEsc(cqRef)}</b> · ${impEsc(ps)} · ${cqRecs.length} pedido${cqRecs.length===1?'':'s'} · <b>${cqCjPal()}</b></p>`; }
function cqHTMLBodega(){
  return cqTitulo()+`<table cellpadding="0" cellspacing="0" style="${CQ_ST.tbl}"><thead><tr><th style="${CQ_ST.th}">PAÍS</th><th style="${CQ_ST.th}">PO</th><th style="${CQ_ST.th}">DT/ONL/OT</th><th style="${CQ_ST.th}">CAJAS</th><th style="${CQ_ST.th}">PALLETS</th></tr></thead><tbody>`+
    cqRecs.map(r=>{ const dt=String(r.dt||'').trim(); return `<tr><td style="${CQ_ST.td}">${CQ_PAIS_COD[cqPais(r)]||impEsc(cqPais(r))}</td><td style="${CQ_ST.td}">${impEsc(cqPed(r))}</td><td style="${dt?CQ_ST.td:CQ_ST.tdPte}">${dt?impEsc(dt):'PTE'}</td>`+
      `<td style="${CQ_ST.tdN}">${cqNum(r.cajas)?cqFmt(r.cajas,0):''}</td><td style="${cqNum(r.pallets)?CQ_ST.tdN:CQ_ST.tdPte}">${cqNum(r.pallets)?cqFmt(r.pallets,0):'PTE'}</td></tr>`; }).join('')+
    `<tr><td colspan="3" style="${CQ_ST.totL}">TOTAL</td><td style="${CQ_ST.tot}">${cqFmt(cqRecs.reduce((a,r)=>a+cqNum(r.cajas),0),0)}</td><td style="${CQ_ST.tot}">${cqFmt(cqRecs.reduce((a,r)=>a+cqNum(r.pallets),0),0)}</td></tr></tbody></table>`;
}
function cqHTMLTransporte(){
  const fl=cqFletes(); const n=cqRecs.length;
  const sum=k=>cqRecs.reduce((a,r)=>a+cqNum(r[k]),0);
  // Destino agrupado (celda combinada por país, en el orden de la lista)
  const filas=cqRecs.map((r,i)=>{
    const pais=cqPais(r), prev=i?cqPais(cqRecs[i-1]):null;
    let dest='';
    if(pais!==prev){ let span=1; while(i+span<n&&cqPais(cqRecs[i+span])===pais) span++; dest=`<td rowspan="${span}" style="${CQ_ST.td}vertical-align:middle;">${impEsc(CQ_PAIS_NOM[pais]||pais)}</td>`; }
    return `<tr>${dest}<td style="${CQ_ST.td}">${impEsc(cqPed(r))}</td><td style="${CQ_ST.td}">${impEsc(r.fact_ul||'')}</td><td style="${CQ_ST.td}">${impEsc(r.bl_cp||'')}</td>`+
      `<td style="${CQ_ST.tdN}">${cqNum(r.cajas)?cqFmt(r.cajas,0):''}</td><td style="${CQ_ST.tdN}">${cqNum(r.pallets)?cqFmt(r.pallets,0):''}</td><td style="${CQ_ST.tdN}">${cqFmt(r.peso,2)}</td>`+
      `<td style="${CQ_ST.tdN}">${cqNum(r.valor)?'$'+cqFmt(r.valor,2):''}</td><td style="${CQ_ST.tdN}">${fl[i]?cqFmt(fl[i],2):''}</td></tr>`;
  }).join('');
  return cqTitulo()+`<table cellpadding="0" cellspacing="0" style="${CQ_ST.tbl}"><thead><tr>`+
    ['Destino','Orden de compra','Factura','BL / CP / AWB','Cajas','Pallets','Peso (kg)','Valor factura'].map(h=>`<th style="${CQ_ST.th}">${h}</th>`).join('')+`<th style="${CQ_ST.thDark}">Flete</th></tr></thead><tbody>`+
    filas+`<tr><td colspan="4" style="${CQ_ST.totL}">TOTAL</td><td style="${CQ_ST.tot}">${cqFmt(sum('cajas'),0)}</td><td style="${CQ_ST.tot}">${cqFmt(sum('pallets'),0)}</td><td style="${CQ_ST.tot}">${cqFmt(sum('peso'),2)}</td>`+
    `<td style="${CQ_ST.tot}">$${cqFmt(sum('valor'),2)}</td><td style="${CQ_ST.tot}">${cqFmt(fl.reduce((a,b)=>a+b,0),2)}</td></tr></tbody></table>`;
}
function cqTexto(tipo){
  if(tipo==='bodega') return [`Referencia ${cqRef} · ${cqCjPal()}`,'PAÍS\tPO\tDT/ONL/OT\tCAJAS\tPALLETS',...cqRecs.map(r=>`${CQ_PAIS_COD[cqPais(r)]||cqPais(r)}\t${cqPed(r)}\t${r.dt||'PTE'}\t${r.cajas||''}\t${r.pallets||'PTE'}`)].join('\n');
  const fl=cqFletes();
  return [`Referencia ${cqRef} · ${cqCjPal()}`,'Destino\tOrden de compra\tFactura\tBL / CP / AWB\tCajas\tPallets\tPeso (kg)\tValor factura\tFlete',
    ...cqRecs.map((r,i)=>[CQ_PAIS_NOM[cqPais(r)]||cqPais(r),cqPed(r),r.fact_ul||'',r.bl_cp||'',r.cajas||'',r.pallets||'',cqFmt(r.peso,2),cqNum(r.valor)?'$'+cqFmt(r.valor,2):'',fl[i]?cqFmt(fl[i],2):''].join('\t'))].join('\n');
}
// ---- Ventana ----
function cqAbrir(ref,fuente){
  const k=npRefNorm(ref);
  cqRef=k;
  cqRecs=fuente==='desp'?despachos.filter(r=>npRefNorm(r.ref)===k):npGrupoRef(k);
  if(!cqRecs.length){ alert(`No hay pedidos con la referencia ${k}.`); return; }
  cqFleteTotal=cqRecs.reduce((a,r)=>a+cqNum(r.flete),0);
  document.getElementById('cq-titulo').textContent=`Cuadros para correo · ${k}`;
  document.getElementById('cq-flete').value=cqFleteTotal?cqFleteTotal.toFixed(2):'';
  cqRenderEditor(); cqRender();
  document.getElementById('modal-cuadros').classList.add('open');
}
function cqRenderEditor(){
  const esc=v=>String(v==null?'':v).replace(/"/g,'&quot;');
  document.getElementById('cq-edit').innerHTML=cqRecs.map((r,i)=>`<tr>
    <td class="mono">${impEsc(cqPed(r))}</td>
    <td><input value="${esc(r.dt)}" placeholder="PTE" oninput="cqSet(${i},'dt',this.value)"></td>
    <td><input value="${esc(r.fact_ul)}" oninput="cqSet(${i},'fact_ul',this.value)"></td>
    <td><input value="${esc(r.bl_cp)}" oninput="cqSet(${i},'bl_cp',this.value)"></td>
    <td><input type="number" min="0" value="${esc(r.cajas)}" oninput="cqSet(${i},'cajas',this.value)"></td>
    <td><input type="number" min="0" value="${esc(r.pallets)}" oninput="cqSet(${i},'pallets',this.value)"></td>
    <td class="num">${cqFmt(r.peso,2)}</td>
    <td><input type="number" min="0" step="0.01" value="${esc(r.valor)}" oninput="cqSet(${i},'valor',this.value)"></td></tr>`).join('');
}
function cqSet(i,k,v){ cqRecs[i][k]=v; cqRender(); }
function cqSetFlete(v){ cqFleteTotal=cqNum(v); cqRender(); }
function cqRender(){
  const fl=cqFletes(); cqRecs.forEach((r,i)=>r.flete=fl[i]?Math.round(fl[i]*100)/100:'');
  const base=cqRecs.every(r=>cqNum(r.valor)>0)?'el valor de factura':'el peso (falta valor de factura)';
  document.getElementById('cq-base').textContent=cqFleteTotal?`Se reparte según ${base}.`:'';
  document.getElementById('cq-prev-bod').innerHTML=cqHTMLBodega();
  document.getElementById('cq-prev-tra').innerHTML=cqHTMLTransporte();
}
async function cqCopiar(tipo){
  const html=tipo==='bodega'?cqHTMLBodega():cqHTMLTransporte(), txt=cqTexto(tipo);
  let ok=false;
  try{
    if(navigator.clipboard&&window.ClipboardItem){
      await navigator.clipboard.write([new ClipboardItem({'text/html':new Blob([html],{type:'text/html'}),'text/plain':new Blob([txt],{type:'text/plain'})})]);
      ok=true;
    }
  }catch(e){}
  if(!ok){
    const d=document.createElement('div'); d.contentEditable='true'; d.style.cssText='position:fixed;left:-9999px;top:0;'; d.innerHTML=html; document.body.appendChild(d);
    const rg=document.createRange(); rg.selectNodeContents(d); const sel=getSelection(); sel.removeAllRanges(); sel.addRange(rg);
    try{ ok=document.execCommand('copy'); }catch(e){}
    sel.removeAllRanges(); d.remove();
  }
  const b=document.getElementById(tipo==='bodega'?'cq-btn-bod':'cq-btn-tra');
  const t0=b.textContent; b.textContent=ok?'✓ Copiado, pégalo en el correo':'No se pudo copiar'; setTimeout(()=>b.textContent=t0,2200);
}

function renderNp(){
  const filtered=npGetFiltered();
  const tbody=document.getElementById('np-tbody');
  const countEl=document.getElementById('np-count-label');
  const titleEl=document.getElementById('np-table-title');
  (document.getElementById('tab-count-noprog')||{}).textContent =noProg.length;
  if(countEl) countEl.textContent=filtered.length+' registros';
  if(titleEl) titleEl.textContent=npPaisActivo?'Pedidos — '+npPaisActivo:'Todos los pedidos';
  if(!tbody) return;
  if(!filtered.length){
    tbody.innerHTML=`<tr><td colspan="12"><div class="empty"><strong>${npPaisActivo?'Sin pedidos para '+npPaisActivo:'Sin pedidos'}</strong>Agrega pedidos o selecciona otro país</div></td></tr>`;
    return;
  }
  const prioBadge=p=>{const cls=p==='URGENTE'?'s-prio-urg':p==='ALTA'?'s-prio-alta':'s-prog';return`<span class="badge ${cls}" style="font-size:10px;">${p||'NORMAL'}</span>`;};
  const rowHTML=(r)=>{
    const gi=noProg.indexOf(r);
    const paisNorm=npGetPais(r);
    const col=NP_PAIS_COLOR[paisNorm]||'#888'; const bg=NP_PAIS_BG[paisNorm]||'#f5f5f5';
    // Equipo badge
    const eq=r.equipo||'—';
    const eqColor=eq==='53 FT 3 EJES'?{c:'#92400E',b:'#FEF3C7'}:eq==='53 FT'?{c:'#1D4ED8',b:'#EFF6FF'}:eq==='EXCEDE 3 EJES'?{c:'#991B1B',b:'#FEE2E2'}:{c:'#6B7280',b:'#F3F4F6'};
    const eqBadge=eq!=='—'?`<span style="display:inline-block;padding:2px 8px;border-radius:5px;font-size:10px;font-weight:700;background:${eqColor.b};color:${eqColor.c};white-space:nowrap;">${eq}</span>`:'<span style="color:var(--text-hint);">—</span>';
    // Truck fill badge
    const tf=r.truckFill||'—';
    const tfNum=parseInt(tf)||0;
    const tfColor=tfNum>=100?'#DC2626':tfNum>=80?'#D97706':'#15803D';
    const tfBadge=tf!=='—'?`<span style="font-family:var(--mono);font-size:11px;font-weight:700;color:${tfColor};">${tf}</span>`:'<span style="color:var(--text-hint);">—</span>';
    return`<tr id="np-row-${gi}">
      <td><input type="checkbox" class="np-chk" data-idx="${gi}" onchange="npOnCheck()" style="cursor:pointer;"></td>
      <td><span style="display:inline-block;padding:2px 8px;border-radius:999px;font-size:10px;font-weight:600;background:${bg};color:${col};">${paisNorm||r.dest||'—'}</span></td>
      <td style="font-weight:600;font-size:12px;font-family:var(--mono);">${r.pedido||'—'}</td>
      <td class="mono" style="font-size:11px;max-width:130px;overflow:hidden;text-overflow:ellipsis;" title="${r.doc||''}">${r.doc||'—'}</td>
      <td class="mono" style="font-size:11px;">${r.rg||'—'}</td>
      <td class="mono" style="font-size:11px;">${r.dt||r.rc||'—'}</td>
      <td style="font-size:12px;">${r.origen||'—'}</td>
      <td style="font-size:12px;font-weight:600;">${npRefNorm(r.ref)||npFalta()}</td>
      <td class="num" style="font-weight:600;">${npPalCell(r)}</td>
      <td class="num">${r.peso?Number(r.peso).toLocaleString('es-SV',{minimumFractionDigits:2,maximumFractionDigits:2}):'—'}</td>
      <td>${eqBadge}</td>
      <td style="text-align:center;">${tfBadge}</td>
      <td style="font-size:11px;">${contVacio(r.proveedor)?npFalta():r.proveedor}</td>
      <td class="mono" style="font-size:11px;">${contVacio(r.fsolicitud)?npFalta():r.fsolicitud}</td>
      <td class="mono" style="font-size:11px;">${npDescargaCell(r)}</td>
      <td>${prioBadge(r.prio)}</td>
      <td style="font-size:11px;color:var(--text-muted);max-width:140px;overflow:hidden;text-overflow:ellipsis;">${r.notas||'—'}</td>
      <td>
        <button class="edit-btn" onclick="openNpModal(${gi})">editar</button>
      </td>
    </tr>`;
  };
  tbody.innerHTML=npHTMLAgrupado(filtered,rowHTML);
  npRenderPaisesBtns();
}

// ── IMPORTAR EXCEL A NP ──────────────────────────────────
function npImportarExcel(input){
  const file = input.files[0];
  if(!file) return;
  input.value = '';
  const reader = new FileReader();
  reader.onload = async function(e){
    try {
      // Use SheetJS to parse Excel
      const data = new Uint8Array(e.target.result);
      const workbook = XLSX.read(data, {type:'array', cellDates:true});
      const sheet = workbook.Sheets[workbook.SheetNames[0]];
      const rows = XLSX.utils.sheet_to_json(sheet, {defval:''});
      if(!rows.length){ alert('El archivo está vacío.'); return; }

      // Map columns
      const NP_PAIS_MAP = {
        'UL COSTA RICA':'COSTA RICA', 'COSTA RICA':'COSTA RICA',
        'UNILEVER EL SALVADOR':'EL SALVADOR', 'EL SALVADOR':'EL SALVADOR',
        'UNILEVER DE CENTROAMERICA':'GUATEMALA', 'GUATEMALA':'GUATEMALA',
        'NICARAGUA':'NICARAGUA', 'HONDURAS':'HONDURAS', 'PANAMA':'PANAMA'
      };
      const getPais = (consig='')=>{
        const u = consig.toUpperCase();
        for(const k of Object.keys(NP_PAIS_MAP)){
          if(u.includes(k)) return NP_PAIS_MAP[k];
        }
        return '';
      };
      const fmtDate = (v)=>{
        if(!v) return '';
        if(v instanceof Date) return v.toLocaleDateString('es-SV');
        return String(v);
      };

      let agregados=0, actualizados=0; window._npOmitidos=[];
      const toSave = [];

      for(const row of rows){
        const pedido = String(row['pedido']||row['PEDIDO']||'').trim();
        if(!pedido) continue;

        const dest = getPais(String(row['Consignatario']||''));
        const nuevo = {
          fecha: fmtDate(row['Arribo']||new Date()),
          doc: String(row['BL o Carta Porte']||'').trim(),
          rc: String(row['OT']||'').trim(),
          rg: '',
          origen: String(row['ORIGEN']||'').trim(),
          pais: dest==='EL SALVADOR'?'SV':dest==='COSTA RICA'?'CR':dest==='NICARAGUA'?'NI':dest==='HONDURAS'?'HN':dest==='GUATEMALA'?'GT':dest==='PANAMA'?'PA':'',
          dest,
          pedido,
          ref: '',
          prio: 'NORMAL',
          pallets: String(row['No. Bultos']||'').trim(),
          peso: String(row['Peso']||'').trim(),
          equipo: '53 FT',
          truckFill: '',
          proveedor: '',
          fsolicitud: '',
          fdescarga: fmtDate(row['Descargo']||''),
          notas: String(row['Mercancias']||'').substring(0,100),
          programado: 'false',
          equipoAsignado: '',
          dt: String(row['DT']||'').trim(),
        };

        // Check if exists by pedido
        const idx = noProg.findIndex(r=>String(r.pedido)===pedido);
        if(idx>=0){
          // Update existing
          const existing = noProg[idx];
          const changed = JSON.stringify(existing) !== JSON.stringify({...existing,...nuevo});
          if(changed){
            noProg[idx] = {...existing, ...nuevo};
            toSave.push({r:noProg[idx], rowNum:idx+1, action:'update'});
            actualizados++;
          }
        } else {
          // Add new (solo si el pedido/DT no existe ya en el HUB)
          if(hubDuplicados([{pedido:nuevo.pedido,dt:nuevo.dt}],['ingreso','np','desp','hist']).length){ (window._npOmitidos=window._npOmitidos||[]).push(pedido); continue; }
          noProg.push(nuevo);
          toSave.push({r:nuevo, rowNum:null, action:'append'});
          agregados++;
        }
      }

      renderNp();
      npRenderPaisesBtns();

      // Save to SheetDB row by row
      gsSyncIndicator('guardando');
      const campos = GS_CAMPOS.PedidosNoProgramados;
      for(const item of toSave){
        const fila = campos.map(k=>item.r[k]!==undefined?item.r[k]:'');
        await gsSaveRow('PedidosNoProgramados', fila, item.rowNum);
        await new Promise(r=>setTimeout(r,100)); // small delay between requests
      }
      gsSyncIndicator('guardado');

      const om=window._npOmitidos||[];
      alert(`✅ Importación completada\n\n• Nuevos: ${agregados}\n• Actualizados: ${actualizados}${om.length?`\n• Omitidos (pedido o DT ya existe en el HUB): ${om.length}\n  ${om.slice(0,10).join(', ')}${om.length>10?'…':''}`:''}\n• Total en NP: ${noProg.length}`);
    } catch(err){
      console.error('npImportarExcel error:', err);
      alert('Error al importar: '+err.message);
    }
  };
  reader.readAsArrayBuffer(file);
}
// ── FIN IMPORTAR EXCEL ────────────────────────────────────

function npToggleAll(checked){ document.querySelectorAll('.np-chk').forEach(c=>{c.checked=checked;}); npOnCheck(); }
function npSelectAll(){ document.querySelectorAll('.np-chk').forEach(c=>c.checked=true); npOnCheck(); }
function npClearSel(){
  document.querySelectorAll('.np-chk').forEach(c=>c.checked=false);
  const ca=document.getElementById('np-chk-all'); if(ca) ca.checked=false;
  npOnCheck();
}

function npOnCheck(){
  const selected=[...document.querySelectorAll('.np-chk:checked')];
  const selCount=document.getElementById('np-sel-count');
  const vinheta=document.getElementById('np-vinheta');
  if(!selected.length){ if(vinheta) vinheta.style.display='none'; if(selCount) selCount.textContent=''; return; }
  if(vinheta) vinheta.style.display='block';
  if(selCount) selCount.textContent=`${selected.length} seleccionado${selected.length>1?'s':''}`;
  // Alert if mixing countries
  const paisesSelec=[...new Set(selected.map(chk=>{const r=noProg[parseInt(chk.dataset.idx)];return r?npGetPais(r):'';}))].filter(Boolean);
  if(paisesSelec.length>1){
    const icon=document.getElementById('np-verd-icon');
    const txt=document.getElementById('np-verd-txt');
    const sub=document.getElementById('np-verd-sub');
    const btnP=document.getElementById('np-btn-programar');
    if(icon) icon.textContent='🚫';
    if(txt){txt.textContent='Países mezclados';txt.style.color='#DC2626';}
    if(sub) sub.textContent=`No se permite mezclar: ${paisesSelec.join(', ')}`;
    if(btnP) btnP.style.display='none';
    return;
  }

  let totalPallets=0, totalPeso=0;
  selected.forEach(chk=>{ const r=noProg[parseInt(chk.dataset.idx)]; if(!r) return; totalPallets+=parseInt(r.pallets)||0; totalPeso+=parseFloat(r.peso)||0; });

  const pPct=Math.min(100,(totalPallets/NP_MAX_PALLETS)*100);
  const wPct=Math.min(100,(totalPeso/NP_MAX_PESO)*100);
  const pOver=totalPallets>NP_MAX_PALLETS; const wOver=totalPeso>NP_MAX_PESO;

  const pBarEl=document.getElementById('np-pallets-bar'); const wBarEl=document.getElementById('np-peso-bar');
  pBarEl.style.width=pPct+'%'; pBarEl.style.background=pOver?'#DC2626':pPct>80?'#F59E0B':'#3B82F6';
  wBarEl.style.width=wPct+'%'; wBarEl.style.background=wOver?'#DC2626':wPct>80?'#F59E0B':'#3B82F6';
  (document.getElementById('np-pallets-txt')||{}).textContent =`${totalPallets} / 30 pallets`;
  (document.getElementById('np-peso-txt')||{}).textContent =`${totalPeso.toLocaleString('es-SV',{minimumFractionDigits:0,maximumFractionDigits:0})} / 21,000 kg`;

  const icon=document.getElementById('np-verd-icon');
  const txt=document.getElementById('np-verd-txt');
  const sub=document.getElementById('np-verd-sub');
  const btnP=document.getElementById('np-btn-programar');

  // 53 FT NORMAL limits
  const NP_MAX_P2=30, NP_MAX_W2=21000;
  // 53 FT 3 EJES limits
  const NP_MAX_P3=30, NP_MAX_W3=23000;

  // El peso define el equipo; los pallets sobre 30 solo se avisan
  const excedeNormal = totalPeso>NP_MAX_W2;
  const excede3Ejes  = totalPeso>NP_MAX_W3;

  if(excede3Ejes){
    // Excede incluso 3 ejes
    icon.textContent='🚫'; txt.style.color='#DC2626';
    txt.textContent='Excede capacidad de 3 ejes';
    sub.textContent=`Pallets: ${totalPallets}/${NP_MAX_P3} · Peso: ${Math.round(totalPeso).toLocaleString()}/${NP_MAX_W3.toLocaleString()} kg`;
    btnP.style.display='none';
    btnP.dataset.equipo='';
  } else if(excedeNormal){
    // Excede 53 FT normal pero cabe en 3 ejes
    const eq=document.getElementById('np-equipo-label')||null; if(eq){eq.textContent='53 FT 3 EJES';eq.style.color='#D97706';}
    icon.textContent='⚠️'; txt.style.color='#D97706';
    txt.textContent='Requiere 53 FT 3 EJES';
    const librePeso=Math.round(NP_MAX_W3-totalPeso);
    sub.textContent=`No cabe en equipo normal · Libre 3 ejes: ${librePeso.toLocaleString()} kg`;
    btnP.style.display='inline-flex';
    btnP.style.background='#D97706';
    btnP.textContent='⚠️ Programar con 3 Ejes';
    btnP.dataset.equipo='3EJES';
  } else if(totalPallets===0&&totalPeso===0){
    const eq=document.getElementById('np-equipo-label')||null; if(eq){eq.textContent='53 FT';eq.style.color='var(--text)';}
    icon.textContent='📦'; txt.textContent='Sin pallets ni peso'; txt.style.color='var(--text-muted)';
    sub.textContent='Edita los pedidos para agregar datos';
    btnP.style.display='none'; btnP.dataset.equipo='';
  } else if((totalPallets/NP_MAX_P2)>0.8||(totalPeso/NP_MAX_W2)>0.8){
    const eq=document.getElementById('np-equipo-label')||null; if(eq){eq.textContent='53 FT';eq.style.color='var(--text)';}
    icon.textContent='✅'; txt.textContent='¡Caben! Equipo casi lleno'; txt.style.color='#D97706';
    sub.textContent=`Libre: ${NP_MAX_P2-totalPallets} pallets · ${Math.round(NP_MAX_W2-totalPeso).toLocaleString()} kg`;
    btnP.style.display='inline-flex'; btnP.style.background='#1A5C3A'; btnP.textContent='✓ Programar envío'; btnP.dataset.equipo='NORMAL';
  } else {
    const eq=document.getElementById('np-equipo-label')||null; if(eq){eq.textContent='53 FT';eq.style.color='var(--text)';}
    icon.textContent='✅'; txt.textContent='¡Caben en el equipo!'; txt.style.color='#15803D';
    sub.textContent=`Libre: ${NP_MAX_P2-totalPallets} pallets · ${Math.round(NP_MAX_W2-totalPeso).toLocaleString()} kg`;
    btnP.style.display='inline-flex'; btnP.style.background='#1A5C3A'; btnP.textContent='✓ Programar envío'; btnP.dataset.equipo='NORMAL';
  }
}

function npProgramarSeleccion(){
  const selected=[...document.querySelectorAll('.np-chk:checked')].map(chk=>noProg[parseInt(chk.dataset.idx)]).filter(Boolean);
  if(!selected.length) return;
  const sinRef=selected.filter(r=>!npRefNorm(r.ref));
  if(sinRef.length){ alert(`🔒 ${sinRef.length} pedido${sinRef.length>1?'s':''} seleccionado${sinRef.length>1?'s':''} sin referencia:\n\n${sinRef.map(r=>'• '+(r.pedido||'—')).join('\n')}\n\nAsígnales una referencia UL con "editar" para poder programarlos.`); return; }
  const refs=[...new Set(selected.map(r=>npRefNorm(r.ref)))];
  if(refs.length>1){ alert(`Selecciona pedidos de una sola referencia.\n\nSeleccionaste: ${refs.join(', ')}`); return; }
  npProgramarReferencia(refs[0]);
}


// ── NP: validate correlativo in real time ──
function npValidarCorrelativo(input){
  const raw = input.value.trim();
  const errEl = document.getElementById('np-ref-error');
  if(!raw||!errEl){ if(errEl) errEl.style.display='none'; return; }
  const fullRef = 'UL-'+raw.replace(/^UL-/i,'');
  // Solo bloquear si ya está en Despachos o Historial
  const inDesp = despachos.findIndex(r=>r.ref===fullRef);
  const inHist = historial.findIndex(r=>r.ref===fullRef);
  if(inDesp>=0||inHist>=0){
    const donde = inDesp>=0?'Despacho':'Historial';
    errEl.textContent = '⚠️ '+fullRef+' ya existe en '+donde+'. No puede reutilizarse.';
    errEl.style.display='block';
  } else {
    errEl.style.display='none';
  }
}

// ── NP: auto-suggest programming by country ──
function npSugerirProgramacionActivo(){
  if(!npPaisActivo){
    alert('⚠️ Selecciona un país primero para ver la sugerencia de programación.');
    return;
  }
  npSugerirProgramacion();
}

function npSugerirProgramacion(){
  if(!noProg.length){ alert('No hay pedidos en No Programados.'); return; }

  // Only use pedidos from the active country
  const pedidosFiltrados = npPaisActivo
    ? noProg.filter(r=>npGetPais(r)===npPaisActivo)
    : noProg;

  if(!pedidosFiltrados.length){
    alert('No hay pedidos para '+npPaisActivo+'.');
    return;
  }

  // Group by country
  const byPais = {};
  pedidosFiltrados.forEach((r,i)=>{
    const pais = npGetPais(r)||'SIN PAÍS';
    if(!byPais[pais]) byPais[pais]=[];
    byPais[pais].push({r,i:noProg.indexOf(r)});
  });

  // Sort each group: oldest fdescarga first, then oldest fecha
  Object.keys(byPais).forEach(p=>{
    byPais[p].sort((a,b)=>{
      const fa=a.r.fdescarga||a.r.fecha||'9999';
      const fb=b.r.fdescarga||b.r.fecha||'9999';
      return fa.localeCompare(fb);
    });
  });

  // Build suggestion for each country
  let msg = '📋 SUGERENCIA DE PROGRAMACIÓN\n';
  msg += '════════════════════════════════\n\n';
  let totalEquipos = 0;

  Object.keys(byPais).sort().forEach(pais=>{
    const pedidos = byPais[pais];
    msg += `🌎 ${pais} — ${pedidos.length} pedido${pedidos.length>1?'s':''}\n`;

    // Calculate how many 53FT needed
    let totalPallets=0, totalPeso=0;
    pedidos.forEach(({r})=>{
      totalPallets += parseInt(r.pallets)||0;
      totalPeso    += parseFloat(r.peso)||0;
    });
    const equiposNorm  = Math.ceil(Math.max(totalPallets/30, totalPeso/21000));
    const equipos3ejes = Math.ceil(Math.max(totalPallets/30, totalPeso/23000));
    const equipo = totalPeso > (equiposNorm*21000) ? '53 FT 3 EJES' : '53 FT';
    totalEquipos += equiposNorm;

    msg += `   Pallets: ${totalPallets} · Peso: ${Math.round(totalPeso).toLocaleString('es-SV')} kg\n`;
    msg += `   Equipo sugerido: ${equipo} × ${equiposNorm}\n`;
    msg += `   Pedidos (del más antiguo):\n`;
    pedidos.forEach(({r},idx)=>{
      msg += `   ${idx+1}. ${r.pedido||'—'} (${r.fdescarga||r.fecha||'sin fecha'})\n`;
    });
    msg += '\n';
  });

  msg += `════════════════════════════════\n`;
  msg += `Total equipos sugeridos: ${totalEquipos}\n\n`;
  msg += '¿Deseas seleccionar automáticamente el país con mayor prioridad?';

  // Find country with oldest pending pedido
  let oldestPais = null, oldestDate = '9999';
  Object.keys(byPais).forEach(p=>{
    const fecha = byPais[p][0].r.fdescarga||byPais[p][0].r.fecha||'9999';
    if(fecha < oldestDate){ oldestDate=fecha; oldestPais=p; }
  });

  if(confirm(msg) && oldestPais){
    // Auto-filter by oldest country
    npFiltrarPais(oldestPais==='SIN PAÍS'?'':oldestPais);
    // Select all pedidos of that country
    setTimeout(()=>{
      document.querySelectorAll('.np-chk').forEach(chk=>{
        chk.checked=true;
      });
      npOnCheck();
    },200);
    alert(`✅ Se seleccionaron ${byPais[oldestPais].length} pedido${byPais[oldestPais].length>1?'s':''} de ${oldestPais}\n\nPrioridad: fecha de descarga más antigua (${oldestDate})`);
  }
}


function npDescargaCell(r){
  const fd = parseFdesc(r.fdescarga||r.fdesc||'');
  if(!fd) return '—';
  const diff=Math.floor((Date.now()-new Date(fd).getTime())/(1000*60*60*24));
  const color=diff>=4?'#DC2626':diff>=3?'#D97706':'var(--text-muted)';
  const alerta=diff>=4?` ⚠️ ${diff}d`:'';
  return `<span style="font-family:var(--mono);font-size:11px;color:${color};font-weight:${diff>=4?'700':'400'};">${fd}${alerta}</span>`;
}

// ── NP: send single pedido → despacho (needs ref) ──
function npEnviarDespacho(gi){
  const r=noProg[gi]; if(!r) return;
  npProgramarReferencia(r.ref);
}

// ── Despachos: return pedido → NP ──
function toggleGrp(groupId){
  const rows = document.querySelectorAll('.'+groupId);
  const arrow = document.getElementById(groupId+'-arrow');
  const hidden = rows[0]&&rows[0].style.display==='none';
  rows.forEach(r=>r.style.display=hidden?'':'none');
  if(arrow) arrow.textContent = hidden?'▼':'▶';
}

let ordenModalRef = null;
function abrirOrdenModal(ref){
  ordenModalRef = ref;
  document.getElementById('orden-ref').textContent = ref;
  // Auto-fill date from first matching despacho
  const rows = despachos.filter(r=>r.ref===ref);
  const fecha = rows[0]?.fsalida||rows[0]?.fcarga||new Date().toLocaleDateString('es-SV');
  document.getElementById('orden-fecha').value = fecha;
  document.getElementById('orden-hora').value = '08:00';
  document.getElementById('orden-cat').value = 'PC';
  actualizarVistaOrden();
  openModal('modal-orden');
}

function actualizarVistaOrden(){
  const ref = ordenModalRef;
  if(!ref) return;
  const rows = despachos.filter(r=>r.ref===ref);
  const hora = document.getElementById('orden-hora').value||'08:00';
  const cat = document.getElementById('orden-cat').value||'PC';
  const fecha = document.getElementById('orden-fecha').value||'';
  const trans = rows[0]?.transporte||'—';
  const dest = rows[0]?.dest||'—';
  const pallets = rows.reduce((a,r)=>a+(parseInt(r.pallets)||0),0);

  // Format date nicely
  const diasSemana = ['DOMINGO','LUNES','MARTES','MIÉRCOLES','JUEVES','VIERNES','SÁBADO'];
  let fechaStr = fecha;
  try {
    const parts = fecha.split('-');
    if(parts.length===3){
      const d = new Date(parts[2],parts[1]-1,parts[0]);
      fechaStr = diasSemana[d.getDay()]+' '+fecha;
    }
  } catch(e){}

  const col1w = 15, col2w = 16;
  const sep = '─'.repeat(52);
  const header = 'PAÍS'.padEnd(col1w)+'PO'.padEnd(col2w)+'DT/ONL/OT';
  const filas = rows.map(r=>{
    const pais = (r.dest||'').toUpperCase().padEnd(col1w);
    const po = (r.no_pedido||r.dt||'—').padEnd(col2w);
    const dt = r.dt||'—';
    return pais+po+dt;
  }).join('\n');

  const texto =
`ORDEN DE DESPACHO

Transporte: ${trans}
Fecha y lugar de recolección: Blue Logistics (${fechaStr}) ${hora}
Unidad Solicitada: 53 FT${pallets?' · '+pallets+' pallets':''}
Lugar de Entrega: Centro de distribución, ${dest}
Categoría del producto: ${cat}

${header}
${sep}
${filas}`;

  document.getElementById('orden-preview').textContent = texto;
}

function copiarOrden(){
  const texto = document.getElementById('orden-preview').textContent;
  navigator.clipboard.writeText(texto).then(()=>{
    const btn = document.getElementById('btn-copiar-orden');
    btn.textContent = '✓ Copiado';
    btn.style.background = '#15803D';
    setTimeout(()=>{ btn.textContent = '📋 Copiar'; btn.style.background = '#A32D2D'; }, 2000);
  });
}

// Solo admin: corrige el estado de TODOS los pedidos de una referencia (p. ej. pruebas)
function despCorregirEstado(ref){
  if(window.HUB_ONLINE&&!hubEsAdmin()){ alert('Solo el administrador puede corregir el estado.'); return; }
  const k=String(ref||'').trim().toUpperCase();
  const rows=despachos.filter(r=>String(r.ref||'').trim().toUpperCase()===k);
  if(!rows.length) return;
  const ops=['PROGRAMADO','EN PROCESO DE CARGA','CARGADO'];
  const act=[...new Set(rows.map(r=>r.status))].join(', ');
  const v=prompt(`↺ Corregir estado de ${ref} (${rows.length} pedido${rows.length===1?'':'s'})\nEstado actual: ${act}\n\nEscribe el número del nuevo estado:\n1 = Programado (quita edificio, cortina y F. carga)\n2 = En proceso de carga\n3 = Cargado`,'');
  if(v==null) return;
  const st=ops[parseInt(v)-1]; if(!st){ alert('Opción no válida. Escribe 1, 2 o 3.'); return; }
  if(!confirm(`¿Cambiar los ${rows.length} pedidos de ${ref} a "${STATUS_LABEL[st]}"?`)) return;
  rows.forEach(r=>{
    r.status=st;
    if(st==='PROGRAMADO'){ r.edif=''; r.cortina=''; r.fcarga=''; }
    if(st==='EN PROCESO DE CARGA'){ r.fcarga=''; }
  });
  // si la referencia sigue ocupando una cortina y se regresa a Programado, se libera sin historial
  if(st==='PROGRAMADO') [12,6].forEach(e=>{ const C=(edifState[e]||{}).cortinas||{}; Object.keys(C).forEach(i=>{ const c=C[i]; if(c&&c.estado!=='libre'&&c.tipo==='carga'&&String(c.ref||'').trim().toUpperCase()===k){ C[i]={estado:'libre',tipo:null,ref:null,label:null,inicio:null,operador:'',notas:'',minutos:0,docId:null}; try{ edifRenderAll(e); }catch(x){} } }); });
  populateFilters(); renderDespachos(); setTimeout(gsSaveAll,300);
  hubToast(`${ref}: ${rows.length} pedido${rows.length===1?'':'s'} en "${STATUS_LABEL[st]}".`);
}
function despPuedeCortina(){ return !window.HUB_ONLINE || (typeof hubEsAdmin==='function' && hubEsAdmin()) || (typeof hubPerfil!=='undefined' && hubPerfil && hubPerfil.rol==='bodega'); }
function despAsignarEdifBloque(ref){
  if(!despPuedeCortina()){ alert('La cortina de carga la asigna bodega.'); return; }
  const rows = despachos.filter(r=>r.ref===ref);
  if(!rows.length){ alert('No se encontraron pedidos con referencia: '+ref); return; }
  const edif = prompt(`🏭 ASIGNAR CORTINA EN BLOQUE\nReferencia: ${ref}\n(${rows.length} pedido${rows.length>1?'s':''})\n\nEdificio (12 o 6):`,'12');
  if(edif===null||edif.trim()==='') return;
  const edifNum = parseInt(edif.trim());
  if(![12,6].includes(edifNum)){ alert('Edificio inválido. Ingrese 12 o 6.'); return; }
  const cortina = prompt(`Cortina (número):`, '');
  if(cortina===null||cortina.trim()==='') return;
  const cortinaNum = parseInt(cortina.trim());
  if(isNaN(cortinaNum)||cortinaNum<1){ alert('Cortina inválida. Ingrese un número.'); return; }
  if(!confirm(`¿Asignar ${rows.length} pedido${rows.length>1?'s':''} de ${ref}\nal Edificio ${edifNum} · Cortina ${cortinaNum}?\n\nEstado cambiará a: EN PROCESO DE CARGA`)) return;
  rows.forEach(r=>{
    r.edif = String(edifNum);
    r.cortina = cortinaNum;
    r.status = 'EN PROCESO DE CARGA';
    r.fcarga = r.fcarga||new Date().toLocaleDateString('es-SV');
  });
  if(edifState&&edifState[edifNum]){
    edifState[edifNum].cortinas[cortinaNum]={
      estado:'ocupada', tipo:'carga', ref,
      label:`${ref} (${rows.length} ped.)`,
      inicio:Date.now(), operador:'', notas:'', minutos:0, docId:ref
    };
    edifRenderAll(edifNum);
  }
  renderDespachos();
  populateFilters();
  setTimeout(gsSaveAll,500);
  alert(`✅ ${rows.length} pedido${rows.length>1?'s':''} asignados al Edificio ${edifNum} · Cortina ${cortinaNum}`);
}

// Copia exacta del pedido como estaba en NP (para poder regresarlo sin perder datos)
function npCopia(r){ const o={}; Object.keys(r||{}).forEach(k=>{ if(k==='_id'||k==='_t'||k==='_est'||k==='_est_en'||typeof r[k]==='function') return; o[k]=r[k]; }); return JSON.stringify(o); }
// Datos del pedido según su contenedor en Ingreso (para registros sin copia)
function npDatosIngreso(pedido){
  const k=hubNormPed(pedido); if(!k) return null;
  for(const c of [...(contenedores||[]), ...(historialCont||[])]){
    const p=contPedidos(c).find(x=>hubNormPed(x.pedido)===k);
    if(p) return {c,p};
  }
  return null;
}
function despRetornarNP(ri){
  const r=despachos[ri];
  if(!r) return;
  if(!confirm(`↩ Retornar a Pedidos No Programados:\n\nRef: ${r.ref||'—'}\nPedido: ${r.no_pedido||'—'}\nDT: ${r.dt||'—'}\nDestino: ${r.dest||'—'}\n\n¿Confirmar?`)) return;
  let np=null;
  try{ np=r.np_json?JSON.parse(r.np_json):null; }catch(e){ np=null; }
  const hoy=new Date().toLocaleDateString('es-SV');
  if(np){
    // Copia original + lo que se cambió en Despacho
    if(r.dt) np.dt=r.dt;
    if(r.no_pedido) np.pedido=r.no_pedido;
    if(r.pallets!==''&&r.pallets!=null) np.pallets=r.pallets;
    if(r.peso) np.peso=String(r.peso);
    if(r.equipo) np.equipo=r.equipo;
    ['ot','cajas','valor','fact_ul','bl_cp','flete','proveedor','fsolicitud'].forEach(k=>{ if(r[k]!==undefined&&r[k]!=='') np[k]=r[k]; });
    if(r.ref) np.ref=r.ref;
    np.notas=[np.notas&&np.notas!=='—'?np.notas:'', `Retornado desde Despacho ${hoy}`].filter(Boolean).join(' · ');
  } else {
    // Registro sin copia: reconstruir con lo que hay en Despacho + su contenedor
    const I=npDatosIngreso(r.no_pedido), c=I?I.c:{}, p=I?I.p:{};
    np={
      fecha:hoy,
      doc:r.bl_cp||c.doc||'', cont:c.cont||'', rc:c.rc||'', rg:c.rg||'', origen:c.origen||'',
      pais:Object.keys(NP_ABBREV).find(k=>NP_ABBREV[k]===r.dest&&k.length===2)||(p.pais||'').toUpperCase(),
      dest:r.dest||'', pedido:r.no_pedido||'', dt:r.dt||p.dt||'',
      ref:r.ref||'', prio:'ALTA',
      pallets:r.pallets||'', peso:r.peso?String(r.peso):'',
      equipo:r.equipo||'53 FT', truckFill:'',
      proveedor:r.proveedor||'', fsolicitud:r.fsolicitud||'', fdescarga:r.fingreso||parseFdesc(r.fdesc||r.fdescarga||'')||'',
      ot:r.ot||p.ot||'', cajas:r.cajas||'', valor:r.valor||p.valor||'', fact_ul:r.fact_ul||p.factura||'', bl_cp:r.bl_cp||c.doc||'', flete:r.flete||'',
      notas:'Retornado desde Despacho '+hoy
    };
  }
  delete np._id; delete np._t;
  noProg.push(np);
  despachos.splice(ri,1);
  populateFilters(); renderDespachos(); renderNp();
  setTimeout(()=>{
    gsSaveAll();
    const campos = GS_CAMPOS.PedidosNoProgramados;
    const x = noProg[noProg.length-1];
    if(x){ const fila = campos.map(k=>x[k]!==undefined?x[k]:''); gsSaveRow('PedidosNoProgramados', fila, null); }
  }, 500);
  const npTab=document.querySelector('.op-tab[data-tab="noprog"]');
  if(npTab) npTab.click();
  alert('↩ Pedido retornado a Pedidos No Programados con sus datos');
}

// ============================================================
// CONTENEDORES
// ============================================================
let contenedores = [];

// Pre-load data from document
// Contenedores cargados desde SheetDB al iniciar
const CONT_ESTADOS = [
  '01-TRÁNSITO MARÍTIMO',
  '02-TRAMITANDO EN PUERTO',
  '03-EN TRÁNSITO TERRESTRE',
  '04-POSICIONADO EN BLUE',
  '05-EN DESCARGA',
  '06-DESCARGADO',
  '07-NOTIFICADO VACÍO'
];
const CONT_ESTADO_CLASS = {
  '01-TRÁNSITO MARÍTIMO':  {bg:'#EFF6FF',color:'#1D4ED8',dot:'#3B82F6'},
  '02-TRAMITANDO EN PUERTO':{bg:'#FFF7ED',color:'#C2410C',dot:'#F97316'},
  '03-EN TRÁNSITO TERRESTRE':{bg:'#FEF3C7',color:'#92400E',dot:'#F59E0B'},
  '04-POSICIONADO EN BLUE': {bg:'#F0F9FF',color:'#0369A1',dot:'#0EA5E9'},
  '05-EN DESCARGA':         {bg:'#FDF4FF',color:'#7E22CE',dot:'#A855F7'},
  '06-DESCARGADO':          {bg:'#F0FDF4',color:'#15803D',dot:'#22C55E'},
  '07-NOTIFICADO VACÍO':    {bg:'#F0FDF4',color:'#166534',dot:'#16A34A'}
};

// Normalize old estado values to new ones
function normalizarEstado(e){
  const s=(e||'').toUpperCase().trim();
  if(s.includes('TRANSITO MARITIMO')||s.includes('TRÁNSITO MARÍTIMO'))return'01-TRÁNSITO MARÍTIMO';
  if(s.includes('TRAMITANDO'))return'02-TRAMITANDO EN PUERTO';
  if(s.includes('TRANSITO TERRESTRE')||s.includes('TRÁNSITO TERRESTRE'))return'03-EN TRÁNSITO TERRESTRE';
  if(s.includes('POSICIONADO')||s.includes('BLUE'))return'04-POSICIONADO EN BLUE';
  if(s.includes('EN DESCARGA'))return'05-EN DESCARGA';
  if(s.includes('DESCARGADO'))return'06-DESCARGADO';
  if(s.includes('VACIO')||s.includes('VACÍO')||s.includes('NOTIFICACION')||s.includes('NOTIFICADO'))return'07-NOTIFICADO VACÍO';
  if(s.includes('TRANSITO'))return'01-TRÁNSITO MARÍTIMO';
  return e||'01-TRÁNSITO MARÍTIMO';
}

// Normalize all existing data
contenedores.forEach(r=>{ r.estado=normalizarEstado(r.estado); r.report_esa=r.report_esa||'03-NO APLICA'; });

// Pasos en orden: solo el siguiente (o uno atrás para corregir).
// 04→05 solo asignando cortina · 05→06 solo liberando la cortina
function contEstadosPermitidos(r){
  const i=CONT_ESTADOS.indexOf(r.estado);
  if(i<0) return CONT_ESTADOS.slice();          // estado desconocido: deja corregir
  const ok=new Set([r.estado]);
  const sig=CONT_ESTADOS[i+1], ant=CONT_ESTADOS[i-1];
  if(sig) ok.add(sig);                           // 04→05 se intercepta y abre la cortina
  if(ant && !['05-EN DESCARGA','06-DESCARGADO'].includes(r.estado)) ok.add(ant);
  return CONT_ESTADOS.filter(e=>ok.has(e));
}
function contMotivoNoPermitido(r,nuevo){
  const i=CONT_ESTADOS.indexOf(r.estado), j=CONT_ESTADOS.indexOf(nuevo);
  if(j>i+1) return `No se pueden saltar pasos.\n\nDe "${r.estado}" solo puede avanzar a "${CONT_ESTADOS[i+1]}".`;
  if(r.estado==='06-DESCARGADO'&&nuevo==='05-EN DESCARGA') return 'Un contenedor descargado no regresa a 05. Si hay que volver a descargar, asígnale cortina desde 04.';
  return `De "${r.estado}" no puede pasar a "${nuevo}".`;
}
// Mientras el contenedor ocupa un lugar en el edificio, el estado lo mueve el edificio
function contBloqueoEstado(r){
  const u=contUbicacion(r); if(!u) return '';
  return u.tipo==='cola'
    ? `En cola del Edificio ${u.edif}: pasa a 05 solo cuando entre a una cortina. Para cambiarlo, quítalo de la cola.`
    : `Descargando en Edificio ${u.edif} · Cortina ${u.n}: pasa a 06 al liberar la cortina.`;
}
function estadoSelectCont(idx, estadoActual){
  const cfg=CONT_ESTADO_CLASS[estadoActual]||{bg:'#F3F4F6',color:'#374151',dot:'#9CA3AF'};
  const perm=contEstadosPermitidos(contenedores[idx]);
  const opts=CONT_ESTADOS.map(e=>`<option value="${e}"${e===estadoActual?' selected':''}${perm.includes(e)?'':' disabled'}>${e}${e==='05-EN DESCARGA'&&estadoActual==='04-POSICIONADO EN BLUE'?' (asignar cortina)':''}</option>`).join('');
  const bloq=contBloqueoEstado(contenedores[idx]);
  return `<select onchange="cambiarEstadoCont(${idx},this.value)" ${bloq?`disabled title="${bloq}"`:''} style="font-size:11px;font-family:var(--mono);font-weight:600;padding:3px 6px;border-radius:999px;border:1px solid ${cfg.dot};background:${cfg.bg};color:${cfg.color};cursor:pointer;outline:none;max-width:200px;">
    ${opts}
  </select>`;
}

// Campos obligatorios de la ficha de ingreso antes de pasar a NP
function contFaltantes(r){
  const f=[];
  const vacio=v=>!v||String(v).trim()===''||String(v).trim()==='-'||String(v).trim()==='—';
  if(vacio(r.doc))      f.push('Doc. de Transporte');
  if(vacio(r.cont))     f.push('Contenedor');
  if(vacio(r.eta_pto))  f.push('ETA Puerto');
  if(vacio(r.eta_blue)) f.push('ETA Blue');
  if(vacio(r.origen))   f.push('Origen');
  if(vacio(r.rg))       f.push('RG');
  if(vacio(r.rc))       f.push('RC');
  if(vacio(r.fdesc))    f.push('Fecha de descarga');
  if(String(r.report_esa||'').toUpperCase()==='02-SI') f.push('Reporte para ESA: lleva "02-SI" — mándalo y cámbialo a "04-ENVIADO"');
  const peds=contPedidos(r);
  const conPedido=peds;
  if(!peds.length) f.push('Al menos un pedido');
  peds.forEach(p=>{
    const et=String(p.pais||'').toUpperCase()+' '+(p.pedido||'(sin número)');
    if(vacio(p.pedido)) f.push(String(p.pais||'').toUpperCase()+': número de pedido');
    if(vacio(p.dt)) f.push(et+': DT');
    if(!(parseInt(p.bultos)>0)) f.push(et+': bultos');
    if(!(parseFloat(p.peso)>0)) f.push(et+': peso');
  });
  // El peso de los pedidos debe cuadrar con el peso del contenedor (tolerancia 1 kg)
  const pesoCont=parseFloat(r.peso)||0;
  const sumPeso=peds.reduce((a,p)=>a+(parseFloat(p.peso)||0),0);
  if(!(pesoCont>0)) f.push('Peso del contenedor');
  else if(conPedido.length && Math.abs(pesoCont-sumPeso)>1){
    const dif=pesoCont-sumPeso, fmt=n=>Math.abs(n).toLocaleString('es-SV',{maximumFractionDigits:2});
    f.push(`Peso no cuadra: pedidos ${fmt(sumPeso)} kg vs contenedor ${fmt(pesoCont)} kg (${dif>0?'faltan':'sobran'} ${fmt(dif)} kg)`);
  }
  return f;
}
function contAvisoFaltantes(idx){
  const r=contenedores[idx]; if(!r) return;
  const f=contFaltantes(r);
  alert(`🔒 No se puede enviar a NP.\n\nFalta completar en la ficha de ingreso:\n\n• ${f.join('\n• ')}\n\nUsa "editar" para completarlos.`);
}

// Estados desde los que se puede enviar un equipo a Pedidos No Programados
const NP_ESTADOS_OK = ['07-NOTIFICADO VACÍO'];

function cambiarEstadoCont(idx,nuevoEstado){
  const bloq=contBloqueoEstado(contenedores[idx]);
  if(bloq){ alert('🔒 '+bloq); renderContenedores(); return; }
  const antes=contenedores[idx].estado;
  if(nuevoEstado===antes) return;
  if(!contEstadosPermitidos(contenedores[idx]).includes(nuevoEstado)){ alert('🔒 '+contMotivoNoPermitido(contenedores[idx],nuevoEstado)); renderContenedores(); return; }
  if(antes==='04-POSICIONADO EN BLUE'&&nuevoEstado==='05-EN DESCARGA'){ renderContenedores(); ccAbrir(idx); return; }
  if(antes==='05-EN DESCARGA'&&nuevoEstado==='06-DESCARGADO'&&contVacio(contenedores[idx].fdesc)) contenedores[idx].fdesc=new Date().toLocaleDateString('es-SV');
  contenedores[idx].estado=nuevoEstado;
  renderContenedores();
  if(nuevoEstado==='04-POSICIONADO EN BLUE'&&antes!=='04-POSICIONADO EN BLUE') setTimeout(()=>ccAbrir(idx),50);
  const now=new Date();
  (document.getElementById('last-update')||{}).textContent ='Actualizado: '+now.toLocaleDateString('es-SV')+' '+now.toLocaleTimeString('es-SV',{hour:'2-digit',minute:'2-digit'});
}
const CONT_FLETES = [
  '01-NO PAGADO',
  '02-PAGO SOLICITADO',
  '03-EN PROCESO DE PAGO',
  '04-PAGADO'
];
const CONT_FLETE_CLASS = {
  '01-NO PAGADO':          {bg:'#FEE2E2',color:'#991B1B',dot:'#EF4444'},
  '02-PAGO SOLICITADO':    {bg:'#FFF7ED',color:'#C2410C',dot:'#F97316'},
  '03-EN PROCESO DE PAGO': {bg:'#FEF3C7',color:'#92400E',dot:'#F59E0B'},
  '04-PAGADO':             {bg:'#F0FDF4',color:'#15803D',dot:'#22C55E'}
};

function normalizarFlete(f){
  const s=(f||'').toUpperCase().trim();
  if(s==='04-PAGADO'||s.includes('PAGADO')&&!s.includes('NO')&&!s.includes('PROCESO')&&!s.includes('SOLICIT'))return'04-PAGADO';
  if(s.includes('PROCESO'))return'03-EN PROCESO DE PAGO';
  if(s.includes('SOLICIT'))return'02-PAGO SOLICITADO';
  return'01-NO PAGADO';
}
contenedores.forEach(r=>{ r.flete=normalizarFlete(r.flete); });

function fleteSelect(idx, fleteActual){
  const cfg=CONT_FLETE_CLASS[fleteActual]||{bg:'#F3F4F6',color:'#374151',dot:'#9CA3AF'};
  const opts=CONT_FLETES.map(e=>`<option value="${e}"${e===fleteActual?' selected':''}>${e}</option>`).join('');
  return `<select onchange="cambiarFleteCont(${idx},this.value)" style="font-size:11px;font-family:var(--mono);font-weight:600;padding:3px 6px;border-radius:999px;border:1px solid ${cfg.dot};background:${cfg.bg};color:${cfg.color};cursor:pointer;outline:none;max-width:190px;">
    ${opts}
  </select>`;
}

function cambiarFleteCont(idx,nuevoFlete){
  contenedores[idx].flete=nuevoFlete;
  renderContenedores();
  const now=new Date();
  (document.getElementById('last-update')||{}).textContent ='Actualizado: '+now.toLocaleDateString('es-SV')+' '+now.toLocaleTimeString('es-SV',{hour:'2-digit',minute:'2-digit'});
}
function blBadge(b, ri){
  const val = b||'01-NO ENTREGADO';
  const color = val==='02-ENTREGADO' ? '#15803D' : '#92400E';
  const bg    = val==='02-ENTREGADO' ? '#F0FDF4' : '#FEF3C7';
  const brd   = val==='02-ENTREGADO' ? '#86EFAC' : '#FCD34D';
  return `<select onchange="cambiarBL(${ri},this.value)" style="font-size:10px;font-family:var(--mono);font-weight:600;padding:2px 4px;border-radius:5px;border:1px solid ${brd};background:${bg};color:${color};cursor:pointer;min-width:130px;">
    <option value="01-NO ENTREGADO"${val==='01-NO ENTREGADO'?' selected':''}>01-NO ENTREGADO</option>
    <option value="02-ENTREGADO"${val==='02-ENTREGADO'?' selected':''}>02-ENTREGADO</option>
  </select>`;
}

function cambiarBL(ri, val){
  if(contenedores[ri]){
    contenedores[ri].bl = val;
    setTimeout(gsSaveAll, 500);
  }
}

function reportEsaBadge(b, ri){
  const val = b||'03-NO APLICA';
  const opts = ['01-NO','02-SI','03-NO APLICA','04-ENVIADO'];
  const color = val==='04-ENVIADO'?'#15803D':val==='02-SI'?'#1D4ED8':val==='01-NO'?'#991B1B':'#6B7280';
  const bg    = val==='04-ENVIADO'?'#F0FDF4':val==='02-SI'?'#EFF6FF':val==='01-NO'?'#FEF2F2':'#F3F4F6';
  const brd   = val==='04-ENVIADO'?'#86EFAC':val==='02-SI'?'#BFDBFE':val==='01-NO'?'#FECACA':'#E5E7EB';
  return `<select onchange="cambiarReportEsa(${ri},this.value)" style="font-size:10px;font-family:var(--mono);font-weight:600;padding:2px 4px;border-radius:5px;border:1px solid ${brd};background:${bg};color:${color};cursor:pointer;min-width:110px;">
    ${opts.map(o=>`<option value="${o}"${val===o?' selected':''}>${o}</option>`).join('')}
  </select>`;
}

function cambiarReportEsa(ri, val){
  if(contenedores[ri]){
    contenedores[ri].report_esa = val;
    setTimeout(gsSaveAll, 500);
  }
}
function pedidoCell(v,b,p){
  if(!v||v==='-')return`<span style="color:var(--text-hint);">—</span>`;
  const det=(b||p)?`<div style="font-size:9px;color:var(--text-hint);font-family:var(--mono);white-space:nowrap;">${b||0} b · ${Number(p||0).toLocaleString('es-SV',{maximumFractionDigits:0})} kg</div>`:'';
  return String(v).split(/\s*,\s*/).map(x=>`<span style="font-family:var(--mono);font-size:11px;display:block;">${x}</span>`).join('')+det;
}

// Month sort order — original chronological (oldest first)
const MES_ORDER = {
  'enero':1,'febrero':2,'marzo':3,'abril':4,'mayo':5,'junio':6,
  'julio':7,'agosto':8,'septiembre':9,'octubre':10,'noviembre':11,'diciembre':12
};

// Orden: por mes (como siempre) y, dentro de cada mes, lo más reciente arriba
// (el contenedor que avanzó de estado o se creó último va primero).

// ── Ingreso de equipo: contenedores del mismo BL juntos (el BL sube con su contenedor más reciente) ──
function contAgruparBL(rows){
  const m=new Map();
  rows.forEach(r=>{ const k=String(r.mes||'')+'|'+String(r.doc||'').trim().toUpperCase(); if(!m.has(k)) m.set(k,{rows:[]}); m.get(k).rows.push(r); });
  return [...m.values()];
}
function sortContenedores(data){
  if(typeof alrSellarEstados==='function') alrSellarEstados();
  return [...data].sort((a,b)=>{
    const ma = MES_ORDER[a.mes?.toLowerCase()]||99;
    const mb = MES_ORDER[b.mes?.toLowerCase()]||99;
    if(ma!==mb) return ma-mb;
    // Dentro del mes: por estado (01 → 07) y luego por fecha de arribo (ETA Blue; si no hay, ETA Puerto)
    const ea=parseInt(String(a.estado||'').slice(0,2))||99, eb=parseInt(String(b.estado||'').slice(0,2))||99;
    if(ea!==eb) return ea-eb;
    const fx=r=>dgIso(dgFecha(r.eta_blue||r.eta_pto))||'9999', fa=fx(a), fb=fx(b);
    if(fa!==fb) return String(fa).localeCompare(String(fb));
    return String(a.cont||'').localeCompare(String(b.cont||''));
  });
}

function getContFiltered(){
  const mes=document.getElementById('cf-mes').value;
  const origen=document.getElementById('cf-origen').value;
  const estado=document.getElementById('cf-estado').value;
  const flete=document.getElementById('cf-flete').value;
  const q=(document.getElementById('cf-q').value||'').toLowerCase();
  return contenedores.filter(r=>{
    if(r.enviado) return false; // hide enviados from main view
    if(mes&&r.mes!==mes)return false;
    if(origen&&r.origen!==origen)return false;
    if(estado&&r.estado!==estado)return false;
    if(flete&&r.flete!==flete)return false;
    if(q&&!String(r.cont||'').toLowerCase().includes(q)&&!String(r.doc||'').toLowerCase().includes(q)&&!String(r.rg||'').toLowerCase().includes(q)&&!String(r.rc||'').toLowerCase().includes(q)&&!contPedidos(r).some(p=>String(p.pedido).toLowerCase().includes(q)||String(p.dt||'').toLowerCase().includes(q)))return false;
    return true;
  });
}

// Barra del flujo 01→07 (clic = filtrar por estado)
function contFlowRender(){
  const el=document.getElementById('cont-flow'); if(!el) return;
  const activos=contenedores.filter(r=>!r.enviado);
  const sel=(document.getElementById('cf-estado')||{}).value||'';
  const CORTO={'01':'Marítimo','02':'En puerto','03':'Terrestre','04':'En Blue','05':'En descarga','06':'Descargado','07':'Vacío'};
  const nombre=e=>CORTO[e.slice(0,2)]||e;
  el.innerHTML=`<button class="fl-all ${sel?'':'on'}" onclick="contFlowFiltrar('')"><b>${activos.length}</b><span>Activos</span></button>`+
    CONT_ESTADOS.map(e=>{ const n=activos.filter(r=>r.estado===e).length;
      return `<button class="fl-st ${sel===e?'on':''} ${n?'has':''}" onclick="contFlowFiltrar('${e}')" title="${e}"><i>${e.slice(0,2)}</i><b>${n}</b><span>${nombre(e)}</span></button>`; }).join('');
}
function contFlowFiltrar(e){ const s=document.getElementById('cf-estado'); if(s) s.value=(s.value===e?'':e); renderContenedores(); }
function actualizarMetricasCont(){
  contFlowRender();
  const f=getContFiltered();
  const counts={};
  CONT_ESTADOS.forEach(e=>counts[e]=0);
  contenedores.forEach(r=>{if(counts[r.estado]!==undefined)counts[r.estado]++;});
  // Promedio equipos por mes — cada fila = 1 contenedor
  const mesesUnicos=[...new Set(contenedores.map(r=>(r.mes||'').toLowerCase()).filter(Boolean))];
  const totalMeses=mesesUnicos.length||1;
  const promedio=(contenedores.length/totalMeses).toFixed(1);
  const peso=f.reduce((a,r)=>a+r.peso,0);
  (document.getElementById('cm-total')||{}).textContent =f.length;
  (document.getElementById('cm-en-proceso')||{}).textContent =(counts['04-POSICIONADO EN BLUE']||0)+(counts['05-EN DESCARGA']||0)+(counts['06-DESCARGADO']||0);
  (document.getElementById('cm-transito')||{}).textContent =counts['01-TRÁNSITO MARÍTIMO']||0;
  (document.getElementById('cm-tramitando')||{}).textContent =counts['02-TRAMITANDO EN PUERTO']||0;
  (document.getElementById('cm-vacio')||{}).textContent =counts['07-NOTIFICADO VACÍO']||0;
  (document.getElementById('cm-promedio')||{}).textContent =promedio;
  (document.getElementById('cm-meses')||{}).textContent =mesesUnicos.length;
  (document.getElementById('cm-sv')||{}).textContent =f.filter(r=>r.sv&&r.sv!=='-').length;
  (document.getElementById('cm-hn')||{}).textContent =f.filter(r=>r.hn&&r.hn!=='-').length;
  (document.getElementById('cm-cr')||{}).textContent =f.filter(r=>r.cr&&r.cr!=='-').length;
  (document.getElementById('cm-ni')||{}).textContent =f.filter(r=>r.ni&&r.ni!=='-').length;
  (document.getElementById('cm-gt')||{}).textContent =f.filter(r=>r.gt&&r.gt!=='-').length;
  (document.getElementById('cm-pa')||{}).textContent =f.filter(r=>r.pa&&r.pa!=='-').length;
  (document.getElementById('tab-count-cont')||{}).textContent =contenedores.length;
  (document.getElementById('cont-count-label')||{}).textContent =f.length+' de '+contenedores.length+' contenedores';
}

function renderContenedores(){
  actualizarMetricasCont();
  const f=getContFiltered();
  const sorted=sortContenedores(f);
  const tbody=document.getElementById('cont-tbody');
  if(!sorted.length){tbody.innerHTML='<tr><td colspan="23"><div class="empty"><strong>Sin resultados</strong>Ajusta los filtros</div></td></tr>';return;}
  let blN=0;
  tbody.innerHTML=contAgruparBL(sorted).map(g=>{ blN++; const zebra=blN%2?'bl-a':'bl-b';
   return g.rows.map((r,gi)=>{ const si=sorted.indexOf(r);
    const ri=contenedores.indexOf(r)>=0?contenedores.indexOf(r):si;
    const reciente=r._est_en&&(Date.now()-r._est_en)<6000;
    const enviadoCls=' class="bl-row '+zebra+(gi===0?' bl-first':'')+(r.enviado?' row-enviado':(reciente?' cont-recien':''))+'"';
    const enviadoBadge=r.enviado?'<span class="badge-enviado">✓ NP</span>':'';
    const estadoPermite = NP_ESTADOS_OK.includes(r.estado);
    const faltan = contFaltantes(r);
    const btnAccion=r.enviado
      ? `<button class="btn-enviar" disabled>✓ Enviado</button>`
      : (estadoPermite && faltan.length)
        ? `<button class="btn-enviar" onclick="contAvisoFaltantes(${ri})" style="background:#FEE2E2;color:#991B1B;border-color:#FECACA;" title="Faltan datos: ${faltan.join(', ').replace(/"/g,'')}">🔒 NP (${faltan.length})</button>`
      : estadoPermite
        ? `<button class="btn-enviar" onclick="enviarContANP(${ri})" title="Enviar pedidos a Pedidos No Programados">→ NP</button>`
        : `<button class="btn-enviar" disabled title="Disponible solo en: 07 - Notificado vacío">🔒 NP</button>`;
    return`<tr${enviadoCls}>
    <td>${r.mes}</td>
    <td class="mono bl-doc" style="max-width:140px;overflow:hidden;text-overflow:ellipsis;" title="${r.doc}">${r.doc}${gi===0&&g.rows.length>1?`<span class="bl-n">${g.rows.length}</span>`:''}</td>
    <td style="font-weight:600;font-family:var(--mono);font-size:12px;">${r.cont}${enviadoBadge}</td>
    <td class="mono">${r.eta_pto||'—'}</td>
    <td class="mono">${r.eta_blue||'—'}</td>
    <td class="num">${r.cant?r.cant.toLocaleString('es-SV'):'—'}</td>
    <td class="num">${r.peso?r.peso.toLocaleString('es-SV',{minimumFractionDigits:2,maximumFractionDigits:2}):'—'}</td>
    <td style="font-size:12px;">${r.origen}</td>
    <td>${estadoSelectCont(ri, r.estado)}</td>
    <td style="white-space:nowrap;">${contCortinaCell(r,ri)}</td>
    <td>${fleteSelect(ri, r.flete)}</td>
    <td>${blBadge(r.bl, ri)}</td>
    <td>${reportEsaBadge(r.report_esa, ri)}</td>
    <td class="mono" style="font-size:11px;">${r.rg||'—'}</td>
    <td class="mono" style="font-size:11px;">${r.rc||'—'}</td>
    <td class="mono">${r.fdesc||'—'}</td>
    <td style="text-align:center;">${pedidoCell(r.sv,r.sv_bultos,r.sv_peso)}</td>
    <td style="text-align:center;">${pedidoCell(r.hn,r.hn_bultos,r.hn_peso)}</td>
    <td style="text-align:center;">${pedidoCell(r.cr,r.cr_bultos,r.cr_peso)}</td>
    <td style="text-align:center;">${pedidoCell(r.ni,r.ni_bultos,r.ni_peso)}</td>
    <td style="text-align:center;">${pedidoCell(r.gt,r.gt_bultos,r.gt_peso)}</td>
    <td style="text-align:center;">${pedidoCell(r.pa,r.pa_bultos,r.pa_peso)}</td>
    <td style="text-align:center;white-space:nowrap;">${r.enviado?'':`<button class="edit-btn" onclick="abrirModalCont(${ri})" style="margin-right:4px;">editar</button>`}${btnAccion}</td>
  </tr>`;
  }).join(''); }).join('');

  // Populate filters — meses sorted most recent first
  const meses=[...new Set(contenedores.map(r=>r.mes))].sort((a,b)=>(MES_ORDER[a?.toLowerCase()]||99)-(MES_ORDER[b?.toLowerCase()]||99));
  const origenes=[...new Set(contenedores.map(r=>r.origen))].sort();
  const mSel=document.getElementById('cf-mes'),oSel=document.getElementById('cf-origen');
  const cm=mSel.value,co=oSel.value;
  mSel.innerHTML='<option value="">Todos los meses</option>'+meses.map(m=>`<option${m===cm?' selected':''}>${m}</option>`).join('');
  oSel.innerHTML='<option value="">Todos los orígenes</option>'+origenes.map(o=>`<option${o===co?' selected':''}>${o}</option>`).join('');
}

// ── Parse fdesc from contenedor (e.g. "15-ene.-2026") → "YYYY-MM-DD" for date input ──
function parseFdesc(fd){
  if(!fd||fd==='—'||fd.trim()==='') return '';
  // Try direct ISO or already formatted
  if(/^\d{4}-\d{2}-\d{2}$/.test(fd.trim())) return fd.trim();
  const MESES={'ene':1,'feb':2,'mar':3,'abr':4,'may':5,'jun':6,'jul':7,'ago':8,'sep':9,'oct':10,'nov':11,'dic':12,
               'jan':1,'feb':2,'mar':3,'apr':4,'may':5,'jun':6,'jul':7,'aug':8,'sep':9,'oct':10,'nov':11,'dec':12};
  // Format: "15-ene.-2026" or "15-ene-2026" or "15/01/2026"
  const m1=fd.match(/(\d{1,2})[\-\/]([a-záéíóú\.]+)[\-\/](\d{4})/i);
  if(m1){
    const day=m1[1].padStart(2,'0');
    const monKey=m1[2].replace('.','').toLowerCase().substring(0,3);
    const mon=String(MESES[monKey]||1).padStart(2,'0');
    return `${m1[3]}-${mon}-${day}`;
  }
  // Format: "15/01/2026" or "15-01-2026"
  const m2=fd.match(/(\d{1,2})[\-\/](\d{1,2})[\-\/](\d{4})/);
  if(m2) return `${m2[3]}-${m2[2].padStart(2,'0')}-${m2[1].padStart(2,'0')}`;
  return fd;
}

// Enviar contenedor → No Programados (uno por país con pedido)
function enviarContANP(idx){
  const r=contenedores[idx];
  if(r.enviado){alert('Este equipo ya fue enviado a Pedidos No Programados');return;}
  // Solo permitir desde Posicionado en Blue en adelante
  if(contFaltantes(r).length){ contAvisoFaltantes(idx); return; }
  if(!NP_ESTADOS_OK.includes(r.estado)){
    alert(`⚠️ No es posible enviar a NP.\n\nEstado actual: ${r.estado}\n\nSolo se permite enviar a Pedidos No Programados cuando el equipo está en:\n• 07 - Notificado Vacío`);
    return;
  }
  const todos=contPedidos(r).filter(p=>!contVacio(p.pedido));
  const yaSalieron=todos.filter(p=>p.salida);
  const paises=todos.filter(p=>!p.salida).map(p=>({code:String(p.pais).toUpperCase(),val:p.pedido,dt:p.dt||'',bultos:p.bultos||'',peso:p.peso||'',ot:p.ot||'',valor:p.valor||'',factura:p.factura||''}));
  if(!paises.length){
    alert(yaSalieron.length?'Todos los pedidos de este contenedor ya tienen fecha de salida.':'Este contenedor no tiene pedidos registrados.');
    return;
  }
  { const dups=hubDuplicados(paises.map(p=>({pedido:p.val,dt:p.dt})),['np','desp','hist']);
    if(dups.length){ hubAvisoDup(dups,'No se puede enviar a NP'); return; } }
  const lista=paises.map(p=>`  • ${p.code} ${p.val}${p.dt?'  ·  DT '+p.dt:''}  ·  ${p.bultos||0} bultos  ·  ${Number(p.peso||0).toLocaleString('es-SV',{maximumFractionDigits:2})} kg`).join('\n')+(yaSalieron.length?`\n\n(${yaSalieron.length} pedido${yaSalieron.length>1?'s':''} ya salió y no se envía)`:'');
  if(!confirm(`Se enviarán ${paises.length} pedido${paises.length>1?'s':''} a Pedidos No Programados:\n\n${lista}\n\nDoc. Transporte: ${r.doc}\nRG: ${r.rg||'—'}\nOrigen: ${r.origen}\n\n¿Continuar?`))return;
  const today=new Date().toLocaleDateString('es-SV');
  const granelOrig=npEsGranelOrigen(r.origen);
  paises.forEach(p=>{
    const esCaja=p.bultos&&(granelOrig||+p.bultos>60);
    noProg.push({
      fecha:today,
      doc:r.doc,
      rc:r.rc,
      rg:r.rg,
      origen:r.origen,
      dest:npNormPais(p.code)||p.code,
      pais:p.code,
      pedido:p.val,
      dt:p.dt||'',
      ref:'',
      prio:'NORMAL',
      // Bultos > 60 son cajas (granel): los pallets se completan después
      pallets:p.bultos&&!esCaja?String(p.bultos):'',
      cajas:esCaja?String(p.bultos):'',
      peso:p.peso?String(p.peso):'',
      ...npCalcEquipo(esCaja?0:p.bultos,p.peso),
      ot:p.ot||'', valor:p.valor||'', fact_ul:p.factura||'', bl_cp:r.doc||'',
      proveedor:'',
      fsolicitud:'',
      fdescarga:parseFdesc(r.fdesc)||'',
      notas:'',
      contIdx:idx
    });
  });
  // Mark as enviado and save to Sheets
  r.fechaEnvioNP=new Date().toLocaleDateString('es-SV');
  r.enviado=true;
  historialCont.push({...r});
  renderContenedores();
  renderNp();
  renderHistorialCont();
  setTimeout(()=>{
    gsSaveAll();
    // Save updated contenedor row to Sheets
    const ci = contenedores.indexOf(r);
    if(ci>=0){
      const fila = GS_CAMPOS.Contenedores.map(k=>r[k]!==undefined?String(r[k]):'');
      gsSaveRow('Contenedores', fila, ci+1);
    }
    // Append each new NP row
    const campos = GS_CAMPOS.PedidosNoProgramados;
    paises.forEach(p=>{
      const npR = noProg[noProg.length - paises.indexOf(p) - 1];
      if(npR){ const fila = campos.map(k=>npR[k]!==undefined?npR[k]:''); gsSaveRow('PedidosNoProgramados', fila, null); }
    });
  }, 500);
  const now=new Date();
  (document.getElementById('last-update')||{}).textContent ='Actualizado: '+now.toLocaleDateString('es-SV')+' '+now.toLocaleTimeString('es-SV',{hour:'2-digit',minute:'2-digit'});
}

function clearContFilters(){
  ['cf-mes','cf-origen','cf-estado','cf-flete','cf-q'].forEach(id=>document.getElementById(id).value='');
  renderContenedores();
}

function exportContCSV(){
  const header='Mes,Doc.Transporte,Contenedor,ETA Puerto,ETA Blue,Cantidad,Peso KG,Origen,Estado,Flete,BL,RG,RC,F.Descarga,EL SALVADOR,HONDURAS,COSTA RICA,NICARAGUA,GUATEMALA,PANAMA';
  const rows=contenedores.map(r=>[r.mes,r.doc,r.cont,r.eta_pto,r.eta_blue,r.cant,r.peso,r.origen,r.estado,r.flete,r.bl,r.rg,r.rc,r.fdesc,r.sv,r.hn,r.cr,r.ni,r.gt,r.pa].map(v=>`"${v||''}"`).join(','));
  const blob=new Blob(['\uFEFF'+header+'\n'+rows.join('\n')],{type:'text/csv;charset=utf-8'});
  const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='contenedores_'+new Date().toISOString().slice(0,10)+'.csv';a.click();
}

document.getElementById('cf-mes').addEventListener('change',renderContenedores);
document.getElementById('cf-origen').addEventListener('change',renderContenedores);
document.getElementById('cf-estado').addEventListener('change',renderContenedores);
document.getElementById('cf-flete').addEventListener('change',renderContenedores);
document.getElementById('cf-q').addEventListener('input',renderContenedores);

// Init contenedores on load
renderContenedores();


// ============================================================
// EDIFICIOS — SISTEMA MULTI-EDIFICIO
// ============================================================

const EDIFICIOS = {
  12: { nombre: 'Edificio 12 — En Vivo', cortinas: 3, tabId: 'edif12' },
  6:  { nombre: 'Edificio 6 — En Vivo',  cortinas: 8, tabId: 'edif6'  }
};

// State per building
let edifState = {
  12: { cortinas: {}, historial: [], cola: [] },
  6:  { cortinas: {}, historial: [], cola: [] }
};

// Init cortinas state
Object.keys(EDIFICIOS).forEach(edif=>{
  const n = EDIFICIOS[edif].cortinas;
  for(let i=1;i<=n;i++){
    edifState[edif].cortinas[i]={estado:'libre',tipo:null,ref:null,label:null,inicio:null,operador:'',notas:'',minutos:0,docId:null};
  }
});

let edifLiberarTarget = null; // {edif, cortina}
let edifAsignarTarget = null; // edif number for current modal

// Color config
const EDIF_CONFIG = {
  carga:    {color:'#2E6CB5',bg:'#EAF2FC',border:'#BFD6F0',icon:'▲',label:'Cargando'},
  descarga: {color:'#B45309',bg:'#FFF4D6',border:'#F5D27A',icon:'▼',label:'Descargando'},
  libre:    {color:'#8F9BB0',bg:'#F5F7FA',border:'#E3E8EF',icon:'○',label:'Libre'}
};

// Compact elegant card per cortina
function edifCardHTML(edif, n){
  const c = edifState[edif].cortinas[n];
  const cfg = EDIF_CONFIG[c.estado==='libre'?'libre':c.tipo]||EDIF_CONFIG.libre;
  const isOcupada = c.estado!=='libre';
  const inicioStr = c.inicio ? new Date(c.inicio).toLocaleTimeString('es-SV',{hour:'2-digit',minute:'2-digit'}) : '';
  const durId = `edif-dur-${edif}-${n}`;

  return `<div style="
    border:1px solid ${cfg.border};
    border-radius:18px;
    background:#fff;
    overflow:hidden;
    box-shadow:var(--shadow-2);
    font-size:12px;
  ">
    <!-- Top strip -->
    <div style="background:${cfg.color};padding:6px 10px;display:flex;align-items:center;justify-content:space-between;">
      <span style="color:#fff;font-weight:700;font-size:12px;letter-spacing:.02em;">C${n}</span>
      <span style="color:rgba(255,255,255,.85);font-size:10px;font-weight:500;">${cfg.icon} ${cfg.label}</span>
    </div>

    <!-- Mini SVG illustration -->
    <div style="background:${cfg.bg};padding:8px 10px;display:flex;justify-content:center;">
      <svg width="110" height="52" viewBox="0 0 110 52" xmlns="http://www.w3.org/2000/svg">
        <!-- Ground -->
        <rect x="0" y="44" width="110" height="8" fill="#e2e8f0"/>
        <!-- Building -->
        <rect x="38" y="4" width="72" height="40" fill="#f8fafc" stroke="#cbd5e1" stroke-width="1" rx="2"/>
        <!-- Door -->
        ${isOcupada
          ? `<rect x="50" y="14" width="36" height="30" fill="${cfg.bg}" stroke="${cfg.border}" stroke-width="1.5"/>
             <line x1="50" y1="21" x2="86" y2="21" stroke="${cfg.border}" stroke-width=".8" stroke-dasharray="3,2"/>
             <line x1="50" y1="28" x2="86" y2="28" stroke="${cfg.border}" stroke-width=".8" stroke-dasharray="3,2"/>
             <line x1="50" y1="35" x2="86" y2="35" stroke="${cfg.border}" stroke-width=".8" stroke-dasharray="3,2"/>`
          : `<rect x="50" y="14" width="36" height="30" fill="#f1f5f9" stroke="#cbd5e1" stroke-width="1"/>
             <rect x="62" y="26" width="12" height="18" fill="#e2e8f0" rx="1"/>`
        }
        <!-- Roof strip -->
        <rect x="36" y="3" width="76" height="3" fill="#94a3b8" rx="1"/>
        <!-- Yellow posts -->
        <rect x="40" y="28" width="3" height="16" fill="#fbbf24" rx=".5"/>
        <rect x="106" y="28" width="3" height="16" fill="#fbbf24" rx=".5"/>
        ${isOcupada ? `
        <!-- Truck body -->
        <rect x="0" y="24" width="44" height="20" fill="${cfg.color}" rx="3" opacity=".92"/>
        <rect x="30" y="18" width="14" height="12" fill="${cfg.color}" rx="2" opacity=".8"/>
        <!-- Windshield -->
        <rect x="31" y="19" width="11" height="7" fill="rgba(255,255,255,.3)" rx="1"/>
        <!-- Wheels -->
        <circle cx="10" cy="45" r="4" fill="#1e293b"/>
        <circle cx="10" cy="45" r="2" fill="#64748b"/>
        <circle cx="32" cy="45" r="4" fill="#1e293b"/>
        <circle cx="32" cy="45" r="2" fill="#64748b"/>
        <!-- Arrow -->
        <text x="22" y="37" text-anchor="middle" fill="#fff" font-size="10" font-weight="bold">${c.tipo==='carga'?'↑':'↓'}</text>
        `:``}
      </svg>
    </div>

    <!-- Info body -->
    <div style="padding:8px 10px;">
      ${isOcupada ? `
        <div style="font-size:11px;font-weight:600;color:var(--text);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-bottom:4px;" title="${c.label||''}">${c.label||'—'}</div>
        <div style="display:flex;gap:8px;font-size:10px;color:var(--text-muted);margin-bottom:6px;">
          <span>⏱ ${inicioStr}</span>
          <span>⏳ <span id="${durId}">${c.minutos}</span>m</span>
          ${c.operador?`<span>👤 ${c.operador}</span>`:''}
        </div>
        <button onclick="edifLiberarModal(${edif},${n})" style="width:100%;height:24px;font-size:10px;font-family:var(--sans);font-weight:600;border-radius:999px;border:1px solid #FECACA;background:#FEE2E2;color:#991B1B;cursor:pointer;height:28px;font-size:11px;">✓ Completar</button>
      ` : `
        <div style="font-size:10px;color:var(--text-hint);margin-bottom:6px;text-align:center;">Disponible</div>
        <button onclick="edifAsignarModal(${edif},${n})" style="width:100%;height:24px;font-size:10px;font-family:var(--sans);font-weight:600;border-radius:999px;border:1px solid #BFD6F0;background:#EAF2FC;color:#1D4E8C;cursor:pointer;height:28px;font-size:11px;">+ Asignar</button>
      `}
    </div>
  </div>`;
}

function edifRenderCortinas(edif){
  const gridId = `edif-cortinas-grid-${edif}`;
  const grid = document.getElementById(gridId);
  if(!grid) return;
  const n = EDIFICIOS[edif].cortinas;
  // Use auto-fill grid, 4 cols max
  const cols = edif==6 ? 4 : 3;
  grid.style.gridTemplateColumns = `repeat(${cols},1fr)`;
  let html='';
  for(let i=1;i<=n;i++) html+=edifCardHTML(edif,i);
  grid.innerHTML=html;
}

function edifUpdateKPIs(edif){
  const st = edifState[edif];
  const vals = Object.values(st.cortinas);
  const total = EDIFICIOS[edif].cortinas;
  const ocupadas = vals.filter(c=>c.estado!=='libre').length;
  const eid = (id,v)=>{const e=document.getElementById(id);if(e)e.textContent=v;};
  eid(`edif-kpi-ocupadas-${edif}`, ocupadas);
  eid(`edif-kpi-libres-${edif}`,   total-ocupadas);
  eid(`edif-kpi-carga-${edif}`,    vals.filter(c=>c.tipo==='carga').length);
  eid(`edif-kpi-descarga-${edif}`, vals.filter(c=>c.tipo==='descarga').length);
  eid(`edif-kpi-done-${edif}`,     edifHistDelDia(edif).length);
}

function edifRenderCola(edif){
  const tbody = document.getElementById(`edif-cola-tbody-${edif}`);
  const countEl = document.getElementById(`edif-cola-count-${edif}`);
  const cola = edifState[edif].cola;
  if(!tbody) return;
  if(countEl) countEl.textContent = cola.length + ' en espera';
  if(!cola.length){
    tbody.innerHTML='<tr><td colspan="7"><div class="empty" style="padding:1rem;"><strong>Cola vacía</strong></div></td></tr>';
    return;
  }
  tbody.innerHTML=cola.map((r,i)=>`<tr>
    <td style="font-weight:600;color:var(--text-muted);">#${i+1}</td>
    <td><span class="badge ${r.tipo==='carga'?'s-despachado':'s-enproceso'}" style="font-size:10px;">${r.tipo==='carga'?'▲ Carga':'▼ Descarga'}</span></td>
    <td style="font-weight:600;font-size:12px;max-width:180px;overflow:hidden;text-overflow:ellipsis;">${r.label||'—'}</td>
    <td style="font-size:11px;">${r.destOrig||'—'}</td>
    <td class="mono" style="font-size:10px;">${r.equipo||'—'}</td>
    <td><span class="badge s-noprog" style="font-size:10px;">En espera</span></td>
    <td>
      <button class="btn btn-sm btn-accent" onclick="edifAsignarDesdeCola(${edif},${i})" style="font-size:10px;height:24px;">→</button>
      <button class="btn btn-sm btn-danger" onclick="edifQuitarCola(${edif},${i})" style="font-size:10px;height:24px;">✕</button>
    </td>
  </tr>`).join('');
}

function edifHoyISO(d){ d=d||new Date(); const z=n=>String(n).padStart(2,'0'); return `${d.getFullYear()}-${z(d.getMonth()+1)}-${z(d.getDate())}`; }
// Registros viejos sin fecha: se fechan con su sello de creación (o hoy)
function edifFecharHistorial(edif){
  edifState[edif].historial.forEach(h=>{ if(h&&!h.fecha){ const t=h.ts||h._t; h.fecha=edifHoyISO(t?new Date(t):new Date()); } });
}
function edifHistDelDia(edif, fecha){ edifFecharHistorial(edif); return edifState[edif].historial.filter(h=>h&&h.fecha===(fecha||edifHoyISO())); }
function edifPuedeEditar(){ return !window.HUB_ONLINE || (typeof hubPuede==='function' && hubPuede('edificios')); }
function edifBorrarHist(edif, i){
  const h=edifState[edif].historial[i]; if(!h||!edifPuedeEditar()) return;
  if(!confirm(`¿Borrar este registro del historial?\n\n${h.tipo==='carga'?'Carga':'Descarga'} · ${h.label||'—'} · C${h.cortina} · ${h.inicio}–${h.fin}\n\nSolo se quita del historial; no cambia el estado del contenedor ni del despacho.`)) return;
  edifState[edif].historial.splice(i,1);
  edifRenderAll(edif);
}
function edifRenderHistorial(edif){
  const tbody = document.getElementById(`edif-hist-tbody-${edif}`);
  const countEl = document.getElementById(`edif-hist-count-${edif}`);
  const fEl = document.getElementById(`edif-hist-fecha-${edif}`);
  if(!tbody) return;
  const hoy=edifHoyISO();
  if(fEl && !fEl.value) fEl.value=hoy;
  if(fEl) fEl.max=hoy;
  const fecha=(fEl&&fEl.value)||hoy;
  edifFecharHistorial(edif);
  const todos=edifState[edif].historial;
  const hist=todos.map((h,i)=>({h,i})).filter(x=>x.h&&x.h.fecha===fecha);
  if(countEl) countEl.textContent = hist.length + ' completado' + (hist.length===1?'':'s');
  if(!hist.length){
    tbody.innerHTML=`<tr><td colspan="8"><div class="empty" style="padding:1rem;">${fecha===hoy?'Sin actividad hoy':'Sin actividad ese día'}</div></td></tr>`;
    return;
  }
  const ed=edifPuedeEditar();
  tbody.innerHTML=hist.slice().reverse().map(({h,i})=>`<tr>
    <td><span class="badge ${h.tipo==='carga'?'s-despachado':'s-enproceso'}" style="font-size:10px;">${h.tipo==='carga'?'▲ Carga':'▼ Descarga'}</span></td>
    <td style="font-weight:600;font-size:12px;max-width:160px;overflow:hidden;text-overflow:ellipsis;" title="${h.label||''}">${h.label||'—'}</td>
    <td style="text-align:center;font-weight:700;">C${h.cortina}</td>
    <td class="mono">${h.inicio}</td>
    <td class="mono">${h.fin}</td>
    <td class="mono" style="color:var(--text-muted);">${h.duracion}m</td>
    <td style="font-size:11px;">${h.operador||'—'}</td>
    <td>${ed?`<button class="edif-hist-del" onclick="edifBorrarHist(${edif},${i})" title="Borrar registro" aria-label="Borrar registro">×</button>`:''}</td>
  </tr>`).join('');
}

function edifRenderAll(edif){
  edifRenderCortinas(edif);
  edifUpdateKPIs(edif);
  edifRenderCola(edif);
  edifRenderHistorial(edif);
  try{ descRender(); }catch(e){}
}

// ---- Modal asignar ----
function edifAsignarModal(edif, cortinaPresel){
  edifAsignarTarget = edif;
  document.getElementById('edif-f-tipo').value='';
  (document.getElementById('edif-f-registro')||{}).innerHTML ='<option value="">Primero selecciona tipo...</option>';
  document.getElementById('edif-f-operador').value='';
  document.getElementById('edif-f-notas').value='';
  (document.getElementById('edif-modal-title')||{}).textContent =`Asignar — ${EDIFICIOS[edif].nombre}`;

  const sel=document.getElementById('edif-f-cortina');
  sel.innerHTML='';
  const n=EDIFICIOS[edif].cortinas;
  for(let i=1;i<=n;i++){
    const libre=edifState[edif].cortinas[i].estado==='libre';
    const opt=document.createElement('option');
    opt.value=i;
    opt.textContent=`Cortina ${i}${libre?'':' ⚠️ Ocupada'}`;
    opt.disabled=!libre;
    if(cortinaPresel && parseInt(cortinaPresel)===i && libre) opt.selected=true;
    sel.appendChild(opt);
  }
  if(!cortinaPresel){
    for(let i=1;i<=n;i++){
      if(edifState[edif].cortinas[i].estado==='libre'){sel.value=i;break;}
    }
  }
  document.getElementById('modal-edif-asignar').classList.add('open');
}

function edifTipoChange(){
  const tipo=document.getElementById('edif-f-tipo').value;
  const regSel=document.getElementById('edif-f-registro');
  regSel.innerHTML='<option value="">Selecciona registro...</option>';
  if(!tipo) return;
  let opciones=[];

  if(tipo==='carga'){
    // Una opción por REFERENCIA (UL-425): al asignarla se cargan todos sus pedidos
    const src=typeof despachos!=='undefined'?despachos:[];
    const enCortina=new Set(); [12,6].forEach(e=>Object.values((edifState[e]||{}).cortinas||{}).forEach(cx=>{ if(cx&&cx.estado!=='libre'&&cx.tipo==='carga') enCortina.add(String(cx.ref||'').toUpperCase()); }));
    const g={};
    src.filter(r=>!['DESPACHADO','CARGADO'].includes(String(r.status||'').toUpperCase())&&String(r.ref||'').trim()).forEach(r=>{
      const k=String(r.ref).trim(); (g[k]=g[k]||[]).push(r);
    });
    Object.entries(g).sort((a,b)=>a[0].localeCompare(b[0],'es',{numeric:true})).forEach(([ref,rows])=>{
      if(enCortina.has(ref.toUpperCase())) return;
      const pal=rows.reduce((a,r)=>a+(parseFloat(r.pallets)||0),0), dest=[...new Set(rows.map(r=>r.dest).filter(Boolean))].join('/');
      const label=`${ref} — ${rows.length} pedido${rows.length===1?'':'s'}${pal?` · ${pal} pallets`:''}${dest?' — '+dest:''}`;
      opciones.push({val:ref,label,equipo:rows.map(r=>r.remolque).find(Boolean)||'',destOrig:dest,docId:ref});
    });
    if(!opciones.length){regSel.innerHTML='<option value="">Sin referencias programadas para cargar</option>';return;}
  } else {
    const src=typeof contenedores!=='undefined'?contenedores:[];
    // Only POSICIONADO EN BLUE, and not already assigned to a cortina in this building
    const asignados=new Set(Object.values(edifState[edifAsignarTarget]?.cortinas||{})
      .filter(cx=>cx.estado!=='libre').map(cx=>cx.ref));
    src.filter(r=>r.estado==='04-POSICIONADO EN BLUE'&&!asignados.has(r.cont)).forEach(r=>{
      const label=[r.cont,r.rc||r.doc,r.origen].filter(Boolean).join(' — ');
      opciones.push({val:r.cont||label,label,equipo:r.cont||'',destOrig:r.origen||'',docId:r.cont});
    });
    if(!opciones.length){
      regSel.innerHTML='<option value="">Sin contenedores Posicionados en Blue disponibles</option>';
      return;
    }
  }

  opciones.forEach(o=>{
    const opt=document.createElement('option');
    opt.value=o.val;
    opt.dataset.label=o.label;
    opt.dataset.equipo=o.equipo;
    opt.dataset.destOrig=o.destOrig;
    opt.dataset.docId=o.docId||'';
    opt.textContent=o.label.length>72?o.label.slice(0,72)+'…':o.label;
    regSel.appendChild(opt);
  });
}

// Carga por referencia: todos los pedidos de la referencia → En proceso de carga, edificio y cortina
function edifCargaRef(ref, edif, cortina){
  const k=String(ref||'').trim().toUpperCase(); if(!k) return 0;
  const rows=(despachos||[]).filter(r=>String(r.ref||'').trim().toUpperCase()===k && !['DESPACHADO','CARGADO'].includes(String(r.status||'').toUpperCase()));
  rows.forEach(r=>{ r.edif=String(edif); r.cortina=cortina; r.status='EN PROCESO DE CARGA'; r.fcarga=r.fcarga||new Date().toLocaleDateString('es-SV'); });
  if(rows.length) setTimeout(()=>{ try{ populateFilters(); renderDespachos(); gsSaveAll(); }catch(e){} },300);
  return rows.length;
}
function edifConfirmarAsignar(){
  const edif=edifAsignarTarget;
  const tipo=document.getElementById('edif-f-tipo').value;
  const cortina=parseInt(document.getElementById('edif-f-cortina').value);
  const regSel=document.getElementById('edif-f-registro');
  const operador=document.getElementById('edif-f-operador').value;
  const notas=document.getElementById('edif-f-notas').value;
  const regVal=regSel.value;
  const selOpt=regSel.options[regSel.selectedIndex];

  if(!tipo){alert('Selecciona el tipo de operación.');return;}
  if(!regVal){alert('Selecciona un registro.');return;}

  if(edifState[edif].cortinas[cortina].estado!=='libre'){
    const ocu=edifState[edif].cortinas[cortina];
    if(!confirm(`⚠️ Cortina ${cortina} OCUPADA con:\n"${ocu.label}"\n\n¿Agregar a la cola de espera?`)) return;
    edifState[edif].cola.push({
      tipo,ref:regVal,label:selOpt.dataset.label||regVal,
      equipo:selOpt.dataset.equipo||'',destOrig:selOpt.dataset.destOrig||'',
      operador,notas,docId:selOpt.dataset.docId||''
    });
    closeModals();
    edifRenderAll(edif);
    return;
  }

  edifState[edif].cortinas[cortina]={
    estado:'ocupada',tipo,ref:regVal,label:selOpt.dataset.label||regVal,
    inicio:Date.now(),operador,notas,minutos:0,docId:selOpt.dataset.docId||''
  };

  if(tipo==='carga') edifCargaRef(regVal, edif, cortina);
  // Auto-update contenedor to EN DESCARGA when assigned to cortina
  if(tipo==='descarga'||tipo==='Descarga'||tipo==='DESCARGA'||tipo==='desc'){
    const docId=selOpt.dataset.docId||'';
    const cont=contenedores.find(r=>r.cont===docId||r.doc===docId);
    if(cont && cont.estado==='04-POSICIONADO EN BLUE'){
      cont.estado='05-EN DESCARGA';
      renderContenedores(); actualizarMetricasCont();
      const ci=contenedores.indexOf(cont);
      const fila=GS_CAMPOS.Contenedores.map(k=>cont[k]!==undefined?cont[k]:'');
      setTimeout(()=>{ gsSaveAll(); gsSaveRow('Contenedores',fila,ci+1); },500);
    }
  }

  closeModals();
  edifRenderAll(edif);
}

// ---- Asignar desde contenedores/despachos directamente ----
function edifAsignarDesdeRegistro(tipo, val, label, equipo, destOrig, docId){
  // Show modal pre-filled
  const edif = 12; // default edificio 12
  edifAsignarTarget = edif;
  (document.getElementById('edif-modal-title')||{}).textContent =`Asignar — ${EDIFICIOS[edif].nombre}`;
  document.getElementById('edif-f-tipo').value=tipo;
  document.getElementById('edif-f-operador').value='';
  document.getElementById('edif-f-notas').value='';

  // Build cortina options
  const sel=document.getElementById('edif-f-cortina');
  sel.innerHTML='';
  const n=EDIFICIOS[edif].cortinas;
  for(let i=1;i<=n;i++){
    const libre=edifState[edif].cortinas[i].estado==='libre';
    const opt=document.createElement('option');
    opt.value=i;
    opt.textContent=`Cortina ${i}${libre?'':' ⚠️ Ocupada'}`;
    opt.disabled=!libre;
    if(i===1&&libre) opt.selected=true;
    sel.appendChild(opt);
  }
  // Auto-select first free
  for(let i=1;i<=n;i++){
    if(edifState[edif].cortinas[i].estado==='libre'){sel.value=i;break;}
  }

  // Pre-fill registro
  const regSel=document.getElementById('edif-f-registro');
  const opt=document.createElement('option');
  opt.value=val; opt.dataset.label=label; opt.dataset.equipo=equipo||'';
  opt.dataset.destOrig=destOrig||''; opt.dataset.docId=docId||'';
  opt.textContent=label.length>72?label.slice(0,72)+'…':label;
  opt.selected=true;
  regSel.innerHTML=''; regSel.appendChild(opt);

  document.getElementById('modal-edif-asignar').classList.add('open');
}

// ============================================================
// CORTINA DESDE INGRESO DE EQUIPO
// Al pasar a 04 Posicionado en Blue → asignar cortina (Edificio 12 por defecto)
// Asignar = empieza la descarga (05) · Cola = entra al liberarse una cortina
// ============================================================
const CC_EDIF_DEFAULT=12;
let ccIdx=null;
// Dónde está el contenedor: cortina ocupada o cola
function contUbicacion(r){
  if(!r||!r.cont) return null;
  for(const e of Object.keys(EDIFICIOS)){
    const cs=edifState[e].cortinas;
    for(const n of Object.keys(cs)){ if(cs[n].estado!=='libre'&&cs[n].tipo==='descarga'&&cs[n].docId===r.cont) return {tipo:'cortina',edif:+e,n:+n,inicio:cs[n].inicio}; }
    const i=edifState[e].cola.findIndex(c=>c.tipo==='descarga'&&c.docId===r.cont);
    if(i>=0) return {tipo:'cola',edif:+e,pos:i+1};
  }
  return null;
}
function contCortinaCell(r,ri){
  if(r.enviado) return '<span style="color:var(--text-hint)">—</span>';
  const u=contUbicacion(r);
  if(u&&u.tipo==='cortina'){ const min=Math.max(0,(Date.now()-u.inicio)/60000), t=descTiempos(r.origen), nv=descNivel(min,t); return `<span class="cc-chip on ${nv}" title="Descargando · meta ${descDur(t.limite)}">E${u.edif} · C${u.n}<em>${descDur(min)}</em></span>`; }
  if(u&&u.tipo==='cola') return `<span class="cc-chip cola" title="En cola de espera">E${u.edif} · cola #${u.pos}<button onclick="ccQuitarCola(${ri})" title="Quitar de la cola" aria-label="Quitar de la cola">×</button></span>`;
  if(r.estado==='04-POSICIONADO EN BLUE') return `<button class="cc-btn" onclick="ccAbrir(${ri})">Asignar cortina</button>`;
  return '<span style="color:var(--text-hint)">—</span>';
}
function ccLibres(edif){ const cs=edifState[edif].cortinas; return Object.keys(cs).filter(n=>cs[n].estado==='libre').map(Number); }
function ccAbrir(idx){
  const r=contenedores[idx]; if(!r) return;
  if(contUbicacion(r)) return;
  ccIdx=idx;
  const peds=contPedidos(r);
  document.getElementById('cc-titulo').textContent=`${r.cont} llegó a Blue`;
  document.getElementById('cc-info').innerHTML=`${impEsc(r.doc||'—')} · ${impEsc(r.origen||'—')} · ${peds.length} pedido${peds.length===1?'':'s'} · ${(+r.peso||0).toLocaleString('es-SV',{maximumFractionDigits:0})} kg`;
  document.getElementById('cc-edif').innerHTML=Object.keys(EDIFICIOS).sort((a,b)=>(+b===CC_EDIF_DEFAULT)-(+a===CC_EDIF_DEFAULT)).map(e=>`<option value="${e}">Edificio ${e} · ${ccLibres(e).length} libre${ccLibres(e).length===1?'':'s'}</option>`).join('');
  document.getElementById('cc-edif').value=String(CC_EDIF_DEFAULT);
  document.getElementById('cc-operador').value='';
  ccEdifChange();
  document.getElementById('modal-cont-cortina').classList.add('open');
}
function ccEdifChange(){
  const edif=+document.getElementById('cc-edif').value;
  const cs=edifState[edif].cortinas, libres=ccLibres(edif);
  const sel=document.getElementById('cc-cortina');
  sel.innerHTML=Object.keys(cs).map(n=>`<option value="${n}" ${cs[n].estado==='libre'?'':'disabled'}>Cortina ${n}${cs[n].estado==='libre'?' · libre':' · ocupada'}</option>`).join('');
  if(libres.length) sel.value=String(libres[0]);
  const btn=document.getElementById('cc-asignar'), msg=document.getElementById('cc-msg');
  btn.disabled=!libres.length; sel.disabled=!libres.length;
  const cola=edifState[edif].cola.length;
  msg.textContent=libres.length?'':`Todas las cortinas del Edificio ${edif} están ocupadas. Mándalo a la cola: entra solo cuando se libere una${cola?` (hay ${cola} en espera)`:''}.`;
}
function contMarcarDescarga(docId){
  const cont=contenedores.find(r=>r.cont===docId||r.doc===docId);
  if(cont && cont.estado==='04-POSICIONADO EN BLUE'){
    cont.estado='05-EN DESCARGA';
    renderContenedores(); actualizarMetricasCont();
    const ci=contenedores.indexOf(cont);
    const fila=GS_CAMPOS.Contenedores.map(k=>cont[k]!==undefined?cont[k]:'');
    setTimeout(()=>{ gsSaveAll(); gsSaveRow('Contenedores',fila,ci+1); },500);
  }
}
function ccRegistro(r){
  return {tipo:'descarga',ref:r.cont,label:[r.cont,r.rc||r.doc,r.origen].filter(Boolean).join(' — '),equipo:r.cont,destOrig:r.origen||'',
    operador:document.getElementById('cc-operador').value.trim(),notas:'',docId:r.cont};
}
function ccAsignar(){
  const r=contenedores[ccIdx]; if(!r) return;
  const edif=+document.getElementById('cc-edif').value, n=+document.getElementById('cc-cortina').value;
  if(edifState[edif].cortinas[n].estado!=='libre'){ alert('Esa cortina ya está ocupada.'); ccEdifChange(); return; }
  const g=ccRegistro(r);
  edifState[edif].cortinas[n]={estado:'ocupada',tipo:'descarga',ref:g.ref,label:g.label,inicio:Date.now(),operador:g.operador,notas:'',minutos:0,docId:g.docId};
  closeModals(); ccIdx=null;
  contMarcarDescarga(r.cont);
  edifRenderAll(edif); renderContenedores();
}
function ccCola(){
  const r=contenedores[ccIdx]; if(!r) return;
  const edif=+document.getElementById('cc-edif').value;
  edifState[edif].cola.push(ccRegistro(r));
  closeModals(); ccIdx=null;
  edifRenderAll(edif); renderContenedores();
}
function ccDespues(){ closeModals(); ccIdx=null; }
function ccQuitarCola(idx){
  const r=contenedores[idx], u=contUbicacion(r); if(!u||u.tipo!=='cola') return;
  if(!confirm(`¿Quitar ${r.cont} de la cola del Edificio ${u.edif}?\n\nQueda en 04 Posicionado en Blue, sin cortina.`)) return;
  edifState[u.edif].cola.splice(u.pos-1,1);
  edifRenderAll(u.edif); renderContenedores();
}

// ============================================================
// ALERTA DE DESCARGA EN CURSO
// Tiempo meta por origen: Colombia 4 h (granel) · resto 60 min
// Semáforo: verde en tiempo · ámbar cerca del límite · rojo pasado
// ============================================================
const DESC_TIEMPOS={ colombia:{aviso:180,limite:240}, otro:{aviso:45,limite:60} };
const DESC_TITULO_BASE=document.title;
const descAvisados=new Set();
function descTiempos(origen){ return /COLOMBIA/i.test(String(origen||''))?DESC_TIEMPOS.colombia:DESC_TIEMPOS.otro; }
function descDur(min){ min=Math.max(0,Math.floor(min)); const h=Math.floor(min/60), m=min%60; return h?`${h} h ${String(m).padStart(2,'0')} min`:`${m} min`; }
function descNivel(min,t){ return min>t.limite?'late':min>=t.aviso?'warn':'ok'; }
function descEnCurso(){
  const out=[];
  Object.keys(EDIFICIOS).forEach(e=>{
    const cs=edifState[e].cortinas;
    Object.keys(cs).forEach(n=>{
      const c=cs[n];
      if(c.estado==='libre'||c.tipo!=='descarga'||!c.inicio) return;
      const cont=(contenedores||[]).find(r=>r.cont===c.docId||r.doc===c.docId);
      const origen=cont?cont.origen:(c.destOrig||'');
      const t=descTiempos(origen), min=(Date.now()-c.inicio)/60000;
      out.push({edif:+e,n:+n,cont:c.docId||c.ref||c.label,origen,min,t,nivel:descNivel(min,t)});
    });
  });
  return out.sort((a,b)=>(b.min/b.t.limite)-(a.min/a.t.limite));
}
function descIrA(edif){ const b=document.querySelector(`[data-tab=edif${edif}]`); if(b) switchTab('edif'+edif,b); }
function descRender(){
  const bar=document.getElementById('desc-bar'); if(!bar) return;
  const lista=descEnCurso();
  document.title=lista.length?`(${lista.length}) Descargando · ${DESC_TITULO_BASE}`:DESC_TITULO_BASE;
  if(!lista.length){ bar.hidden=true; bar.innerHTML=''; return; }
  const tarde=lista.filter(x=>x.nivel==='late').length;
  bar.hidden=false;
  bar.className='desc-bar'+(tarde?' has-late':'');
  bar.innerHTML=`<span class="desc-tit">🔽 Descargando <b>${lista.length}</b>${tarde?` · <em>${tarde} fuera de tiempo</em>`:''}</span>
    <div class="desc-items">${lista.map(x=>`<button class="desc-item ${x.nivel}" onclick="descIrA(${x.edif})" title="${impEsc(x.origen||'Sin origen')} · meta ${descDur(x.t.limite)}">
      <i></i><b>${impEsc(x.cont)}</b><span>E${x.edif} · C${x.n}</span><strong>${descDur(x.min)}</strong><small>/ ${descDur(x.t.limite)}</small></button>`).join('')}</div>`;
  // Aviso único al pasar el límite
  lista.forEach(x=>{
    const k=`${x.edif}-${x.n}-${x.cont}`;
    if(x.nivel==='late'&&!descAvisados.has(k)){ descAvisados.add(k); descToast(`${x.cont} lleva ${descDur(x.min)} descargando en E${x.edif} · C${x.n}. El límite para ${/COLOMBIA/i.test(x.origen)?'Colombia':'este origen'} es ${descDur(x.t.limite)}.`,x.edif); }
  });
  // Limpia avisos de cortinas que ya se liberaron
  [...descAvisados].forEach(k=>{ if(!lista.some(x=>`${x.edif}-${x.n}-${x.cont}`===k)) descAvisados.delete(k); });
}
function descToast(msg,edif){
  let box=document.getElementById('desc-toasts');
  if(!box){ box=document.createElement('div'); box.id='desc-toasts'; box.setAttribute('role','status'); box.setAttribute('aria-live','polite'); document.body.appendChild(box); }
  const t=document.createElement('div'); t.className='desc-toast';
  t.innerHTML=`<strong>⏱ Descarga fuera de tiempo</strong><span>${impEsc(msg)}</span><div><button class="ver">Ver cortina</button><button class="cerrar">Cerrar</button></div>`;
  t.querySelector('.ver').onclick=()=>{ descIrA(edif); t.remove(); };
  t.querySelector('.cerrar').onclick=()=>t.remove();
  box.appendChild(t);
}
setInterval(()=>{ try{ descRender(); }catch(e){} },20000);

// ---- Liberar ----
function edifLiberarModal(edif, n){
  edifLiberarTarget={edif,cortina:n};
  const c=edifState[edif].cortinas[n];
  const cfg=EDIF_CONFIG[c.tipo]||EDIF_CONFIG.libre;
  (document.getElementById('edif-lib-title')||{}).textContent =`Liberar Cortina ${n} — ${EDIFICIOS[edif].nombre}`;
  (document.getElementById('edif-lib-info')||{}).innerHTML =`
    <div style="display:grid;gap:5px;font-size:13px;">
      <div><span style="color:var(--text-muted);">Operación:</span> <strong>${cfg.label}</strong></div>
      <div><span style="color:var(--text-muted);">Registro:</span> <strong>${c.label||'—'}</strong></div>
      <div><span style="color:var(--text-muted);">Inicio:</span> <strong>${new Date(c.inicio).toLocaleTimeString('es-SV',{hour:'2-digit',minute:'2-digit'})}</strong></div>
      <div><span style="color:var(--text-muted);">Duración:</span> <strong>${c.minutos} min</strong></div>
      ${c.operador?`<div><span style="color:var(--text-muted);">Operador:</span> <strong>${c.operador}</strong></div>`:''}
    </div>`;
  document.getElementById('modal-edif-liberar').classList.add('open');
}

function edifLiberarConfirmar(){
  const {edif,cortina}=edifLiberarTarget;
  const c=edifState[edif].cortinas[cortina];

  // Auto-update contenedor to DESCARGADO + fecha descarga when liberated
  if(c.docId){
    const cont = contenedores.find(r=>r.cont===c.docId||r.doc===c.docId);
    if(cont && (cont.estado==='05-EN DESCARGA'||cont.estado==='04-POSICIONADO EN BLUE')){
      cont.estado='06-DESCARGADO';
      cont.fdesc=new Date().toLocaleDateString('es-SV');
      renderContenedores(); actualizarMetricasCont();
      const ci2=contenedores.indexOf(cont);
      const fila2=GS_CAMPOS.Contenedores.map(k=>cont[k]!==undefined?cont[k]:'');
      setTimeout(()=>{ gsSaveAll(); gsSaveRow('Contenedores',fila2,ci2+1); },500);
    }
  }

  // Auto-update ALL despachos with matching ref to CARGADO
  if(c.docId||c.ref){
    const refBuscar = String(c.ref||c.docId||'').trim().toUpperCase(), idB=String(c.docId||'').trim().toUpperCase();
    // Al terminar la carga: TODOS los pedidos de la referencia pasan a CARGADO
    const desps = c.tipo==='carga' ? despachos.filter(r=>
      String(r.ref||'').trim().toUpperCase()===refBuscar || String(r.ref||'').trim().toUpperCase()===idB || String(r.dt||'').trim().toUpperCase()===idB
    ) : [];
    desps.forEach(desp=>{
      if(['PROGRAMADO','EN PROCESO DE CARGA'].includes(String(desp.status||'').toUpperCase())){
        desp.status='CARGADO';
        desp.fcarga=desp.fcarga||new Date().toLocaleDateString('es-SV');
      }
    });
    if(desps.length) setTimeout(()=>{ populateFilters(); renderDespachos(); gsSaveAll(); },300);
  }

  edifState[edif].historial.push({
    tipo:c.tipo,label:c.label,cortina,
    inicio:new Date(c.inicio).toLocaleTimeString('es-SV',{hour:'2-digit',minute:'2-digit'}),
    fin:new Date().toLocaleTimeString('es-SV',{hour:'2-digit',minute:'2-digit'}),
    duracion:c.minutos,operador:c.operador||'—',
    fecha:edifHoyISO(), ts:Date.now()
  });
  edifState[edif].cortinas[cortina]={estado:'libre',tipo:null,ref:null,label:null,inicio:null,operador:'',notas:'',minutos:0,docId:null};
  edifLiberarTarget=null;
  closeModals();
  setTimeout(()=>{ try{ renderContenedores(); }catch(e){} },0);
  // Auto-assign cola
  if(edifState[edif].cola.length){
    const next=edifState[edif].cola.shift();
    edifState[edif].cortinas[cortina]={
      estado:'ocupada',tipo:next.tipo,ref:next.ref,label:next.label,
      inicio:Date.now(),operador:next.operador||'',notas:next.notas||'',minutos:0,docId:next.docId||''
    };
    if(next.tipo==='descarga'&&next.docId) contMarcarDescarga(next.docId);
    if(next.tipo==='carga') edifCargaRef(next.ref, edif, cortina);
    setTimeout(()=>alert(`✅ Cortina ${cortina} asignada desde cola:\n"${next.label}"`),200);
  }
  edifRenderAll(edif);
}

function edifAsignarDesdeCola(edif,idx){
  const item=edifState[edif].cola[idx];
  let free=null;
  const n=EDIFICIOS[edif].cortinas;
  for(let i=1;i<=n;i++){if(edifState[edif].cortinas[i].estado==='libre'){free=i;break;}}
  if(!free){alert('⚠️ No hay cortinas libres. El registro permanece en cola.');return;}
  edifState[edif].cortinas[free]={
    estado:'ocupada',tipo:item.tipo,ref:item.ref,label:item.label,
    inicio:Date.now(),operador:item.operador||'',notas:item.notas||'',minutos:0,docId:item.docId||''
  };
  edifState[edif].cola.splice(idx,1);
  if(item.tipo==='descarga'&&item.docId) contMarcarDescarga(item.docId);
  if(item.tipo==='carga') edifCargaRef(item.ref, edif, free);
  edifRenderAll(edif);
}

function edifQuitarCola(edif,idx){
  if(confirm('¿Quitar de la cola?')){edifState[edif].cola.splice(idx,1);edifRenderCola(edif);}
}

// Clock tick — update all running timers
function edifStartClock(){
  function tick(){
    const now=new Date();
    const t=now.toLocaleTimeString('es-SV',{hour:'2-digit',minute:'2-digit',second:'2-digit'});
    const elh=document.getElementById('edif-reloj-hdr');
    if(elh) elh.textContent=now.toLocaleTimeString('es-SV',{hour:'2-digit',minute:'2-digit'});
    Object.keys(EDIFICIOS).forEach(edif=>{
      Object.keys(edifState[edif].cortinas).forEach(n=>{
        const c=edifState[edif].cortinas[n];
        if(c.estado!=='libre'&&c.inicio){
          c.minutos=Math.floor((Date.now()-c.inicio)/60000);
          const el=document.getElementById(`edif-dur-${edif}-${n}`);
          if(el) el.textContent=c.minutos;
        }
      });
      edifUpdateKPIs(edif);
    });
  }
  tick();
  setInterval(tick,1000);
}



// ============================================================
// HISTORIAL CONTENEDORES
// ============================================================
let historialCont = [];
let editContIdx = null;

function histContGetFiltered(){
  const mes=(document.getElementById('histcont-f-mes')||{}).value||'';
  const origen=(document.getElementById('histcont-f-origen')||{}).value||'';
  const q=((document.getElementById('histcont-f-q')||{}).value||'').toLowerCase();
  return historialCont.filter(r=>{
    if(mes&&r.mes!==mes) return false;
    if(origen&&r.origen!==origen) return false;
    if(q&&!String(r.cont||'').toLowerCase().includes(q)&&!String(r.doc||'').toLowerCase().includes(q)&&!String(r.rg||'').toLowerCase().includes(q)&&!String(r.rc||'').toLowerCase().includes(q)&&!contPedidos(r).some(p=>String(p.pedido).toLowerCase().includes(q)||String(p.dt||'').toLowerCase().includes(q))) return false;
    return true;
  });
}

// ── CENTRO DE MANDO ──────────────────────────────────────
function mandoDias(fechaStr){
  if(!fechaStr||fechaStr==='—'||fechaStr==='-') return null;
  const meses = {
    'ene':0,'feb':1,'mar':2,'abr':3,'may':4,'jun':5,
    'jul':6,'ago':7,'sep':8,'oct':9,'nov':10,'dic':11
  };
  // Formato: 29-dic.-2025 o 29-dic-2025
  const m = fechaStr.match(/(\d{1,2})-([a-záéíóú]+)\.?-(\d{4})/i);
  if(m){
    const mes = meses[m[2].toLowerCase().substring(0,3)];
    if(mes===undefined) return null;
    const d = new Date(parseInt(m[3]), mes, parseInt(m[1]));
    if(isNaN(d)) return null;
    return Math.floor((Date.now()-d.getTime())/(1000*60*60*24));
  }
  // Formato: dd-mm-yyyy
  const parts = fechaStr.split('-');
  if(parts.length===3&&parts[2].length===4){
    const d = new Date(parseInt(parts[2]), parseInt(parts[1])-1, parseInt(parts[0]));
    if(isNaN(d)) return null;
    return Math.floor((Date.now()-d.getTime())/(1000*60*60*24));
  }
  return null;
}

function mandoTarjeta(estado, color, datos, tipo){
  const id = 'mando-card-'+estado.replace(/[^a-z0-9]/gi,'');
  return `<div id="${id}" onclick="mandoDetalle('${estado}','${color}','${tipo}')"
    style="background:var(--surface);border:1px solid var(--border);border-radius:10px;padding:14px;text-align:center;cursor:pointer;transition:border-color 0.15s;"
    onmouseover="this.style.borderColor='${color}'" onmouseout="this.style.borderColor='var(--border)'">
    <div style="width:32px;height:32px;border-radius:50%;background:${color}20;border:1.5px solid ${color}60;margin:0 auto 10px;display:flex;align-items:center;justify-content:center;">
      <div style="width:10px;height:10px;border-radius:50%;background:${color};"></div>
    </div>
    <p style="font-size:11px;color:var(--text-hint);margin:0 0 3px;">${estado}</p>
    <p style="font-size:28px;font-weight:600;color:${color};margin:0;">${datos.length}</p>
    <p style="font-size:10px;color:var(--text-hint);margin:5px 0 0;">ver detalle</p>
  </div>`;
}

function mandoDetalle(estado, color, tipo){
  const panel = document.getElementById('mando-detalle');
  document.getElementById('mando-detalle-titulo').textContent = estado + ' — ' + mandoGetDatos(estado, tipo).length + ' registro(s)';
  const datos = mandoGetDatos(estado, tipo);
  let html = '';
  if(tipo==='ingreso'){
    html += `<div style="display:flex;gap:16px;margin-bottom:6px;font-size:10px;color:var(--text-hint);letter-spacing:0.06em;">
      <span style="min-width:120px;">DOC. TRANSPORTE</span><span style="min-width:140px;">CONTENEDOR</span><span style="min-width:100px;">ORIGEN</span><span>DÍAS EN PUERTO</span>
    </div>`;
    datos.forEach(r=>{
      const dias = mandoDias(r.eta_pto);
      const diasStr = (dias!==null&&!r.fdesc) ? `<span style="color:${dias>=4?'#A32D2D':'#854F0B'};font-weight:600;">${dias}d</span>` : '—';
      html += `<div style="padding:6px 0;border-bottom:0.5px solid var(--border);display:flex;gap:16px;align-items:center;">
        <span style="min-width:120px;color:${color};">${r.doc||'—'}</span>
        <span style="min-width:140px;">${r.cont||'—'}</span>
        <span style="min-width:100px;">${r.origen||'—'}</span>
        <span>${diasStr}</span>
      </div>`;
    });
  } else {
    html += `<div style="display:flex;gap:16px;margin-bottom:6px;font-size:10px;color:var(--text-hint);letter-spacing:0.06em;">
      <span style="min-width:120px;">REFERENCIA</span><span style="min-width:120px;">DESTINO</span><span>DÍAS SIN POSICIONAR</span>
    </div>`;
    datos.forEach(r=>{
      const sinRemolque = !r.remolque||r.remolque==='—'||r.remolque==='';
      const dias = mandoDias(r.fsolicitud);
      const diasStr = (dias!==null&&sinRemolque) ? `<span style="color:${dias>=3?'#A32D2D':'#854F0B'};font-weight:600;">${dias}d</span>` : '—';
      html += `<div style="padding:6px 0;border-bottom:0.5px solid var(--border);display:flex;gap:16px;align-items:center;">
        <span style="min-width:120px;color:${color};">${r.ref||'—'}</span>
        <span style="min-width:120px;">${r.dest||'—'}</span>
        <span>${diasStr}</span>
      </div>`;
    });
  }
  document.getElementById('mando-detalle-lista').innerHTML = html;
  panel.style.display = 'block';
  document.getElementById('mando-reporte').style.display = 'none';
}

function mandoGetDatos(estado, tipo){
  if(tipo==='ingreso'){
    const mapa = {
      'En ruta':                ['01-TRÁNSITO MARÍTIMO'],
      'En puerto':              ['02-LLEGADA A PUERTO'],
      'Tramitando en puerto':   ['02-TRAMITANDO EN PUERTO'],
      'En tránsito terrestre':  ['03-EN TRÁNSITO TERRESTRE'],
      'En Blue':                ['04-POSICIONADO EN BLUE'],
      'En descarga':            ['05-EN DESCARGA','06-DESCARGADO'],
    };
    const estados = mapa[estado]||[];
    return contenedores.filter(r=>estados.includes(r.estado));
  } else {
    const mapa = {
      'Programados':         ['PROGRAMADO'],
      'En Blue':             ['NO PROGRAMADO'],
      'En proceso de carga': ['EN PROCESO DE CARGA'],
      'Despachados hoy':     ['CARGADO','DESPACHADO']
    };
    const statuses = mapa[estado]||[];
    return despachos.filter(r=>statuses.includes(r.status));
  }
}

let mandoClock;
function renderMando(){
  const grupos_ingresos = [
    {estado:'Tramitando en puerto',  color:'#854F0B'},
    {estado:'En tránsito terrestre', color:'#0F6E56'},
    {estado:'En Blue',               color:'#A32D2D'},
    {estado:'En descarga',           color:'#993C1D'},
  ];
  const grupos_ingresos_ruta = [
    {estado:'En ruta', color:'#185FA5'},
  ];
  const grupos_despachos = [
    {estado:'Programados', color:'#534AB7'},
    {estado:'En Blue', color:'#A32D2D'},
    {estado:'En proceso de carga', color:'#854F0B'},
    {estado:'Despachados hoy', color:'#3B6D11'},
  ];
  document.getElementById('mando-grid-ingresos').innerHTML =
    grupos_ingresos.map(g=>mandoTarjeta(g.estado, g.color, mandoGetDatos(g.estado,'ingreso'), 'ingreso')).join('');
  document.getElementById('mando-grid-despachos').innerHTML =
    grupos_despachos.map(g=>mandoTarjeta(g.estado, g.color, mandoGetDatos(g.estado,'despacho'), 'despacho')).join('');

  // En ruta — oculto por defecto
  const rutaDiv = document.getElementById('mando-ruta-section');
  const rutaGrid = document.getElementById('mando-grid-ruta');
  if(rutaGrid){
    rutaGrid.innerHTML = grupos_ingresos_ruta.map(g=>mandoTarjeta(g.estado, g.color, mandoGetDatos(g.estado,'ingreso'), 'ingreso')).join('');
  }
  if(rutaDiv) rutaDiv.style.display='none';
  const btnRuta = document.getElementById('mando-btn-ruta');
  if(btnRuta){
    const cnt = mandoGetDatos('En ruta','ingreso').length;
    btnRuta.textContent = `🌊 Mostrar En ruta (${cnt})`;
    btnRuta.onclick = ()=>{
      const visible = rutaDiv.style.display!=='none';
      rutaDiv.style.display = visible?'none':'block';
      btnRuta.textContent = visible?`🌊 Mostrar En ruta (${cnt})`:`🌊 Ocultar En ruta`;
    };
  }
  if(mandoClock) clearInterval(mandoClock);
  mandoClock = setInterval(()=>{
    const el=document.getElementById('mando-hora');
    if(el) el.textContent=new Date().toLocaleString('es-SV',{weekday:'long',day:'2-digit',month:'short',hour:'2-digit',minute:'2-digit'});
  },1000);
  const el=document.getElementById('mando-hora');
  if(el) el.textContent=new Date().toLocaleString('es-SV',{weekday:'long',day:'2-digit',month:'short',hour:'2-digit',minute:'2-digit'});
}

function generarReporteMando(){
  const fecha = new Date().toLocaleString('es-SV',{weekday:'long',day:'2-digit',month:'long',year:'numeric',hour:'2-digit',minute:'2-digit'});
  let txt = `REPORTE OPERATIVO — BLUE LOGISTICS\n${fecha}\n${'─'.repeat(55)}\n\n`;
  txt += `EQUIPOS EN TRÁNSITO\n${'─'.repeat(55)}\n`;
  [
    {estado:'Tramitando en puerto',  label:'TRAMITANDO EN PUERTO'},
    {estado:'En tránsito terrestre', label:'EN TRÁNSITO TERRESTRE'},
    {estado:'En Blue',               label:'EN BLUE'},
    {estado:'En descarga',           label:'EN DESCARGA'},
  ].forEach(g=>{
    const datos = mandoGetDatos(g.estado,'ingreso');
    if(!datos.length) return;
    txt += `\n${g.label} (${datos.length})\n`;
    txt += `  ${'DOC. TRANSPORTE'.padEnd(22)} ${'CONTENEDOR'.padEnd(16)} ${'ORIGEN'.padEnd(14)} DÍAS EN PUERTO\n`;
    datos.forEach(r=>{
      const dias = mandoDias(r.eta_pto);
      const diasStr = (dias!==null&&(!r.fdesc||r.fdesc==='—'))?`${dias}d`:'—';
      txt += `  ${(r.doc||'—').padEnd(22)} ${(r.cont||'—').padEnd(16)} ${(r.origen||'—').padEnd(14)} ${diasStr}\n`;
    });
  });
  txt += `\n\nDESPACHOS\n${'─'.repeat(55)}\n`;
  [
    {estado:'Programados',         label:'PROGRAMADOS'},
    {estado:'En Blue',             label:'EN BLUE'},
    {estado:'En proceso de carga', label:'EN PROCESO DE CARGA'},
    {estado:'Despachados hoy',     label:'DESPACHADOS HOY'},
  ].forEach(g=>{
    const datos = mandoGetDatos(g.estado,'despacho');
    if(!datos.length) return;
    txt += `\n${g.label} (${datos.length})\n`;
    datos.forEach(r=>{
      const sinRemolque = !r.remolque||r.remolque==='—'||r.remolque==='';
      const dias = sinRemolque ? mandoDias(r.fsolicitud) : null;
      const diasStr = dias!==null ? ` | ${dias}d sin posicionar` : '';
      txt += `  ${(r.ref||'—').padEnd(14)} ${r.dest||'—'}${diasStr}\n`;
    });
  });
  document.getElementById('mando-reporte-txt').textContent = txt;
  document.getElementById('mando-reporte').style.display = 'block';
  document.getElementById('mando-detalle').style.display = 'none';
}

function copiarReporteMando(){
  navigator.clipboard.writeText(document.getElementById('mando-reporte-txt').textContent).then(()=>{
    const btn = document.getElementById('mando-btn-copiar');
    btn.textContent = '✓ Copiado';
    setTimeout(()=>btn.textContent='📋 Copiar', 2000);
  });
}
// ── FIN CENTRO DE MANDO ──────────────────────────────────

function renderHistorialCont(){
  const f=histContGetFiltered();
  const badge=document.getElementById('tab-count-histcont');
  if(badge) badge.textContent=historialCont.length;
  const eid=(id,v)=>{const e=document.getElementById(id);if(e)e.textContent=v;};
  const peso=historialCont.reduce((a,r)=>a+r.peso,0);
  eid('histcont-kpi-total', historialCont.length);
  eid('histcont-kpi-peso', (peso/1000).toLocaleString('es-SV',{minimumFractionDigits:2,maximumFractionDigits:2}));
  eid('histcont-kpi-br', historialCont.filter(r=>r.origen==='BRASIL').length);
  eid('histcont-kpi-co', historialCont.filter(r=>r.origen==='COLOMBIA').length);
  eid('histcont-kpi-de', historialCont.filter(r=>r.origen==='ALEMANIA').length);
  eid('histcont-kpi-otros', historialCont.filter(r=>!['BRASIL','COLOMBIA','ALEMANIA'].includes(r.origen)).length);
  // Populate filters
  const meses=[...new Set(historialCont.map(r=>r.mes))];
  const origenes=[...new Set(historialCont.map(r=>r.origen))];
  const mSel=document.getElementById('histcont-f-mes'),oSel=document.getElementById('histcont-f-origen');
  if(mSel){const mv=mSel.value;mSel.innerHTML='<option value="">Todos los meses</option>'+meses.map(m=>`<option${m===mv?' selected':''}>${m}</option>`).join('');}
  if(oSel){const ov=oSel.value;oSel.innerHTML='<option value="">Todos los orígenes</option>'+origenes.map(o=>`<option${o===ov?' selected':''}>${o}</option>`).join('');}
  const cl=document.getElementById('histcont-count-label');
  if(cl) cl.textContent=f.length+' de '+historialCont.length+' registros';
  const tbody=document.getElementById('histcont-tbody');
  if(!tbody) return;
  if(!f.length){
    tbody.innerHTML='<tr><td colspan="21"><div class="empty"><strong>Sin registros archivados</strong></div></td></tr>';
    return;
  }
  const pedidoCell=v=>(!v||v==='-')?'<span style="color:var(--text-hint);">—</span>':`<span style="font-family:var(--mono);font-size:11px;">${v}</span>`;
  tbody.innerHTML=f.map(r=>{
    const hi=historialCont.indexOf(r);
    return`<tr style="opacity:.78;">
      <td style="color:var(--text-muted);">${r.mes}</td>
      <td class="mono" style="font-size:11px;max-width:130px;overflow:hidden;text-overflow:ellipsis;" title="${r.doc}">${r.doc}</td>
      <td style="font-weight:600;font-family:var(--mono);font-size:12px;">${r.cont}</td>
      <td class="mono" style="font-size:11px;">${r.eta_pto||'—'}</td>
      <td class="mono" style="font-size:11px;">${r.eta_blue||'—'}</td>
      <td class="num">${r.cant?r.cant.toLocaleString('es-SV'):'—'}</td>
      <td class="num">${r.peso?r.peso.toLocaleString('es-SV',{minimumFractionDigits:2,maximumFractionDigits:2}):'—'}</td>
      <td style="font-size:12px;">${r.origen||'—'}</td>
      <td><span class="badge s-cargado" style="font-size:10px;">${r.estado||'—'}</span></td>
      <td><span class="badge s-cargado" style="font-size:10px;">${r.flete||'—'}</span></td>
      <td style="font-size:11px;">${r.bl||'—'}</td>
      <td class="mono" style="font-size:11px;">${r.rc||'—'}</td>
      <td class="mono" style="font-size:11px;">${r.fdesc||'—'}</td>
      <td class="mono" style="font-size:11px;color:var(--text-hint);">${r.fechaEnvioNP||'—'}</td>
      <td style="text-align:center;">${pedidoCell(r.sv)}</td>
      <td style="text-align:center;">${pedidoCell(r.hn)}</td>
      <td style="text-align:center;">${pedidoCell(r.cr)}</td>
      <td style="text-align:center;">${pedidoCell(r.ni)}</td>
      <td style="text-align:center;">${pedidoCell(r.gt)}</td>
      <td style="text-align:center;">${pedidoCell(r.pa)}</td>
      <td>
        <button onclick="histContRestaurar(${hi})" style="font-size:10px;padding:3px 8px;border-radius:5px;border:1px solid #C7D2FE;background:#EEF2FF;color:#3730A3;cursor:pointer;font-family:var(--sans);font-weight:600;">↩ Restaurar</button>
      </td>
    </tr>`;
  }).join('');
}

function histContRestaurar(hi){
  const r=historialCont[hi];
  if(!r) return;
  if(!confirm(`↩ Restaurar equipo a Ingreso de Equipo:\n\n${r.cont} — ${r.doc}\n\n¿Confirmar?`)) return;
  const restored={...r};
  delete restored.fechaEnvioNP;
  restored.enviado=false;
  contenedores.push(restored);
  historialCont.splice(hi,1);
  renderHistorialCont();
  renderContenedores();
  const contTab=document.querySelector('.op-tab[data-tab="contenedores"]');
  if(contTab) contTab.click();
  alert('✅ Equipo restaurado a Ingreso de Equipo.');
}

function histContClearFilters(){
  ['histcont-f-mes','histcont-f-origen','histcont-f-q'].forEach(id=>{const e=document.getElementById(id);if(e)e.value='';});
  renderHistorialCont();
}

function exportHistContCSV(){
  if(!historialCont.length){alert('No hay registros en el historial.');return;}
  const header='Mes,Doc.Transporte,Contenedor,ETA Puerto,ETA Blue,Cant,Peso,Origen,Estado,Flete,BL,RC,F.Descarga,F.EnvioNP,SV,HN,CR,NI,GT,PA';
  const rows=historialCont.map(r=>[r.mes,r.doc,r.cont,r.eta_pto,r.eta_blue,r.cant,r.peso,r.origen,r.estado,r.flete,r.bl,r.rc,r.fdesc,r.fechaEnvioNP||'',r.sv,r.hn,r.cr,r.ni,r.gt,r.pa].map(v=>`"${v||''}"`).join(','));
  const blob=new Blob(['\uFEFF'+header+'\n'+rows.join('\n')],{type:'text/csv;charset=utf-8'});
  const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='historial_contenedores_'+new Date().toISOString().slice(0,10)+'.csv';a.click();
}

['histcont-f-mes','histcont-f-origen','histcont-f-q'].forEach(id=>{
  const el=document.getElementById(id);
  if(el) el.addEventListener(el.tagName==='SELECT'?'change':'input',renderHistorialCont);
});

// ── Modal Nuevo/Editar Contenedor ──
// ============================================================
// PEDIDOS DEL CONTENEDOR — lista (varios pedidos por país, con DT)
// Compatible con el formato anterior de una casilla por país
// ============================================================
const CONT_PAISES=['sv','hn','cr','ni','gt','pa'];
const CONT_PAIS_INFO={sv:{l:'El Salvador',c:'#A32D2D'},hn:{l:'Honduras',c:'#7A1F5A'},cr:{l:'Costa Rica',c:'#185FA5'},ni:{l:'Nicaragua',c:'#3B6D11'},gt:{l:'Guatemala',c:'#854F0B'},pa:{l:'Panamá',c:'#0F6E56'}};
function contVacio(v){ const s=String(v==null?'':v).trim(); return !s||s==='-'||s==='—'; }
function contPedidos(r){
  if(!r) return [];
  if(Array.isArray(r.pedidos)) return r.pedidos;
  if(r.pedidos_json){ try{ const a=JSON.parse(r.pedidos_json); if(Array.isArray(a)){ r.pedidos=a; return a; } }catch(e){} }
  const a=[];
  CONT_PAISES.forEach(k=>{
    if(contVacio(r[k])) return;
    String(r[k]).split(/\s*[,;]\s*/).filter(Boolean).forEach((p,i)=>a.push({pais:k,dt:'',pedido:p,bultos:i===0?(+r[k+'_bultos']||0):0,peso:i===0?(+r[k+'_peso']||0):0}));
  });
  return a;
}
// Guarda la lista y deja sincronizadas las casillas por país (tabla, filtros, dashboard)
function contSetPedidos(r,lista){
  r.pedidos=lista;
  r.pedidos_json=JSON.stringify(lista);
  CONT_PAISES.forEach(k=>{
    const ps=lista.filter(p=>p.pais===k);
    r[k]=ps.length?ps.map(p=>p.pedido).join(', '):'-';
    r[k+'_bultos']=ps.reduce((a,p)=>a+(+p.bultos||0),0);
    r[k+'_peso']=Math.round(ps.reduce((a,p)=>a+(+p.peso||0),0)*1000)/1000;
  });
  return r;
}
function contFmtFecha(d){
  if(!d) return '—';
  return d.toLocaleDateString('es-SV',{day:'2-digit',month:'short',year:'numeric'}).replace(/ /g,'-');
}

// ---------- editor de pedidos en la ficha ----------
function contPedFila(p){
  p=p||{pais:'',dt:'',pedido:'',bultos:'',peso:''};
  const opts=CONT_PAISES.map(k=>`<option value="${k}"${p.pais===k?' selected':''}>${k.toUpperCase()} — ${CONT_PAIS_INFO[k].l}</option>`).join('');
  const esc=v=>String(v==null?'':v).replace(/"/g,'&quot;');
  const extra={}; Object.keys(p).forEach(k=>{ if(!['pais','dt','pedido','bultos','peso'].includes(k)&&p[k]!=null&&p[k]!=='') extra[k]=p[k]; });
  return `<div class="cped-grid cped-row" data-salida="${esc(p.salida||'')}" data-extra="${esc(JSON.stringify(extra))}">
    <select class="cp-pais" aria-label="País"><option value="">País</option>${opts}</select>
    <input class="cp-dt" type="text" placeholder="0015-01-24" value="${esc(p.dt)}" aria-label="DT">
    <input class="cp-ped" type="text" placeholder="No. pedido" value="${esc(p.pedido)}" aria-label="No. de pedido">
    <input class="cp-bul" type="number" min="0" placeholder="0" value="${esc(p.bultos||'')}" oninput="contPedTotales()" aria-label="Bultos">
    <input class="cp-peso" type="number" min="0" step="0.01" placeholder="0.00" value="${esc(p.peso||'')}" oninput="contPedTotales()" aria-label="Peso kg">
    <button type="button" class="cped-del" onclick="contPedQuitar(this)" title="Quitar pedido" aria-label="Quitar pedido">×</button>
  </div>`;
}
function contPedRender(lista){
  const el=document.getElementById('c-ped-rows');
  el.innerHTML=(lista&&lista.length?lista:[null]).map(contPedFila).join('');
  contPedTotales();
}
function contPedAgregar(){
  const el=document.getElementById('c-ped-rows');
  const ult=el.querySelector('.cped-row:last-child .cp-pais');
  el.insertAdjacentHTML('beforeend',contPedFila({pais:ult?ult.value:''}));
  const nuevo=el.querySelector('.cped-row:last-child .cp-ped'); if(nuevo) nuevo.focus();
}
function contPedQuitar(btn){
  const el=document.getElementById('c-ped-rows');
  btn.closest('.cped-row').remove();
  if(!el.querySelector('.cped-row')) el.innerHTML=contPedFila(null);
  contPedTotales();
}
function contPedLeer(){
  return [...document.querySelectorAll('#c-ped-rows .cped-row')].map(row=>({
    ...(()=>{ try{ return JSON.parse(row.dataset.extra||'{}'); }catch(e){ return {}; } })(),
    pais:row.querySelector('.cp-pais').value,
    dt:row.querySelector('.cp-dt').value.trim(),
    pedido:row.querySelector('.cp-ped').value.trim(),
    bultos:parseInt(row.querySelector('.cp-bul').value)||0,
    peso:parseFloat(row.querySelector('.cp-peso').value)||0
  })).filter(p=>p.pais||p.dt||p.pedido||p.bultos||p.peso);
}
// Totales en vivo de bultos/peso en la ficha
function contPedTotales(){
  const lista=document.getElementById('c-ped-rows')?contPedLeer():[];
  const b=lista.reduce((a,p)=>a+p.bultos,0), p=lista.reduce((a,x)=>a+x.peso,0);
  const pc=parseFloat((document.getElementById('c-peso')||{}).value)||0;
  const eb=document.getElementById('c-ped-bultos'), ep=document.getElementById('c-ped-peso'), em=document.getElementById('c-ped-msg');
  if(eb) eb.textContent=b.toLocaleString('es-SV');
  if(ep) ep.textContent=p.toLocaleString('es-SV',{minimumFractionDigits:2,maximumFractionDigits:2});
  if(!em) return;
  em.textContent=`${lista.length} pedido${lista.length===1?'':'s'}`; em.style.color='';
  if(!p||!pc){ ep.style.color=''; return; }
  const dif=pc-p;
  if(Math.abs(dif)<=1){ em.textContent+=' · ✓ cuadra'; em.style.color='#15803D'; ep.style.color='#15803D'; }
  else { em.textContent+=` · ${dif>0?'faltan':'sobran'} ${Math.abs(dif).toLocaleString('es-SV',{maximumFractionDigits:2})} kg`; em.style.color='#B45309'; ep.style.color='#B45309'; }
}

// ============================================================
// PEDIDOS Y DT ÚNICOS EN TODO EL HUB
// Un pedido/DT vive en una sola ficha por etapa. El mismo pedido puede
// avanzar Ingreso → NP → Despacho → Historial, pero nunca duplicarse.
// ============================================================
function hubNormPed(v){ const s=String(v==null?'':v).trim().toUpperCase(); return contVacio(s)?'':s; }
function hubNormDT(v){ const s=String(v==null?'':v).trim().toUpperCase().replace(/^DT[-\s]*/,''); return contVacio(s)?'':s; }
// Unidades extra de un mismo DT: 0125-01-24-A, -B… (mismo pedido, otra unidad)
function hubDtBase(d){ return String(d||'').replace(/-[A-Z]$/,''); }
function hubSiguienteUnidad(dtOriginal){
  const base=hubDtBase(hubNormDT(dtOriginal));
  const usados=new Set(hubRegistro().map(e=>e.dt).filter(d=>hubDtBase(d)===base));
  for(const L of 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'){ if(!usados.has(base+'-'+L)) return String(dtOriginal).trim().replace(/-[A-Z]$/i,'')+'-'+L; }
  return '';
}
function hubRegistro(){
  const out=[], vistos=new Set();
  [...contenedores,...historialCont].forEach(r=>{
    const key=(String(r.cont||'')+'|'+String(r.doc||'')).toUpperCase();
    if(vistos.has(key)) return; vistos.add(key);
    contPedidos(r).forEach(p=>out.push({etapa:'ingreso',obj:r,key,pedido:hubNormPed(p.pedido),dt:hubNormDT(p.dt),donde:`Ingreso de Equipo (${r.cont||'—'})`}));
  });
  noProg.forEach(r=>out.push({etapa:'np',obj:r,pedido:hubNormPed(r.pedido),dt:hubNormDT(r.dt),donde:'Pedidos No Programados'}));
  despachos.forEach(r=>out.push({etapa:'desp',obj:r,pedido:hubNormPed(r.no_pedido),dt:hubNormDT(r.dt),donde:`Pedidos en Despacho${r.ref?' ('+r.ref+')':''}`}));
  historial.forEach(r=>out.push({etapa:'hist',obj:r,pedido:hubNormPed(r.no_pedido),dt:hubNormDT(r.dt),donde:`Historial de Despachos${r.ref?' ('+r.ref+')':''}`}));
  return out;
}
// items: [{pedido,dt}] · etapas donde buscar · excluir(e): registros propios que no cuentan
function hubDuplicados(items, etapas, excluir){
  const reg=hubRegistro().filter(e=>etapas.includes(e.etapa)&&!(excluir&&excluir(e)));
  const msgs=[], sp={}, sd={};
  items.forEach(it=>{
    const p=hubNormPed(it.pedido), d=hubNormDT(it.dt);
    if(p){ if(sp[p]) msgs.push(`Pedido ${p} está repetido en la lista`); sp[p]=1;
      const e=reg.find(x=>x.pedido===p&&!(d&&x.dt&&x.dt!==d&&hubDtBase(x.dt)===hubDtBase(d)));
      if(e) msgs.push(`Pedido ${p} ya existe en ${e.donde}`); }
    if(d){ if(sd[d]) msgs.push(`DT ${d} está repetido en la lista`); sd[d]=1;
      const e=reg.find(x=>x.dt===d); if(e) msgs.push(`DT ${d} ya existe en ${e.donde}`); }
  });
  return [...new Set(msgs)];
}
// Solo los valores que cambiaron respecto a la ficha anterior (los que ya tenía siguen siendo suyos)
function hubCambiados(items, prevItems){
  const pp=new Set(prevItems.map(x=>hubNormPed(x.pedido)).filter(Boolean)), pd=new Set(prevItems.map(x=>hubNormDT(x.dt)).filter(Boolean));
  return items.map(it=>({pedido:pp.has(hubNormPed(it.pedido))?'':it.pedido, dt:pd.has(hubNormDT(it.dt))?'':it.dt}));
}
function hubAvisoDup(msgs, titulo){
  alert(`🔒 ${titulo||'No se puede guardar'}\n\nNo se puede repetir pedido ni DT:\n\n• ${msgs.slice(0,12).join('\n• ')}${msgs.length>12?`\n• … y ${msgs.length-12} más`:''}`);
}

// ============================================================
// PEGAR AVISO DE EMBARQUE (filas copiadas del Excel)
// OT · PO · Manifiesto · Contenedor · Consignatario · ETA Puerto · ETA Blue · Origen · Bultos · Peso · Valor SAP · RG
// ============================================================
let pasteData=null, pasteTimer=null;
const PASTE_COLS=[
  {k:'ot',   al:['OT']},
  {k:'po',   al:['PO','PEDIDO','NO. PEDIDO','NO PEDIDO']},
  {k:'man',  al:['MANIFIESTO','DOC. TRANSPORTE','DOC TRANSPORTE','BL']},
  {k:'cont', al:['CONTENEDOR','EQUIPO']},
  {k:'con',  al:['CONSIGNATARIO','CLIENTE','DESTINO','PAIS']},
  {k:'etap', al:['ETA PUERTO','ETA PTO']},
  {k:'etab', al:['ETA BLUE']},
  {k:'ori',  al:['ORIGEN','ORIEGN','ORIGIN']},
  {k:'bul',  al:['BULTOS','NO. BULTOS','CAJAS']},
  {k:'peso', al:['PESO','PESO KG','KG']},
  {k:'val',  al:['VALOR SAP','VALOR']},
  {k:'rg',   al:['RG']},
  {k:'rc',   al:['RC','NO. RC','NO RC','N° RC','NUM RC','NUMERO RC']}
];
function pasteNum(v){ const n=parseFloat(String(v==null?'':v).replace(/[$\s]/g,'').replace(/,/g,'')); return isFinite(n)?n:0; }
// Fechas sin año ("04-nov"): año actual; si ya pasó hace más de 60 días, el siguiente
function pasteFecha(v){
  const s=String(v||'').trim(); if(!s) return null;
  const d=dgFecha(s); if(d) return d;
  const hoy=dgHoy(); let m, dd, mm;
  if((m=s.match(/^(\d{1,2})[-\s\/]([a-záéíóú]{3,5})\.?$/i))){ mm=DG_MES_ABR[m[2].toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g,'').slice(0,3)]; dd=+m[1]; }
  else if((m=s.match(/^(\d{1,2})[\/-](\d{1,2})$/))){ dd=+m[1]; mm=+m[2]-1; }
  if(mm==null||!dd) return null;
  let f=new Date(hoy.getFullYear(),mm,dd);
  if((hoy-f)/86400000>60) f=new Date(hoy.getFullYear()+1,mm,dd);
  return f;
}
function pasteAnalizarDiferido(){ clearTimeout(pasteTimer); pasteTimer=setTimeout(pasteAnalizar,250); }
function pasteAnalizar(){
  const txt=document.getElementById('c-paste').value;
  const res=document.getElementById('c-paste-res');
  pasteData=null;
  if(!txt.trim()){ res.innerHTML=''; return; }
  let lineas=txt.replace(/\r/g,'').split('\n').filter(l=>l.trim());
  const sep=lineas.some(l=>l.includes('\t'))?'\t':/\s{2,}/;
  let filas=lineas.map(l=>l.split(sep).map(c=>c.trim()));
  // Encabezados (si vienen); si no, orden estándar del aviso
  let idx={};
  const h=filas[0].map(impNorm);
  const tieneHdr=h.some(x=>x==='PO'||x==='CONTENEDOR'||x==='CONSIGNATARIO');
  if(tieneHdr){ PASTE_COLS.forEach(c=>{ const i=h.findIndex(x=>c.al.includes(x)); if(i>=0) idx[c.k]=i; }); filas=filas.slice(1); }
  else PASTE_COLS.forEach((c,i)=>idx[c.k]=i);
  const faltan=['po','cont','con'].filter(k=>idx[k]==null);
  if(faltan.length){ res.innerHTML=`<div class="paste-msg err">No reconozco las columnas ${faltan.map(k=>({po:'PO',cont:'Contenedor',con:'Consignatario'}[k])).join(', ')}. Copia las filas con su encabezado.</div>`; return; }
  const g=(f,k)=>idx[k]!=null?(f[idx[k]]||''):'';
  // Lo que ya existe en el HUB
  const existe=new Set(), contAct=new Set();
  [...contenedores,...historialCont].forEach(r=>contPedidos(r).forEach(p=>existe.add(impNorm(p.pedido))));
  noProg.forEach(r=>existe.add(impNorm(r.pedido))); [...despachos,...historial].forEach(r=>existe.add(impNorm(r.no_pedido)));
  contenedores.forEach(r=>{ if(!r.enviado) contAct.add(impNorm(r.cont)); });
  const grupos={}, errores=[], vistosPO=new Set();
  filas.forEach((f,i)=>{
    const po=g(f,'po'), cont=impNorm(g(f,'cont')), pais=impPaisKey(g(f,'con'));
    if(!po&&!cont) return;
    if(!po){ errores.push(`Fila ${i+1}: sin PO`); return; }
    if(!pais){ errores.push(`PO ${po}: país no reconocido (${g(f,'con')||'sin consignatario'})`); return; }
    const key=cont||impNorm(g(f,'man'));
    if(!key){ errores.push(`PO ${po}: sin contenedor ni manifiesto`); return; }
    const gr=grupos[key]=grupos[key]||{cont,man:g(f,'man'),etap:null,etab:null,ori:'',rgs:new Set(),rcs:new Set(),peds:[],dup:contAct.has(cont)};
    const etap=pasteFecha(g(f,'etap')), etab=pasteFecha(g(f,'etab'));
    if(etap&&(!gr.etap||etap<gr.etap)) gr.etap=etap;
    if(etab&&(!gr.etab||etab<gr.etab)) gr.etab=etab;
    if(!gr.ori&&g(f,'ori')) gr.ori=impNorm(g(f,'ori'));
    if(g(f,'rg')) gr.rgs.add(g(f,'rg'));
    if(g(f,'rc')) gr.rcs.add(g(f,'rc'));
    gr.peds.push({pais,dt:'',pedido:po,bultos:pasteNum(g(f,'bul')),peso:pasteNum(g(f,'peso')),
      ...(g(f,'ot')?{ot:g(f,'ot')}:{}),...(g(f,'val')?{valor:pasteNum(g(f,'val'))}:{}),
      dup:existe.has(impNorm(po))||vistosPO.has(impNorm(po)), dupMotivo:existe.has(impNorm(po))?'ya existe en el HUB':(vistosPO.has(impNorm(po))?'repetido en lo pegado':'')});
    vistosPO.add(impNorm(po));
  });
  const conts=Object.values(grupos);
  pasteData={conts,errores};
  if(!conts.length){ res.innerHTML=`<div class="paste-msg err">No encontré pedidos en el texto.${errores.length?'<br>'+errores.map(impEsc).join('<br>'):''}</div>`; return; }
  const fmtF=d=>d?`${String(d.getDate()).padStart(2,'0')}/${String(d.getMonth()+1).padStart(2,'0')}/${d.getFullYear()}`:'—';
  const pill=p=>`<span class="imp-ped ${p.dup?'dup':''}" title="${p.ot?'OT '+impEsc(p.ot)+' · ':''}${dgFmt(p.bultos)} bultos · ${dgFmt(p.peso,2)} kg${p.dup?' · '+(p.dupMotivo||'duplicado'):''}"><i style="background:${CONT_PAIS_INFO[p.pais].c}"></i>${p.pais.toUpperCase()} ${impEsc(p.pedido)}</span>`;
  const dupMsgs=pasteDuplicados(conts);
  const crear=dupMsgs.length?[]:conts;
  res.innerHTML=`<div class="paste-list">${conts.map(c=>{
      const kg=c.peds.reduce((a,p)=>a+p.peso,0), val=c.peds.reduce((a,p)=>a+(p.valor||0),0);
      return `<div class="paste-cont ${c.dup?'dup':''}">
        <div class="paste-cont-h"><b>${impEsc(c.cont||'—')}</b><span>${impEsc(c.man)} · ${impEsc(c.ori||'—')} · ETA puerto ${fmtF(c.etap)} · ETA Blue ${fmtF(c.etab)}</span>
        <em>${c.peds.length} pedidos · ${dgFmt(kg,0)} kg${val?' · '+dgUsd(val):''}${c.dup?' · contenedor ya existe':''}</em></div>
        <div class="imp-peds">${c.peds.map(pill).join('')}</div></div>`;}).join('')}</div>`+
    (errores.length?`<div class="paste-msg err">${errores.map(impEsc).join('<br>')}</div>`:'')+
    (dupMsgs.length
      ? `<div class="paste-msg err"><b>🔒 Bloqueado: hay duplicados. No se crea nada hasta corregirlos.</b><br>${dupMsgs.slice(0,15).map(impEsc).join('<br>')}${dupMsgs.length>15?`<br>… y ${dupMsgs.length-15} más`:''}</div>`
      : conts.length===1
        ? `<div class="paste-msg ok">✓ Ficha completada abajo en estado 01 — Tránsito marítimo. Revisa y guarda.</div>`
        : `<button class="btn btn-accent paste-btn" onclick="pasteCrearTodos()">Crear los ${conts.length} contenedores</button>`);
  if(!dupMsgs.length && conts.length===1) pasteLlenarFicha(conts[0]);
}
function pasteDuplicados(conts){
  const m=[];
  conts.forEach(c=>{
    if(c.dup) m.push(`Contenedor ${c.cont} ya está en Ingreso de equipo`);
    c.peds.forEach(p=>{ if(p.dup) m.push(`Pedido ${p.pedido} (${c.cont||c.man}): ${p.dupMotivo||'duplicado'}`); });
  });
  return m;
}
function pasteRegistro(c){
  const lista=c.peds.map(({dup,dupMotivo,...p})=>p);
  const r={doc:c.man, cont:c.cont, eta_pto:contFmtFecha(c.etap), eta_blue:contFmtFecha(c.etab), cant:1,
    peso:Math.round(lista.reduce((a,p)=>a+p.peso,0)*1000)/1000, origen:c.ori,
    estado:'01-TRÁNSITO MARÍTIMO', flete:'01-NO PAGADO', bl:'01-NO ENTREGADO', report_esa:'03-NO APLICA',
    rg:[...c.rgs].join(', '), rc:[...(c.rcs||[])].join(', '), fdesc:'—', mes:(c.etab||c.etap)?IMP_MESES[(c.etab||c.etap).getMonth()]:'', enviado:false};
  return contSetPedidos(r,lista);
}
function pasteSelect(id,val){
  const el=document.getElementById(id); if(!el||!val) return;
  if(![...el.options].some(o=>o.value===val||o.text===val)) el.add(new Option(val,val));
  el.value=val;
}
function pasteLlenarFicha(c){
  const r=pasteRegistro(c);
  const iso=d=>d?impIso(d):'';
  document.getElementById('c-doc').value=r.doc;
  document.getElementById('c-cont').value=r.cont;
  document.getElementById('c-eta-pto').value=iso(c.etap);
  document.getElementById('c-eta-blue').value=iso(c.etab);
  document.getElementById('c-cant').value=1;
  document.getElementById('c-peso').value=r.peso;
  pasteSelect('c-origen',r.origen);
  pasteSelect('c-estado','01-TRÁNSITO MARÍTIMO');
  pasteSelect('c-flete','01-NO PAGADO');
  pasteSelect('c-bl','01-NO ENTREGADO');
  document.getElementById('c-rg').value='03-NO APLICA';
  document.getElementById('c-rc').value=r.rg;
  const _rcn=document.getElementById('c-rcnum'); if(_rcn) _rcn.value=r.rc||'';
  if(r.mes) pasteSelect('c-mes',r.mes);
  contPedRender(contPedidos(r).map(p=>({...p})));
}
function pasteCrearTodos(){
  if(!pasteData) return;
  const dups=pasteDuplicados(pasteData.conts);
  if(dups.length){ hubAvisoDup(dups,'No se crea ningún contenedor'); return; }
  const crear=pasteData.conts;
  crear.forEach(c=>contenedores.push(pasteRegistro(c)));
  closeModals(); renderContenedores(); actualizarMetricasCont();
  alert(`✅ ${crear.length} contenedor${crear.length===1?'':'es'} creado${crear.length===1?'':'s'} en 01 — Tránsito marítimo\n\n${crear.map(c=>`• ${c.cont} · ${c.peds.length} pedidos`).join('\n')}\n\nOjo: todavía no se guardan en Google Sheets. Eso se conecta en la etapa de base de datos.`);
  pasteData=null;
}

// ============================================================
// IMPORTAR INGRESOS desde Excel (1 fila = 1 pedido/DT)
// Agrupa por Manifiesto + cabezal → 1 contenedor
// ============================================================
let impData=null;
const IMP_MESES=['enero','febrero','marzo','abril','mayo','junio','julio','agosto','septiembre','octubre','noviembre','diciembre'];
function impNorm(v){ return String(v==null?'':v).trim().toUpperCase().normalize('NFD').replace(/[̀-ͯ]/g,'').replace(/\s+/g,' '); }
function impPaisKey(consig){
  const s=impNorm(consig);
  if(/\(HN\)|HONDURAS/.test(s)) return 'hn';
  if(/\(NIC\)|NICARAGUA/.test(s)) return 'ni';
  if(/\(PA\)|PANAMA/.test(s)) return 'pa';
  if(/GUATEMALA/.test(s)) return 'gt';
  if(/COSTA RICA/.test(s)) return 'cr';
  if(/EL SALVADOR/.test(s)) return 'sv';
  return '';
}
function impFecha(v){
  if(v==null||v==='') return null;
  if(typeof v==='number'&&typeof XLSX!=='undefined'){ const o=XLSX.SSF.parse_date_code(v); return o?new Date(o.y,o.m-1,o.d):null; }
  if(v instanceof Date) return isNaN(v)?null:new Date(v.getFullYear(),v.getMonth(),v.getDate());
  return dgFecha(String(v));
}
function impIso(d){ return d?`${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`:''; }
function impKey(d){ return d?impIso(d).slice(0,7):''; }
function impKeyLargo(k){ return k?IMP_MESES[+k.slice(5,7)-1].replace(/^./,c=>c.toUpperCase())+' '+k.slice(0,4):''; }
function impEsc(v){ return String(v==null?'':v).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c])); }
function impNormPlaca(p){ return impNorm(p).replace(/\s*(\/\/|-)\s*/g,' // ').replace(/\s+/g,' ').trim(); }

function impElegir(){ const i=document.getElementById('imp-file'); i.value=''; i.click(); }
function impLeer(input){
  const file=input.files&&input.files[0]; if(!file) return;
  if(typeof XLSX==='undefined'){ alert('No se pudo cargar el lector de Excel. Revisa la conexión a internet y vuelve a intentar.'); return; }
  const fr=new FileReader();
  fr.onload=e=>{
    try{
      const wb=XLSX.read(new Uint8Array(e.target.result),{type:'array'});
      let ws=null, hdr=null, hoja='';
      for(const n of wb.SheetNames){
        const h=(XLSX.utils.sheet_to_json(wb.Sheets[n],{header:1,defval:''})[0]||[]).map(impNorm);
        if(h.includes('DT')&&h.includes('PEDIDO')&&h.includes('CONSIGNATARIO')&&h.includes('MANIFIESTO')){ ws=wb.Sheets[n]; hdr=h; hoja=n; break; }
      }
      if(!ws){ alert('No encontré la hoja de ingresos.\n\nDebe tener al menos las columnas: DT, pedido, Consignatario, Manifiesto y Placa.'); return; }
      const col=n=>hdr.indexOf(n);
      const C={ca:col('CA'),man:col('MANIFIESTO'),bl:col('BL O CARTA PORTE'),con:col('CONSIGNATARIO'),dt:col('DT'),arr:col('ARRIBO'),des:col('DESCARGO'),sal:col('SALIDA'),
               rs:col('REPORTE DE SALIDA'),rc:['RC','NO. RC','NO RC','N° RC'].map(col).find(i=>i>=0)??-1,bul:col('NO. BULTOS'),peso:col('PESO'),placa:col('PLACA'),ori:col('ORIGEN'),ped:col('PEDIDO'),mer:col('MERCANCIAS')};
      const rows=XLSX.utils.sheet_to_json(ws,{header:1,defval:'',raw:true}).slice(1).filter(r=>r.some(v=>String(v).trim()!==''));
      impProcesar(rows,C,file.name,hoja);
    }catch(err){ console.error(err); alert('No se pudo leer el archivo: '+err.message); }
  };
  fr.readAsArrayBuffer(file);
}

function impProcesar(rows,C,archivo,hoja){
  const g=(r,i)=>i>=0?r[i]:'';
  // Pedidos y DT que ya existen en el HUB
  const existe=new Set();
  const addEx=v=>{ const s=impNorm(v); if(s&&s!=='-') existe.add(s); };
  [...contenedores,...historialCont].forEach(r=>contPedidos(r).forEach(p=>{ addEx(p.pedido); addEx('DT:'+p.dt); }));
  [...noProg].forEach(r=>{ addEx(r.pedido); if(r.dt) addEx('DT:'+r.dt); });
  [...despachos,...historial].forEach(r=>{ addEx(r.no_pedido); if(r.dt) addEx('DT:'+String(r.dt).replace(/^DT[-\s]*/i,'')); });

  const grupos={}, errores=[];
  rows.forEach((r,ix)=>{
    const fila=ix+2;
    const pedido=String(g(r,C.ped)).trim(), dt=String(g(r,C.dt)).trim();
    const pais=impPaisKey(g(r,C.con));
    const man=String(g(r,C.man)).trim();
    const placa=impNormPlaca(g(r,C.placa)), cab=placa.split(' ')[0]||'';
    const p={fila,pedido,dt,pais,consig:String(g(r,C.con)).trim(),man,placa,cab,ca:String(g(r,C.ca)).trim(),bl:String(g(r,C.bl)).trim(),
      arribo:impFecha(g(r,C.arr)),descargo:impFecha(g(r,C.des)),salida:impFecha(g(r,C.sal)),rs:String(g(r,C.rs)).trim(),rc:String(g(r,C.rc)).trim(),
      bultos:dgNum(g(r,C.bul)),peso:dgNum(g(r,C.peso)),
      factura:(()=>{ const m=String(g(r,C.mer)).match(/\b\d{9,11}\s*-\s*([0-9][0-9A-Z-]{5,})/i); return m?m[1]:''; })(),origen:impNorm(g(r,C.ori)),obs:[]};
    if(!pedido){ errores.push({fila,dt,msg:'Sin número de pedido'}); return; }
    if(!pais){ errores.push({fila,dt,pedido,msg:`País no reconocido (${p.consig||'sin consignatario'})`}); return; }
    if(!man){ errores.push({fila,dt,pedido,msg:'Sin manifiesto'}); return; }
    p.dup=existe.has(impNorm(pedido))||(dt&&existe.has(impNorm('DT:'+dt)));
    if(p.arribo&&p.descargo&&p.descargo<p.arribo) p.obs.push('descargo antes del arribo');
    if(p.descargo&&p.salida&&p.salida<p.descargo) p.obs.push('salida antes del descargo');
    if(impNorm(p.bl)==='PENDIENTE') p.obs.push('BL pendiente');
    if(/^SSAO/.test(impNorm(p.bl))) p.obs.push('BL con doble S');
    if(p.bultos>200) p.obs.push(`${dgFmt(p.bultos)} bultos (¿cajas?)`);
    if(!p.peso) p.obs.push('sin peso');
    const key=man+'|'+(cab||p.bl);
    (grupos[key]=grupos[key]||[]).push(p);
  });
  const conts=Object.entries(grupos).map(([key,ps])=>{
    const nuevos=ps.filter(p=>!p.dup);
    const arr=ps.map(p=>p.arribo).filter(Boolean).sort((a,b)=>a-b)[0]||null;
    const des=ps.map(p=>p.descargo).filter(Boolean).sort((a,b)=>a-b)[0]||null;
    const todosSalieron=ps.every(p=>p.salida);
    const sal=todosSalieron?ps.map(p=>p.salida).sort((a,b)=>b-a)[0]:null;
    const origenes={}; ps.forEach(p=>{ if(p.origen) origenes[p.origen]=(origenes[p.origen]||0)+1; });
    return {key,ps,nuevos,arr,des,sal,k:impKey(arr||des),destino:!nuevos.length?'omitir':todosSalieron?'historial':'activo',
      origen:Object.entries(origenes).sort((a,b)=>b[1]-a[1]).map(x=>x[0])[0]||'',obs:[...new Set(ps.flatMap(p=>p.obs))]};
  }).sort((a,b)=>(a.arr||a.des||0)-(b.arr||b.des||0));
  const meses=[...new Set(conts.map(c=>c.k).filter(Boolean))].sort();
  impData={archivo,hoja,conts,errores,meses,total:rows.length};
  const sel=v=>meses.map(k=>`<option value="${k}"${k===v?' selected':''}>${impKeyLargo(k)}</option>`).join('');
  document.getElementById('imp-desde').innerHTML=sel(meses[0]);
  document.getElementById('imp-hasta').innerHTML=sel(meses[meses.length-1]);
  document.getElementById('imp-archivo').textContent=`${archivo} · hoja ${hoja} · ${dgFmt(rows.length)} filas`;
  impRender();
  document.getElementById('modal-import').classList.add('open');
}

function impSeleccion(){
  if(!impData) return [];
  const d=document.getElementById('imp-desde').value, h=document.getElementById('imp-hasta').value;
  return impData.conts.filter(c=>c.k&&c.k>=d&&c.k<=h);
}
function impRender(){
  const sel=impSeleccion();
  const act=sel.filter(c=>c.destino==='activo'), his=sel.filter(c=>c.destino==='historial'), omi=sel.filter(c=>c.destino==='omitir');
  const cargar=[...act,...his];
  const nPed=cargar.reduce((a,c)=>a+c.nuevos.length,0), tn=cargar.reduce((a,c)=>a+c.nuevos.reduce((x,p)=>x+p.peso,0),0)/1000;
  const dupPed=sel.reduce((a,c)=>a+(c.ps.length-c.nuevos.length),0);
  const conObs=cargar.filter(c=>c.obs.length).length;
  const errs=impData.errores.length;
  const chip=(n,l,cls)=>`<div class="imp-chip ${cls||''}"><strong>${dgFmt(n)}</strong><span>${l}</span></div>`;
  document.getElementById('imp-resumen').innerHTML=
    chip(cargar.length,'contenedores a cargar','main')+chip(nPed,`pedidos · ${dgFmt(tn,1)} tn`)+
    chip(act.length,'a Ingreso de Equipo')+chip(his.length,'a Historial (ya salieron)')+
    (dupPed?chip(dupPed,'pedidos ya existen: se omiten','warn'):'')+
    (conObs?chip(conObs,'con observaciones','warn'):'')+
    (errs?chip(errs,'filas con error (todo el archivo)','err'):'');
  const pill=p=>`<span class="imp-ped ${p.dup?'dup':''}" title="DT ${impEsc(p.dt)}${p.dup?' · ya existe en el HUB':''}"><i style="background:${CONT_PAIS_INFO[p.pais].c}"></i>${p.pais.toUpperCase()} ${impEsc(p.pedido)}</span>`;
  const destLbl={activo:'<span class="imp-dest act">Ingreso</span>',historial:'<span class="imp-dest his">Historial</span>',omitir:'<span class="imp-dest omi">Ya existe</span>'};
  document.getElementById('imp-tbody').innerHTML=sel.length?sel.map(c=>`<tr class="${c.destino==='omitir'?'imp-omi':''}">
      <td class="mono">${c.arr?impIso(c.arr).split('-').reverse().join('/'):'—'}</td>
      <td class="mono">${impEsc(c.ps[0].man)}</td><td class="mono">${impEsc(c.ps[0].placa||'—')}</td>
      <td><div class="imp-peds">${c.ps.map(pill).join('')}</div></td>
      <td class="num">${dgFmt(c.ps.reduce((a,p)=>a+p.peso,0))}</td>
      <td>${destLbl[c.destino]}</td>
      <td class="imp-obs">${c.obs.map(impEsc).join(' · ')}</td></tr>`).join('')
    :'<tr><td colspan="7"><div class="empty"><strong>Sin contenedores en ese rango</strong>Cambia los meses de arribo.</div></td></tr>';
  const errBox=document.getElementById('imp-errores');
  errBox.innerHTML=errs?`<details><summary>${errs} fila${errs===1?'':'s'} no se pueden cargar</summary><ul>${impData.errores.slice(0,50).map(e=>`<li>Fila ${e.fila}${e.dt?' · DT '+impEsc(e.dt):''}${e.pedido?' · '+impEsc(e.pedido):''}: ${impEsc(e.msg)}</li>`).join('')}${errs>50?`<li>… y ${errs-50} más</li>`:''}</ul></details>`:'';
  const btn=document.getElementById('imp-btn');
  btn.disabled=!cargar.length;
  btn.textContent=cargar.length?`Importar ${dgFmt(cargar.length)} contenedor${cargar.length===1?'':'es'}`:'Nada que importar';
}

function impConfirmar(){
  const sel=impSeleccion().filter(c=>c.destino!=='omitir');
  if(!sel.length) return;
  let nAct=0,nHis=0,nPed=0;
  sel.forEach(c=>{
    const p0=c.ps[0];
    const lista=c.nuevos.map(p=>({pais:p.pais,dt:p.dt,pedido:p.pedido,bultos:p.bultos,peso:p.peso,...(p.factura?{factura:p.factura}:{}),...(p.salida?{salida:impIso(p.salida)}:{}),...(p.rs?{rs:p.rs}:{})}));
    const blOk=c.ps.some(p=>p.bl&&impNorm(p.bl)!=='PENDIENTE');
    const r={
      doc:p0.man, cont:p0.placa||p0.cab||p0.bl,
      eta_pto:'—', eta_blue:contFmtFecha(c.arr), cant:1,
      peso:Math.round(lista.reduce((a,p)=>a+p.peso,0)*1000)/1000,
      origen:c.origen,
      estado:c.destino==='historial'?'07-NOTIFICADO VACÍO':c.des?'06-DESCARGADO':'04-POSICIONADO EN BLUE',
      flete:'01-NO PAGADO', bl:blOk?'02-ENTREGADO':'01-NO ENTREGADO', report_esa:'03-NO APLICA',
      rg:[...new Set(c.ps.map(p=>p.ca).filter(Boolean))].join(', '), rc:[...new Set(c.ps.map(p=>p.rc).filter(Boolean))].join(', '),
      fdesc:contFmtFecha(c.des),
      mes:c.arr?IMP_MESES[c.arr.getMonth()]:'',
      enviado:c.destino==='historial',
      fechaEnvioNP:c.destino==='historial'&&c.sal?c.sal.toLocaleDateString('es-SV'):'',
      importado:impData.archivo
    };
    contSetPedidos(r,lista);
    if(c.destino==='historial'){ historialCont.push(r); nHis++; } else { contenedores.push(r); nAct++; }
    nPed+=lista.length;
  });
  closeModals();
  renderContenedores(); renderHistorialCont();
  if(typeof populateFilters==='function') try{ populateFilters(); }catch(e){}
  alert(`✅ Ingresos importados\n\n${nAct} contenedor${nAct===1?'':'es'} a Ingreso de Equipo\n${nHis} a Historial de Ingreso (ya salieron)\n${nPed} pedidos con su DT, bultos y peso\n\nOjo: todavía no se guardan en Google Sheets. Eso se conecta en la etapa de base de datos.`);
  impData=null;
}

// Equipo y truck fill a partir de pallets/bultos y kg (mismas reglas que NP)
function npCalcEquipo(pal,kg){
  pal=parseInt(pal)||0; kg=parseFloat(kg)||0;
  if(!pal&&!kg) return {equipo:'—',truckFill:'—'};
  // Solo el peso define el equipo; más de 30 pallets es aviso, no bloqueo
  if(kg>23000) return {equipo:'EXCEDE 3 EJES',truckFill:'—'};
  if(kg>21000) return {equipo:'53 FT 3 EJES',truckFill:Math.max(Math.round(pal/30*100),Math.round(kg/23000*100))+'%'};
  return {equipo:'53 FT',truckFill:Math.max(Math.round(pal/30*100),Math.round(kg/21000*100))+'%'};
}

function abrirModalCont(idx){
  editContIdx=idx;
  (document.getElementById('cont-modal-title')||{}).textContent =idx===null?'Nuevo Contenedor':'Editar Contenedor';
  document.getElementById('cont-delete-btn').style.display=idx!==null?'inline-flex':'none';
  const FIELDS=['doc','cont','cant','peso'];
  const SELECTS=['origen','estado','flete','bl','mes'];
  const DATES=['eta-pto','eta-blue','fdesc'];
  if(idx!==null){
    const r=contenedores[idx];
    FIELDS.forEach(f=>{const el=document.getElementById('c-'+f);if(el)el.value=r[f.replace('-','_')]||'';});
    SELECTS.forEach(f=>{const el=document.getElementById('c-'+f);if(el)el.value=r[f]||'';});
    // REPORT ESA y RG — campos separados
    const elRg=document.getElementById('c-rg'); if(elRg) elRg.value=r.report_esa||'03-NO APLICA';
    const elRc=document.getElementById('c-rc'); if(elRc) elRc.value=r.rg||'';
    const elRcn=document.getElementById('c-rcnum'); if(elRcn) elRcn.value=contVacio(r.rc)?'':r.rc;
    // Dates: convert from stored format
    if(document.getElementById('c-eta-pto')) document.getElementById('c-eta-pto').value=parseFdesc(r.eta_pto)||'';
    if(document.getElementById('c-eta-blue')) document.getElementById('c-eta-blue').value=parseFdesc(r.eta_blue)||'';
    if(document.getElementById('c-fdesc')) document.getElementById('c-fdesc').value=parseFdesc(r.fdesc)||'';
    contPedRender(contPedidos(r).map(p=>({...p})));
  } else {
    [...FIELDS,...DATES].forEach(f=>{const el=document.getElementById('c-'+f);if(el)el.value='';});
    SELECTS.forEach(f=>{const el=document.getElementById('c-'+f);if(el)el.value='';});
    contPedRender([]);
    const elRcn=document.getElementById('c-rcnum'); if(elRcn) elRcn.value='';
    const elRgn=document.getElementById('c-rc'); if(elRgn) elRgn.value='';
    const elRe=document.getElementById('c-rg'); if(elRe) elRe.value='';
  }
  const selEst=document.getElementById('c-estado'), avEst=document.getElementById('c-estado-lock');
  const bloqF=idx!==null?contBloqueoEstado(contenedores[idx]):'';
  if(selEst){
    selEst.disabled=!!bloqF;
    const perm=idx!==null?contEstadosPermitidos(contenedores[idx]):CONT_ESTADOS;
    const act=idx!==null?contenedores[idx].estado:'';
    [...selEst.options].forEach(o=>{ if(!o.value) return; o.disabled=!perm.includes(o.value)||(act==='04-POSICIONADO EN BLUE'&&o.value==='05-EN DESCARGA'); });
    if(avEst&&!bloqF&&act==='04-POSICIONADO EN BLUE') avEst.textContent='Para pasar a 05, asigna cortina desde la tabla.';
  }
  if(avEst){ avEst.textContent=bloqF?'🔒 '+bloqF:''; }
  const pb=document.getElementById('c-paste-box');
  if(pb){ pb.style.display=idx===null?'':'none'; document.getElementById('c-paste').value=''; document.getElementById('c-paste-res').innerHTML=''; pasteData=null; }
  document.getElementById('modal-cont').classList.add('open');
}

function guardarCont(){
  const doc=document.getElementById('c-doc').value.trim();
  const cont=document.getElementById('c-cont').value.trim();
  if(!doc){alert('El Doc. de Transporte es obligatorio.');return;}
  if(!cont){alert('El Número de Contenedor es obligatorio.');return;}
  const fmtDate=val=>{
    if(!val) return '—';
    // date input returns YYYY-MM-DD, format to display
    const d=new Date(val+'T00:00:00');
    if(isNaN(d)) return val;
    return d.toLocaleDateString('es-SV',{day:'2-digit',month:'short',year:'numeric'}).replace(/ /g,'-');
  };
  // Pedidos del contenedor (lista)
  const lista=contPedLeer();
  const sinPais=lista.filter(p=>!p.pais);
  if(sinPais.length){ alert(`Falta elegir el país en ${sinPais.length} pedido${sinPais.length>1?'s':''}.`); return; }
  const vistos={}, repetidos=[];
  lista.forEach(p=>{ if(!p.pedido) return; if(vistos[p.pedido]) repetidos.push(p.pedido); vistos[p.pedido]=1; });
  if(repetidos.length){ alert(`El pedido ${repetidos.join(', ')} está repetido en la lista.`); return; }
  {
    const prevC=editContIdx!==null?contenedores[editContIdx]:null;
    const keyPrev=prevC?(String(prevC.cont||'')+'|'+String(prevC.doc||'')).toUpperCase():'';
    const propios=prevC?contPedidos(prevC):[];
    const pp=new Set(propios.map(x=>hubNormPed(x.pedido)).filter(Boolean)), pd=new Set(propios.map(x=>hubNormDT(x.dt)).filter(Boolean));
    // Excluye su propia ficha y lo que ya era suyo y avanzó a NP / Despacho / Historial
    const dups=hubDuplicados(lista,['ingreso','np','desp','hist'],e=>(e.etapa==='ingreso'&&e.key===keyPrev)||(e.etapa!=='ingreso'&&((e.pedido&&pp.has(e.pedido))||(e.dt&&pd.has(e.dt)))));
    if(dups.length){ hubAvisoDup(dups,'No se puede guardar el contenedor'); return; }
  }
  const sumPeso=lista.reduce((a,p)=>a+p.peso,0);
  let pesoCont=parseFloat(document.getElementById('c-peso').value)||0;
  if(!pesoCont && sumPeso) pesoCont=sumPeso; // si no hay peso del contenedor, toma la suma
  if(pesoCont && sumPeso && Math.abs(pesoCont-sumPeso)>1){
    if(!confirm(`⚠️ El peso de los pedidos no cuadra con el contenedor.\n\nSuma pedidos: ${sumPeso.toLocaleString('es-SV',{maximumFractionDigits:2})} kg\nPeso contenedor: ${pesoCont.toLocaleString('es-SV',{maximumFractionDigits:2})} kg\nDiferencia: ${(pesoCont-sumPeso).toLocaleString('es-SV',{maximumFractionDigits:2})} kg\n\n¿Guardar de todas formas?`)) return;
  }
  const prev=editContIdx!==null?contenedores[editContIdx]:null;
  const estNuevo=document.getElementById('c-estado').value||'01-TRÁNSITO MARÍTIMO';
  if(prev&&estNuevo!==prev.estado){
    if(!contEstadosPermitidos(prev).includes(estNuevo)||(prev.estado==='04-POSICIONADO EN BLUE'&&estNuevo==='05-EN DESCARGA')){
      alert('🔒 '+(prev.estado==='04-POSICIONADO EN BLUE'&&estNuevo==='05-EN DESCARGA'?'Para pasar a 05, asigna cortina desde la tabla.':contMotivoNoPermitido(prev,estNuevo))); return;
    }
  }
  const r={
    ...(prev||{}),
    doc, cont,
    eta_pto:fmtDate(document.getElementById('c-eta-pto').value),
    eta_blue:fmtDate(document.getElementById('c-eta-blue').value),
    cant:parseInt(document.getElementById('c-cant').value)||0,
    peso:pesoCont,
    origen:document.getElementById('c-origen').value||'',
    estado:document.getElementById('c-estado').value||'01-TRÁNSITO MARÍTIMO',
    flete:normalizarFlete(document.getElementById('c-flete').value||'01-NO PAGADO'),
    bl:document.getElementById('c-bl').value||'01-NO ENTREGADO',
    report_esa:document.getElementById('c-rg').value||'03-NO APLICA',
    rg:document.getElementById('c-rc').value||'',
    rc:document.getElementById('c-rcnum').value.trim(),
    fdesc:fmtDate(document.getElementById('c-fdesc').value),
    mes:document.getElementById('c-mes').value||new Date().toLocaleString('es-SV',{month:'long'}),
    enviado:prev?!!prev.enviado:false
  };
  contSetPedidos(r,lista);
  const llegoABlue=r.estado==='04-POSICIONADO EN BLUE'&&(!prev||prev.estado!=='04-POSICIONADO EN BLUE');
  if(llegoABlue) setTimeout(()=>{ const i=contenedores.indexOf(r); if(i>=0) ccAbrir(i); },80);
  if(editContIdx===null){
    contenedores.push(r);
    closeModals(); renderContenedores(); actualizarMetricasCont();
    const fila = GS_CAMPOS.Contenedores.map(k=>r[k]!==undefined?r[k]:'');
    console.log('guardarCont: nuevo, fila len='+fila.length);
    setTimeout(()=>{ gsSaveAll(); gsSaveRow('Contenedores', fila, null); }, 500);
  } else {
    contenedores[editContIdx]=r;
    closeModals(); renderContenedores(); actualizarMetricasCont();
    const fila = GS_CAMPOS.Contenedores.map(k=>r[k]!==undefined?r[k]:'');
    console.log('guardarCont: editar idx='+editContIdx+', fila len='+fila.length);
    setTimeout(()=>{ gsSaveAll(); gsSaveRow('Contenedores', fila, editContIdx+1); }, 500);
  }
}

function eliminarCont(){
  if(editContIdx===null) return;
  if(!confirm('¿Eliminar este contenedor?')) return;
  contenedores.splice(editContIdx,1);
  closeModals();
  renderContenedores();
}

// ============================================================
// HISTORIAL DE DESPACHOS
// ============================================================
let historial = [];

function histGetFiltered(){
  const mes=(document.getElementById('hist-f-mes')||{}).value||'';
  const dest=(document.getElementById('hist-f-dest')||{}).value||'';
  const q=((document.getElementById('hist-f-q')||{}).value||'').toLowerCase().trim();
  return historial.filter(r=>{
    if(mes&&r.mes!==mes) return false;
    if(dest&&r.dest!==dest) return false;
    if(q&&![r.ref,r.dt,r.no_pedido,r.dest,r.remolque,r.regimen].some(v=>String(v||'').toLowerCase().includes(q))) return false;
    return true;
  });
}

// Doc selector helper
function histDocSel(hi, campo, val, opciones, colores){
  const opts = opciones.map(o=>{
    const col = colores[o]||{c:'#6B7280',b:'#F3F4F6'};
    return `<option value="${o}"${val===o?' selected':''}>${o}</option>`;
  }).join('');
  const col = colores[val]||{c:'#6B7280',b:'#F3F4F6'};
  return `<select onchange="histCambiarDoc(${hi},'${campo}',this.value)"
    style="font-size:10px;font-family:var(--mono);font-weight:600;padding:2px 5px;border-radius:5px;
    border:1px solid ${col.b};background:${col.b}33;color:${col.c};cursor:pointer;min-width:100px;">
    ${opts}
  </select>`;
}

function histCambiarDoc(hi, campo, val){
  if(historial[hi]){ historial[hi][campo]=val; setTimeout(gsSaveAll,500); renderHistorial(); }
}

const HIST_DOC_COLORS = {
  'NO ENVIADA': {c:'#991B1B',b:'#FECACA'},
  'ENVIADA':    {c:'#15803D',b:'#86EFAC'},
  'NO RECIBIDO':{c:'#991B1B',b:'#FECACA'},
  'RECIBIDO':   {c:'#15803D',b:'#86EFAC'},
  'NO ENVIADO': {c:'#991B1B',b:'#FECACA'},
  'ENVIADO':    {c:'#15803D',b:'#86EFAC'},
};
const HIST_PAIS_COLOR = {
  'COSTA RICA':'#185FA5','NICARAGUA':'#3B6D11','GUATEMALA':'#854F0B',
  'HONDURAS':'#7A1F5A','EL SALVADOR':'#A32D2D','PANAMA':'#0F6E56'
};

function renderHistorial(){
  const f=histGetFiltered();
  const badge=document.getElementById('tab-count-historial');
  if(badge) badge.textContent=historial.length;
  const eid=(id,v)=>{const e=document.getElementById(id);if(e)e.textContent=v;};
  eid('hist-kpi-total', historial.length);
  eid('hist-kpi-furgones', new Set(historial.map(r=>r.ref).filter(Boolean)).size);
  eid('hist-kpi-peso', Math.round(historial.reduce((a,r)=>a+(parseFloat(r.peso)||0),0)).toLocaleString('es-SV'));
  eid('hist-kpi-cr',  historial.filter(r=>r.dest==='COSTA RICA').length);
  eid('hist-kpi-ni',  historial.filter(r=>r.dest==='NICARAGUA').length);
  eid('hist-kpi-gt',  historial.filter(r=>r.dest==='GUATEMALA').length);
  eid('hist-kpi-hn',  historial.filter(r=>r.dest==='HONDURAS').length);
  const cl=document.getElementById('hist-count-label');
  if(cl) cl.textContent=f.length+' de '+historial.length+' registros';
  const meses=[...new Set(historial.map(r=>r.mes))];
  const dests=[...new Set(historial.map(r=>r.dest))];
  const mSel=document.getElementById('hist-f-mes'),dSel=document.getElementById('hist-f-dest');
  if(mSel){const mv=mSel.value;mSel.innerHTML='<option value="">Todos los meses</option>'+meses.map(m=>`<option${m===mv?' selected':''}>${m}</option>`).join('');}
  if(dSel){const dv=dSel.value;dSel.innerHTML='<option value="">Todos los destinos</option>'+dests.map(d=>`<option${d===dv?' selected':''}>${d}</option>`).join('');}
  const tbody=document.getElementById('hist-tbody');
  if(!tbody) return;
  if(!f.length){
    tbody.innerHTML='<tr><td colspan="18"><div class="empty"><strong>Sin registros archivados</strong>Los pedidos despachados aparecerán aquí</div></td></tr>';
    return;
  }

  // Group by country
  const byPais = {};
  f.forEach(r=>{
    const p=r.dest||'SIN PAÍS';
    if(!byPais[p]) byPais[p]=[];
    byPais[p].push(r);
  });

  let html = '';
  Object.keys(byPais).sort().forEach(pais=>{
    const rows = byPais[pais];
    const col  = HIST_PAIS_COLOR[pais]||'#6B7280';
    const totalPallets = rows.reduce((a,r)=>a+(parseInt(r.pallets)||0),0);
    const totalPeso    = rows.reduce((a,r)=>a+(parseFloat(r.peso)||0),0);
    const pendFact  = rows.filter(r=>(!r.factura||r.factura==='NO ENVIADA')).length;
    const pendGR    = rows.filter(r=>(!r.gr||r.gr==='NO RECIBIDO')).length;
    const pendScan  = rows.filter(r=>(!r.scan_id||r.scan_id==='NO ENVIADO')).length;

    // Country header row
    html += `<tr style="background:${col}12;border-top:2px solid ${col};">
      <td colspan="5" style="padding:8px 12px;">
        <span style="font-weight:700;font-size:12px;color:${col};">${pais}</span>
        <span style="font-size:11px;color:var(--text-muted);margin-left:8px;">${rows.length} despacho${rows.length>1?'s':''}</span>
        ${pendFact>0?`<span style="margin-left:8px;font-size:10px;background:#FEE2E2;color:#991B1B;padding:1px 6px;border-radius:4px;">📄 ${pendFact} factura${pendFact>1?'s':''} pendiente${pendFact>1?'s':''}</span>`:''}
        ${pendGR>0?`<span style="margin-left:4px;font-size:10px;background:#FEF3C7;color:#92400E;padding:1px 6px;border-radius:4px;">📦 ${pendGR} GR pendiente${pendGR>1?'s':''}</span>`:''}
        ${pendScan>0?`<span style="margin-left:4px;font-size:10px;background:#EFF6FF;color:#1D4ED8;padding:1px 6px;border-radius:4px;">🔍 ${pendScan} Scan pendiente${pendScan>1?'s':''}</span>`:''}
      </td>
      <td class="num" style="font-weight:600;font-size:11px;color:${col};">${totalPallets}</td>
      <td colspan="6"></td>
      <td class="num" style="font-weight:600;font-size:11px;color:${col};">${Math.round(totalPeso).toLocaleString('es-SV')}</td>
      <td class="num" style="font-weight:600;font-size:11px;color:${col};">${dgUsd(costTotalRef(rows),2)}</td>
      <td colspan="4"></td>
    </tr>`;

    // Data rows
    rows.forEach(r=>{
      const hi=historial.indexOf(r);
      html+=`<tr>
        <td style="font-size:11px;color:var(--text-muted);padding-left:20px;">${r.mes||'—'}</td>
        <td style="font-weight:600;font-size:12px;">${r.ref||'—'}</td>
        <td class="mono" style="font-size:11px;">${r.dt||'—'}</td>
        <td class="mono" style="font-size:11px;">${r.no_pedido||'—'}</td>
        <td style="font-size:11px;color:${col};font-weight:500;">${r.dest||'—'}</td>
        <td class="num">${r.pallets||'—'}${+r.cajas>0?`<small class="pal-cj">${Number(r.cajas).toLocaleString('es-SV')} cj</small>`:''}</td>
        <td class="mono" style="font-size:11px;">${r.remolque||'—'}</td>
        <td style="font-size:11px;">${r.edif||'—'}</td>
        <td style="text-align:center;font-weight:600;color:#6B7280;">${r.cortina?'C'+r.cortina:'—'}</td>
        <td class="mono" style="font-size:11px;">${r.fcarga||'—'}</td>
        <td class="mono" style="font-size:11px;">${r.fsalida||'—'}</td>
        <td class="mono" style="font-size:11px;color:var(--text-hint);">${r.fechaArchivo||'—'}</td>
        <td class="num">${r.peso?Math.round(Number(r.peso)).toLocaleString('es-SV'):'—'}</td>
        <td class="num">${despTieneCostos(r)?`<button class="cst-link" onclick="costAbrir('${(r.ref||'SIN REF').replace(/'/g,'')}','hist')">${dgUsd(r.costo_total,2)}</button>`:'<span style="color:var(--text-hint)">—</span>'}</td>
        <td>${histDocSel(hi,'factura',r.factura||'NO ENVIADA',['NO ENVIADA','ENVIADA'],HIST_DOC_COLORS)}</td>
        <td>${histDocSel(hi,'gr',r.gr||'NO RECIBIDO',['NO RECIBIDO','RECIBIDO'],HIST_DOC_COLORS)}</td>
        <td>${histDocSel(hi,'scan_id',r.scan_id||'NO ENVIADO',['NO ENVIADO','ENVIADO'],HIST_DOC_COLORS)}</td>
        <td>
          <button onclick="histRestaurar(${hi})" style="font-size:10px;padding:3px 8px;border-radius:5px;border:1px solid #C7D2FE;background:#EEF2FF;color:#3730A3;cursor:pointer;font-family:var(--sans);font-weight:600;">↩</button>
        </td>
      </tr>`;
    });
  });
  tbody.innerHTML = html;
}

function histRestaurar(hi){
  const r=historial[hi];
  if(!r) return;
  if(!confirm(`↩ Restaurar a Despachos:\n\nRef: ${r.ref||'—'} · DT: ${r.dt||'—'}\nDestino: ${r.dest||'—'}\n\n¿Confirmar?`)) return;
  // Restore with status CARGADO instead of DESPACHADO
  const restored={...r, status:'CARGADO', fechaArchivo:undefined};
  delete restored.fechaArchivo;
  despachos.push(restored);
  historial.splice(hi,1);
  renderHistorial();
  populateFilters();
  renderDespachos();
  // Go to despachos tab
  const despTab=document.querySelector('.op-tab[data-tab="despachos"]');
  if(despTab) despTab.click();
  alert('✅ Pedido restaurado en Despachos con estatus CARGADO.');
}

function histClearFilters(){
  ['hist-f-mes','hist-f-dest','hist-f-q'].forEach(id=>{const e=document.getElementById(id);if(e)e.value='';});
  renderHistorial();
}

function exportHistCSV(){
  if(!historial.length){alert('No hay registros en el historial.');return;}
  const header='Mes,Referencia,DT,No.Pedido,Destino,Pallets,Remolque,Edificio,Cortina,F.Carga,F.Salida,F.Archivo,Peso';
  const rows=historial.map(r=>[r.mes,r.ref,r.dt,r.no_pedido||'',r.dest,r.pallets,r.remolque,r.edif||'',r.cortina||'',r.fcarga,r.fsalida,r.fechaArchivo||'',r.peso].map(v=>`"${v||''}"`).join(','));
  const blob=new Blob(['﻿'+header+'\n'+rows.join('\n')],{type:'text/csv;charset=utf-8'});
  const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='historial_despachos_'+new Date().toISOString().slice(0,10)+'.csv';a.click();
}

// Bind historial filters
['hist-f-mes','hist-f-dest','hist-f-q'].forEach(id=>{
  const el=document.getElementById(id);
  if(el) el.addEventListener(el.tagName==='SELECT'?'change':'input',renderHistorial);
});


// ============================================================
// DASHBOARD GERENCIAL — Reporte ejecutivo
// Salidas: historial + despachos · Ingresos: historialCont + contenedores
// Costos: reporte de facturación (hoja COSTOS) importado, ubicado en el MES DE FACTURA
// Periodo: mes + año (clave 'YYYY-MM')
// ============================================================
const DASH_MES_ORDER = {enero:1,febrero:2,marzo:3,abril:4,mayo:5,junio:6,julio:7,agosto:8,septiembre:9,octubre:10,noviembre:11,diciembre:12};
const DG_MESES = Object.keys(DASH_MES_ORDER);
// Países: orden fijo y color fijo por país (paleta validada para daltonismo; el color sigue al país, nunca al ranking)
const DG_PAISES = [
  {k:'cr', n:'COSTA RICA',  l:'Costa Rica',  c:'#2a78d6'},
  {k:'sv', n:'EL SALVADOR', l:'El Salvador', c:'#eb6834'},
  {k:'pa', n:'PANAMA',      l:'Panamá',      c:'#1baf7a'},
  {k:'gt', n:'GUATEMALA',   l:'Guatemala',   c:'#eda100'},
  {k:'hn', n:'HONDURAS',    l:'Honduras',    c:'#e87ba4'},
  {k:'ni', n:'NICARAGUA',   l:'Nicaragua',   c:'#008300'}
];
const DG_BY_N = Object.fromEntries(DG_PAISES.map(p=>[p.n,p]));
const DG_CAP = {pal:30, kg53:21000, kg3e:23000};
const DG_C = {ink:'#14213A', muted:'#5D6B82', hint:'#8F9BB0', grid:'#EEF1F5', surface:'#FFFFFF', blue:'#2E6CB5', deep:'#0E2D57', sky:'#9EC5F4'};
const DG_LS_KEY = 'hubul_dash_tarifas_v1';
const DG_LS_COSTOS = 'hubul_costos_v1';
// Rubros de facturación agrupados (orden fijo)
const DG_CATS = ['Flete marítimo','Puerto, naviera y terceros','Servicios DT y trámites','Consolidación y comisión','Almacenaje y seguro','Mano de obra y pallets'];
let dashCharts = {};
let dgState = {pais:'', per:'', vista:'blue', origen:''};   // per: '' (todo) · 'YYYY' (año) · 'YYYY-MM' (mes)
let dgCostos = null;               // {meta, peds:{pedido:{...}}}
let dgTarifasMem = null;

// ---------- utilidades ----------
function dashDestroyCharts(){ Object.values(dashCharts).forEach(ch=>{ try{ ch.destroy(); }catch(e){} }); dashCharts={}; }
function dgEsc(v){ return String(v==null?'':v).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c])); }
function dgNum(v){ const n=parseFloat(String(v==null?'':v).replace(/,/g,'')); return isFinite(n)?n:0; }
function dgNorm(v){ return String(v||'').trim().toUpperCase().normalize('NFD').replace(/[̀-ͯ]/g,''); }
function dgPais(v){
  const s=dgNorm(v);
  const ab={SV:'EL SALVADOR',HN:'HONDURAS',CR:'COSTA RICA',NI:'NICARAGUA',GT:'GUATEMALA',PA:'PANAMA'};
  if(ab[s]) return ab[s];
  // Consignatarios del reporte de facturación / ingresos
  if(/\(HN\)|HONDURAS/.test(s)) return 'HONDURAS';
  if(/\(NIC\)|NICARAGUA/.test(s)) return 'NICARAGUA';
  if(/\(PA\)|PANAMA/.test(s)) return 'PANAMA';
  if(/GUATEMALA/.test(s)) return 'GUATEMALA';
  if(/COSTA RICA/.test(s)) return 'COSTA RICA';
  if(/EL SALVADOR/.test(s)) return 'EL SALVADOR';
  return s;
}
function dgOrigen(v){ const s=dgNorm(v).replace(/^ORIEGN$/,''); if(!s||s==='-'||s==='—') return 'SIN ORIGEN'; return s; }
function dgOrigenLabel(o){ return o==='SIN ORIGEN'?'Sin origen':o.toLowerCase().replace(/(^|\s)\S/g,c=>c.toUpperCase()); }
const DG_ORIG_COL=['#2E6CB5','#E8892B','#1BAF7A','#8B5CF6','#D6455D','#14A3A3','#C9A227','#5D6B82','#7A1F5A','#3B6D11'];
function dgCap(m){ return m.charAt(0).toUpperCase()+m.slice(1); }
function dgFmt(n,d=0){ return Number(n||0).toLocaleString('es-SV',{minimumFractionDigits:d,maximumFractionDigits:d}); }
function dgUsd(n,d=0){ return '$'+Number(n||0).toLocaleString('en-US',{minimumFractionDigits:d,maximumFractionDigits:d}); }
function dgCompact(n){ n=Number(n||0); if(Math.abs(n)>=1e6) return (n/1e6).toFixed(1).replace(/\.0$/,'')+'M'; if(Math.abs(n)>=1e3) return (n/1e3).toFixed(1).replace(/\.0$/,'')+'K'; return String(Math.round(n)); }

// ---------- fechas: acepta 2026-10-28, 28/10/2026, 28-oct-2026, Date ----------
const DG_MES_ABR={ene:0,feb:1,mar:2,abr:3,may:4,jun:5,jul:6,ago:7,sep:8,set:8,oct:9,nov:10,dic:11};
function dgFecha(v){
  if(!v) return null;
  if(v instanceof Date) return isNaN(v)?null:new Date(v.getFullYear(),v.getMonth(),v.getDate());
  const s=String(v).trim(); let m;
  if((m=s.match(/^(\d{4})-(\d{1,2})-(\d{1,2})/))) return new Date(+m[1],+m[2]-1,+m[3]);
  if((m=s.match(/^(\d{1,2})\/(\d{1,2})\/(\d{2,4})/))) return new Date(+m[3]<100?2000+ +m[3]:+m[3],+m[2]-1,+m[1]);
  if((m=s.match(/^(\d{1,2})[-\s]([a-záéíóú]{3,5})\.?[-\s](\d{2,4})/i))){ const mi=DG_MES_ABR[m[2].toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g,'').slice(0,3)]; if(mi!=null) return new Date(+m[3]<100?2000+ +m[3]:+m[3],mi,+m[1]); }
  return null;
}
function dgIso(d){ return d?`${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`:''; }
// Días en bodega = fecha de salida − fecha de ingreso (mismo día = 0)
function dgDias(ing,sal){ if(!ing||!sal) return null; const d=Math.round((sal-ing)/86400000); return d<0?null:d; }
function dgHoy(){ const n=new Date(); return new Date(n.getFullYear(),n.getMonth(),n.getDate()); }
function dgMediana(a){ if(!a.length) return null; const b=a.slice().sort((x,y)=>x-y), k=Math.floor(b.length/2); return b.length%2?b[k]:(b[k-1]+b[k])/2; }

// ---------- periodos 'YYYY-MM' ----------
const DG_MES_CORTO=['Ene','Feb','Mar','Abr','May','Jun','Jul','Ago','Sep','Oct','Nov','Dic'];
function dgKey(d){ return d?`${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}`:''; }
// Clave desde una fecha; si no hay, desde el nombre del mes + año de referencia (o el año actual)
function dgKeyDe(fecha, mesNombre, refFecha){
  const d=dgFecha(fecha); if(d) return dgKey(d);
  const n=DASH_MES_ORDER[String(mesNombre||'').trim().toLowerCase()];
  if(!n) return '';
  const r=dgFecha(refFecha); const y=r?r.getFullYear():dgHoy().getFullYear();
  return `${y}-${String(n).padStart(2,'0')}`;
}
function dgKeyLabel(k){ return k?`${DG_MES_CORTO[+k.slice(5,7)-1]} ${k.slice(2,4)}`:''; }
function dgKeyLargo(k){ return k?`${dgCap(DG_MESES[+k.slice(5,7)-1])} ${k.slice(0,4)}`:''; }
function dgPerLabel(p){ return !p?'Todo el periodo':p.length===4?`Año ${p}`:dgKeyLargo(p); }
function dgEnPer(k, per){ if(!per) return true; if(!k) return false; return per.length===4?k.startsWith(per):k===per; }

// ---------- tarifas (respaldo cuando no hay costos facturados) ----------
function dgLoadTarifas(){
  let t=null;
  try{ t=JSON.parse(localStorage.getItem(DG_LS_KEY)||'null'); }catch(e){}
  const base={meta:85, paises:{}};
  DG_PAISES.forEach(p=>base.paises[p.k]={t53:0,t3e:0});
  if(t&&t.paises){ DG_PAISES.forEach(p=>{ if(t.paises[p.k]) base.paises[p.k]={t53:dgNum(t.paises[p.k].t53),t3e:dgNum(t.paises[p.k].t3e)}; }); }
  if(t&&dgNum(t.meta)>0) base.meta=dgNum(t.meta);
  return base;
}
function dgTieneTarifas(t){ return DG_PAISES.some(p=>t.paises[p.k].t53>0||t.paises[p.k].t3e>0); }
function dgAbrirTarifas(){
  const t=dgTarifasMem||dgLoadTarifas();
  document.getElementById('dg-tar-rows').innerHTML =
    `<span class="h">País</span><span class="h">53 FT (USD)</span><span class="h">3 ejes (USD)</span>`+
    DG_PAISES.map(p=>`<span class="p"><i style="background:${p.c}"></i>${p.l}</span>
      <input type="number" min="0" step="1" id="dg-t53-${p.k}" value="${t.paises[p.k].t53||''}" placeholder="0" aria-label="Tarifa 53 FT ${p.l}">
      <input type="number" min="0" step="1" id="dg-t3e-${p.k}" value="${t.paises[p.k].t3e||''}" placeholder="igual a 53 FT" aria-label="Tarifa 3 ejes ${p.l}">`).join('');
  document.getElementById('dg-tar-meta').value=t.meta;
  document.getElementById('modal-tarifas').classList.add('open');
}
function dgGuardarTarifas(){
  const t={meta:Math.min(100,Math.max(1,dgNum(document.getElementById('dg-tar-meta').value)||85)), paises:{}};
  DG_PAISES.forEach(p=>{ t.paises[p.k]={t53:dgNum(document.getElementById('dg-t53-'+p.k).value), t3e:dgNum(document.getElementById('dg-t3e-'+p.k).value)}; });
  dgTarifasMem=t;
  try{ localStorage.setItem(DG_LS_KEY, JSON.stringify(t)); }
  catch(e){ alert('No se pudieron guardar las tarifas en este navegador. Se usarán mientras la página esté abierta.'); }
  closeModals(); dashInit();
}

// ---------- costos facturados: importación del reporte (hoja COSTOS) ----------
function dgCatRubro(rubro){
  const r=dgNorm(rubro);
  if(r.includes('FLETE MARITIMO')) return 'Flete marítimo';
  if(r.includes('REINTEGRO')||/^\*\*(?!\*)/.test(r)) return 'Puerto, naviera y terceros';
  if(r.includes('CONSOLIDACION')||r.includes('COMISION')) return 'Consolidación y comisión';
  if(r.includes('ALMACENAMIENTO')||r.includes('ALMACENAJE')||r.startsWith('SEGURO')) return 'Almacenaje y seguro';
  if(r.includes('MANO DE OBRA')||r.includes('PALLET')||r.includes('TIEMPO EXTRA')||r.includes('MARCAJE')) return 'Mano de obra y pallets';
  return 'Servicios DT y trámites';
}
function dgEsReintegro(rubro){ const r=dgNorm(rubro); return r.includes('REINTEGRO')||/^\*\*(?!\*)/.test(r); }
function dgCargarCostos(){
  if(dgCostos) return dgCostos;
  try{ const c=JSON.parse(localStorage.getItem(DG_LS_COSTOS)||'null'); if(c&&c.v===3&&c.peds) dgCostos=c; }catch(e){}
  return dgCostos;
}
function dgElegirArchivoCostos(){ const i=document.getElementById('dg-costos-file'); i.value=''; i.click(); }
// Lee la hoja de costos de un libro de Excel (se usa en Importar costos y en Años anteriores)
function dgCostosDeLibro(wb,nombre){
      // Hoja con COMENTARIOS + TOTAL + RUBRO (normalmente "COSTOS")
      let ws=null, hdr=null;
      for(const n of wb.SheetNames){
        const rows=XLSX.utils.sheet_to_json(wb.Sheets[n],{header:1,range:0,defval:''});
        const h=(rows[0]||[]).map(dgNorm);
        if(h.includes('COMENTARIOS')&&h.includes('TOTAL')&&h.some(x=>x.includes('RUBRO'))){ ws=wb.Sheets[n]; hdr=h; break; }
      }
      if(!ws){ return {err:'No encontré la hoja de costos.\n\nDebe tener las columnas COMENTARIOS, TOTAL y RUBRO (como la hoja COSTOS del reporte de facturación).'}; }
      const col=(...nombres)=>{ for(const nm of nombres){ const i=hdr.findIndex(h=>h===nm||h.includes(nm)); if(i>=0) return i; } return -1; };
      const C={com:col('COMENTARIOS'),tot:col('TOTAL'),rub:col('NM ACTUAL RUBRO','RUBRO'),ter:col('DS TERCERO','CLIENTE'),fac:col('FACTURA'),tp:col('TP FACT'),imp:col('IMPRESION'),arr:col('FECHA DE ARRIBO'),sal:col('FECHA DE SALIDA')};
      if(C.imp<0){ return {err:'La hoja de costos no tiene la columna IMPRESION (fecha de factura). Sin ella no puedo ubicar el costo en su mes de facturación.'}; }
      const rows=XLSX.utils.sheet_to_json(ws,{header:1,defval:'',raw:true}).slice(1);
      const peds={}; let renglones=0, sinPedido=0, montoSin=0, compartidos=0, total=0, sinFecha=0;
      rows.forEach(r=>{
        const monto=dgNum(r[C.tot]); if(!monto&&!String(r[C.rub]||'').trim()) return;
        renglones++; total+=monto;
        const lista=[...new Set(String(r[C.com]||'').match(/\b4[25]\d{8}\b/g)||[])];
        if(!lista.length){ sinPedido++; montoSin+=monto; return; }
        if(lista.length>1) compartidos++;
        const fFac=dgFecha(r[C.imp]); if(!fFac) sinFecha++;
        const cat=dgCatRubro(r[C.rub]), reint=dgEsReintegro(r[C.rub]), parte=monto/lista.length;
        const factura=[String(r[C.tp]||'').trim(),String(r[C.fac]||'').trim()].filter(Boolean).join(' ');
        const kF=fFac?dgKey(fFac):'';
        lista.forEach(p=>{
          // Un registro por pedido y mes de factura: cada factura cae en su propio mes
          const id=p+'|'+kF;
          const o=peds[id]=peds[id]||{pedido:p,kFac:kF,pais:dgPais(r[C.ter]),total:0,serv:0,reint:0,cats:{},conds:{},facturas:[],fFac:'',fArr:'',fSal:'',compartido:false};
          o.total+=parte; if(reint) o.reint+=parte; else o.serv+=parte;
          o.cats[cat]=(o.cats[cat]||0)+parte;
          const cnd=costCondRubro(r[C.rub]); o.conds[cnd]=(o.conds[cnd]||0)+parte;
          if(factura&&!o.facturas.includes(factura)) o.facturas.push(factura);
          if(factura){ o.det=o.det||{}; const dd=o.det[factura]=o.det[factura]||{m:0,f:'',s:0,r:0,c:{}}; dd.m+=parte; if(reint) dd.r+=parte; else dd.s+=parte; dd.c[cnd]=(dd.c[cnd]||0)+parte; if(fFac) dd.f=dgIso(fFac); }
          if(fFac&&(!o.fFac||dgIso(fFac)>o.fFac)) o.fFac=dgIso(fFac);
          if(!o.fArr){ const d=dgFecha(r[C.arr]); if(d) o.fArr=dgIso(d); }
          if(!o.fSal){ const d=dgFecha(r[C.sal]); if(d) o.fSal=dgIso(d); }
          if(lista.length>1) o.compartido=true;
        });
      });
      Object.values(peds).forEach(o=>{ ['total','serv','reint'].forEach(k=>o[k]=Math.round(o[k]*100)/100); if(o.det) Object.values(o.det).forEach(d=>{ d.m=Math.round(d.m*100)/100; d.s=Math.round(d.s*100)/100; d.r=Math.round(d.r*100)/100; Object.keys(d.c||{}).forEach(k=>d.c[k]=Math.round(d.c[k]*100)/100); }); Object.keys(o.cats).forEach(k=>o.cats[k]=Math.round(o.cats[k]*100)/100); });
      const nPed=new Set(Object.values(peds).map(o=>o.pedido)).size;
      if(!nPed){ return {err:'La hoja no trae números de pedido en COMENTARIOS (10 dígitos que empiezan con 42 o 45).'}; }
      return {costos:{v:3,meta:{archivo:nombre,cargado:dgIso(dgHoy()),renglones,pedidos:nPed,sinPedido,montoSin:Math.round(montoSin*100)/100,compartidos,sinFecha,total:Math.round(total*100)/100},peds}};
}
function dgImportarCostos(input){
  const file=input.files&&input.files[0]; if(!file) return;
  if(typeof XLSX==='undefined'){ alert('No se pudo cargar el lector de Excel. Revisa la conexión a internet y vuelve a intentar.'); return; }
  const btn=document.getElementById('dg-btn-costos'); if(btn){ btn.disabled=true; btn.textContent='Leyendo…'; }
  const fr=new FileReader();
  fr.onload=e=>{
    try{
      const wb=XLSX.read(new Uint8Array(e.target.result),{type:'array',cellDates:true});
      const R=dgCostosDeLibro(wb,file.name);
      if(R.err){ alert(R.err); return; }
      dgCostos=R.costos;
      try{ localStorage.setItem(DG_LS_COSTOS, JSON.stringify(dgCostos)); }
      catch(err){ alert('Los costos se cargaron, pero este navegador no permitió guardarlos: se perderán al cerrar la página.'); }
      const m=dgCostos.meta;
      alert(`✅ Costos importados\n\n${dgFmt(m.pedidos)} pedidos · ${dgUsd(m.total-m.montoSin)} ligados a pedido\n${dgFmt(m.renglones)} renglones leídos${m.sinPedido?`\n⚠ ${m.sinPedido} renglones sin número de pedido (${dgUsd(m.montoSin)}) no se incluyen`:''}${m.compartidos?`\n⚠ ${m.compartidos} renglones con 2 pedidos: repartidos en partes iguales`:''}\n\nCada costo se ubica en el mes de su factura.`);
      dashInit();
    }catch(err){ console.error(err); alert('No se pudo leer el archivo: '+err.message); }
    finally{ if(btn){ btn.disabled=false; btn.textContent='Importar costos'; } }
  };
  fr.readAsArrayBuffer(file);
}
function dgQuitarCostos(){
  if(!confirm('¿Quitar los costos importados? El Dashboard volverá a estimar con las tarifas de flete.')) return;
  dgCostos=null; try{ localStorage.removeItem(DG_LS_COSTOS); }catch(e){}
  dashInit();
}

// ---------- modelo de datos ----------
function dgModelo(){
  const tar = dgTarifasMem || dgLoadTarifas();
  const CO = dgCargarCostos();
  const ESTADOS_SALIDA=['CARGADO','DESPACHADO'];
  const salidas=[];
  (historial||[]).forEach(r=>salidas.push({...r,_src:'hist'}));
  archHist().forEach(r=>salidas.push({...r,_src:'hist'}));   // años anteriores (archivo histórico)
  (despachos||[]).forEach(r=>{ if(ESTADOS_SALIDA.includes(String(r.status||'').toUpperCase())) salidas.push({...r,_src:'act'}); });
  const enCola=(despachos||[]).filter(r=>!ESTADOS_SALIDA.includes(String(r.status||'').toUpperCase())).length;

  const peds=salidas.map((r,i)=>{
    const sal=dgFecha(r.fsalida||r.fcarga||r.fechaArchivo);
    return {
      k:sal?dgKey(sal):dgKeyDe(null,r.mes,r.fechaArchivo), ref:String(r.ref||'').trim(), pedido:String(r.no_pedido||'').trim(), pais:dgPais(r.dest),
      pal:dgNum(r.pallets), kg:dgNum(r.peso), equipo:String(r.equipo||''), estado:r._src==='hist'?'ARCHIVADO':String(r.status||''),
      _i:i, ing:dgFecha(r.fingreso), sal
    };
  });
  peds.forEach(p=>{ p.dias=dgDias(p.ing,p.sal); });

  // Viajes = referencia UL (sin referencia → viaje propio)
  const viajes={};
  peds.forEach(p=>{
    const key=p.ref?('R:'+p.ref.toUpperCase()):('P:'+p._i);
    p.viaje=key;
    const v=(viajes[key]=viajes[key]||{key,ref:p.ref,peds:[],pal:0,kg:0,paises:new Set(),es3e:false});
    v.peds.push(p); v.pal+=p.pal; v.kg+=p.kg; v.paises.add(p.pais);
    if(/3\s*EJES/i.test(p.equipo)) v.es3e=true;
  });
  const conTarifa=dgTieneTarifas(tar);
  const costoPorPedido={};
  // Costos: reporte de facturación importado + costos capturados en Despacho (el importado manda si están ambos)
  const importados=new Set(CO?Object.values(CO.peds).map(o=>o.pedido):[]);
  const capturados=[];
  [...(despachos||[]),...(historial||[])].forEach(r=>{
    const l=costLista(r); const ped=String(r.no_pedido||'').trim();
    if(!l||!l.length||!ped||importados.has(ped)) return;
    const res=costResumen(l), sal=dgFecha(r.fsalida||r.fechaArchivo||r.fcarga);
    capturados.push({pedido:ped,k:sal?dgKey(sal):dgKeyDe(null,r.mes,null),pais:dgPais(r.dest),total:res.total,serv:res.serv,reint:res.reint,cats:res.cats,conds:res.conds,origen:'captura'});
  });
  if(CO) Object.values(CO.peds).forEach(o=>{ costoPorPedido[o.pedido]=(costoPorPedido[o.pedido]||0)+o.total; });
  capturados.forEach(o=>{ costoPorPedido[o.pedido]=(costoPorPedido[o.pedido]||0)+o.total; });
  Object.values(viajes).forEach(v=>{
    if(v.kg>DG_CAP.kg53) v.es3e=true;
    const capKg=v.es3e?DG_CAP.kg3e:DG_CAP.kg53;
    v.fill=(v.pal||v.kg)?Math.max(v.pal/DG_CAP.pal, v.kg/capKg)*100:null;
    let costo=0;
    v.paises.forEach(n=>{ const P=DG_BY_N[n]; if(!P) return; const t=tar.paises[P.k]; const c=v.es3e?(t.t3e||t.t53):t.t53; if(c>costo) costo=c; });
    const basePal=v.peds.reduce((a,p)=>a+p.pal,0), baseKg=v.peds.reduce((a,p)=>a+p.kg,0);
    v.peds.forEach(p=>{
      const share = basePal>0 ? p.pal/basePal : baseKg>0 ? p.kg/baseKg : 1/v.peds.length;
      p.costoEst=costo*share; p.fill=v.fill;
      p.costoReal=costoPorPedido[p.pedido]!=null?costoPorPedido[p.pedido]:null;
    });
  });

  // Ingresos: contenedores (activos + historial) sin duplicar los ya enviados a NP
  const vistos=new Set(), conts=[];
  [...(contenedores||[]),...(historialCont||[]),...archConts()].forEach(r=>{
    const key=(String(r.cont||'')+'|'+String(r.doc||'')).toUpperCase();
    if(vistos.has(key)) return; vistos.add(key); conts.push(r);
  });
  const pedOrigen={};
  const ingresos=conts.map(r=>{
    const porPais={}; let nPed=0;
    const origen=dgOrigen(r.origen);
    contPedidos(r).forEach(p=>{
      if(contVacio(p.pedido)) return;
      const P=DG_PAISES.find(x=>x.k===p.pais); if(!P) return;
      const o=porPais[P.n]=porPais[P.n]||{kg:0,bultos:0,peds:0};
      o.kg+=dgNum(p.peso); o.bultos+=dgNum(p.bultos); o.peds++; nPed++;
      pedOrigen[String(p.pedido).trim()]=origen;
    });
    const f=dgFecha(r.fdesc)||dgFecha(r.eta_blue);
    return {k:f?dgKey(f):dgKeyDe(null,r.mes,null), kg:dgNum(r.peso), porPais, peds:nPed, origen, cont:r.cont||r.doc||''};
  });
  peds.forEach(p=>{ p.origen=pedOrigen[p.pedido]||''; });

  // Costos facturados por pedido (mes de factura)
  const costos=(CO?Object.values(CO.peds).map(o=>({...o,k:o.kFac})):[]).concat(capturados).map(c=>({...c,origenCarga:pedOrigen[String(c.pedido).trim()]||''}));
  // kg por pedido (para costo por tonelada): de los despachos del HUB
  const kgPed={}; peds.forEach(p=>{ if(p.pedido&&p.kg) kgPed[p.pedido]=(kgPed[p.pedido]||0)+p.kg; });

  // Inventario en bodega hoy
  const hoy=dgHoy(), stock=[];
  const addStock=(pedido,pais,fing,donde)=>{ const ing=dgFecha(fing); stock.push({pedido,pais:dgPais(pais),ing,dias:ing?Math.max(0,Math.round((hoy-ing)/86400000)):null,donde}); };
  (noProg||[]).forEach(r=>addStock(r.pedido,r.dest||r.pais,r.fdescarga,'No programado'));
  (despachos||[]).forEach(r=>{ if(!ESTADOS_SALIDA.includes(String(r.status||'').toUpperCase())) addStock(r.no_pedido,r.dest,r.fingreso,'En despacho'); });
  (contenedores||[]).forEach(r=>{
    if(r.enviado&&String(r.enviado)!=='false') return;
    if(!['05-EN DESCARGA','06-DESCARGADO','07-NOTIFICADO VACÍO'].includes(String(r.estado||'').toUpperCase())) return;
    contPedidos(r).forEach(p=>{ if(p.salida||contVacio(p.pedido)) return; const P=DG_PAISES.find(x=>x.k===p.pais); addStock(p.pedido,P?P.n:p.pais,r.fdesc,'Contenedor descargado'); });
  });
  stock.forEach(x=>{ x.origen=pedOrigen[String(x.pedido||'').trim()]||''; });
  return {tar, conTarifa, CO, real:costos.length>0, costos, kgPed, peds, viajes:Object.values(viajes), ingresos, enCola, stock, pedOrigen};
}

// ---------- agregados con filtros ----------
function dgAgregar(M, pais, per, origen){
  if(origen===undefined) origen=dgState.origen;
  const peds=M.peds.filter(p=>(!pais||p.pais===pais)&&dgEnPer(p.k,per)&&(!origen||p.origen===origen));
  const viajeKeys=new Set(peds.map(p=>p.viaje));
  const viajes=M.viajes.filter(v=>viajeKeys.has(v.key));
  const fills=viajes.map(v=>v.fill).filter(f=>f!=null);
  const ings=M.ingresos.filter(i=>dgEnPer(i.k,per)&&(!pais||i.porPais[pais])&&(!origen||i.origen===origen));
  const kgIng=ings.reduce((a,i)=>a+(pais?(i.porPais[pais].kg||0):i.kg),0);
  const pedIng=ings.reduce((a,i)=>a+(pais?(i.porPais[pais].peds||0):i.peds),0);
  const kgDesp=peds.reduce((a,p)=>a+p.kg,0);
  const d=peds.map(p=>p.dias).filter(v=>v!=null);
  const A={
    pedidos:peds.length, viajes:viajes.length, tnDesp:kgDesp/1000, tnIng:kgIng/1000, contIng:ings.length, pedIng, ingsL:ings,
    fill:fills.length?fills.reduce((a,b)=>a+b,0)/fills.length:null, pal:peds.reduce((a,p)=>a+p.pal,0), peds, viajesL:viajes,
    diasProm:d.length?d.reduce((a,b)=>a+b,0)/d.length:null, diasMed:dgMediana(d), diasMax:d.length?Math.max(...d):null, diasN:d.length, diasSin:peds.length-d.length, diasL:d
  };
  if(M.real){
    // Costo facturado: pedidos con factura en el periodo (mes de factura)
    const cs=M.costos.filter(c=>(!pais||c.pais===pais)&&dgEnPer(c.k,per)&&(!origen||c.origenCarga===origen));
    A.cPedidos=new Set(cs.map(c=>c.pedido)).size; A.costo=cs.reduce((a,c)=>a+c.total,0);
    A.serv=cs.reduce((a,c)=>a+c.serv,0); A.reint=cs.reduce((a,c)=>a+c.reint,0);
    A.cats={}; DG_CATS.forEach(k=>A.cats[k]=cs.reduce((a,c)=>a+(c.cats[k]||0),0));
    A.conds={}; COND_ORDEN.forEach(k=>A.conds[k]=cs.reduce((a,c)=>a+((c.conds||{})[k]||0),0));
    A.costoPed=A.cPedidos?A.costo/A.cPedidos:0;
    const conKg=cs.filter(c=>M.kgPed[c.pedido]);
    const kg=conKg.reduce((a,c)=>a+M.kgPed[c.pedido],0);
    A.costoTn=kg>0?conKg.reduce((a,c)=>a+c.total,0)/(kg/1000):null;
  }else{
    A.cPedidos=peds.length; A.costo=peds.reduce((a,p)=>a+(p.costoEst||0),0);
    A.costoPed=peds.length?A.costo/peds.length:0; A.costoTn=kgDesp>0?A.costo/(kgDesp/1000):null;
  }
  return A;
}
function dgKeysConDatos(M){
  const s=new Set(); M.peds.forEach(p=>p.k&&s.add(p.k)); M.ingresos.forEach(i=>i.k&&s.add(i.k)); M.costos.forEach(c=>c.k&&s.add(c.k));
  return [...s].sort();
}

// ---------- filtros UI ----------
function dgRenderFiltros(M){
  const chip=(val,label,color)=>`<button class="dg-chip" aria-pressed="${dgState.pais===val}" onclick="dgSetPais('${val}')"><span class="dot" style="${color?`--c:${color}`:''}"></span>${label}</button>`;
  document.getElementById('dg-paises').innerHTML=chip('','Todos los países','')+DG_PAISES.map(p=>chip(p.n,p.l,p.c)).join('');
  const keys=dgKeysConDatos(M);
  if(dgState.per&&dgState.per.length===7&&!keys.includes(dgState.per)) keys.push(dgState.per);
  const anios=[...new Set(keys.map(k=>k.slice(0,4)))].sort().reverse();
  const opt=(v,l)=>`<option value="${v}"${v===dgState.per?' selected':''}>${l}</option>`;
  const oc={}; M.ingresos.forEach(i=>{ oc[i.origen]=(oc[i.origen]||0)+1; });
  const ors=Object.keys(oc).sort((a,b)=>oc[b]-oc[a]);
  if(dgState.origen&&!ors.includes(dgState.origen)) ors.push(dgState.origen);
  const so=document.getElementById('dg-origen');
  if(so) so.innerHTML=`<option value="">Todos los orígenes</option>`+ors.map(o=>`<option value="${dgEsc(o)}"${o===dgState.origen?' selected':''}>${dgEsc(dgOrigenLabel(o))}</option>`).join('');
  document.getElementById('dg-mes').innerHTML=opt('','Todo el periodo')+anios.map(y=>
    `<optgroup label="${y}">${opt(y,'Año '+y)}${keys.filter(k=>k.startsWith(y)).sort().reverse().map(k=>opt(k,dgKeyLargo(k))).join('')}</optgroup>`).join('');
}
function dgSetPais(v){ dgState.pais=v; dashInit(); }
function dgSetOrigen(v){ dgState.origen=v; dashInit(); }
function dgSetMes(v){ dgState.per=v; dgState._perTocado=true; dashInit(); }

// ---------- KPIs ----------
function dgDelta(act, prev, kPrev, invertir){
  if(prev==null||!isFinite(prev)||prev===0||act==null) return '';
  const d=(act-prev)/Math.abs(prev)*100, anual=String(kPrev).length===4, et=anual?kPrev:dgKeyLabel(kPrev), larg=anual?'el año '+kPrev:dgKeyLargo(kPrev);
  if(Math.abs(d)<0.5) return `<span class="dg-delta flat" title="Igual que ${larg}">= ${et}</span>`;
  const bueno=invertir?d<0:d>0;
  return `<span class="dg-delta ${bueno?'up':'down'}" title="Contra ${larg}">${d>0?'▲':'▼'} ${Math.abs(d).toFixed(0)}% vs ${et}</span>`;
}
function dgRenderKpis(M, A, Ap, kPrev){
  const meta=M.tar.meta;
  const k=(cls,label,val,sub)=>`<div class="dg-kpi ${cls}"><div class="dg-kpi-label">${label}</div><div class="dg-kpi-val">${val}</div><div class="dg-kpi-sub">${sub}</div></div>`;
  const fillW=A.fill==null?0:Math.min(100,A.fill);
  const fillSub=A.fill==null?'Sin viajes con pallets o peso':
    `<div class="dg-meter" aria-hidden="true"><i style="width:${fillW}%"></i><b style="left:calc(${meta}% - 1px)"></b></div>${A.fill>=meta?'✓ Sobre la meta':'⚠ Bajo la meta'} de ${meta}% ${Ap?dgDelta(A.fill,Ap.fill,kPrev):''}`;
  let costoBox;
  if(M.real){
    const pr=A.costo>0?Math.round(A.reint/A.costo*100):0;
    costoBox=A.cPedidos
      ? k('','Costo por pedido',dgUsd(A.costoPed),`${dgUsd(A.costo)} facturado · ${pr}% reintegros ${Ap?dgDelta(A.costoPed,Ap.costoPed,kPrev,true):''}`)
      : k('','Costo por pedido','<span style="color:var(--text-hint)">—</span>','Sin facturas en este periodo');
  }else if(M.conTarifa){
    costoBox=k('','Costo por pedido <em class="dg-est">estimado</em>',dgUsd(A.costoPed),`${dgUsd(A.costo)} según tarifas ${Ap?dgDelta(A.costoPed,Ap.costoPed,kPrev,true):''}`);
  }else{
    costoBox=`<div class="dg-kpi"><div class="dg-kpi-label">Costo por pedido</div><div class="dg-kpi-val" style="color:var(--text-hint)">—</div><button class="dg-kpi-cta" onclick="dgElegirArchivoCostos()">Importar costos</button></div>`;
  }
  document.getElementById('dg-kpis').innerHTML=
    k('hero','Pedidos despachados',dgFmt(A.pedidos),`${Ap?dgDelta(A.pedidos,Ap.pedidos,kPrev):''} ${dgFmt(A.viajes)} viajes · ${dgFmt(A.pal)} pallets${M.enCola&&!dgState.per?` · ${M.enCola} en cola`:''}`)+
    (A.diasProm==null
      ? `<div class="dg-kpi"><div class="dg-kpi-label">Días en bodega</div><div class="dg-kpi-val" style="color:var(--text-hint)">—</div><div class="dg-kpi-sub">${A.pedidos?'Los despachos no traen fecha de ingreso todavía':'Sin pedidos despachados'}</div></div>`
      : k('','Días en bodega',dgFmt(A.diasProm,1)+'<small>días</small>',`Mediana ${dgFmt(A.diasMed,0)} · máx. ${dgFmt(A.diasMax)} ${Ap?dgDelta(A.diasProm,Ap.diasProm,kPrev,true):''}${A.diasSin?`<br>${A.diasSin} sin fecha de ingreso`:''}`))+
    k('','Toneladas despachadas',dgFmt(A.tnDesp,1)+'<small>tn</small>',`${A.viajes?dgFmt(A.tnDesp/A.viajes,1):'0'} tn por viaje ${Ap?dgDelta(A.tnDesp,Ap.tnDesp,kPrev):''}`)+
    (dgState.pais
      ? k('','Pedidos ingresados',dgFmt(A.pedIng),`llegaron en ${dgFmt(A.contIng)} contenedor${A.contIng===1?'':'es'} · ${dgFmt(A.tnIng,1)} tn ${Ap?dgDelta(A.pedIng,Ap.pedIng,kPrev):''}`)
      : k('','Contenedores ingresados',dgFmt(A.contIng),`${dgFmt(A.pedIng)} pedidos · ${dgFmt(A.tnIng,1)} tn recibidas ${Ap?dgDelta(A.contIng,Ap.contIng,kPrev):''}`))+
    k('','Truck fill promedio',A.fill==null?'—':dgFmt(A.fill,0)+'<small>%</small>',fillSub)+
    costoBox;
}


// ---------- origen de la carga ----------
function dgRenderOrigen(M){
  const pais=dgState.pais, per=dgState.per, sel=dgState.origen;
  const Pf=pais?DG_BY_N[pais]:null;
  const A=dgAgregar(M,pais,per,'');           // todos los orígenes, para comparar
  const g={};
  A.ingsL.forEach(i=>{
    const o=g[i.origen]=g[i.origen]||{origen:i.origen,kg:0,peds:0,conts:0,dest:{}};
    o.conts++;
    if(pais){ const x=i.porPais[pais]; o.kg+=x.kg||0; o.peds+=x.peds||0; }
    else{ o.kg+=i.kg; o.peds+=i.peds; Object.entries(i.porPais).forEach(([n,x])=>{ o.dest[n]=(o.dest[n]||0)+(x.kg||0); }); }
  });
  const L=Object.values(g).sort((a,b)=>b.kg-a.kg||b.peds-a.peds);
  const tot=L.reduce((a,o)=>a+o.kg,0);
  const col={}; L.forEach((o,i)=>col[o.origen]=o.origen==='SIN ORIGEN'?'#B8C2D1':DG_ORIG_COL[i%DG_ORIG_COL.length]);
  document.getElementById('dg-n-orig').textContent = pais
    ? `Pedidos de ${Pf.l} según el país de donde vienen · ${dgPerLabel(per).toLowerCase()}`
    : `Toneladas que entran a Blue según su origen · ${dgPerLabel(per).toLowerCase()}`;
  document.getElementById('dg-orig-hint').textContent = sel?'Clic de nuevo en el origen para ver todos':'Clic en un origen para filtrar el reporte';
  document.getElementById('dg-orig-th-cont').textContent = pais?'Cont.*':'Cont.';
  const tb=document.getElementById('dg-orig-body');
  if(!L.length){
    tb.innerHTML='<tr><td colspan="6" style="color:var(--text-hint)">Sin ingresos en este filtro</td></tr>';
    dgEmpty('dg-c-orig','Sin ingresos en este filtro','Cambia el país o el periodo.'); return;
  }
  tb.innerHTML=L.map(o=>{
    const top=pais?Pf.l:(Object.entries(o.dest).sort((a,b)=>b[1]-a[1])[0]||[''])[0];
    const P=DG_BY_N[top]; const pct=tot?o.kg/tot*100:0;
    return `<tr class="dg-click${sel&&sel!==o.origen?' dim':''}${sel===o.origen?' on':''}" onclick="dgSetOrigen('${sel===o.origen?'':dgEsc(o.origen)}')">
      <td><span class="dg-pais"><i style="background:${col[o.origen]}"></i>${dgEsc(dgOrigenLabel(o.origen))}</span></td>
      <td class="num">${dgFmt(o.kg/1000,1)}</td><td class="num"><b>${dgFmt(pct,0)}%</b></td><td class="num">${dgFmt(o.peds)}</td><td class="num">${dgFmt(o.conts)}</td>
      <td>${pais?'—':(P?`<span class="dg-pais"><i style="background:${P.c}"></i>${P.l}</span>`:'—')}</td></tr>`;
  }).join('')+`<tr class="dg-total"><td>Total</td><td class="num">${dgFmt(tot/1000,1)}</td><td class="num">100%</td><td class="num">${dgFmt(L.reduce((a,o)=>a+o.peds,0))}</td><td class="num">${dgFmt(L.reduce((a,o)=>a+o.conts,0))}</td><td>${pais?'<small style="color:var(--text-hint)">*con pedidos del país</small>':''}</td></tr>`;
  if(!dgChartBase()) return;
  dashCharts.orig=new Chart(dgCanvas('dg-c-orig'),{type:'bar',
    data:{labels:L.map(o=>dgOrigenLabel(o.origen)),datasets:[{label:'Toneladas',data:L.map(o=>+(o.kg/1000).toFixed(2)),
      backgroundColor:L.map(o=>(!sel||sel===o.origen)?col[o.origen]:dgAlpha(col[o.origen],.25)),borderRadius:6,borderSkipped:false,maxBarThickness:26}]},
    options:{indexAxis:'y',responsive:true,maintainAspectRatio:false,
      onClick:(e,els)=>{ if(els.length){ const o=L[els[0].index].origen; dgSetOrigen(sel===o?'':o); } },
      plugins:{legend:{display:false},tooltip:{callbacks:{label:c=>{ const o=L[c.dataIndex]; return ` ${dgFmt(c.raw,1)} tn · ${dgFmt(tot?o.kg/tot*100:0,0)}% · ${dgFmt(o.peds)} pedidos · ${dgFmt(o.conts)} contenedores`; }}}},
      scales:{x:{grid:{color:DG_C.grid},border:{display:false},ticks:{color:DG_C.hint,callback:v=>dgCompact(v)+' tn'}},y:{grid:{display:false},border:{display:false},ticks:{color:DG_C.ink,font:{weight:'600'}}}}}});
}

// ---------- gráficos ----------
function dgChartBase(){
  if(typeof Chart==='undefined') return false;
  Chart.defaults.font.family="'Manrope',system-ui,sans-serif";
  Chart.defaults.font.size=11.5;
  Chart.defaults.color=DG_C.muted;
  Chart.defaults.plugins.tooltip.backgroundColor=DG_C.deep;
  Chart.defaults.plugins.tooltip.titleFont={family:"'Sora','Manrope',sans-serif",weight:'700',size:12};
  Chart.defaults.plugins.tooltip.bodyFont={family:"'Manrope',sans-serif",weight:'600',size:12};
  Chart.defaults.plugins.tooltip.padding=10;
  Chart.defaults.plugins.tooltip.cornerRadius=10;
  Chart.defaults.plugins.tooltip.boxPadding=4;
  Chart.defaults.plugins.tooltip.usePointStyle=true;
  return true;
}
function dgAxes(yFmt, yMax){
  return {
    x:{grid:{display:false},border:{color:DG_C.grid},ticks:{color:DG_C.muted,font:{weight:'600'},maxRotation:0,autoSkipPadding:8}},
    y:{beginAtZero:true,max:yMax,grid:{color:DG_C.grid,drawTicks:false},border:{display:false},ticks:{color:DG_C.hint,padding:8,maxTicksLimit:5,callback:yFmt||(v=>dgCompact(v))}}
  };
}
function dgEmpty(canvasId, titulo, texto, ctaHtml){
  const c=document.getElementById(canvasId); if(!c) return;
  const wrap=c.parentElement;
  wrap.querySelectorAll('.dg-empty').forEach(e=>e.remove());
  c.style.display='none';
  wrap.insertAdjacentHTML('beforeend',`<div class="dg-empty"><strong>${titulo}</strong><span>${texto}</span>${ctaHtml||''}</div>`);
}
function dgCanvas(id){
  const c=document.getElementById(id); if(!c) return null;
  c.style.display=''; c.parentElement.querySelectorAll('.dg-empty').forEach(e=>e.remove());
  return c;
}
function dgAlpha(hex, a){ const n=parseInt(hex.slice(1),16); return `rgba(${n>>16&255},${n>>8&255},${n&255},${a})`; }
// Resalta el mes seleccionado: los demás se atenúan
function dgSelMes(){ return dgState.per&&dgState.per.length===7?dgState.per:''; }
function dgColorMes(color, keys){ const s=dgSelMes(); return keys.map(k=>(!s||k===s)?color:dgAlpha(color,.28)); }
function dgTopRadius(ctx){
  const ch=ctx.chart, i=ctx.dataIndex, di=ctx.datasetIndex;
  for(let k=ch.data.datasets.length-1;k>di;k--){ if(ch.isDatasetVisible(k) && (ch.data.datasets[k].data[i]||0)>0) return 0; }
  return {topLeft:4,topRight:4,bottomLeft:0,bottomRight:0};
}
function dgLegend(id, items){
  const el=document.getElementById(id); if(!el) return;
  el.innerHTML=items.map(it=>`<span><i class="${it.line?'line':''}" style="background:${it.c}"></i>${dgEsc(it.l)}</span>`).join('');
}
// Meses que muestran los gráficos: los del año elegido, o todos
function dgKeysGrafico(M){
  const all=dgKeysConDatos(M), y=dgState.per?dgState.per.slice(0,4):'';
  return y?all.filter(k=>k.startsWith(y)):all;
}

function dgRenderCharts(M, A){
  if(!dgChartBase()) return;
  const keys=dgKeysGrafico(M);
  const pais=dgState.pais;
  const Pf=pais?DG_BY_N[pais]:null;
  const porMes=keys.map(k=>dgAgregar(M,pais,k));
  const labels=keys.map(dgKeyLabel);
  const tipTitle=items=>dgKeyLargo(keys[items[0].dataIndex]);
  const intTick=v=>Number.isInteger(v)?dgCompact(v):'';

  // 1) Pedidos despachados por mes (apilado por país)
  if(!keys.length || !M.peds.length){ dgEmpty('dg-c-desp','Sin despachos registrados','Aparecerán cuando haya pedidos cargados, despachados o archivados.'); dgLegend('dg-l-desp',[]); }
  else{
    const series = pais ? [Pf] : DG_PAISES;
    const ds = series.map(P=>({
      label:P.l, _c:P.c, data:keys.map(k=>dgAgregar(M,P.n,k).pedidos),
      backgroundColor:dgColorMes(P.c,keys), borderColor:DG_C.surface, borderWidth:{top:2,left:0,right:0,bottom:0},
      borderRadius:dgTopRadius, borderSkipped:false, maxBarThickness:24, stack:'s'
    })).filter(d=>d.data.some(v=>v>0));
    dgLegend('dg-l-desp', ds.length>1?ds.map(d=>({l:d.label,c:d._c})):[]);
    if(!ds.length) dgEmpty('dg-c-desp','Sin despachos en este filtro','Cambia el país o el periodo.');
    else dashCharts.desp=new Chart(dgCanvas('dg-c-desp'),{type:'bar',data:{labels,datasets:ds},
      options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false},
        tooltip:{mode:'index',intersect:false,itemSort:(a,b)=>b.raw-a.raw,filter:i=>i.raw>0,callbacks:{title:tipTitle,label:c=>` ${c.dataset.label}: ${dgFmt(c.raw)} pedidos`,footer:it=>it.length>1?`Total: ${dgFmt(it.reduce((a,b)=>a+b.raw,0))}`:''}}},
        scales:{x:{...dgAxes().x,stacked:true},y:{...dgAxes(intTick).y,stacked:true}}}});
  }

  // 2) Contenedores ingresados por mes
  const ingData=porMes.map(a=>pais?a.pedIng:a.contIng);
  document.getElementById('dg-t-ing').textContent = pais?'Pedidos ingresados por mes':'Contenedores ingresados por mes';
  if(!ingData.some(v=>v>0)){ dgEmpty('dg-c-ing','Sin ingresos en este filtro', pais?'Ningún contenedor trae pedidos para '+Pf.l+'.':'Registra contenedores en Ingreso de Equipo.'); }
  else{
    const col=Pf?Pf.c:DG_C.blue;
    dashCharts.ing=new Chart(dgCanvas('dg-c-ing'),{type:'bar',data:{labels,datasets:[{label:pais?'Pedidos':'Contenedores',data:ingData,backgroundColor:dgColorMes(col,keys),borderRadius:{topLeft:4,topRight:4},borderSkipped:false,maxBarThickness:24}]},
      options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false},tooltip:{callbacks:{title:tipTitle,label:c=>pais?` ${dgFmt(c.raw)} pedidos · en ${dgFmt(porMes[c.dataIndex].contIng)} contenedores · ${dgFmt(porMes[c.dataIndex].tnIng,1)} tn`:` ${dgFmt(c.raw)} contenedores · ${dgFmt(porMes[c.dataIndex].pedIng)} pedidos · ${dgFmt(porMes[c.dataIndex].tnIng,1)} tn`}}},scales:dgAxes(intTick)}});
  }
  document.getElementById('dg-n-ing').textContent = pais?`Pedidos de ${Pf.l} (un contenedor puede traer pedidos de varios países)`:'Equipos recibidos en Blue';

  // 3) Toneladas: ingresadas vs despachadas (misma unidad, un eje)
  const tnI=porMes.map(a=>+a.tnIng.toFixed(2)), tnD=porMes.map(a=>+a.tnDesp.toFixed(2));
  if(!tnI.some(v=>v>0)&&!tnD.some(v=>v>0)){ dgEmpty('dg-c-tn','Sin toneladas registradas','Se calculan con el peso de contenedores y despachos.'); dgLegend('dg-l-tn',[]); }
  else{
    dgLegend('dg-l-tn',[{l:'Ingresadas',c:DG_C.sky},{l:'Despachadas',c:DG_C.deep}]);
    const bar=(l,d,c)=>({label:l,data:d,backgroundColor:dgColorMes(c,keys),borderRadius:{topLeft:4,topRight:4},borderSkipped:false,maxBarThickness:20,categoryPercentage:.62,barPercentage:.9});
    dashCharts.tn=new Chart(dgCanvas('dg-c-tn'),{type:'bar',data:{labels,datasets:[bar('Ingresadas',tnI,DG_C.sky),bar('Despachadas',tnD,DG_C.deep)]},
      options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false},tooltip:{mode:'index',intersect:false,callbacks:{title:tipTitle,label:c=>` ${c.dataset.label}: ${dgFmt(c.raw,1)} tn`}}},scales:dgAxes(v=>dgCompact(v)+' tn')}});
  }

  // 4) Truck fill promedio por mes + meta
  const meta=M.tar.meta;
  const tf=porMes.map(a=>a.fill==null?null:+a.fill.toFixed(1));
  if(!tf.some(v=>v!=null)){ dgEmpty('dg-c-tf','Sin viajes para calcular','El truck fill usa pallets (máx. 30) y peso (21 tn o 23 tn en 3 ejes) de cada viaje.'); document.getElementById('dg-buckets').innerHTML=''; }
  else{
    const vals=tf.filter(v=>v!=null);
    const yMax=Math.max(100,Math.ceil(Math.max(...vals)/10)*10);
    const yMin=Math.max(0,Math.floor((Math.min(...vals,meta)-15)/10)*10);
    const s=dgSelMes();
    dashCharts.tf=new Chart(dgCanvas('dg-c-tf'),{type:'line',data:{labels,datasets:[
        {label:'Truck fill',data:tf,borderColor:DG_C.blue,backgroundColor:dgAlpha(DG_C.blue,.10),fill:true,borderWidth:2,tension:.35,spanGaps:true,
         pointRadius:keys.map(k=>(!s||k===s)?4:2.5),pointHoverRadius:6,pointBackgroundColor:DG_C.blue,pointBorderColor:DG_C.surface,pointBorderWidth:2},
        {label:`Meta ${meta}%`,data:keys.map(()=>meta),borderColor:DG_C.ink,borderWidth:1.5,borderDash:[5,4],pointRadius:0,pointHoverRadius:0,fill:false}]},
      options:{responsive:true,maintainAspectRatio:false,interaction:{mode:'index',intersect:false},
        plugins:{legend:{display:false},tooltip:{filter:i=>i.datasetIndex===0,callbacks:{title:tipTitle,label:c=>` Truck fill: ${dgFmt(c.raw,1)}% · ${porMes[c.dataIndex].viajes} viajes`,footer:()=>`Meta: ${meta}%`}}},
        scales:{x:dgAxes().x,y:{...dgAxes(v=>v+'%',yMax).y,beginAtZero:false,min:yMin}}}});
    const b=[0,0,0,0]; A.viajesL.forEach(v=>{ if(v.fill==null) return; const f=v.fill; b[f<60?0:f<80?1:f<meta?2:3]++; });
    const lab=['Menos de 60%','60 – 79%',`80 – ${meta-1}%`,`${meta}% o más`];
    document.getElementById('dg-buckets').innerHTML=b.map((n,i)=>`<div class="dg-bucket ${i===3?'ok':''}"><span>${lab[i]}</span><strong>${n}</strong></div>`).join('');
  }
  document.getElementById('dg-n-tf').textContent=`Llenado de cada viaje contra la meta de ${meta}%`;

  // 5) Días en bodega por mes
  const dprom=porMes.map(a=>a.diasProm==null?null:+a.diasProm.toFixed(1));
  if(!dprom.some(v=>v!=null)){ dgEmpty('dg-c-dias','Sin fechas de ingreso','Los pedidos que pasen de No programados a Despacho traen su fecha de descarga y aquí se calcula cuánto estuvieron en bodega.'); document.getElementById('dg-dias-buckets').innerHTML=''; }
  else{
    const col=Pf?Pf.c:DG_C.blue;
    dashCharts.dias=new Chart(dgCanvas('dg-c-dias'),{type:'bar',data:{labels,datasets:[{label:'Días promedio',data:dprom,backgroundColor:dgColorMes(col,keys),borderRadius:{topLeft:4,topRight:4},borderSkipped:false,maxBarThickness:24}]},
      options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false},tooltip:{callbacks:{title:tipTitle,
        label:c=>` ${dgFmt(c.raw,1)} días en promedio`,afterLabel:c=>{const a=porMes[c.dataIndex];return ` Mediana ${dgFmt(a.diasMed,0)} · máx. ${dgFmt(a.diasMax)} · ${a.diasN} pedidos`;}}}},
        scales:dgAxes(v=>v+' d')}});
    const b=[0,0,0,0]; A.diasL.forEach(d=>{ b[d<=3?0:d<=7?1:d<=15?2:3]++; });
    const lab=['0 – 3 días','4 – 7 días','8 – 15 días','Más de 15'];
    document.getElementById('dg-dias-buckets').innerHTML=b.map((n,i)=>`<div class="dg-bucket ${i===0?'ok':''}"><span>${lab[i]}</span><strong>${n}</strong></div>`).join('');
  }

  // 6) Costo por mes
  const costTitle=document.getElementById('dg-t-cost'), costNote=document.getElementById('dg-n-cost');
  if(M.real){
    costTitle.textContent='Costo facturado por mes';
    costNote.textContent=dgState.vista==='cond'?'USD por condición del cliente':'USD, costo Blue y reintegros';
    const sv=porMes.map(a=>Math.round(a.serv||0)), re=porMes.map(a=>Math.round(a.reint||0));
    if(!sv.some(v=>v>0)&&!re.some(v=>v>0)){ dgEmpty('dg-c-cost','Sin facturas en este filtro','Cambia el país o el periodo.'); dgLegend('dg-l-cost',[]); }
    else{
      const st=(l,d,c)=>({label:l,data:d,backgroundColor:dgColorMes(c,keys),borderColor:DG_C.surface,borderWidth:{top:2,left:0,right:0,bottom:0},borderRadius:dgTopRadius,borderSkipped:false,maxBarThickness:24,stack:'c'});
      const sets=dgState.vista==='cond'
        ? COND_ORDEN.map(k=>st(`${k} · ${COND_INFO[k]}`,porMes.map(a=>Math.round((a.conds||{})[k]||0)),DG_COND_COL[k]))
        : [st('Servicios Blue',sv,DG_C.deep),st('Reintegros',re,DG_C.sky)];
      dgLegend('dg-l-cost',dgState.vista==='cond'?COND_ORDEN.map(k=>({l:`${k} · ${COND_INFO[k]}`,c:DG_COND_COL[k]})):[{l:'Servicios Blue',c:DG_C.deep},{l:'Reintegros',c:DG_C.sky}]);
      dashCharts.cost=new Chart(dgCanvas('dg-c-cost'),{type:'bar',data:{labels,datasets:sets},
        options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false},tooltip:{mode:'index',intersect:false,callbacks:{title:tipTitle,
          label:c=>` ${c.dataset.label}: ${dgUsd(c.raw)}`,footer:it=>{const a=porMes[it[0].dataIndex];return `Total ${dgUsd(a.costo)} · ${a.cPedidos} pedidos · ${dgUsd(a.costoPed)} por pedido`;}}}},
          scales:{x:{...dgAxes().x,stacked:true},y:{...dgAxes(v=>'$'+dgCompact(v)).y,stacked:true}}}});
    }
  }else{
    costTitle.textContent='Costo de flete por mes'; dgLegend('dg-l-cost',[]);
    costNote.textContent=M.conTarifa?'USD estimado con tarifas por país':'Importa el reporte de facturación para ver el costo real';
    if(!M.conTarifa){ dgEmpty('dg-c-cost','Sin costos','Importa tu reporte de facturación (hoja COSTOS) o carga tarifas de flete para estimar.','<button class="dg-kpi-cta" onclick="dgElegirArchivoCostos()">Importar costos</button>'); }
    else{
      const cst=porMes.map(a=>Math.round(a.costo));
      if(!cst.some(v=>v>0)) dgEmpty('dg-c-cost','Sin costos en este filtro','No hay viajes despachados para calcular.');
      else{
        const col=Pf?Pf.c:DG_C.blue;
        dashCharts.cost=new Chart(dgCanvas('dg-c-cost'),{type:'bar',data:{labels,datasets:[{label:'Costo',data:cst,backgroundColor:dgColorMes(col,keys),borderRadius:{topLeft:4,topRight:4},borderSkipped:false,maxBarThickness:24}]},
          options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false},tooltip:{callbacks:{title:tipTitle,label:c=>` ${dgUsd(c.raw)} estimado`,afterLabel:c=>` ${dgUsd(porMes[c.dataIndex].costoPed)} por pedido`}}},scales:dgAxes(v=>'$'+dgCompact(v))}});
      }
    }
  }
}

// ---------- composición del costo (rubros) ----------
function dgSetVista(v){ dgState.vista=v; dashInit(); }
function dgVistaToggle(){ const v=dgState.vista; return `<div class="dg-seg" role="group" aria-label="Ver costos por"><button aria-pressed="${v==='blue'}" onclick="dgSetVista('blue')">Grupo Blue</button><button aria-pressed="${v==='cond'}" onclick="dgSetVista('cond')">Condición cliente</button></div>`; }
const DG_COND_COL={ZFA1:'#2a78d6',ZIA1:'#eb6834',ZPB1:'#1baf7a'};
function dgRenderComposicion(M, A){
  const el=document.getElementById('dg-comp'), nota=document.getElementById('dg-n-comp');
  if(!M.real){
    nota.textContent='Por grupo de rubro facturado';
    el.innerHTML=`<div class="dg-empty"><strong>Sin costos facturados</strong><span>Importa la hoja COSTOS de tu reporte y verás en qué se va cada dólar: flete marítimo, puerto y naviera, servicios, almacenaje…</span><button class="dg-kpi-cta" onclick="dgElegirArchivoCostos()">Importar costos</button></div>`;
    return;
  }
  const tot=A.costo||0;
  nota.textContent=tot?`${dgUsd(tot)} facturado en ${dgPerLabel(dgState.per).toLowerCase()} · ${dgFmt(A.cPedidos)} pedidos`:'Sin facturas en este filtro';
  if(!tot){ el.innerHTML='<div class="dg-empty"><strong>Sin facturas en este filtro</strong><span>Cambia el país o el periodo.</span></div>'; return; }
  const filas=dgState.vista==='cond'
    ? COND_ORDEN.map(k=>({c:`${k} · ${COND_INFO[k]}`,v:A.conds[k]||0})).filter(f=>f.v>0)
    : DG_CATS.map(c=>({c,v:A.cats[c]||0})).filter(f=>f.v>0).sort((a,b)=>b.v-a.v);
  const max=Math.max(...filas.map(f=>f.v));
  el.innerHTML=filas.map(f=>`<div class="dg-comp-row"><span class="l">${f.c}</span><span class="bar"><i style="width:${f.v/max*100}%"></i></span><span class="v">${dgUsd(f.v)}</span><span class="p">${(f.v/tot*100).toFixed(1)}%</span></div>`).join('')+
    `<div class="dg-comp-split"><div><span>Servicios Blue</span><strong>${dgUsd(A.serv)}</strong><em>${dgUsd(A.cPedidos?A.serv/A.cPedidos:0)} por pedido</em></div><div><span>Reintegros</span><strong>${dgUsd(A.reint)}</strong><em>${(A.reint/tot*100).toFixed(0)}% del total</em></div></div>`;
}

// ---------- equipos en patio ----------
function dgRenderPipe(M){
  const pais=dgState.pais;
  const ESTADOS=['01-TRÁNSITO MARÍTIMO','02-TRAMITANDO EN PUERTO','03-EN TRÁNSITO TERRESTRE','04-POSICIONADO EN BLUE','05-EN DESCARGA','06-DESCARGADO','07-NOTIFICADO VACÍO'];
  const activos=(contenedores||[]).filter(r=>!(r.enviado&&String(r.enviado)!=='false'))
    .filter(r=>!pais||String(r[DG_BY_N[pais].k]||'').trim().replace(/^[-—]$/,''));
  const cnt=ESTADOS.map(e=>activos.filter(r=>String(r.estado||'').toUpperCase()===e).length);
  const max=Math.max(1,...cnt);
  document.getElementById('dg-n-pipe').textContent=`${activos.length} contenedor${activos.length===1?'':'es'} activo${activos.length===1?'':'s'}${pais?' con pedidos para '+DG_BY_N[pais].l:''}`;
  document.getElementById('dg-pipe').innerHTML=ESTADOS.map((e,i)=>{
    const nombre=e.split('-').slice(1).join('-').toLowerCase().replace(/^\w/,c=>c.toUpperCase());
    return `<div class="dg-pipe-row ${cnt[i]?'on':''}"><span class="n">${i+1}</span><span>${nombre}</span><span class="bar"><i style="width:${cnt[i]/max*100}%"></i></span><span class="v">${cnt[i]}</span></div>`;
  }).join('');
}

// ---------- inventario en bodega hoy ----------
function dgRenderAging(M){
  const pais=dgState.pais;
  const st=M.stock.filter(s=>!pais||s.pais===pais);
  const con=st.filter(s=>s.dias!=null), sin=st.length-con.length;
  const B=[{l:'0 – 7 días',t:7},{l:'8 – 15 días',t:15},{l:'16 – 30 días',t:30},{l:'31 – 60 días',t:60},{l:'Más de 60',t:Infinity}];
  const cnt=B.map(()=>0); con.forEach(s=>{ cnt[B.findIndex(b=>s.dias<=b.t)]++; });
  const max=Math.max(1,...cnt);
  document.getElementById('dg-n-aging').textContent=st.length?`${st.length} pedido${st.length===1?'':'s'} en bodega${pais?' para '+DG_BY_N[pais].l:''}${con.length?` · ${dgFmt(con.reduce((a,s)=>a+s.dias,0)/con.length,1)} días en promedio`:''}`:'Sin pedidos en bodega';
  const viejos=con.slice().sort((a,b)=>b.dias-a.dias).slice(0,4);
  document.getElementById('dg-aging').innerHTML = !st.length ? '<div class="dg-empty"><strong>Bodega al día</strong><span>No hay pedidos descargados pendientes de salir.</span></div>' :
    B.map((b,i)=>`<div class="dg-pipe-row ${cnt[i]?'on':''} ${i>=3&&cnt[i]?'warn':''}"><span class="n">${i+1}</span><span>${b.l}</span><span class="bar"><i style="width:${cnt[i]/max*100}%"></i></span><span class="v">${cnt[i]}</span></div>`).join('')+
    (viejos.length?`<div class="dg-oldest"><span>Más antiguos</span>${viejos.map(s=>{const P=DG_BY_N[s.pais];return `<div><i style="background:${P?P.c:'#8F9BB0'}"></i><b>${dgEsc(s.pedido||'—')}</b><em>${dgEsc(s.donde)}</em><strong>${s.dias} d</strong></div>`;}).join('')}</div>`:'')+
    (sin?`<p class="dg-note">${sin} sin fecha de descarga registrada.</p>`:'');
}

// ---------- tablas ----------
function dgRenderTablaPaises(M){
  const per=dgState.per, meta=M.tar.meta;
  const tf=f=>f==null?'<span style="color:var(--text-hint)">—</span>':`<div class="dg-tf"><span class="bar"><i class="${f<meta?'low':''}" style="width:${Math.min(100,f)}%"></i></span><span>${dgFmt(f,0)}%</span></div>`;
  const hayCosto=M.real||M.conTarifa;
  const c=v=>hayCosto&&v!=null?dgUsd(v):'<span style="color:var(--text-hint)">—</span>';
  const rows=DG_PAISES.map(P=>({P,a:dgAgregar(M,P.n,per)})).sort((x,y)=>y.a.pedidos-x.a.pedidos||(y.a.costo||0)-(x.a.costo||0));
  const T=dgAgregar(M,'',per);
  const fila=(a)=>`<td class="num">${dgFmt(a.pedidos)}</td><td class="num">${dgFmt(a.viajes)}</td>
      <td class="num">${dgFmt(a.tnDesp,1)}</td><td class="num">${dgFmt(a.tnIng,1)}</td><td>${tf(a.fill)}</td>
      <td class="num">${a.diasProm==null?'<span style="color:var(--text-hint)">—</span>':dgFmt(a.diasProm,1)}</td>
      ${M.real?`<td class="num">${dgFmt(a.cPedidos)}</td>`:''}<td class="num">${c(a.costo)}</td><td class="num">${c(a.cPedidos?a.costoPed:null)}</td><td class="num">${c(a.costoTn)}</td>`;
  document.getElementById('dg-pais-thead').innerHTML=`<tr><th>País</th><th class="num">Pedidos</th><th class="num">Viajes</th><th class="num">Tn despachadas</th><th class="num">Tn ingresadas</th><th>Truck fill</th><th class="num">Días en bodega</th>${M.real?'<th class="num">Pedidos facturados</th><th class="num">Costo facturado</th>':'<th class="num">Costo estimado</th>'}<th class="num">Costo / pedido</th><th class="num">Costo / tn</th></tr>`;
  document.getElementById('dg-pais-tbody').innerHTML=rows.map(({P,a})=>`
    <tr class="dg-click" onclick="dgSetPais('${dgState.pais===P.n?'':P.n}')" style="${dgState.pais&&dgState.pais!==P.n?'opacity:.45':''}">
      <td><span class="dg-pais"><i style="background:${P.c}"></i>${P.l}</span></td>${fila(a)}</tr>`).join('')+
    `<tr class="dg-total"><td>Total · ${dgPerLabel(per).toLowerCase()}</td>${fila(T)}</tr>`;
  document.getElementById('dg-pais-count').textContent=dgState.pais?'Clic de nuevo para ver todos':'Clic en un país para filtrar';
}
function dgRenderUltimos(M){
  const A=dgAgregar(M,dgState.pais,dgState.per);
  const lista=A.peds.slice().sort((a,b)=>(b.sal||0)-(a.sal||0)||b._i-a._i).slice(0,15);
  document.getElementById('dg-ult-count').textContent=`${dgFmt(lista.length)} de ${dgFmt(A.peds.length)}`;
  const tb=document.getElementById('dg-ult-tbody');
  if(!lista.length){ tb.innerHTML='<tr><td colspan="10"><div class="empty"><strong>Sin despachos en este filtro</strong>Cambia el país o el periodo.</div></td></tr>'; return; }
  const meta=M.tar.meta;
  tb.innerHTML=lista.map(p=>{
    const P=DG_BY_N[p.pais];
    const costo=p.costoReal!=null?dgUsd(p.costoReal):(M.conTarifa&&!M.real?dgUsd(p.costoEst):(M.real?'<span style="color:var(--text-hint)" title="Sin factura con este número de pedido">—</span>':'—'));
    return `<tr>
      <td style="color:var(--text-muted)">${p.k?dgKeyLabel(p.k):'—'}</td>
      <td style="font-weight:700">${dgEsc(p.ref||'—')}</td>
      <td class="mono">${dgEsc(p.pedido||'—')}</td>
      <td><span class="dg-pais"><i style="background:${P?P.c:'#8F9BB0'}"></i>${P?P.l:dgEsc(p.pais||'—')}</span></td>
      <td class="num">${p.pal?dgFmt(p.pal):'—'}</td><td class="num">${p.kg?dgFmt(p.kg):'—'}</td>
      <td>${p.fill==null?'—':`<div class="dg-tf"><span class="bar"><i class="${p.fill<meta?'low':''}" style="width:${Math.min(100,p.fill)}%"></i></span><span>${dgFmt(p.fill,0)}%</span></div>`}</td>
      <td class="num">${p.dias==null?'<span style="color:var(--text-hint)">—</span>':p.dias}</td>
      <td class="num">${costo}</td>
      <td style="font-size:12px;color:var(--text-muted)">${p.estado==='ARCHIVADO'?'Despachado':dgCap(p.estado.toLowerCase())}</td>
    </tr>`;
  }).join('');
}
function dgRenderFuenteCostos(M){
  const el=document.getElementById('dg-costos-info'); if(!el) return;
  const nCap=M.costos.filter(c=>c.origen==='captura').length;
  if(!M.CO){ el.innerHTML=nCap?`Costos: <b>${dgFmt(nCap)} pedidos registrados en Despacho</b>`:''; return; }
  const m=M.CO.meta;
  el.innerHTML=`Costos: <b>${dgEsc(m.archivo)}</b> · ${dgFmt(m.pedidos)} pedidos · importado ${m.cargado.split('-').reverse().join('/')}${m.sinPedido?` · ${m.sinPedido} renglones sin pedido`:''}${nCap?` · más ${dgFmt(nCap)} registrados en Despacho`:''} <button onclick="dgQuitarCostos()">Quitar</button>`;
}

// ---------- orquestador ----------
async function dashInit(){
  dashDestroyCharts();
  hubArch.cache=null;
  if(archAnios().length&&!dgState.per&&!dgState._perTocado) dgState.per=String(dgHoy().getFullYear());
  const M=dgModelo();
  dgRenderFiltros(M);
  const per=dgState.per;
  const A=dgAgregar(M,dgState.pais,per);
  let Ap=null, kPrev='';
  if(per&&per.length===7){
    const ks=dgKeysConDatos(M).filter(k=>k<per);
    if(ks.length){ kPrev=ks[ks.length-1]; Ap=dgAgregar(M,dgState.pais,kPrev); }
  } else if(per&&per.length===4){
    const yp=String(+per-1);
    if(dgKeysConDatos(M).some(k=>k.startsWith(yp))){ kPrev=yp; Ap=dgAgregar(M,dgState.pais,yp); }
  }
  const Pf=dgState.pais?DG_BY_N[dgState.pais]:null;
  document.getElementById('dg-sub').textContent=`Operación Unilever · ${Pf?Pf.l:'Todos los países'}${dgState.origen?' · Origen '+dgOrigenLabel(dgState.origen):''} · ${dgPerLabel(per)}`;
  dgRenderFuenteCostos(M);
  dgRenderKpis(M,A,Ap,kPrev);
  dgRenderCharts(M,A);
  dgRenderComposicion(M,A);
  ['dg-vista-1','dg-vista-2'].forEach(id=>{ const e=document.getElementById(id); if(e) e.innerHTML=M.real?dgVistaToggle():''; });
  dgRenderOrigen(M);
  dgRenderPipe(M);
  dgRenderAging(M);
  dgRenderTablaPaises(M);
  dgRenderUltimos(M);
}

// Single init listener
document.addEventListener('DOMContentLoaded', function(){
  // Edificios
  edifStartClock();
  edifRenderAll(12);
  edifRenderAll(6);

  // Add top scrollbar to ALL table-wrap elements
  function addTopScroll(wrap){
    if(wrap.dataset.topScrollAdded) return;
    wrap.dataset.topScrollAdded = '1';
    const top = document.createElement('div');
    top.style.cssText = 'overflow-x:scroll;overflow-y:hidden;height:12px;margin-bottom:2px;scrollbar-width:auto;scrollbar-color:#94A3B8 #F1F5F9;';
    top.style.borderRadius = '999px';
    const inner = document.createElement('div');
    inner.style.height = '1px';
    top.appendChild(inner);
    wrap.parentNode.insertBefore(top, wrap);

    function syncInnerWidth(){
      const tbl = wrap.querySelector('table');
      if(tbl) inner.style.width = tbl.scrollWidth + 'px';
    }
    syncInnerWidth();

    top.addEventListener('scroll', ()=>{ wrap.scrollLeft = top.scrollLeft; });
    wrap.addEventListener('scroll', ()=>{ top.scrollLeft = wrap.scrollLeft; });

    const tbl = wrap.querySelector('table');
    if(tbl){
      const obs = new MutationObserver(()=>{ syncInnerWidth(); });
      obs.observe(wrap, {childList:true, subtree:true});
    }
    // Sync after delays to catch dynamic renders
    setTimeout(syncInnerWidth, 300);
    setTimeout(syncInnerWidth, 1000);
    setTimeout(syncInnerWidth, 3000);
  }

  // Apply to all existing table-wraps
  document.querySelectorAll('.table-wrap').forEach(addTopScroll);

  // Observe for new table-wraps added dynamically
  const bodyObs = new MutationObserver(()=>{
    document.querySelectorAll('.table-wrap').forEach(addTopScroll);
  });
  bodyObs.observe(document.body, {childList:true, subtree:true});

  // Arranque: en línea (Firebase) si está configurado; si no, Google Sheets
  hubArranque();
});



</script>
<script>
// ════════════════════════════════════════════════════════════════
//  HUB EN LÍNEA — Firebase (login por usuario, permisos por módulo,
//  guardado automático y cambios en tiempo real entre el equipo)
// ════════════════════════════════════════════════════════════════
// ↓↓ Pegar aquí el firebaseConfig de la consola (Configuración del proyecto → Tus apps → Web).
//    Si se deja en null, el HUB funciona como antes (Google Sheets).
const HUB_FIREBASE_CONFIG = {
  apiKey: "AIzaSyDRgvP1wTYrDhS1ulFUrc4gEjJ7MvVveIQ",
  authDomain: "blue-logistics-control.firebaseapp.com",
  projectId: "blue-logistics-control",
  storageBucket: "blue-logistics-control.firebasestorage.app",
  messagingSenderId: "310981823740",
  appId: "1:310981823740:web:6637b0dcb620a52e1f1b79"
};
const HUB_DOMINIO = 'hub-ul.app';      // dominio interno: usuario → usuario@hub-ul.app (no es un correo real)
const HUB_ADMIN   = 'm.sanchez';       // administrador principal

const HUB_MODULOS = [
  {k:'ingreso',   l:'Ingreso de equipo',    c:'Ingreso'},
  {k:'np',        l:'No programados',       c:'NP'},
  {k:'despacho',  l:'Despacho e historial', c:'Despacho'},
  {k:'edificios', l:'Edificios (cortinas)', c:'Edificios'},
  {k:'reportes',  l:'Reporte ejecutivo',    c:'Reporte'}
];
const HUB_ROLES = {
  admin:    {l:'Administrador', p:{ingreso:'editar',np:'editar',despacho:'editar',edificios:'editar',reportes:'editar'}},
  trafico:  {l:'Tráfico',       p:{ingreso:'editar',np:'editar',despacho:'editar',edificios:'editar',reportes:'ver'}},
  bodega:   {l:'Bodega',        p:{ingreso:'ver',np:'ver',despacho:'ver',edificios:'editar',reportes:'ver'}},
  consulta: {l:'Consulta',      p:{ingreso:'ver',np:'ver',despacho:'ver',edificios:'ver',reportes:'ver'}}
};
// Listas del HUB → colecciones de Firestore
const HUB_COLS = [
  {c:'hub_contenedores',   m:'ingreso',   l:'Ingreso de equipo',      get:()=>contenedores,           render:()=>renderContenedores()},
  {c:'hub_historial_cont', m:'ingreso',   l:'Historial de ingresos',  get:()=>historialCont,          render:()=>renderHistorialCont()},
  {c:'hub_np',             m:'np',        l:'No programados',         get:()=>noProg,                 render:()=>{ renderNp(); npRenderPaisesBtns(); }},
  {c:'hub_despachos',      m:'despacho',  l:'Despacho',               get:()=>despachos,              render:()=>{ populateFilters(); renderDespachos(); }},
  {c:'hub_historial',      m:'despacho',  l:'Historial de despachos', get:()=>historial,              render:()=>renderHistorial()},
  {c:'hub_edif12_hist',    m:'edificios', l:'Historial Edificio 12',  get:()=>edifState[12].historial, render:()=>edifRenderAll(12)},
  {c:'hub_edif6_hist',     m:'edificios', l:'Historial Edificio 6',   get:()=>edifState[6].historial,  render:()=>edifRenderAll(6)}
];
// Documentos únicos (estado de cortinas y configuración del reporte)
const HUB_DOCS = [
  {c:'hub_estado', id:'edif12', m:'edificios', l:'Cortinas Edificio 12', get:()=>hubEdifSer(12), set:s=>hubEdifSet(12,s), render:()=>{ edifRenderAll(12); try{descRender();}catch(e){} }},
  {c:'hub_estado', id:'edif6',  m:'edificios', l:'Cortinas Edificio 6',  get:()=>hubEdifSer(6),  set:s=>hubEdifSet(6,s),  render:()=>{ edifRenderAll(6);  try{descRender();}catch(e){} }},
  {c:'hub_config', id:'tarifas', m:'reportes', l:'Tarifas del reporte', get:()=>hubLsGet(DG_LS_KEY), set:s=>{ hubLsSet(DG_LS_KEY,s); dgTarifasMem=null; }, render:()=>hubDashRefrescar()},
  {c:'hub_config', id:'costos_fact', m:'reportes', l:'Costos importados', partes:true, get:()=>hubLsGet(DG_LS_COSTOS), set:s=>{ hubLsSet(DG_LS_COSTOS,s); dgCostos=null; }, render:()=>hubDashRefrescar()}
];

window.HUB_ONLINE = false;
let hubDb=null, hubAuth=null, hubUser=null, hubPerfil=null;
const hubUlt = {};          // último estado sincronizado: hubUlt[col] = Map(id → json) ; hubUlt['doc:c/id'] = json
const hubOrden = {};        // ids por posición (para heredar id cuando se reemplaza un registro)
const hubPendientes = [];   // cambios remotos en espera (mientras alguien edita)
let hubSyncTimer=null, hubSyncCorriendo=false, hubSyncOtraVez=false, hubListo=false, hubUnsubs=[];
let hubSeqUlt=0, hubInteraccion=false;

// ---------- utilidades ----------
function hubClave(u){
  return String(u||'').trim().toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g,'')
    .replace(/[^a-z0-9]+/g,'.').replace(/^\.+|\.+$/g,'');
}
function hubEmail(k){ return k+'@'+HUB_DOMINIO; }
function hubSeq(){ hubSeqUlt=Math.max(Date.now(), hubSeqUlt+1); return hubSeqUlt; }
function hubNuevoId(){ return Date.now().toString(36)+Math.random().toString(36).slice(2,8); }
function hubEsc(s){ return String(s==null?'':s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }
function hubLsGet(k){ try{ return localStorage.getItem(k); }catch(e){ return null; } }
function hubLsSet(k,s){ try{ if(s==null) localStorage.removeItem(k); else localStorage.setItem(k,s); }catch(e){} }
function hubPuede(m){ if(Array.isArray(m)) return m.some(hubPuede); return !!hubPerfil && (hubPerfil.rol==='admin' || (hubPerfil.permisos||{})[m]==='editar'); }
function hubEsAdmin(){ return !!hubPerfil && hubPerfil.rol==='admin'; }
function hubDashRefrescar(){ const t=document.getElementById('tab-dashboard'); if(t&&t.classList.contains('active')) try{ dashInit(); }catch(e){} }

// Serializa un registro: sin las listas en memoria (pedidos/costos viajan en *_json)
function hubSer(r){
  if(Array.isArray(r.pedidos) && r.pedidos_json!=null){ const j=JSON.stringify(r.pedidos); if(j!==r.pedidos_json) r.pedidos_json=j; }
  if(Array.isArray(r.costos) && r.costos_json!=null){ const j=JSON.stringify(r.costos); if(j!==r.costos_json) r.costos_json=j; }
  const o={};
  Object.keys(r).sort().forEach(k=>{ if(k==='pedidos'||k==='costos') return; const v=r[k]; if(v!==undefined && typeof v!=='function') o[k]=v; });
  return JSON.stringify(o);
}
function hubEdifSer(n){
  const st=edifState[n]; const cort={};
  Object.keys(st.cortinas).forEach(i=>{ const c={...st.cortinas[i]}; delete c.minutos; cort[i]=c; });
  return JSON.stringify({cortinas:cort, cola:st.cola||[]});
}
function hubEdifSet(n,s){
  if(!s) return;
  let o; try{ o=JSON.parse(s); }catch(e){ return; }
  const st=edifState[n];
  Object.keys(o.cortinas||{}).forEach(i=>{
    const c=o.cortinas[i]; c.minutos=c.inicio?Math.floor((Date.now()-c.inicio)/60000):0;
    if(st.cortinas[i]){ Object.keys(st.cortinas[i]).forEach(k=>delete st.cortinas[i][k]); Object.assign(st.cortinas[i],c); }
    else st.cortinas[i]=c;
  });
  st.cola.length=0; (o.cola||[]).forEach(x=>st.cola.push(x));
}

// Asigna _id/_t a cada registro; si un registro fue reemplazado en la misma posición, hereda su id
function hubPrepararLista(col, arr){
  const ant=hubOrden[col]||[]; const vivos=new Set(); arr.forEach(r=>{ if(r&&r._id) vivos.add(r._id); });
  const vistos=new Set();
  arr.forEach((r,i)=>{
    if(!r||typeof r!=='object') return;
    if(r._id && vistos.has(r._id)){ r._id=null; }               // copia duplicada en la misma lista
    if(!r._id){
      const prev=ant[i];
      if(prev && !vivos.has(prev.id)){ r._id=prev.id; r._t=prev.t; vivos.add(prev.id); }
      else { r._id=hubNuevoId(); r._t=hubSeq(); }
    }
    if(!r._t) r._t=hubSeq();
    vistos.add(r._id);
  });
  hubOrden[col]=arr.map(r=>({id:r&&r._id, t:r&&r._t}));
}

// ---------- guardado (diferencial) ----------
function hubProgramarSync(ms){
  if(!window.HUB_ONLINE || !hubListo) return;
  clearTimeout(hubSyncTimer); hubSyncTimer=setTimeout(hubSync, ms==null?700:ms);
}
async function hubSyncAhora(){ clearTimeout(hubSyncTimer); await hubSync(true); }
async function hubSync(manual){
  if(!window.HUB_ONLINE || !hubListo) return;
  if(hubSyncCorriendo){ hubSyncOtraVez=true; return; }
  hubSyncCorriendo=true;
  const ops=[]; const sinPermiso=new Set(); const revertir=[];
  const sello={por:hubPerfil?hubPerfil.usuario:'', nombre:hubPerfil?hubPerfil.nombre:'', en:Date.now()};
  const interaccion=hubInteraccion; hubInteraccion=false;
  try{
    HUB_COLS.forEach(def=>{
      const arr=def.get(); if(!Array.isArray(arr)) return;
      hubPrepararLista(def.c, arr);
      const ult=hubUlt[def.c]||(hubUlt[def.c]=new Map());
      const ahora=new Map();
      arr.forEach(r=>{ if(r&&r._id) ahora.set(r._id, hubSer(r)); });
      const cambios=[], borrados=[];
      ahora.forEach((j,id)=>{ if(ult.get(id)!==j) cambios.push([id,j]); });
      ult.forEach((j,id)=>{ if(!ahora.has(id)) borrados.push(id); });
      if(!cambios.length && !borrados.length) return;
      if(!hubPuede(def.m)){ if(interaccion){ sinPermiso.add(def.l); revertir.push(def); } return; }
      cambios.forEach(([id,j])=>{ const prev=ult.get(id); ops.push({t:'set', ref:hubDb.collection(def.c).doc(id), data:{j, t:JSON.parse(j)._t||0, mod:sello}, ok:()=>ult.set(id,j), undo:()=>prev===undefined?ult.delete(id):ult.set(id,prev)}); });
      borrados.forEach(id=>{ const prev=ult.get(id); ops.push({t:'del', ref:hubDb.collection(def.c).doc(id), ok:()=>ult.delete(id), undo:()=>ult.set(id,prev)}); });
    });
    for(const def of HUB_DOCS){
      const key='doc:'+def.c+'/'+def.id; const j=def.get();
      if((hubUlt[key]??null)===(j??null)) continue;
      if(!hubPuede(def.m)){ if(interaccion && hubUlt[key]!=null){ sinPermiso.add(def.l); revertir.push(def); } continue; }
      const prev=hubUlt[key];
      if(def.partes){ hubUlt[key]=j; try{ await hubGuardarPartes(def, j, sello); }catch(e){ hubUlt[key]=prev; throw e; } }
      else ops.push({t:'set', ref:hubDb.collection(def.c).doc(def.id), data:{j:j==null?null:j, mod:sello}, ok:()=>{ hubUlt[key]=j; }, undo:()=>{ hubUlt[key]=prev; }});
    }
    if(ops.length){
      gsSyncIndicator('guardando');
      for(let i=0;i<ops.length;i+=400){
        const b=hubDb.batch(); const lote=ops.slice(i,i+400);
        lote.forEach(o=> o.t==='set' ? b.set(o.ref,o.data) : b.delete(o.ref));
        lote.forEach(o=>o.ok());   // se marca antes para que el eco local no se tome como cambio remoto
        try{ await b.commit(); }catch(e){ lote.forEach(o=>o.undo()); throw e; }
      }
      gsSyncIndicator('guardado'); hubMarcarHora();
    } else if(manual===true){ gsSyncIndicator('listo'); }
    if(sinPermiso.size){
      revertir.forEach(def=>hubRevertir(def));
      hubToast('Sin permiso para editar: '+[...sinPermiso].join(', ')+'. Se restauró lo guardado.', 'err');
    }
  }catch(e){
    console.error('HUB sync', e);
    gsSyncIndicator('error');
    hubToast(e&&e.code==='permission-denied' ? 'El servidor rechazó el cambio (sin permiso). Recarga la página.' : 'No se pudo guardar: '+(e.message||e)+'. Se reintentará.', 'err');
    setTimeout(()=>hubProgramarSync(4000), 0);
  }finally{
    hubSyncCorriendo=false;
    if(hubSyncOtraVez){ hubSyncOtraVez=false; hubProgramarSync(300); }
    if(hubPendientes.length) hubAplicarPendientes();
  }
}
async function hubGuardarPartes(def, j, sello){
  const TAM=700000; const ver=hubNuevoId();
  const partes = j==null ? [] : Array.from({length:Math.ceil(j.length/TAM)}, (_,i)=>j.slice(i*TAM,(i+1)*TAM));
  for(let i=0;i<partes.length;i++) await hubDb.collection('hub_config_partes').doc(def.id+'_'+ver+'_'+i).set({j:partes[i]});
  const metaRef=hubDb.collection(def.c).doc(def.id);
  const ant=await metaRef.get().catch(()=>null);
  await metaRef.set({n:partes.length, ver, j:null, mod:sello});
  const a=ant&&ant.exists?ant.data():null;
  if(a&&a.ver&&a.n){ for(let i=0;i<a.n;i++) hubDb.collection('hub_config_partes').doc(def.id+'_'+a.ver+'_'+i).delete().catch(()=>{}); }
}
function hubRevertir(def){
  if(def.id){ def.set(hubUlt['doc:'+def.c+'/'+def.id]??null); try{ def.render(); }catch(e){} return; }
  const arr=def.get(); const ult=hubUlt[def.c]||new Map();
  const lista=[...ult.values()].map(j=>JSON.parse(j)).sort((a,b)=>(a._t||0)-(b._t||0));
  arr.length=0; lista.forEach(r=>arr.push(r)); hubOrden[def.c]=arr.map(r=>({id:r._id,t:r._t}));
  try{ def.render(); }catch(e){}
}
function hubMarcarHora(){
  const el=document.getElementById('last-update'); const d=new Date();
  if(el) el.textContent='Guardado en línea: '+d.toLocaleDateString('es-SV')+' '+d.toLocaleTimeString('es-SV',{hour:'2-digit',minute:'2-digit'});
}

// ---------- cambios remotos ----------
function hubEditando(){
  if(document.querySelector('.modal-bg.open')) return true;
  const a=document.activeElement;
  return !!(a && a.closest && a.closest('.main td') && /^(INPUT|SELECT|TEXTAREA)$/.test(a.tagName));
}
function hubEncolar(fn){ hubPendientes.push(fn); hubAplicarPendientes(); }
function hubAplicarPendientes(){
  if(!hubPendientes.length || hubEditando() || hubSyncCorriendo) return;
  const renders=new Set();
  while(hubPendientes.length){ const fn=hubPendientes.shift(); try{ const r=fn(); if(r) renders.add(r); }catch(e){ console.error(e); } }
  renders.forEach(r=>{ try{ r(); }catch(e){ console.error(e); } });
  hubDashRefrescar();
}
setInterval(hubAplicarPendientes, 1200);

function hubEscucharColeccion(def, primera){
  let inicial=true;
  return hubDb.collection(def.c).onSnapshot(snap=>{
    const cambios=snap.docChanges();
    const aplicar=()=>{
      const arr=def.get(); const ult=hubUlt[def.c]||(hubUlt[def.c]=new Map());
      const porId=new Map(); arr.forEach(r=>{ if(r&&r._id) porId.set(r._id,r); });
      let hubo=false;
      if(inicial){
        // Primera carga: la nube manda. Se respetan solo los registros locales nuevos (aún sin id).
        const nuevosLocales=arr.filter(r=>r&&!r._id);
        const lista=snap.docs.map(d=>{ const j=d.data().j; ult.set(d.id,j); return JSON.parse(j); });
        lista.sort((a,b)=>(a._t||0)-(b._t||0));
        arr.length=0; lista.forEach(r=>arr.push(r)); nuevosLocales.forEach(r=>arr.push(r));
        hubOrden[def.c]=arr.map(r=>({id:r._id,t:r._t}));
        inicial=false; hubo=true;
      } else {
        cambios.forEach(ch=>{
          const id=ch.doc.id;
          if(ch.type==='removed'){
            if(!ult.has(id)) return;
            const loc=porId.get(id);
            ult.delete(id);
            if(loc){ const i=arr.indexOf(loc); if(i>=0) arr.splice(i,1); hubo=true; }
            return;
          }
          const j=ch.doc.data().j; if(ult.get(id)===j) return;
          const loc=porId.get(id);
          if(loc && hubPuede(def.m) && ult.has(id) && hubSer(loc)!==ult.get(id)){ ult.set(id,j); return; } // también lo cambié yo: gana el mío (se sube enseguida)
          ult.set(id,j);
          const rem=JSON.parse(j);
          if(loc){ Object.keys(loc).forEach(k=>delete loc[k]); Object.assign(loc,rem); }
          else {
            let i=arr.length; while(i>0 && (arr[i-1]._t||0)>(rem._t||0)) i--;
            arr.splice(i,0,rem);
          }
          hubo=true;
        });
        hubOrden[def.c]=arr.map(r=>({id:r&&r._id,t:r&&r._t}));
      }
      return hubo ? def.render : null;
    };
    if(primera && !primera.hecho[def.c]){ primera.hecho[def.c]=true; aplicar(); primera.listo(); }
    else hubEncolar(aplicar);
  }, err=>{ console.error('HUB escucha', def.c, err); hubToast('Sin acceso a '+def.l+': '+(err.code||err.message), 'err'); if(primera && !primera.hecho[def.c]){ primera.hecho[def.c]=true; primera.listo(); } });
}
function hubEscucharDoc(def, primera){
  const key='doc:'+def.c+'/'+def.id;
  return hubDb.collection(def.c).doc(def.id).onSnapshot(async snap=>{
    const d=snap.exists?snap.data():null;
    let j=d?d.j:null;
    if(d && def.partes && d.n){
      try{
        const ps=await Promise.all(Array.from({length:d.n},(_,i)=>hubDb.collection('hub_config_partes').doc(def.id+'_'+d.ver+'_'+i).get()));
        j=ps.map(p=>p.exists?p.data().j:'').join('');
      }catch(e){ console.error(e); j=hubUlt[key]??null; }
    }
    const esPrimera = primera && !primera.hecho[key];
    const aplicar=()=>{
      if(!snap.exists && esPrimera){ hubUlt[key]=undefined; return null; }  // nada en la nube: se sube lo local
      if((hubUlt[key]??null)===(j??null)) return null;
      hubUlt[key]=j; def.set(j); return def.render;
    };
    if(esPrimera){ primera.hecho[key]=true; aplicar(); primera.listo(); }
    else hubEncolar(aplicar);
  }, err=>{ console.error('HUB escucha doc', def.id, err); if(primera && !primera.hecho[key]){ primera.hecho[key]=true; primera.listo(); } });
}

// Cada vez que el HUB re-dibuja algo, revisa si hay cambios para subir
['renderContenedores','renderNp','renderDespachos','renderHistorial','renderHistorialCont','edifRenderAll','closeModals','dgGuardarTarifas','dgQuitarCostos']
  .forEach(n=>{ const f=window[n]; if(typeof f!=='function') return; window[n]=function(){ const r=f.apply(this,arguments); hubProgramarSync(); return r; }; });
document.addEventListener('change', ()=>{ hubInteraccion=true; hubProgramarSync(); }, true);
document.addEventListener('click',  e=>{ if(!e.target.closest('#hub-login,#hub-user-chip,#modal-hub-usuarios')){ hubInteraccion=true; hubProgramarSync(1500); } }, true);
setInterval(()=>hubProgramarSync(0), 15000);

// ---------- arranque / login ----------
function hubArranque(){
  if(!HUB_FIREBASE_CONFIG || typeof firebase==='undefined'){
    if(HUB_FIREBASE_CONFIG) alert('No se pudo cargar Firebase (revisa la conexión a internet). Se usará el modo anterior.');
    rcCargarLocal(); tramCargarLocal(); Promise.resolve(gsLoadAll()).finally(()=>{ alrIniciar(); rcRender(); }); return;
  }
  window.HUB_ONLINE=true;
  document.body.classList.add('hub-online');
  firebase.initializeApp(HUB_FIREBASE_CONFIG);
  hubAuth=firebase.auth(); hubDb=firebase.firestore();
  hubLoginMostrar(true);
  hubAuth.onAuthStateChanged(async u=>{
    if(!u){ hubUser=null; hubPerfil=null; hubLoginMostrar(true); return; }
    hubUser=u;
    const key=(u.email||'').split('@')[0];
    try{
      let snap=await hubDb.collection('hub_usuarios').doc(key).get();
      if(!snap.exists && key===HUB_ADMIN){
        await hubDb.collection('hub_usuarios').doc(key).set({usuario:key, nombre:'M Sanchez', rol:'admin', activo:true, permisos:HUB_ROLES.admin.p, creado:Date.now()});
        snap=await hubDb.collection('hub_usuarios').doc(key).get();
      }
      if(!snap.exists){ hubLoginError('Tu usuario no está dado de alta en el HUB. Pídelo al administrador.'); return hubAuth.signOut(); }
      const p=snap.data();
      if(!p.activo){ hubLoginError('Tu usuario está desactivado. Habla con el administrador.'); return hubAuth.signOut(); }
      hubPerfil={...p, usuario:key};
      hubEntrar();
    }catch(e){ console.error(e); hubLoginError('No se pudo leer tu perfil: '+(e.code||e.message)); hubAuth.signOut(); }
  });
}
function hubLoginMostrar(v){
  let ov=document.getElementById('hub-login');
  if(!ov){
    ov=document.createElement('div'); ov.id='hub-login';
    ov.innerHTML=`<form class="hl-card" onsubmit="event.preventDefault();hubLogin()">
      <div class="hl-brand"><div class="brand-mark">BL</div><div><b>Control Logístico HUB UL</b><small>Blue Logistics · Operación Unilever</small></div></div>
      <label>Usuario<input id="hl-user" autocomplete="username" placeholder="ej. M Sanchez" required></label>
      <label>Clave<input id="hl-pass" type="password" autocomplete="current-password" required></label>
      <div id="hl-err" class="hl-err" hidden></div>
      <button class="btn btn-accent" id="hl-btn" type="submit">Entrar</button>
      <button class="btn btn-sm hl-crear" id="hl-crear" type="button" hidden onclick="hubCrearAdmin()">Crear cuenta de administrador</button>
      <p class="hl-nota">¿Olvidaste tu clave? Pídele al administrador que te asigne una nueva.</p>
    </form>`;
    document.body.appendChild(ov);
  }
  ov.hidden=!v;
  document.body.classList.toggle('hub-bloqueado', !!v);
  if(v) setTimeout(()=>{ const i=document.getElementById('hl-user'); if(i&&!i.value) i.focus(); },50);
}
function hubLoginError(msg){ const e=document.getElementById('hl-err'); if(e){ e.textContent=msg; e.hidden=!msg; } const b=document.getElementById('hl-btn'); if(b){ b.disabled=false; b.textContent='Entrar'; } }
async function hubLogin(){
  const key=hubClave(document.getElementById('hl-user').value), pass=document.getElementById('hl-pass').value;
  document.getElementById('hl-crear').hidden=true; hubLoginError('');
  if(!key) return hubLoginError('Escribe tu usuario.');
  const b=document.getElementById('hl-btn'); b.disabled=true; b.textContent='Entrando…';
  try{ await hubAuth.signInWithEmailAndPassword(hubEmail(key), pass); }
  catch(e){
    const malos=['auth/invalid-credential','auth/wrong-password','auth/user-not-found','auth/invalid-email','auth/invalid-login-credentials'];
    if(malos.includes(e.code)){
      hubLoginError('Usuario o clave incorrectos.');
      if(key===HUB_ADMIN) document.getElementById('hl-crear').hidden=false;
    } else if(e.code==='auth/too-many-requests') hubLoginError('Demasiados intentos. Espera unos minutos.');
    else if(e.code==='auth/operation-not-allowed') hubLoginError('Falta activar "Correo/contraseña" en Firebase → Authentication.');
    else hubLoginError('No se pudo entrar: '+(e.code||e.message));
  }
}
async function hubCrearAdmin(){
  const key=hubClave(document.getElementById('hl-user').value), pass=document.getElementById('hl-pass').value;
  if(key!==HUB_ADMIN) return;
  if(pass.length<6) return hubLoginError('La clave debe tener al menos 6 caracteres.');
  if(!confirm('Se creará la cuenta de administrador "'+key+'" con la clave escrita. ¿Continuar?')) return;
  try{ await hubAuth.createUserWithEmailAndPassword(hubEmail(key), pass); }
  catch(e){ hubLoginError(e.code==='auth/email-already-in-use' ? 'La cuenta ya existe: la clave es incorrecta.' : 'No se pudo crear: '+(e.code||e.message)); }
}
function hubSalir(){ if(!confirm('¿Cerrar sesión?')) return; hubSyncAhora().finally(()=>{ hubAuth.signOut().then(()=>location.reload()); }); }

function hubEntrar(){
  hubLoginMostrar(false);
  hubPintarUsuario();
  document.body.classList.toggle('hub-admin', hubEsAdmin());
  document.body.classList.toggle('rol-hn', !!hubPerfil&&hubPerfil.rol==='honduras');
  if(hubPerfil&&hubPerfil.rol==='honduras') setTimeout(()=>{ const b=document.querySelector('.op-tab[data-tab="tramites"]'); if(b) switchTab('tramites',b); },300);
  if(hubUnsubs.length) return;  // ya escuchando
  gsSyncIndicator('cargando');
  const total=HUB_COLS.length+HUB_DOCS.length; let n=0;
  const primera={hecho:{}, listo:()=>{ if(++n===total) hubCargaLista(); }};
  HUB_COLS.forEach(def=>hubUnsubs.push(hubEscucharColeccion(def, primera)));
  HUB_DOCS.forEach(def=>hubUnsubs.push(hubEscucharDoc(def, primera)));
  // Escuchar mi propio perfil (si me desactivan o cambian permisos)
  hubUnsubs.push(hubDb.collection('hub_usuarios').doc(hubPerfil.usuario).onSnapshot(s=>{
    if(!s.exists || !s.data().activo){ alert('Tu usuario fue desactivado.'); hubAuth.signOut().then(()=>location.reload()); return; }
    hubPerfil={...s.data(), usuario:hubPerfil.usuario}; hubPintarUsuario(); document.body.classList.toggle('hub-admin', hubEsAdmin());
  }));
}
function hubCargaLista(){
  HUB_COLS.forEach(def=>{ try{ def.render(); }catch(e){} });
  try{ populateFilters(); }catch(e){}
  hubListo=true;
  gsSyncIndicator('listo');
  hubProgramarSync(300);  // sube lo que exista solo local (p. ej. tarifas guardadas en este navegador)
  if(hubEsAdmin()) setTimeout(hubRespaldoRecordatorio, 4000);
  alrIniciar();
}
function hubPintarUsuario(){
  let el=document.getElementById('hub-user-chip');
  if(!el){
    el=document.createElement('div'); el.id='hub-user-chip';
    const acts=document.querySelector('.header-actions'); if(acts) acts.insertBefore(el, acts.firstChild);
  }
  const p=hubPerfil||{}; const rol=(HUB_ROLES[p.rol]||{}).l||p.rol||'';
  const ini=String(p.nombre||p.usuario||'?').split(/\s+/).map(s=>s[0]).join('').slice(0,2).toUpperCase();
  el.innerHTML=`<button class="huc-btn" onclick="hubMenu(event)" aria-haspopup="true"><span class="huc-av">${hubEsc(ini)}</span><span class="huc-tx"><b>${hubEsc(p.nombre||p.usuario)}</b><small>${hubEsc(rol)}</small></span></button>
    <div class="huc-menu" id="hub-menu" hidden>
      ${hubEsAdmin()?'<button onclick="hubUsuariosAbrir()">Usuarios y permisos</button><button onclick="hubRespaldoDescargar()">Descargar respaldo</button><button onclick="hubRespaldoRestaurarElegir()">Restaurar respaldo…</button><button onclick="npRepararRetornados()">Reparar pedidos retornados a NP</button><button onclick="hubImportarSheets()">Importar datos de Google Sheets</button><button onclick="archAbrir()">Años anteriores (solo reportes)…</button>':''}
      <button onclick="hubCambiarClave()">Cambiar mi clave</button>
      <button onclick="hubSalir()">Cerrar sesión</button>
    </div>`;
}
function hubMenu(ev){ ev.stopPropagation(); const m=document.getElementById('hub-menu'); m.hidden=!m.hidden; }
document.addEventListener('click', e=>{ const m=document.getElementById('hub-menu'); if(m && !m.hidden && !e.target.closest('#hub-user-chip')) m.hidden=true; });

async function hubCambiarClave(){
  const actual=prompt('Escribe tu clave actual:'); if(actual==null) return;
  const nueva=prompt('Nueva clave (mínimo 6 caracteres):'); if(nueva==null) return;
  if(nueva.length<6) return alert('La clave debe tener al menos 6 caracteres.');
  try{
    const cred=firebase.auth.EmailAuthProvider.credential(hubUser.email, actual);
    await hubUser.reauthenticateWithCredential(cred);
    await hubUser.updatePassword(nueva);
    alert('✅ Clave actualizada.');
  }catch(e){ alert(e.code==='auth/invalid-credential'||e.code==='auth/wrong-password' ? 'La clave actual no es correcta.' : 'No se pudo cambiar: '+(e.code||e.message)); }
}

// Importación única desde Google Sheets (para pasar lo que ya existe)
async function hubImportarSheets(){
  if(!hubEsAdmin()) return;
  if(!confirm('Esto trae los datos de Google Sheets (contenedores, NP, despachos e historiales) y REEMPLAZA lo que haya en línea en esas listas.\n\nÚsalo una sola vez, al arrancar. ¿Continuar?')) return;
  window.HUB_ONLINE=false;
  try{ await gsLoadAll(); } finally { window.HUB_ONLINE=true; }
  await hubSyncAhora();
  alert('✅ Datos importados y guardados en línea.');
}

// ---------- administración de usuarios ----------
let hubUsuariosLista=[], hubUsuariosUnsub=null;
function hubUsuariosAbrir(){
  document.getElementById('hub-menu').hidden=true;
  let m=document.getElementById('modal-hub-usuarios');
  if(!m){
    m=document.createElement('div'); m.className='modal-bg'; m.id='modal-hub-usuarios';
    m.innerHTML=`<div class="modal hu-modal">
      <div class="hu-head"><div><h3>Usuarios y permisos</h3><p>Cada persona entra con su usuario y clave. Marca en qué módulos puede editar; en los demás solo ve.</p></div><button class="btn btn-sm" onclick="closeModals()">Cerrar</button></div>
      <form class="hu-nuevo" onsubmit="event.preventDefault();hubUsuarioCrear()">
        <input id="hu-nombre" placeholder="Nombre (ej. Karen Osorio)" required>
        <input id="hu-usuario" placeholder="Usuario (ej. K Osorio)" required oninput="document.getElementById('hu-clave-prev').textContent=hubClave(this.value)||'—'">
        <input id="hu-clave" placeholder="Clave inicial (6+)" minlength="6" required>
        <select id="hu-rol">${Object.entries(HUB_ROLES).map(([k,r])=>`<option value="${k}" ${k==='trafico'?'selected':''}>${r.l}</option>`).join('')}</select>
        <button class="btn btn-accent btn-sm" id="hu-btn-crear">+ Crear usuario</button>
        <small>Entrará como: <b id="hu-clave-prev">—</b></small>
      </form>
      <div class="hu-tabla-wrap"><table class="hu-tabla"><thead><tr><th>Persona</th><th>Perfil</th>${HUB_MODULOS.map(x=>`<th class="hu-c" title="${x.l}">${x.c}</th>`).join('')}<th class="hu-c">Activo</th></tr></thead><tbody id="hu-body"><tr><td colspan="9">Cargando…</td></tr></tbody></table></div>
      <p class="hu-nota">✔ = puede editar · vacío = solo ver. En <b>Gerencia</b>, ✔ = puede ver los reportes de gerencia (Reporte para seguro); sin ✔ no aparecen. Para cambiar la clave de alguien que la olvidó: desactívalo y créale un usuario nuevo (o cámbiala desde la consola de Firebase → Authentication).</p>
    </div>`;
    document.body.appendChild(m);
  }
  m.classList.add('open');
  if(!hubUsuariosUnsub){
    hubUsuariosUnsub=hubDb.collection('hub_usuarios').onSnapshot(s=>{
      hubUsuariosLista=s.docs.map(d=>({...d.data(), usuario:d.id})).sort((a,b)=>String(a.nombre).localeCompare(String(b.nombre)));
      hubUsuariosRender();
    }, e=>{ document.getElementById('hu-body').innerHTML=`<tr><td colspan="9">Sin acceso: ${hubEsc(e.code||e.message)}</td></tr>`; });
  }
}
function hubUsuariosRender(){
  const tb=document.getElementById('hu-body'); if(!tb) return;
  tb.innerHTML=hubUsuariosLista.map(u=>{
    const yo=u.usuario===HUB_ADMIN; const per=u.permisos||{};
    return `<tr class="${u.activo?'':'hu-inactivo'}">
      <td><b>${hubEsc(u.nombre)}</b><small>${hubEsc(u.usuario)}</small></td>
      <td><select ${yo?'disabled':''} onchange="hubUsuarioRol('${u.usuario}',this.value)">${Object.entries(HUB_ROLES).map(([k,r])=>`<option value="${k}" ${u.rol===k?'selected':''}>${r.l}</option>`).join('')}</select></td>
      ${HUB_MODULOS.map(x=>`<td class="hu-c"><input type="checkbox" ${per[x.k]==='editar'||u.rol==='admin'?'checked':''} ${yo||u.rol==='admin'?'disabled':''} onchange="hubUsuarioPermiso('${u.usuario}','${x.k}',this.checked)" aria-label="${hubEsc(u.nombre)} edita ${x.l}"></td>`).join('')}
      <td class="hu-c"><input type="checkbox" ${u.activo?'checked':''} ${yo?'disabled':''} onchange="hubUsuarioActivo('${u.usuario}',this.checked)" aria-label="Activo"></td>
    </tr>`;
  }).join('') || '<tr><td colspan="9">Sin usuarios</td></tr>';
}
async function hubUsuarioCrear(){
  const nombre=document.getElementById('hu-nombre').value.trim();
  const key=hubClave(document.getElementById('hu-usuario').value);
  const clave=document.getElementById('hu-clave').value;
  const rol=document.getElementById('hu-rol').value;
  if(!key) return alert('Usuario no válido.');
  if(clave.length<6) return alert('La clave debe tener al menos 6 caracteres.');
  if(hubUsuariosLista.some(u=>u.usuario===key)) return alert('Ya existe el usuario "'+key+'".');
  const btn=document.getElementById('hu-btn-crear'); btn.disabled=true; btn.textContent='Creando…';
  let sec=null;
  try{
    sec=firebase.apps.find(a=>a.name==='hub-alta') || firebase.initializeApp(HUB_FIREBASE_CONFIG,'hub-alta');
    try{ await sec.auth().createUserWithEmailAndPassword(hubEmail(key), clave); }
    catch(e){ if(e.code!=='auth/email-already-in-use') throw e; if(!confirm('La cuenta "'+key+'" ya existía en Firebase (con su clave anterior). ¿Darla de alta en el HUB de todos modos?')) throw {message:'cancelado'}; }
    await sec.auth().signOut().catch(()=>{});
    await hubDb.collection('hub_usuarios').doc(key).set({usuario:key, nombre, rol, activo:true, permisos:{...HUB_ROLES[rol].p}, creado:Date.now(), creadoPor:hubPerfil.usuario});
    alert(`✅ Usuario creado\n\nUsuario: ${document.getElementById('hu-usuario').value.trim()}\nClave: ${clave}\n\nCompártelo con la persona; puede cambiar su clave desde su menú.`);
    ['hu-nombre','hu-usuario','hu-clave'].forEach(id=>document.getElementById(id).value=''); document.getElementById('hu-clave-prev').textContent='—';
  }catch(e){ if(e.message!=='cancelado') alert('No se pudo crear: '+(e.code||e.message)); }
  finally{ btn.disabled=false; btn.textContent='+ Crear usuario'; }
}
function hubUsuarioRol(key, rol){ hubDb.collection('hub_usuarios').doc(key).update({rol, permisos:{...HUB_ROLES[rol].p}}).catch(e=>alert('Error: '+(e.code||e.message))); }
function hubUsuarioPermiso(key, m, on){ hubDb.collection('hub_usuarios').doc(key).update({['permisos.'+m]: on?'editar':'ver'}).catch(e=>alert('Error: '+(e.code||e.message))); }
function hubUsuarioActivo(key, on){ hubDb.collection('hub_usuarios').doc(key).update({activo:on}).catch(e=>alert('Error: '+(e.code||e.message))); }


// ---------- respaldo (solo administrador) ----------
const HUB_RESP_HOJAS = {
  hub_contenedores:'Ingreso de equipo', hub_historial_cont:'Historial ingresos', hub_np:'No programados',
  hub_despachos:'Despacho', hub_historial:'Historial despachos', hub_edif12_hist:'Edif 12 historial', hub_edif6_hist:'Edif 6 historial'
};
function hubFechaArchivo(){ const d=new Date(), z=n=>String(n).padStart(2,'0'); return `${d.getFullYear()}-${z(d.getMonth()+1)}-${z(d.getDate())}_${z(d.getHours())}${z(d.getMinutes())}`; }
function hubDescargar(nombre, blob){ const a=document.createElement('a'); a.href=URL.createObjectURL(blob); a.download=nombre; document.body.appendChild(a); a.click(); setTimeout(()=>{ URL.revokeObjectURL(a.href); a.remove(); },1500); }
function hubPlano(r){ const o={}; Object.keys(r).forEach(k=>{ if(k==='pedidos'||k==='costos') return; const v=r[k]; o[k]=(v&&typeof v==='object')?JSON.stringify(v):v; }); return o; }
async function hubRespaldoDescargar(){
  const m=document.getElementById('hub-menu'); if(m) m.hidden=true;
  if(!hubEsAdmin()) return;
  await hubSyncAhora();
  const datos={}; HUB_COLS.forEach(def=>{ datos[def.c]=JSON.parse(JSON.stringify(def.get(),(k,v)=>(k==='pedidos'||k==='costos')&&Array.isArray(v)?undefined:v)); });
  const docs={}; HUB_DOCS.forEach(def=>{ docs[def.c+'/'+def.id]=def.get()??null; });
  let usuarios=[]; try{ const s=await hubDb.collection('hub_usuarios').get(); usuarios=s.docs.map(d=>({...d.data(), usuario:d.id})); }catch(e){}
  const fecha=hubFechaArchivo();
  const resp={v:1, sistema:'HUB UL', fecha:new Date().toISOString(), por:hubPerfil.usuario, datos, docs, usuarios};
  hubDescargar(`HUB_UL_respaldo_${fecha}.json`, new Blob([JSON.stringify(resp)],{type:'application/json'}));
  if(typeof XLSX!=='undefined'){
    const wb=XLSX.utils.book_new();
    const res=[['Respaldo HUB UL'],['Fecha',new Date().toLocaleString('es-SV')],['Generado por',hubPerfil.nombre||hubPerfil.usuario],[],['Lista','Registros']];
    Object.entries(HUB_RESP_HOJAS).forEach(([c,l])=>res.push([l,(datos[c]||[]).length]));
    XLSX.utils.book_append_sheet(wb, XLSX.utils.aoa_to_sheet(res), 'Resumen');
    Object.entries(HUB_RESP_HOJAS).forEach(([c,l])=>{ const filas=(datos[c]||[]).map(hubPlano); XLSX.utils.book_append_sheet(wb, filas.length?XLSX.utils.json_to_sheet(filas):XLSX.utils.aoa_to_sheet([['Sin registros']]), l.slice(0,31)); });
    const cort=[]; [12,6].forEach(n=>Object.entries(edifState[n].cortinas).forEach(([i,c])=>cort.push({edificio:n,cortina:i,estado:c.estado,tipo:c.tipo||'',referencia:c.ref||'',detalle:c.label||'',inicio:c.inicio?new Date(c.inicio).toLocaleString('es-SV'):'',operador:c.operador||'',notas:c.notas||''})));
    XLSX.utils.book_append_sheet(wb, XLSX.utils.json_to_sheet(cort), 'Cortinas');
    XLSX.utils.book_append_sheet(wb, XLSX.utils.json_to_sheet(usuarios.map(u=>({usuario:u.usuario,nombre:u.nombre,perfil:(HUB_ROLES[u.rol]||{}).l||u.rol,activo:u.activo?'Sí':'No',...Object.fromEntries(HUB_MODULOS.map(x=>[x.c,(u.rol==='admin'||(u.permisos||{})[x.k]==='editar')?'Edita':'Ve']))}))), 'Usuarios');
    XLSX.writeFile(wb, `HUB_UL_respaldo_${fecha}.xlsx`);
  }
  try{ await hubDb.collection('hub_config').doc('respaldo').set({en:Date.now(), por:hubPerfil.usuario}); }catch(e){}
  hubToast('✓ Respaldo descargado: Excel para consultar y .json para restaurar. Guárdalos en tu OneDrive o carpeta de respaldos.');
}
async function hubRespaldoRecordatorio(){
  try{
    const d=await hubDb.collection('hub_config').doc('respaldo').get();
    const en=d.exists?d.data().en:0; const dias=Math.floor((Date.now()-en)/86400000);
    if(!en) hubToast('Aún no tienes respaldo del HUB. Menú → Descargar respaldo.');
    else if(dias>=7) hubToast(`Último respaldo hace ${dias} días. Menú → Descargar respaldo.`);
  }catch(e){}
}
function hubRespaldoRestaurarElegir(){
  const m=document.getElementById('hub-menu'); if(m) m.hidden=true;
  let i=document.getElementById('hub-resp-file');
  if(!i){ i=document.createElement('input'); i.type='file'; i.accept='.json,application/json'; i.id='hub-resp-file'; i.hidden=true; i.onchange=()=>hubRespaldoRestaurar(i); document.body.appendChild(i); }
  i.value=''; i.click();
}
function hubRespaldoRestaurar(input){
  const f=input.files&&input.files[0]; if(!f||!hubEsAdmin()) return;
  const fr=new FileReader();
  fr.onload=async()=>{
    let r; try{ r=JSON.parse(fr.result); }catch(e){ return alert('El archivo no es un respaldo válido del HUB.'); }
    if(!r||r.sistema!=='HUB UL'||!r.datos) return alert('El archivo no es un respaldo del HUB UL.');
    const res=Object.entries(HUB_RESP_HOJAS).map(([c,l])=>`• ${l}: ${(r.datos[c]||[]).length}`).join('\n');
    if(!confirm(`Restaurar respaldo del ${new Date(r.fecha).toLocaleString('es-SV')}\n\n${res}\n\n⚠ Esto REEMPLAZA lo que hay en línea para todo el equipo. Te recomiendo descargar un respaldo actual antes.\n\n¿Continuar?`)) return;
    HUB_COLS.forEach(def=>{ const arr=def.get(); arr.length=0; (r.datos[def.c]||[]).forEach(x=>arr.push(x)); hubOrden[def.c]=arr.map(x=>({id:x._id,t:x._t})); });
    HUB_DOCS.forEach(def=>{ const k=def.c+'/'+def.id; if(r.docs&&k in r.docs) def.set(r.docs[k]); });
    HUB_COLS.forEach(def=>{ try{ def.render(); }catch(e){} }); [12,6].forEach(n=>{ try{ edifRenderAll(n); }catch(e){} });
    hubInteraccion=true; await hubSyncAhora();
    alert('✅ Respaldo restaurado y guardado en línea.');
  };
  fr.readAsText(f);
}

// ════════════════════════════════════════════════════════════════
//  ALERTAS — campana con contador, panel, ventanita + sonido.
//  Se calculan de los datos; al cerrarlas ("Atendida") desaparecen
//  para todo el equipo y queda registrado quién y cuándo.
// ════════════════════════════════════════════════════════════════
const ALR_NP_DIAS = 3;          // NP sin programar
const ALR_VACIO_HORAS = 24;     // notificado vacío sin pasar a NP
let alrCerradas = {};           // key → {por, nombre, en}
let alrActivas = [];
let alrConocidas = null;        // keys ya vistas (para avisar solo las nuevas)
let alrUnsub = null, alrOn = false;

function alrId(r){ return String(r._id||r.cont||r.doc||r.pedido||'x'); }
function alrKey(...p){ return p.join('_').replace(/[^A-Za-z0-9_-]/g,'-').slice(0,300); }
function alrFechaSV(s){ // dd/mm/aaaa o aaaa-mm-dd → ms
  if(!s) return 0; s=String(s).trim();
  let m=s.match(/^(\d{1,2})\/(\d{1,2})\/(\d{4})/); if(m) return new Date(+m[3],+m[2]-1,+m[1]).getTime();
  m=s.match(/^(\d{4})-(\d{2})-(\d{2})/); if(m) return new Date(+m[1],+m[2]-1,+m[3]).getTime();
  return 0;
}
function alrHoyISO(){ const d=new Date(), z=n=>String(n).padStart(2,'0'); return `${d.getFullYear()}-${z(d.getMonth()+1)}-${z(d.getDate())}`; }
function alrHace(ms){ if(!ms) return ''; const min=Math.max(0,Math.floor((Date.now()-ms)/60000)); if(min<60) return `hace ${min} min`; const h=Math.floor(min/60); if(h<48) return `hace ${h} h`; return `hace ${Math.floor(h/24)} días`; }

// Marca desde cuándo cada contenedor está en su estado actual
function alrSellarEstados(){
  (contenedores||[]).forEach(r=>{ if(r && r.estado && r._est!==r.estado){ r._est=r.estado; r._est_en=Date.now(); } });
}

function alrCalcular(){
  const L=[]; const ahora=Date.now();
  alrSellarEstados();
  // ── Llegadas y cortinas ──
  (contenedores||[]).forEach(r=>{
    if(!r||r.enviado) return;
    const u=contUbicacion(r); const id=alrId(r); const c=r.cont||r.doc||'Contenedor';
    if(r.estado==='04-POSICIONADO EN BLUE' && !u)
      L.push({key:alrKey('llegada',id), g:'cortinas', nivel:'warn', ico:'🚛', tit:`${c} llegó a Blue sin cortina`, det:[r.origen,r.rc||r.doc].filter(Boolean).join(' · ')||'Asigna cortina o mándalo a cola', desde:r._est_en, ir:()=>goToTab('contenedores')});
    if(u && u.tipo==='cortina'){
      const min=(ahora-u.inicio)/60000, t=descTiempos(r.origen);
      if(min>t.limite) L.push({key:alrKey('exceso',id,u.inicio), g:'cortinas', nivel:'late', ico:'⏱', tit:`${c} fuera de tiempo en E${u.edif} · C${u.n}`, det:`${descDur(min)} descargando · meta ${descDur(t.limite)}${/COLOMBIA/i.test(r.origen||'')?' (Colombia)':''}`, desde:u.inicio, ir:()=>descIrA(u.edif)});
      else L.push({key:alrKey('cortina',id,u.inicio), g:'cortinas', nivel:'info', ico:'🔽', tit:`${c} en cortina E${u.edif} · C${u.n}`, det:`Descargando · meta ${descDur(t.limite)}`, desde:u.inicio, ir:()=>descIrA(u.edif)});
    }
    // ── Descarga y NP ──
    if(r.estado==='06-DESCARGADO')
      L.push({key:alrKey('descargado',id), g:'np', nivel:'ok', ico:'✅', tit:`${c} descargado`, det:'Cuando se notifique vacío, pasa sus pedidos a No programados', desde:r._est_en, ir:()=>goToTab('contenedores')});
    if(r.estado==='07-NOTIFICADO VACÍO' && r._est_en && ahora-r._est_en>ALR_VACIO_HORAS*3600000)
      L.push({key:alrKey('vacio',id), g:'np', nivel:'warn', ico:'📦', tit:`${c}: notificado vacío sin pasar a NP`, det:`Lleva ${alrHace(r._est_en).replace('hace ','')} · pasa los pedidos a No programados`, desde:r._est_en, ir:()=>goToTab('contenedores')});
  });
  // ── No programados ──
  const grupos={};
  (noProg||[]).forEach(r=>{
    const f=alrFechaSV(r.fecha); if(!f || ahora-f < ALR_NP_DIAS*86400000) return;
    const k=r.ref?('REF '+String(r.ref).trim()):(r.doc||r.rc||'Sin documento');
    (grupos[k]=grupos[k]||{peds:[],f,pais:new Set()}).peds.push(r);
    grupos[k].f=Math.min(grupos[k].f,f); const p=npGetPais(r); if(p) grupos[k].pais.add(p);
  });
  Object.entries(grupos).forEach(([k,g])=>{
    const dias=Math.floor((ahora-g.f)/86400000);
    L.push({key:alrKey('np',k,g.f), g:'np', nivel:dias>=7?'late':'warn', ico:'🗂', tit:`${g.peds.length} pedido${g.peds.length>1?'s':''} sin programar · ${k}`, det:`${dias} días en NP${g.pais.size?' · '+[...g.pais].join(', '):''}`, desde:g.f, ir:()=>goToTab('noprog')});
  });
  const hoy=alrHoyISO(); const refs={};
  (despachos||[]).forEach(r=>{ if(String(r.status||'').toUpperCase()==='PROGRAMADO' && String(r.fcarga||'').slice(0,10)===hoy){ const k=r.ref||'Sin referencia'; (refs[k]=refs[k]||[]).push(r); } });
  Object.entries(refs).forEach(([k,ps])=>L.push({key:alrKey('cargahoy',k,hoy), g:'np', nivel:'info', ico:'📅', tit:`${k} programada para cargar hoy`, det:`${ps.length} pedido${ps.length>1?'s':''} · ${ps[0].dest||''}`, desde:alrFechaSV(hoy), ir:()=>goToTab('despachos')}));
  const orden={late:0,warn:1,info:2,ok:3};
  return L.filter(a=>!alrCerradas[a.key]).sort((a,b)=>orden[a.nivel]-orden[b.nivel] || (b.desde||0)-(a.desde||0));
}

function alrActualizar(){
  if(!alrOn) return;
  try{ alrActivas=alrCalcular(); }catch(e){ console.error('alertas',e); return; }
  const keys=new Set(alrActivas.map(a=>a.key));
  if(alrConocidas){
    const nuevas=alrActivas.filter(a=>!alrConocidas.has(a.key));
    if(nuevas.length){ alrSonido(nuevas.some(a=>a.nivel==='late')); nuevas.slice(0,3).forEach(alrVentanita); if(nuevas.length>3) alrVentanita({ico:'🔔',nivel:'info',tit:`+${nuevas.length-3} alertas más`,det:'Abre la campana para verlas'}); }
  }
  alrConocidas=new Set([...(alrConocidas||[]), ...keys]);
  alrPintarCampana();
  const p=document.getElementById('alr-panel'); if(p && !p.hidden) alrPintarPanel();
}

// ---------- cierre compartido ----------
function alrCerrar(key){
  const reg={por:(typeof hubPerfil!=='undefined'&&hubPerfil)?hubPerfil.usuario:'local', nombre:(typeof hubPerfil!=='undefined'&&hubPerfil)?(hubPerfil.nombre||hubPerfil.usuario):'', en:Date.now()};
  alrCerradas[key]=reg; alrActualizar();
  if(window.HUB_ONLINE && hubDb) hubDb.collection('hub_alertas').doc(key).set(reg).catch(e=>hubToast('No se pudo cerrar la alerta en línea: '+(e.code||e.message),'err'));
  else { try{ localStorage.setItem('hubul_alertas_cerradas', JSON.stringify(alrCerradas)); }catch(e){} }
}
function alrCerrarTodas(){ if(!alrActivas.length) return; if(!confirm(`¿Marcar las ${alrActivas.length} alertas como atendidas para todo el equipo?`)) return; alrActivas.slice().forEach(a=>alrCerrar(a.key)); }
function alrEscuchar(){
  if(alrUnsub || !window.HUB_ONLINE || !hubDb) return;
  alrUnsub=hubDb.collection('hub_alertas').onSnapshot(s=>{
    const o={}; s.docs.forEach(d=>o[d.id]=d.data()); alrCerradas=o; alrActualizar();
    // limpieza: el admin borra registros de más de 45 días
    if(hubEsAdmin()){ const lim=Date.now()-45*86400000; s.docs.forEach(d=>{ if((d.data().en||0)<lim) d.ref.delete().catch(()=>{}); }); }
  }, e=>console.warn('alertas', e.code||e.message));
}

// ---------- interfaz ----------
function alrMontar(){
  if(document.getElementById('alr-bell')) return;
  const acts=document.querySelector('.header-actions'); if(!acts) return;
  const w=document.createElement('div'); w.className='alr-wrap';
  w.innerHTML=`<button id="alr-bell" class="alr-bell" onclick="alrTogglePanel(event)" aria-label="Alertas" aria-haspopup="true">
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M12 22a2.5 2.5 0 0 0 2.45-2h-4.9A2.5 2.5 0 0 0 12 22Zm7-6V11a7 7 0 0 0-5.5-6.84V3.5a1.5 1.5 0 0 0-3 0v.66A7 7 0 0 0 5 11v5l-1.7 1.7A1 1 0 0 0 4 19.4h16a1 1 0 0 0 .7-1.7Z"/></svg>
      <span id="alr-count" class="alr-count" hidden>0</span></button>
    <div id="alr-panel" class="alr-panel" hidden role="dialog" aria-label="Alertas"></div>`;
  acts.insertBefore(w, acts.firstChild);
}
function alrTogglePanel(ev){ ev.stopPropagation(); const p=document.getElementById('alr-panel'); p.hidden=!p.hidden; if(!p.hidden) alrPintarPanel(); }
document.addEventListener('click', e=>{ const p=document.getElementById('alr-panel'); if(p&&!p.hidden&&!e.target.closest('.alr-wrap')) p.hidden=true; });
function alrPintarCampana(){
  const c=document.getElementById('alr-count'), b=document.getElementById('alr-bell'); if(!c) return;
  const n=alrActivas.length; c.hidden=!n; c.textContent=n>99?'99+':n;
  b.classList.toggle('late', alrActivas.some(a=>a.nivel==='late'));
}
const ALR_GRUPOS={cortinas:'Llegadas y cortinas', np:'Descarga y No programados'};
function alrPintarPanel(){
  const p=document.getElementById('alr-panel'); if(!p) return;
  const hist=Object.entries(alrCerradas).sort((a,b)=>(b[1].en||0)-(a[1].en||0)).slice(0,5);
  const sec=Object.entries(ALR_GRUPOS).map(([g,l])=>{
    const xs=alrActivas.filter(a=>a.g===g); if(!xs.length) return '';
    return `<div class="alr-sec">${l} <span>${xs.length}</span></div>`+xs.map(a=>`
      <div class="alr-item ${a.nivel}">
        <div class="alr-ico">${a.ico}</div>
        <div class="alr-tx"><b>${hubEsc(a.tit)}</b><small>${hubEsc(a.det||'')}</small>${a.desde?`<em>${alrHace(a.desde)}</em>`:''}</div>
        <div class="alr-acc"><button class="alr-ir" data-k="${a.key}">Ver</button><button class="alr-ok" data-k="${a.key}" title="Marcar como atendida para todos">✓ Atendida</button></div>
      </div>`).join('');
  }).join('');
  p.innerHTML=`<div class="alr-head"><b>Alertas</b><span>${alrActivas.length?alrActivas.length+' pendiente'+(alrActivas.length>1?'s':''):'Todo al día'}</span>${alrActivas.length>1?'<button onclick="alrCerrarTodas()">Atender todas</button>':''}</div>
    <div class="alr-list">${sec||'<div class="alr-vacio">✓ No hay alertas pendientes</div>'}</div>
    ${hist.length?`<div class="alr-hist"><div class="alr-sec">Atendidas recientes</div>${hist.map(([k,h])=>`<div class="alr-h"><span>${hubEsc(alrTitHist(k))}</span><small>${hubEsc(h.nombre||h.por||'')} · ${alrHace(h.en)}</small></div>`).join('')}</div>`:''}`;
  p.querySelectorAll('.alr-ok').forEach(b=>b.onclick=e=>{ e.stopPropagation(); alrCerrar(b.dataset.k); });
  p.querySelectorAll('.alr-ir').forEach(b=>b.onclick=e=>{ e.stopPropagation(); const a=alrActivas.find(x=>x.key===b.dataset.k); if(a&&a.ir) a.ir(); p.hidden=true; });
}
function alrTitHist(k){ const t={llegada:'Llegada sin cortina',exceso:'Descarga fuera de tiempo',cortina:'Equipo en cortina',descargado:'Equipo descargado',vacio:'Vacío sin pasar a NP',np:'NP sin programar',cargahoy:'Carga programada hoy'}; const [tipo,...r]=k.split('_'); return (t[tipo]||tipo)+(tipo==='np'||tipo==='cargahoy'?' · '+r.slice(0,-1).join(' ').replace(/-/g,' ').trim():''); }
function alrVentanita(a){
  let box=document.getElementById('alr-toasts');
  if(!box){ box=document.createElement('div'); box.id='alr-toasts'; box.setAttribute('role','status'); box.setAttribute('aria-live','polite'); document.body.appendChild(box); }
  const t=document.createElement('div'); t.className='alr-toast '+(a.nivel||'');
  t.innerHTML=`<div class="alr-ico">${a.ico||'🔔'}</div><div class="alr-tx"><b>${hubEsc(a.tit)}</b><small>${hubEsc(a.det||'')}</small></div><button aria-label="Cerrar">×</button>`;
  t.querySelector('button').onclick=()=>t.remove();
  t.onclick=e=>{ if(e.target.tagName!=='BUTTON'){ if(a.ir) a.ir(); t.remove(); } };
  box.appendChild(t); setTimeout(()=>t.remove(), 9000);
}
let alrAudio=null;
function alrSonido(urgente){
  try{
    alrAudio=alrAudio||new (window.AudioContext||window.webkitAudioContext)();
    const tonos=urgente?[880,660,880]:[740,988];
    tonos.forEach((f,i)=>{ const o=alrAudio.createOscillator(), g=alrAudio.createGain(); o.type='sine'; o.frequency.value=f;
      const t0=alrAudio.currentTime+i*0.16; g.gain.setValueAtTime(0.0001,t0); g.gain.exponentialRampToValueAtTime(0.12,t0+0.02); g.gain.exponentialRampToValueAtTime(0.0001,t0+0.14);
      o.connect(g).connect(alrAudio.destination); o.start(t0); o.stop(t0+0.15); });
  }catch(e){}
}

// La alerta de descarga fuera de tiempo ahora la maneja la campana (evita avisos dobles)
descToast=function(){};
// Recalcular cuando cambian los datos y cada 30 s
['renderContenedores','renderNp','renderDespachos','edifRenderAll'].forEach(n=>{ const f=window[n]; if(typeof f!=='function') return; window[n]=function(){ const r=f.apply(this,arguments); clearTimeout(window._alrT); window._alrT=setTimeout(alrActualizar,400); return r; }; });
setInterval(alrActualizar, 30000);
function alrIniciar(){
  alrOn=true; alrMontar();
  if(window.HUB_ONLINE) alrEscuchar();
  else { try{ alrCerradas=JSON.parse(localStorage.getItem('hubul_alertas_cerradas')||'{}'); }catch(e){} }
  alrActualizar();
}

// ════════════════════════════════════════════════════════════════
//  REQUISICIONES DE CHEQUE (RC)
//  Factura por BL/manifiesto → costo por contenedor (según valor de factura,
//  editable) → costo por PO según su valor de factura.
// ════════════════════════════════════════════════════════════════
let rcLista = [];
let rcEdit = null;          // registro en edición (o null si es nueva)
let rcBorr = [];            // BLs en el formulario
const RC_ESTADOS = ['BORRADOR','ENVIADA','PAGADA'];
const RC_CONSIG = {
  sv:'UNILEVER EL SALVADOR SCC, S.A. DE C.V.',
  cr:'UL COSTA RICA SCC, S.A.',
  hn:'UNILEVER DE CENTROAMERICA S.A. (HN)',
  ni:'UNILEVER DE CENTROAMERICA S.A. (NIC)',
  gt:'UNILEVER DE CENTROAMERICA S.A. (OPERACION GUATEMALA)',
  pa:'UNILEVER DE CENTROAMERICA S.A. (PANAMÁ)'
};
const RC_LS = 'hubul_rc_v1';

// Permisos y almacenamiento
if(typeof HUB_MODULOS!=='undefined'){
  HUB_MODULOS.push({k:'pagos', l:'Pagos (RC)', c:'Pagos'});
  HUB_ROLES.admin.p.pagos='editar'; HUB_ROLES.trafico.p.pagos='ver'; HUB_ROLES.bodega.p.pagos='ver'; HUB_ROLES.consulta.p.pagos='ver';
  HUB_COLS.push({c:'hub_rc', m:'pagos', l:'Requisiciones (RC)', get:()=>rcLista, render:()=>rcRender()});
}
function rcPuede(){ return !window.HUB_ONLINE || (typeof hubPuede==='function' && hubPuede('pagos')); }
function rcPersistirLocal(){ if(window.HUB_ONLINE) return; try{ localStorage.setItem(RC_LS, JSON.stringify(rcLista)); }catch(e){} }
function rcCargarLocal(){ if(window.HUB_ONLINE) return; try{ const a=JSON.parse(localStorage.getItem(RC_LS)||'[]'); if(Array.isArray(a)){ rcLista.length=0; a.forEach(x=>rcLista.push(x)); } }catch(e){} }

// ---------- utilidades ----------
const rcC = n => Math.round((+n||0)*100);                 // a centavos
const rcUsd = n => '$ '+(+n||0).toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2});
const rcNum = (n,d=2) => (+n||0).toLocaleString('en-US',{minimumFractionDigits:d,maximumFractionDigits:d});
const rcEsc = s => String(s==null?'':s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const rcNorm = s => String(s||'').trim().toUpperCase().replace(/\s+/g,'');
function rcHoy(){ const d=new Date(), z=n=>String(n).padStart(2,'0'); return `${d.getFullYear()}-${z(d.getMonth()+1)}-${z(d.getDate())}`; }
function rcFechaLarga(iso){ if(!iso) return '—'; const [y,m,d]=iso.split('-').map(Number); return new Date(y,m-1,d).toLocaleDateString('es-SV',{day:'2-digit',month:'long',year:'numeric'}); }
function rcParseMonto(v){ const n=parseFloat(String(v||'').replace(/[$\s,]/g,'')); return isFinite(n)?n:0; }
// Reparte 'total' (centavos) según pesos, cuadrando al centavo (mayor residuo)
function rcRepartir(totalC, pesos){
  const s=pesos.reduce((a,b)=>a+b,0);
  if(!pesos.length) return [];
  const base = s>0 ? pesos.map(p=>totalC*p/s) : pesos.map(()=>totalC/pesos.length);
  const ent = base.map(Math.floor); let resto = totalC-ent.reduce((a,b)=>a+b,0);
  base.map((b,i)=>[b-ent[i],i]).sort((a,b)=>b[0]-a[0]).forEach(([,i])=>{ if(resto>0){ ent[i]++; resto--; } });
  return ent;
}
// Monto en letras (para el cheque)
function rcLetras(n){
  const U=['','UNO','DOS','TRES','CUATRO','CINCO','SEIS','SIETE','OCHO','NUEVE','DIEZ','ONCE','DOCE','TRECE','CATORCE','QUINCE','DIECISÉIS','DIECISIETE','DIECIOCHO','DIECINUEVE','VEINTE','VEINTIUNO','VEINTIDÓS','VEINTITRÉS','VEINTICUATRO','VEINTICINCO','VEINTISÉIS','VEINTISIETE','VEINTIOCHO','VEINTINUEVE'];
  const D=['','','','TREINTA','CUARENTA','CINCUENTA','SESENTA','SETENTA','OCHENTA','NOVENTA'];
  const C=['','CIENTO','DOSCIENTOS','TRESCIENTOS','CUATROCIENTOS','QUINIENTOS','SEISCIENTOS','SETECIENTOS','OCHOCIENTOS','NOVECIENTOS'];
  const c999=x=>{ if(x===0) return ''; if(x===100) return 'CIEN'; const c=Math.floor(x/100), r=x%100; let s=C[c];
    if(r){ s+=(s?' ':'')+(r<30?U[r]:D[Math.floor(r/10)]+(r%10?' Y '+U[r%10]:'')); } return s; };
  const ent=Math.floor(Math.round(n*100)/100), cent=Math.round((n-ent)*100);
  const mill=Math.floor(ent/1e6), miles=Math.floor((ent%1e6)/1000), resto=ent%1000;
  let s=[];
  if(mill) s.push(mill===1?'UN MILLÓN':c999(mill).replace(/UNO$/,'UN')+' MILLONES');
  if(miles) s.push(miles===1?'MIL':c999(miles).replace(/UNO$/,'UN')+' MIL');
  if(resto) s.push(c999(resto));
  const txt=(s.join(' ')||'CERO');
  return `${txt} ${String(cent).padStart(2,'0')}/100 DÓLARES`;
}

// ---------- datos del HUB ----------
function rcContsDeManifiesto(man){
  const k=rcNorm(man); if(!k) return [];
  const vistos=new Set(), out=[];
  [...(contenedores||[]), ...(historialCont||[])].forEach(r=>{
    if(!r || rcNorm(r.doc)!==k) return;
    const id=rcNorm(r.cont)||rcNorm(r.doc); if(vistos.has(id)) return; vistos.add(id); out.push(r);
  });
  return out;
}
function rcPedidosDe(r){
  return contPedidos(r).map(p=>({ot:p.ot||'', pedido:p.pedido||'', dt:p.dt||'', pais:p.pais||'', bultos:+p.bultos||0, peso:+p.peso||0, valor:+p.valor||0}));
}
function rcManifiestosDisponibles(){
  const usados=new Set(); rcLista.forEach(x=>(x.bls||[]).forEach(b=>usados.add(rcNorm(b.man))));
  const m=new Map();
  [...(contenedores||[]), ...(historialCont||[])].forEach(r=>{ const k=rcNorm(r.doc); if(!k||usados.has(k)) return; if(!m.has(k)) m.set(k,{man:String(r.doc).trim(), origen:r.origen||'', n:0}); m.get(k).n++; });
  return [...m.values()];
}
// Calcula costos por PO de un BL (en la estructura del formulario o guardada)
function rcCalcularBL(bl){
  bl.conts.forEach(c=>{
    const tot=rcC(c.costo);
    const pesos=c.peds.some(p=>p.valor>0) ? c.peds.map(p=>p.valor) : c.peds.some(p=>p.peso>0) ? c.peds.map(p=>p.peso) : c.peds.map(()=>1);
    c.base = c.peds.some(p=>p.valor>0) ? 'valor' : c.peds.some(p=>p.peso>0) ? 'peso' : 'igual';
    rcRepartir(tot,pesos).forEach((v,i)=>c.peds[i].costo=v/100);
  });
  return bl;
}
function rcTotalesBL(bl){
  const t={bultos:0,peso:0,valor:0,costo:0,conts:bl.conts.length,peds:0};
  bl.conts.forEach(c=>{ t.costo+=rcC(c.costo); c.peds.forEach(p=>{ t.bultos+=p.bultos; t.peso+=p.peso; t.valor+=p.valor; t.peds++; }); });
  t.costo/=100; return t;
}

// ---------- formulario ----------
function rcAbrir(id){
  if(!rcPuede()){ alert('No tienes permiso para crear o editar requisiciones.'); return; }
  rcEdit = id ? rcLista.find(x=>x._id===id) : null;
  const r = rcEdit ? JSON.parse(JSON.stringify(rcEdit)) : null;
  document.getElementById('rc-m-tit').textContent = r ? `Editar RC ${r.rc}` : 'Nueva requisición de cheque';
  document.getElementById('rc-m-num').value = r ? r.rc : '';
  document.getElementById('rc-m-fecha').value = r ? r.fecha : rcHoy();
  document.getElementById('rc-m-benef').value = r ? (r.beneficiario||'') : '';
  document.getElementById('rc-m-concepto').value = r ? (r.concepto||'') : 'Flete marítimo';
  document.getElementById('rc-m-notas').value = r ? (r.notas||'') : '';
  document.getElementById('rc-m-man').value=''; document.getElementById('rc-m-msg').textContent=''; document.getElementById('rc-m-msg').className=''; document.getElementById('rc-m-msg').dataset.rc='';
  rcBorr = r ? r.bls : [];
  document.getElementById('rc-dl-man').innerHTML = rcManifiestosDisponibles().map(m=>`<option value="${rcEsc(m.man)}">${rcEsc(m.origen)} · ${m.n} cont.</option>`).join('');
  document.getElementById('rc-dl-benef').innerHTML = [...new Set(rcLista.map(x=>x.beneficiario).filter(Boolean))].map(b=>`<option>${rcEsc(b)}</option>`).join('');
  rcPintarBLs();
  document.getElementById('modal-rc').classList.add('open');
  setTimeout(()=>document.getElementById(r?'rc-m-man':'rc-m-num').focus(),60);
}
// Contenedores (activos e historial) que tienen este No. de RC capturado en Ingreso
function rcContsDeRC(num){
  const k=rcNorm(num); if(!k) return [];
  const vistos=new Set(), out=[];
  [...(contenedores||[]), ...(historialCont||[])].forEach(r=>{
    const tiene=String(r.rc||'').split(/[,;/]+/).map(rcNorm).includes(k); if(!tiene) return;
    const id=rcNorm(r.cont)+'|'+rcNorm(r.doc); if(vistos.has(id)) return; vistos.add(id); out.push(r);
  });
  return out;
}
let rcNumT=null;
function rcNumCambio(ya){
  clearTimeout(rcNumT);
  rcNumT=setTimeout(()=>{
    const num=document.getElementById('rc-m-num').value.trim(), msg=document.getElementById('rc-m-msg');
    if(num && msg.dataset.rc===rcNorm(num) && rcBorr.length) return;   // ya se cargó este RC
    msg.className=''; msg.dataset.rc='';
    if(!num){ msg.textContent=''; return; }
    // ¿ya existe esa RC guardada?
    const otra=rcLista.find(x=>x!==rcEdit && rcNorm(x.rc)===rcNorm(num));
    if(otra){ msg.innerHTML=`La RC ${rcEsc(num)} ya está registrada. <button type="button" class="rc-link" onclick="rcAbrir('${otra._id}')">Abrirla</button>`; return; }
    const conts=rcContsDeRC(num);
    if(!conts.length){ msg.textContent=`No hay contenedores con el RC ${num} en Ingreso de equipo. Agrega los manifiestos a mano.`; return; }
    const mans=[...new Set(conts.map(r=>String(r.doc||'').trim()).filter(Boolean))];
    const nuevos=mans.filter(m=>!rcBorr.some(b=>rcNorm(b.man)===rcNorm(m)));
    nuevos.forEach(m=>rcAgregarManifiesto(m,true));
    rcPintarBLs();
    msg.className='rc-ok-msg'; msg.dataset.rc=rcNorm(num);
    msg.textContent = nuevos.length
      ? `✓ RC ${num}: se agregaron ${nuevos.length} manifiesto${nuevos.length===1?'':'s'} desde Ingreso (${conts.length} contenedor${conts.length===1?'':'es'} con este RC). Completa factura y monto.`
      : `✓ RC ${num}: sus manifiestos ya están en la lista.`;
    const f=document.querySelector('#rc-m-bls .rc-in-fact'); if(f && nuevos.length && !f.value) f.focus();
  }, ya?0:450);
}
// Agrega un manifiesto con todos sus contenedores (devuelve false si no se pudo)
function rcAgregarManifiesto(man, silencioso){
  const msg=document.getElementById('rc-m-msg');
  if(rcBorr.some(b=>rcNorm(b.man)===rcNorm(man))){ if(!silencioso) msg.textContent='Ese manifiesto ya está en esta RC.'; return false; }
  const conts=rcContsDeManifiesto(man);
  if(!conts.length){ if(!silencioso) msg.textContent=`No encontré contenedores con el manifiesto ${man} en Ingreso de equipo ni en su historial.`; return false; }
  rcBorr.push({man:String(conts[0].doc).trim(), origen:conts[0].origen||'', factura:'', monto:0, conts:conts.map(r=>({cont:r.cont||r.doc, costo:0, manual:false, peds:rcPedidosDe(r)}))});
  return true;
}
function rcAgregarBL(){
  const inp=document.getElementById('rc-m-man'), msg=document.getElementById('rc-m-msg');
  msg.className='';
  const man=inp.value.trim(); if(!man) return;
  if(rcBorr.some(b=>rcNorm(b.man)===rcNorm(man))){ msg.textContent='Ese manifiesto ya está en esta RC.'; return; }
  const otra=rcLista.find(x=>x!==rcEdit && (x.bls||[]).some(b=>rcNorm(b.man)===rcNorm(man)));
  if(otra && !confirm(`El manifiesto ${man} ya está en la RC ${otra.rc}. ¿Agregarlo de todos modos?`)) return;
  const conts=rcContsDeManifiesto(man);
  if(!conts.length){ msg.textContent=`No encontré contenedores con el manifiesto ${man} en Ingreso de equipo ni en su historial.`; return; }
  const bl={man:String(conts[0].doc).trim(), origen:conts[0].origen||'', factura:'', monto:0, conts:conts.map(r=>({cont:r.cont||r.doc, costo:0, manual:false, peds:rcPedidosDe(r)}))};
  rcBorr.push(bl); inp.value=''; msg.textContent='';
  rcPintarBLs();
  const f=document.querySelector(`#rc-m-bls .rc-bl:last-child .rc-in-fact`); if(f) f.focus();
}
function rcQuitarBL(i){ rcBorr.splice(i,1); rcPintarBLs(); }
function rcSetFactura(i,v){ rcBorr[i].factura=v.trim(); }
function rcSetMonto(i,v){
  const bl=rcBorr[i]; bl.monto=rcParseMonto(v);
  // reparte entre los contenedores no editados a mano según su VALOR DE FACTURA
  // (si algún contenedor no tiene valor, por peso; si tampoco hay peso, en partes iguales)
  const man=bl.conts.filter(c=>c.manual), auto=bl.conts.filter(c=>!c.manual);
  const resto=Math.max(0, rcC(bl.monto)-man.reduce((a,c)=>a+rcC(c.costo),0));
  const suma=(c,k)=>c.peds.reduce((a,p)=>a+(+p[k]||0),0);
  const pesos=auto.every(c=>suma(c,'valor')>0) ? auto.map(c=>suma(c,'valor')) : auto.every(c=>suma(c,'peso')>0) ? auto.map(c=>suma(c,'peso')) : auto.map(()=>1);
  bl.baseBL=auto.every(c=>suma(c,'valor')>0)?'valor':auto.every(c=>suma(c,'peso')>0)?'peso':'igual';
  rcRepartir(resto, pesos).forEach((v,k)=>auto[k].costo=v/100);
  rcPintarBLs(i);
}
function rcSetCostoCont(i,j,v){ const c=rcBorr[i].conts[j]; c.costo=rcParseMonto(v); c.manual=true; rcPintarBLs(i); }
function rcIgualar(i){ rcBorr[i].conts.forEach(c=>c.manual=false); rcSetMonto(i, rcBorr[i].monto); }
function rcPintarBLs(foco){
  const box=document.getElementById('rc-m-bls');
  let total=0;
  box.innerHTML = rcBorr.length ? rcBorr.map((bl,i)=>{
    rcCalcularBL(bl); const t=rcTotalesBL(bl); total+=rcC(bl.monto);
    const dif=rcC(bl.monto)-rcC(t.costo);
    const pend=bl.conts.filter(c=>c.peds.every(p=>!p.valor));
    return `<div class="rc-bl">
      <div class="rc-bl-h">
        <div class="rc-bl-id"><span>Manifiesto / BL</span><b>${rcEsc(bl.man)}</b><small>${rcEsc(bl.origen||'Sin origen')} · ${t.conts} contenedor${t.conts>1?'es':''} · ${t.peds} PO</small></div>
        <div class="form-group"><label>Factura *</label><input class="rc-in-fact" value="${rcEsc(bl.factura)}" oninput="rcSetFactura(${i},this.value)" placeholder="No. factura"></div>
        <div class="form-group"><label>Monto factura *</label><input class="rc-in-monto" value="${bl.monto?rcNum(bl.monto):''}" onchange="rcSetMonto(${i},this.value)" placeholder="0.00" inputmode="decimal"></div>
        <button class="rc-x" onclick="rcQuitarBL(${i})" title="Quitar manifiesto" aria-label="Quitar manifiesto">×</button>
      </div>
      <table class="rc-ct"><thead><tr><th>Contenedor</th><th class="num">PO</th><th class="num">Bultos</th><th class="num">Peso kg</th><th class="num">Valor factura</th><th class="num">Costo</th></tr></thead><tbody>
      ${bl.conts.map((c,j)=>{ const b=c.peds.reduce((a,p)=>a+p.bultos,0), w=c.peds.reduce((a,p)=>a+p.peso,0), v=c.peds.reduce((a,p)=>a+p.valor,0);
        return `<tr><td class="mono"><b>${rcEsc(c.cont)}</b>${c.base!=='valor'?` <em class="rc-warn" title="Sin valor de factura en los PO: se reparte por ${c.base==='peso'?'peso':'partes iguales'}">sin valor</em>`:''}</td>
        <td class="num">${c.peds.length}</td><td class="num">${rcNum(b,0)}</td><td class="num">${rcNum(w)}</td><td class="num">${rcUsd(v)}</td>
        <td class="num"><input class="rc-in-cc ${c.manual?'man':''}" value="${rcNum(c.costo)}" onchange="rcSetCostoCont(${i},${j},this.value)" aria-label="Costo ${rcEsc(c.cont)}"></td></tr>`+
        c.peds.map(p=>`<tr class="rc-po"><td><span class="rc-po-l">PO</span> <span class="mono">${rcEsc(p.pedido||'—')}</span><small class="rc-ot">OT <b>${rcEsc(p.ot||'—')}</b></small> <small>${rcEsc(String(p.pais||'').toUpperCase())}</small></td>
          <td class="num">${v>0&&p.valor>0?rcNum(p.valor/v*100,1)+'%':''}</td><td class="num">${rcNum(p.bultos,0)}</td><td class="num">${rcNum(p.peso)}</td><td class="num">${rcUsd(p.valor)}</td><td class="num"><b>${rcUsd(p.costo||0)}</b></td></tr>`).join(''); }).join('')}
      </tbody></table>
      <div class="rc-bl-f ${dif?'bad':''}">${dif?`⚠ Repartido ${rcUsd(t.costo)} de ${rcUsd(bl.monto)} · diferencia ${rcUsd(dif/100)}`:`✓ Repartido ${rcUsd(t.costo)}`}${bl.baseBL&&bl.baseBL!=='valor'&&bl.conts.length>1?` · <span class="rc-warn">repartido por ${bl.baseBL==='peso'?'peso':'partes iguales'}: algún contenedor no tiene valor de factura</span>`:''}${bl.conts.some(c=>c.manual)?` · <button onclick="rcIgualar(${i})">volver a repartir por valor</button>`:''}${pend.length?` · <span class="rc-warn">${pend.length} contenedor${pend.length>1?'es':''} sin valor de factura</span>`:''}</div>
    </div>`;
  }).join('') : '<div class="rc-vacio">Agrega el primer manifiesto / BL para empezar.</div>';
  document.getElementById('rc-m-total').textContent = rcUsd(total/100);
}
function rcGuardar(imprimir){
  if(!rcPuede()) return;
  const num=document.getElementById('rc-m-num').value.trim();
  if(!num){ alert('Escribe el número de RC.'); document.getElementById('rc-m-num').focus(); return; }
  if(rcLista.some(x=>x!==rcEdit && rcNorm(x.rc)===rcNorm(num))){ alert(`Ya existe la RC ${num}.`); return; }
  if(!rcBorr.length){ alert('Agrega al menos un manifiesto / BL.'); return; }
  const prob=[];
  rcBorr.forEach(bl=>{ rcCalcularBL(bl); const t=rcTotalesBL(bl);
    if(!bl.factura) prob.push(`${bl.man}: falta el número de factura`);
    if(!(bl.monto>0)) prob.push(`${bl.man}: falta el monto de la factura`);
    else if(rcC(bl.monto)!==rcC(t.costo)) prob.push(`${bl.man}: el costo repartido (${rcUsd(t.costo)}) no cuadra con la factura (${rcUsd(bl.monto)})`);
  });
  if(prob.length){ alert('🔒 No se puede guardar la RC\n\n• '+prob.join('\n• ')); return; }
  const facturasOtras=new Map(); rcLista.forEach(x=>{ if(x!==rcEdit) (x.bls||[]).forEach(b=>facturasOtras.set(rcNorm(b.factura),x.rc)); });
  const rep=rcBorr.filter(b=>facturasOtras.has(rcNorm(b.factura)));
  if(rep.length && !confirm(`La factura ${rep.map(b=>b.factura).join(', ')} ya aparece en la RC ${facturasOtras.get(rcNorm(rep[0].factura))}. ¿Guardar de todos modos?`)) return;
  const quien = (typeof hubPerfil!=='undefined'&&hubPerfil) ? (hubPerfil.nombre||hubPerfil.usuario) : '';
  const reg = rcEdit || {estado:'BORRADOR', creado:{por:quien, en:Date.now()}};
  Object.assign(reg, {rc:num, fecha:document.getElementById('rc-m-fecha').value||rcHoy(), beneficiario:document.getElementById('rc-m-benef').value.trim(),
    concepto:document.getElementById('rc-m-concepto').value.trim(), notas:document.getElementById('rc-m-notas').value.trim(),
    bls:JSON.parse(JSON.stringify(rcBorr)), total:rcBorr.reduce((a,b)=>a+rcC(b.monto),0)/100, editado:{por:quien, en:Date.now()}});
  if(!rcEdit) rcLista.push(reg);
  rcVincularContenedores(reg);
  rcPersistirLocal();
  closeModals(); rcRender(); try{ renderContenedores(); renderHistorialCont(); }catch(e){}
  if(imprimir) rcImprimir(reg);
}
// Escribe el No. de RC en los contenedores (y el flete pagado si la RC está pagada)
function rcVincularContenedores(reg){
  const ids=new Set(); (reg.bls||[]).forEach(b=>b.conts.forEach(c=>ids.add(rcNorm(b.man)+'|'+rcNorm(c.cont))));
  [...(contenedores||[]), ...(historialCont||[])].forEach(r=>{
    if(!ids.has(rcNorm(r.doc)+'|'+rcNorm(r.cont||r.doc))) return;
    const act=String(r.rc||'').split(/\s*,\s*/).filter(x=>x&&x!=='-'&&x!=='—');
    if(!act.includes(reg.rc)) r.rc=[...act, reg.rc].join(', ');
    if(reg.estado==='PAGADA') r.flete='04-PAGADO';
  });
}
function rcCambiarEstado(id, est){
  const r=rcLista.find(x=>x._id===id); if(!r||!rcPuede()) return;
  if(est==='PAGADA'){
    const f=prompt(`Fecha de pago de la RC ${r.rc} (aaaa-mm-dd):`, rcHoy()); if(f==null){ rcRender(); return; }
    r.fpago=f.trim()||rcHoy();
  }
  r.estado=est; rcVincularContenedores(r); rcPersistirLocal(); rcRender(); try{ renderContenedores(); renderHistorialCont(); }catch(e){}
}
function rcEliminar(id){
  const r=rcLista.find(x=>x._id===id); if(!r||!rcPuede()) return;
  if(!confirm(`¿Eliminar la RC ${r.rc} (${rcUsd(r.total)})?\n\nLos contenedores conservan el número escrito en su ficha.`)) return;
  rcLista.splice(rcLista.indexOf(r),1); rcPersistirLocal(); rcRender();
}

// ---------- lista ----------
function rcRender(){
  rcIds();
  const tb=document.getElementById('rc-body'); if(!tb) return;
  document.querySelectorAll('.rc-edita').forEach(b=>b.style.display=rcPuede()?'':'none');
  const est=document.getElementById('rc-f-estado').value, q=rcNorm(document.getElementById('rc-f-q').value);
  const lista=rcLista.filter(r=>(!est||r.estado===est) && (!q || [r.rc,r.beneficiario,...(r.bls||[]).flatMap(b=>[b.man,b.factura,...b.conts.map(c=>c.cont)])].some(v=>rcNorm(v).includes(q))))
    .sort((a,b)=>String(b.fecha).localeCompare(String(a.fecha)) || String(b.rc).localeCompare(String(a.rc)));
  const pend=rcLista.filter(r=>r.estado!=='PAGADA'), mes=rcHoy().slice(0,7);
  document.getElementById('rc-k-n').textContent=rcLista.length;
  document.getElementById('rc-k-pend').textContent=pend.length?`${rcUsd(pend.reduce((a,r)=>a+(+r.total||0),0))} · ${pend.length}`:'—';
  const pagMes=rcLista.filter(r=>r.estado==='PAGADA'&&String(r.fpago||'').startsWith(mes));
  document.getElementById('rc-k-mes').textContent=pagMes.length?rcUsd(pagMes.reduce((a,r)=>a+(+r.total||0),0)):'—';
  document.getElementById('rc-k-sin').textContent=(contenedores||[]).filter(r=>!r.enviado && contVacio(r.rc) && ['02','03','04','05','06','07'].includes(String(r.estado||'').slice(0,2))).length;
  document.getElementById('rc-count').textContent=`${lista.length} de ${rcLista.length}`;
  const ed=rcPuede();
  tb.innerHTML = lista.length ? lista.map(r=>{
    const nc=(r.bls||[]).reduce((a,b)=>a+b.conts.length,0);
    return `<tr>
      <td><span class="rc-num">${rcEsc(r.rc)}</span></td>
      <td class="mono">${rcEsc(r.fecha||'')}</td>
      <td>${rcEsc(r.beneficiario||'—')}</td>
      <td>${rcEsc(r.concepto||'—')}</td>
      <td><div class="rc-mfs">${(r.bls||[]).map(b=>`<span><b>${rcEsc(b.man)}</b> · ${rcEsc(b.factura)} · ${rcUsd(b.monto)}</span>`).join('')}</div></td>
      <td class="num">${nc}</td>
      <td class="num"><b>${rcUsd(r.total)}</b></td>
      <td>${ed?`<select class="rc-est ${r.estado}" onchange="rcCambiarEstado('${r._id}',this.value)">${RC_ESTADOS.map(e=>`<option ${e===r.estado?'selected':''}>${e}</option>`).join('')}</select>`:`<span class="rc-est ${r.estado}">${r.estado}</span>`}${r.estado==='PAGADA'&&r.fpago?`<small class="rc-fp">pagada ${rcEsc(r.fpago)}</small>`:''}</td>
      <td class="rc-acc"><button class="btn btn-sm" onclick="rcImprimir(rcLista.find(x=>x._id==='${r._id}'))">Imprimir</button><button class="btn btn-sm" onclick="rcExcel(rcLista.find(x=>x._id==='${r._id}'))">Excel</button>${ed?`<button class="btn btn-sm" onclick="rcAbrir('${r._id}')">Editar</button><button class="btn btn-sm rc-del" onclick="rcEliminar('${r._id}')" aria-label="Eliminar">×</button>`:''}</td>
    </tr>`; }).join('') : `<tr><td colspan="9"><div class="empty"><strong>${rcLista.length?'Sin resultados':'Aún no hay requisiciones'}</strong>${rcLista.length?'Ajusta los filtros':'Crea la primera con “+ Nueva RC”'}</div></td></tr>`;
  const b=document.getElementById('tab-count-rc'); if(b) b.textContent=pend.length;
}
// Asegura _id en modo sin conexión
function rcIds(){ rcLista.forEach(r=>{ if(!r._id) r._id='rc'+Date.now().toString(36)+Math.random().toString(36).slice(2,6); }); }

// ---------- documento para imprimir ----------
function rcDocumentoHTML(r){
  const bls=(r.bls||[]).map(b=>rcCalcularBL(JSON.parse(JSON.stringify(b))));
  const T={bultos:0,peso:0,valor:0,conts:0,peds:0}; bls.forEach(b=>{ const t=rcTotalesBL(b); T.bultos+=t.bultos; T.peso+=t.peso; T.valor+=t.valor; T.conts+=t.conts; T.peds+=t.peds; });
  const porPais={}; bls.forEach(b=>b.conts.forEach(c=>c.peds.forEach(p=>{ const k=p.pais||'?'; const o=porPais[k]=porPais[k]||{peds:0,valor:0,costo:0}; o.peds++; o.valor+=p.valor; o.costo+=rcC(p.costo); })));
  const origenes=[...new Set(bls.map(b=>b.origen).filter(Boolean))].join(', ')||'—';
  const quien=(r.creado&&r.creado.por)||'';
  const gen=new Date().toLocaleString('es-SV',{dateStyle:'medium',timeStyle:'short'});
  const consig=k=>RC_CONSIG[k]||((CONT_PAIS_INFO[k]||{}).l)||k;
  const det=bls.map(b=>b.conts.map(c=>{ const sb=c.peds.reduce((a,p)=>a+p.bultos,0), sw=c.peds.reduce((a,p)=>a+p.peso,0), sv=c.peds.reduce((a,p)=>a+p.valor,0);
    return `<section class="cont">
      <div class="cont-h"><div><span>Contenedor</span><b>${rcEsc(c.cont)}</b></div><div><span>Manifiesto</span><b>${rcEsc(b.man)}</b></div><div><span>Factura</span><b>${rcEsc(b.factura)}</b></div><div class="r"><span>Costo del contenedor</span><b>${rcUsd(c.costo)}</b></div></div>
      <table><thead><tr><th>OT</th><th>PO</th><th>Consignatario</th><th class="n">Bultos</th><th class="n">Peso kg</th><th class="n">Valor factura</th><th class="n">% </th><th class="n">Costo</th></tr></thead><tbody>
      ${c.peds.map(p=>`<tr><td class="m">${rcEsc(p.ot||'—')}</td><td class="m">${rcEsc(p.pedido)}</td><td>${rcEsc(consig(p.pais))}</td><td class="n">${rcNum(p.bultos,0)}</td><td class="n">${rcNum(p.peso)}</td><td class="n">${rcUsd(p.valor)}</td><td class="n">${sv?rcNum(p.valor/sv*100,1):'—'}</td><td class="n b">${rcUsd(p.costo)}</td></tr>`).join('')}
      </tbody><tfoot><tr><td colspan="3">Subtotal ${rcEsc(c.cont)}${c.base!=='valor'?` <i>(reparto por ${c.base==='peso'?'peso':'partes iguales'}: PO sin valor de factura)</i>`:''}</td><td class="n">${rcNum(sb,0)}</td><td class="n">${rcNum(sw)}</td><td class="n">${rcUsd(sv)}</td><td class="n">100</td><td class="n b">${rcUsd(c.costo)}</td></tr></tfoot></table>
    </section>`; }).join('')).join('');
  return `<!doctype html><html lang="es"><head><meta charset="utf-8"><title>RC ${rcEsc(r.rc)} — Requisición de cheque</title>
<meta name="viewport" content="width=device-width,initial-scale=1">
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;600&display=swap" rel="stylesheet">
<style>
:root{--ink:#14213A;--mut:#5B6B82;--line:#DCE3EC;--soft:#F4F7FB;--deep:#0E2D57;--acc:#2E6CB5;--gold:#C9A227;}
*{box-sizing:border-box;-webkit-print-color-adjust:exact;print-color-adjust:exact;}
body{margin:0;background:#E9EDF3;font-family:Manrope,system-ui,sans-serif;color:var(--ink);font-size:10.5px;}
.bar{position:sticky;top:0;z-index:5;display:flex;gap:8px;justify-content:center;padding:10px;background:#0E2D57;}
.bar button{border:none;border-radius:999px;padding:8px 18px;font:700 12px Manrope,sans-serif;cursor:pointer;background:#fff;color:#0E2D57;}
.bar button.p{background:#4A8FD6;color:#fff;}
.page{width:216mm;min-height:279mm;margin:14px auto;background:#fff;padding:13mm 13mm 16mm;box-shadow:0 10px 30px -12px rgba(14,45,87,.35);position:relative;}
header{display:flex;justify-content:space-between;align-items:flex-start;gap:20px;padding-bottom:12px;border-bottom:2px solid var(--deep);}
.brand{display:flex;gap:10px;align-items:center;}
.mark{width:40px;height:40px;border-radius:50%;background:radial-gradient(circle at 32% 28%,#6FA8E6,#2E6CB5 45%,#0E2D57);color:#fff;font-weight:800;font-size:14px;display:flex;align-items:center;justify-content:center;}
.brand b{display:block;font-size:14px;font-weight:800;color:var(--deep);}
.brand small{font-size:9.5px;color:var(--mut);}
.doc{text-align:right;}
.doc .t{font-size:10px;font-weight:800;letter-spacing:.14em;color:var(--mut);text-transform:uppercase;}
.doc .n{font-size:26px;font-weight:800;color:var(--deep);line-height:1.05;margin:2px 0;}
.doc .n span{font-size:11px;color:var(--mut);font-weight:700;margin-right:6px;letter-spacing:.06em;}
.doc .f{font-size:10.5px;color:var(--mut);}
.est{display:inline-block;margin-top:4px;padding:2px 9px;border-radius:999px;font-size:9px;font-weight:800;letter-spacing:.08em;}
.est.BORRADOR{background:#EEF1F5;color:#4A5A72;}.est.ENVIADA{background:#FFF4D6;color:#8A5A00;}.est.PAGADA{background:#E3F5E9;color:#166534;}
.info{display:grid;grid-template-columns:1.3fr 1fr 1fr;gap:10px;margin:14px 0;}
.info div{background:var(--soft);border-radius:8px;padding:8px 10px;}
.info span,.cont-h span,.tot span{display:block;font-size:8.5px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:var(--mut);margin-bottom:2px;}
.info b{font-size:11.5px;}
.tot{display:flex;justify-content:space-between;align-items:center;gap:16px;background:linear-gradient(135deg,#0E2D57,#1D4E8C);color:#fff;border-radius:10px;padding:12px 16px;margin-bottom:16px;}
.tot span{color:#AFC6E6;}
.tot .m{font-size:24px;font-weight:800;font-family:'JetBrains Mono',monospace;white-space:nowrap;}
.tot .l{font-size:10px;font-weight:700;color:#DCE7F5;max-width:60%;}
h2{font-size:11px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:var(--deep);margin:18px 0 8px;display:flex;align-items:center;gap:8px;}
h2:after{content:"";flex:1;height:1px;background:var(--line);}
table{width:100%;border-collapse:collapse;}
th{font-size:8.5px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;color:var(--mut);text-align:left;padding:6px 6px;border-bottom:1.5px solid var(--deep);background:#fff;}
td{padding:5px 6px;border-bottom:1px solid var(--line);vertical-align:top;}
.n{text-align:right;white-space:nowrap;font-family:'JetBrains Mono',monospace;font-size:10px;}
.m{font-family:'JetBrains Mono',monospace;font-size:10px;}
.b{font-weight:700;}
tfoot td{font-weight:800;background:var(--soft);border-bottom:none;border-top:1.5px solid var(--deep);}
tfoot i{font-weight:500;color:var(--mut);}
.res tfoot td{background:#FFF8DC;}
.cont{break-inside:avoid;margin-bottom:12px;border:1px solid var(--line);border-radius:8px;overflow:hidden;}
.cont-h{display:grid;grid-template-columns:1.1fr 1fr 1fr 1.1fr;gap:8px;padding:8px 10px;background:var(--soft);border-bottom:1px solid var(--line);}
.cont-h b{font-family:'JetBrains Mono',monospace;font-size:11px;}
.cont-h .r{text-align:right;}.cont-h .r b{color:var(--deep);font-size:12px;}
.cont table th{background:#fff;}
.cierre{break-inside:avoid;}
.firmas{display:grid;grid-template-columns:repeat(3,1fr);gap:26px;margin-top:34px;}
.firmas div{border-top:1.2px solid var(--ink);padding-top:5px;text-align:center;font-size:9.5px;color:var(--mut);}
.firmas b{display:block;color:var(--ink);font-size:10.5px;margin-bottom:1px;}
.notas{margin-top:10px;font-size:10px;color:var(--mut);}
footer{position:absolute;left:13mm;right:13mm;bottom:7mm;display:flex;justify-content:space-between;font-size:8.5px;color:#93A0B3;border-top:1px solid var(--line);padding-top:4px;}
.pais td:first-child{font-weight:600;}
@page{size:letter;margin:12mm 12mm 13mm;}
@media print{body{background:#fff;}.bar{display:none;}.page{margin:0;box-shadow:none;width:auto;min-height:auto;padding:0;}footer{position:static;margin-top:12px;}}
</style></head><body>
<div class="bar"><button class="p" onclick="window.print()">Imprimir / Guardar PDF</button><button onclick="window.close()">Cerrar</button></div>
<div class="page">
<header>
  <div class="brand"><div class="mark">BL</div><div><b>Blue Logistics</b><small>Logistic Solutions, S.A. de C.V. · Operación Unilever</small></div></div>
  <div class="doc"><div class="t">Requisición de cheque</div><div class="n"><span>RC N.º</span>${rcEsc(r.rc)}</div><div class="f">${rcFechaLarga(r.fecha)}</div><span class="est ${r.estado}">${r.estado}${r.estado==='PAGADA'&&r.fpago?' · '+rcEsc(r.fpago):''}</span></div>
</header>
<div class="info">
  <div><span>Beneficiario</span><b>${rcEsc(r.beneficiario||'—')}</b></div>
  <div><span>Concepto</span><b>${rcEsc(r.concepto||'—')}</b></div>
  <div><span>Origen</span><b>${rcEsc(origenes)}</b></div>
</div>
<div class="tot"><div><span>Monto a pagar</span><div class="l">${rcLetras(+r.total||0)}</div></div><div class="m">USD ${rcNum(r.total)}</div></div>

<h2>Resumen por manifiesto</h2>
<table class="res"><thead><tr><th>Manifiesto / BL</th><th>Factura</th><th>Origen</th><th class="n">Cont.</th><th class="n">Bultos</th><th class="n">Peso kg</th><th class="n">Valor factura</th><th class="n">Costo</th></tr></thead><tbody>
${bls.map(b=>{ const t=rcTotalesBL(b); return `<tr><td class="m b">${rcEsc(b.man)}</td><td class="m">${rcEsc(b.factura)}</td><td>${rcEsc(b.origen||'—')}</td><td class="n">${t.conts}</td><td class="n">${rcNum(t.bultos,0)}</td><td class="n">${rcNum(t.peso)}</td><td class="n">${rcUsd(t.valor)}</td><td class="n b">${rcUsd(b.monto)}</td></tr>`; }).join('')}
</tbody><tfoot><tr><td colspan="3">Total general</td><td class="n">${T.conts}</td><td class="n">${rcNum(T.bultos,0)}</td><td class="n">${rcNum(T.peso)}</td><td class="n">${rcUsd(T.valor)}</td><td class="n">${rcUsd(r.total)}</td></tr></tfoot></table>

<h2>Detalle por contenedor</h2>
${det}
${r.notas?`<div class="notas"><b>Notas:</b> ${rcEsc(r.notas)}</div>`:''}
<div class="cierre"><div class="firmas"><div><b>${rcEsc(quien)||'&nbsp;'}</b>Elaboró</div><div><b>&nbsp;</b>Revisó</div><div><b>&nbsp;</b>Autorizó</div></div>
<footer><span>Blue Logistics · HUB UL · RC ${rcEsc(r.rc)}</span><span>Costo por contenedor según factura del BL; por PO según valor de factura · Generado ${rcEsc(gen)}</span></footer></div>
</div></body></html>`;
}
function rcImprimir(r){
  if(!r) return;
  const w=window.open('', '_blank');
  if(!w){ alert('El navegador bloqueó la ventana de impresión. Permite ventanas emergentes para este sitio.'); return; }
  w.document.open(); w.document.write(rcDocumentoHTML(r)); w.document.close();
}
function rcExcel(r){
  if(!r) return; if(typeof XLSX==='undefined'){ alert('No se pudo cargar el generador de Excel.'); return; }
  const bls=(r.bls||[]).map(b=>rcCalcularBL(JSON.parse(JSON.stringify(b))));
  const wb=XLSX.utils.book_new();
  const res=[['REQUISICIÓN DE CHEQUE'],['RC',r.rc],['Fecha',r.fecha],['Beneficiario',r.beneficiario||''],['Concepto',r.concepto||''],['Estado',r.estado],[],['Manifiesto','Factura','Origen','Contenedores','Bultos','Peso kg','Valor factura','Costo']];
  bls.forEach(b=>{ const t=rcTotalesBL(b); res.push([b.man,b.factura,b.origen||'',t.conts,t.bultos,+t.peso.toFixed(2),+t.valor.toFixed(2),+(+b.monto).toFixed(2)]); });
  res.push(['TOTAL','','', '', '', '', '', +(+r.total).toFixed(2)]); res.push([]); res.push(['Monto en letras', rcLetras(+r.total||0)]);
  const ws1=XLSX.utils.aoa_to_sheet(res); ws1['!cols']=[{wch:16},{wch:16},{wch:14},{wch:12},{wch:10},{wch:12},{wch:14},{wch:14}];
  XLSX.utils.book_append_sheet(wb, ws1, 'RC '+String(r.rc).slice(0,25));
  const det=[['OT','PO','Manifiesto','Contenedor','Consignatario','Bultos','Peso','Valor factura','Costo','Factura']];
  bls.forEach(b=>b.conts.forEach(c=>c.peds.forEach(p=>det.push([p.ot,p.pedido,b.man,c.cont,RC_CONSIG[p.pais]||p.pais,p.bultos,p.peso,p.valor,p.costo,b.factura]))));
  const ws2=XLSX.utils.aoa_to_sheet(det); ws2['!cols']=[{wch:12},{wch:13},{wch:13},{wch:14},{wch:44},{wch:8},{wch:10},{wch:13},{wch:11},{wch:13}];
  XLSX.utils.book_append_sheet(wb, ws2, 'Detalle');
  XLSX.writeFile(wb, `RC_${r.rc}.xlsx`);
}

// ════════════════════════════════════════════════════════════════
//  REPORTE PARA SEGURO — mercadería bajo custodia de Blue
//  Desde 04-Posicionado en Blue hasta Despacho que aún no sale
//  (incluye CARGADO sin despachar). Excluye lo despachado.
// ════════════════════════════════════════════════════════════════
const SEG_ETAPAS = [
  {k:'blue',  l:'En Blue sin descargar', d:'Contenedor posicionado en Blue (04)'},
  {k:'cont',  l:'Descargado en contenedor', d:'En descarga, descargado o vacío notificado (05–07), aún sin pasar a NP'},
  {k:'np',    l:'No programado', d:'En bodega, pendiente de programar'},
  {k:'desp',  l:'En despacho', d:'Programado, en carga o cargado, sin salir'}
];
const SEG_PAIS = {sv:'El Salvador',hn:'Honduras',cr:'Costa Rica',ni:'Nicaragua',gt:'Guatemala',pa:'Panamá'};
function segNorm(v){ return String(v||'').trim().toUpperCase().replace(/\s+/g,''); }
function segNum(v){ const n=parseFloat(String(v==null?'':v).replace(/[$,\s]/g,'')); return isFinite(n)?n:0; }
function segPaisKey(v){
  const s=String(v||'').trim(); if(!s) return '';
  const low=s.toLowerCase(); if(SEG_PAIS[low]) return low;
  const n=dgNorm(s);
  if(n.includes('SALVADOR')||n==='ESA') return 'sv'; if(n.includes('HONDURAS')||n.includes('(HN)')) return 'hn';
  if(n.includes('COSTA')) return 'cr'; if(n.includes('NICARAGUA')||n.includes('(NIC)')) return 'ni';
  if(n.includes('GUATEMALA')) return 'gt'; if(n.includes('PANAMA')) return 'pa';
  return '';
}
function segFechaISO(v){ const d=dgFecha(v); return d?dgIso(d):''; }

// Arma la lista de pedidos bajo custodia (sin duplicar: Despacho > NP > Contenedor)
function segDatos(){
  // Mapas desde los contenedores (para completar origen, valor, contenedor, manifiesto)
  const info={};
  [...(contenedores||[]), ...(historialCont||[])].forEach(r=>{
    contPedidos(r).forEach(p=>{ const k=segNorm(p.pedido); if(!k||contVacio(p.pedido)) return;
      info[k]=info[k]||{cont:r.cont||'', man:r.doc||'', origen:r.origen||'', valor:segNum(p.valor), ot:p.ot||'', dt:p.dt||'', factura:p.factura||'', bultos:segNum(p.bultos)}; });
  });
  const vistos=new Set(), L=[];
  const add=o=>{ const k=segNorm(o.pedido); if(!k||vistos.has(k)) return; vistos.add(k);
    const I=info[k]||{};
    o.cont=o.cont||I.cont||''; o.man=o.man||I.man||''; o.origen=o.origen||I.origen||''; o.ot=o.ot||I.ot||''; o.dt=o.dt||I.dt||''; o.factura=o.factura||I.factura||'';
    if(!(o.valor>0) && I.valor>0) o.valor=I.valor;
    if(!(o.bultos>0) && I.bultos>0) o.bultos=I.bultos;
    const f=dgFecha(o.fing); o.dias=f?Math.max(0,Math.round((dgHoy()-f)/86400000)):null; o.fingISO=f?dgIso(f):'';
    L.push(o); };
  (despachos||[]).forEach(r=>add({etapa:'desp', estado:String(r.status||'PROGRAMADO').toUpperCase(), pedido:String(r.no_pedido||'').trim(), dt:r.dt||'', ot:r.ot||'',
    pais:segPaisKey(r.dest), ref:r.ref||'', man:r.bl_cp||'', bultos:segNum(r.pallets)||segNum(r.cajas), peso:segNum(r.peso), valor:segNum(r.valor), factura:r.fact_ul||'', fing:r.fingreso||''}));
  (noProg||[]).forEach(r=>add({etapa:'np', estado:'NO PROGRAMADO', pedido:String(r.pedido||'').trim(), dt:r.dt||'', ot:r.ot||'',
    pais:segPaisKey(r.pais||r.dest), ref:r.ref||'', man:r.doc||r.bl_cp||'', origen:r.origen||'', bultos:segNum(r.pallets)||segNum(r.cajas), peso:segNum(r.peso), valor:segNum(r.valor), factura:r.fact_ul||'', fing:r.fdescarga||''}));
  (contenedores||[]).forEach(r=>{
    if(r.enviado===true||String(r.enviado)==='true') return;
    const e=String(r.estado||'').slice(0,2); if(!['04','05','06','07'].includes(e)) return;
    contPedidos(r).forEach(p=>{ if(p.salida||contVacio(p.pedido)) return;
      add({etapa:e==='04'?'blue':'cont', estado:String(r.estado||''), pedido:String(p.pedido).trim(), dt:p.dt||'', ot:p.ot||'', pais:p.pais||'',
        cont:r.cont||'', man:r.doc||'', origen:r.origen||'', bultos:segNum(p.bultos), peso:segNum(p.peso), valor:segNum(p.valor), factura:p.factura||'',
        fing:(contVacio(r.fdesc)?'':r.fdesc)||r.eta_blue||''}); });
  });
  const T={n:L.length, valor:0, peso:0, bultos:0, sinValor:0};
  L.forEach(o=>{ T.valor+=o.valor; T.peso+=o.peso; T.bultos+=o.bultos; if(!(o.valor>0)) T.sinValor++; });
  const porEtapa=SEG_ETAPAS.map(E=>{ const xs=L.filter(o=>o.etapa===E.k); return {...E, n:xs.length, valor:xs.reduce((a,o)=>a+o.valor,0), peso:xs.reduce((a,o)=>a+o.peso,0)}; });
  const pp={}; L.forEach(o=>{ const k=o.pais||'?'; const x=pp[k]=pp[k]||{k, n:0, valor:0, peso:0}; x.n++; x.valor+=o.valor; x.peso+=o.peso; });
  const porPais=Object.values(pp).sort((a,b)=>b.valor-a.valor);
  const ord={blue:0,cont:1,np:2,desp:3};
  L.sort((a,b)=>ord[a.etapa]-ord[b.etapa] || String(a.pais).localeCompare(String(b.pais)) || String(a.pedido).localeCompare(String(b.pedido)));
  return {L, T, porEtapa, porPais};
}
const segUsd=n=>'$ '+(+n||0).toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2});
function segPaisL(k){ return SEG_PAIS[k]||'Sin país'; }
function segGenerado(){ return new Date().toLocaleString('es-SV',{day:'2-digit',month:'long',year:'numeric',hour:'2-digit',minute:'2-digit'}); }
function segOrdenar(L){ return L.slice().sort((a,b)=>segPaisL(a.pais).localeCompare(segPaisL(b.pais)) || String(a.pedido).localeCompare(String(b.pedido))); }

// ---------- pantalla ----------
function segRender(){
  const box=document.getElementById('seg-body'); if(!box) return;
  const D=segDatos(), q=segNorm((document.getElementById('seg-q')||{}).value);
  document.getElementById('seg-gen').textContent='Al '+segGenerado();
  document.getElementById('seg-k-valor').textContent=segUsd(D.T.valor);
  document.getElementById('seg-k-n').textContent=D.T.n.toLocaleString('en-US');
  const sv=document.getElementById('seg-k-sin'); sv.textContent=D.T.sinValor; sv.parentElement.classList.toggle('seg-alerta', D.T.sinValor>0);
  const L=segOrdenar(D.L).filter(o=>!q || [o.pedido,o.dt,o.cont,segPaisL(o.pais)].some(v=>segNorm(v).includes(q)));
  document.getElementById('seg-count').textContent=`${L.length} de ${D.T.n} pedidos`;
  box.innerHTML = L.length ? L.map(o=>`<tr>
      <td class="mono"><b>${dgEsc(o.pedido)}</b></td><td class="mono">${dgEsc(o.dt||'—')}</td><td>${dgEsc(segPaisL(o.pais))}</td>
      <td class="mono">${dgEsc(o.cont||'—')}</td><td class="mono">${o.fingISO||'—'}</td>
      <td class="num"><b>${o.valor>0?segUsd(o.valor):'<span class="seg-falta">sin valor</span>'}</b></td></tr>`).join('')
      + (q?'':`<tr class="seg-total"><td colspan="5">Total · ${D.T.n} pedidos</td><td class="num">${segUsd(D.T.valor)}</td></tr>`)
    : `<tr><td colspan="6"><div class="empty"><strong>Sin mercadería bajo custodia</strong>No hay pedidos en Blue</div></td></tr>`;
}

// ---------- documento para imprimir (carta vertical, simple) ----------
function segDocumentoHTML(){
  const D=segDatos(), L=segOrdenar(D.L), gen=segGenerado();
  const quien=(typeof hubPerfil!=='undefined'&&hubPerfil)?(hubPerfil.nombre||hubPerfil.usuario):'';
  const E=s=>String(s==null?'':s).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
  return `<!doctype html><html lang="es"><head><meta charset="utf-8"><title>Inventario para seguro — ${E(gen)}</title>
<meta name="viewport" content="width=device-width,initial-scale=1">
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;600&display=swap" rel="stylesheet">
<style>
:root{--ink:#14213A;--mut:#5B6B82;--line:#DCE3EC;--soft:#F4F7FB;--deep:#0E2D57;}
*{box-sizing:border-box;-webkit-print-color-adjust:exact;print-color-adjust:exact;}
body{margin:0;background:#E9EDF3;font-family:Manrope,system-ui,sans-serif;color:var(--ink);font-size:10.5px;}
.bar{position:sticky;top:0;z-index:5;display:flex;gap:8px;justify-content:center;padding:10px;background:#0E2D57;}
.bar button{border:none;border-radius:999px;padding:8px 18px;font:700 12px Manrope,sans-serif;cursor:pointer;background:#fff;color:#0E2D57;}
.bar button.p{background:#4A8FD6;color:#fff;}
.page{width:216mm;margin:14px auto;background:#fff;padding:14mm;box-shadow:0 10px 30px -12px rgba(14,45,87,.35);}
header{display:flex;justify-content:space-between;align-items:flex-end;gap:20px;padding-bottom:10px;border-bottom:2px solid var(--deep);}
.brand b{display:block;font-size:15px;font-weight:800;color:var(--deep);}
.brand small{font-size:10px;color:var(--mut);}
.doc{text-align:right;}
.doc .t{font-size:13px;font-weight:800;color:var(--deep);}
.doc .f{font-size:10px;color:var(--mut);margin-top:2px;}
.tot{display:flex;justify-content:space-between;align-items:center;margin:12px 0 14px;padding:10px 14px;background:var(--soft);border-radius:8px;}
.tot span{font-size:9px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:var(--mut);}
.tot b{font-family:'JetBrains Mono',monospace;font-size:18px;color:var(--deep);}
.tot div:last-child{text-align:right;}
table{width:100%;border-collapse:collapse;}
th{font-size:8.5px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;color:var(--mut);text-align:left;padding:6px;border-bottom:1.5px solid var(--deep);}
td{padding:5px 6px;border-bottom:1px solid var(--line);}
.n{text-align:right;white-space:nowrap;font-family:'JetBrains Mono',monospace;}
.m{font-family:'JetBrains Mono',monospace;}
i{color:#B45309;font-style:normal;font-weight:700;}
.tt td{font-weight:800;background:#FFF8DC;border-top:1.5px solid var(--deep);border-bottom:none;}
.nota{font-size:9px;color:var(--mut);margin-top:10px;line-height:1.5;}
.firmas{display:grid;grid-template-columns:repeat(2,1fr);gap:40px;margin-top:36px;break-inside:avoid;}
.firmas div{border-top:1.2px solid var(--ink);padding-top:5px;text-align:center;font-size:9.5px;color:var(--mut);}
.firmas b{display:block;color:var(--ink);font-size:10px;}
@page{size:letter;margin:12mm;}
@media print{body{background:#fff;}.bar{display:none;}.page{margin:0;box-shadow:none;width:auto;padding:0;}thead{display:table-header-group;}}
</style></head><body>
<div class="bar"><button class="p" onclick="window.print()">Imprimir / Guardar PDF</button><button onclick="window.close()">Cerrar</button></div>
<div class="page">
<header>
  <div class="brand"><b>Blue Logistics</b><small>Logistic Solutions, S.A. de C.V. · Operación Unilever</small></div>
  <div class="doc"><div class="t">Inventario bajo custodia — Reporte para seguro</div><div class="f">Al ${E(gen)}</div></div>
</header>
<div class="tot"><div><span>Pedidos</span><br><b>${D.T.n.toLocaleString('en-US')}</b></div><div><span>Valor de factura total</span><br><b>USD ${(+D.T.valor).toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2})}</b></div></div>
<table><thead><tr><th>Pedido</th><th>DT</th><th>País</th><th>Contenedor</th><th>Fecha de ingreso</th><th class="n">Valor factura</th></tr></thead><tbody>
${L.map(o=>`<tr><td class="m">${E(o.pedido)}</td><td class="m">${E(o.dt||'—')}</td><td>${E(segPaisL(o.pais))}</td><td class="m">${E(o.cont||'—')}</td><td class="m">${o.fingISO||'—'}</td><td class="n">${o.valor>0?segUsd(o.valor):'<i>sin valor</i>'}</td></tr>`).join('')}
<tr class="tt"><td colspan="5">Total · ${D.T.n} pedidos</td><td class="n">${segUsd(D.T.valor)}</td></tr>
</tbody></table>
<p class="nota">Mercadería desde su posicionamiento en Blue hasta su salida, incluye pedidos cargados sin despachar. No incluye mercadería en tránsito ni despachada. Valor según factura comercial de cada pedido.${D.T.sinValor?` <b>${D.T.sinValor} pedido(s) sin valor de factura registrado.</b>`:''}</p>
<div class="firmas"><div><b>${E(quien)||'&nbsp;'}</b>Elaboró</div><div><b>&nbsp;</b>Autorizó</div></div>
</div></body></html>`;
}
function segImprimir(){
  const w=window.open('','_blank');
  if(!w){ alert('El navegador bloqueó la ventana de impresión. Permite ventanas emergentes para este sitio.'); return; }
  w.document.open(); w.document.write(segDocumentoHTML()); w.document.close();
}
function segExcel(){
  if(typeof XLSX==='undefined'){ alert('No se pudo cargar el generador de Excel.'); return; }
  const D=segDatos(), L=segOrdenar(D.L), gen=segGenerado();
  const r=[['INVENTARIO BAJO CUSTODIA — REPORTE PARA SEGURO'],['Blue Logistics · Operación Unilever'],['Al',gen],[],['Pedido','DT','País','Contenedor','Fecha de ingreso','Valor factura']];
  L.forEach(o=>r.push([o.pedido,o.dt||'',segPaisL(o.pais),o.cont||'',o.fingISO||'',+(+o.valor).toFixed(2)]));
  r.push(['TOTAL · '+D.T.n+' pedidos','','','','',+(+D.T.valor).toFixed(2)]);
  const ws=XLSX.utils.aoa_to_sheet(r); ws['!cols']=[{wch:24},{wch:14},{wch:14},{wch:15},{wch:16},{wch:15}];
  const wb=XLSX.utils.book_new(); XLSX.utils.book_append_sheet(wb,ws,'Inventario');
  const d=new Date(), z=n=>String(n).padStart(2,'0');
  XLSX.writeFile(wb,`Inventario_seguro_${d.getFullYear()}-${z(d.getMonth()+1)}-${z(d.getDate())}.xlsx`);
}

// ---------- acceso solo gerencia ----------
if(typeof HUB_MODULOS!=='undefined'){
  HUB_MODULOS.push({k:'gerencia', l:'Reportes de gerencia (acceso)', c:'Gerencia'});
  HUB_ROLES.admin.p.gerencia='editar'; HUB_ROLES.trafico.p.gerencia='ver'; HUB_ROLES.bodega.p.gerencia='ver'; HUB_ROLES.consulta.p.gerencia='ver';
}
function segAcceso(){ return !window.HUB_ONLINE || (typeof hubPuede==='function' && hubPuede('gerencia')); }
function segAplicarAcceso(){
  const ok=segAcceso(), b=document.getElementById('nav-seguro'); if(b) b.style.display=ok?'':'none';
  const t=document.getElementById('tab-seguro');
  if(!ok && t && t.classList.contains('active')) goToTab('contenedores');
  if(!ok){ const body=document.getElementById('seg-body'); if(body) body.innerHTML=''; }
}
const _segRenderBase=segRender;
segRender=function(){ if(!segAcceso()){ segAplicarAcceso(); return; } return _segRenderBase(); };
const _segImpBase=segImprimir; segImprimir=function(){ if(!segAcceso()) return alert('Este reporte es solo para gerencia.'); return _segImpBase(); };
const _segXlsBase=segExcel; segExcel=function(){ if(!segAcceso()) return alert('Este reporte es solo para gerencia.'); return _segXlsBase(); };
if(typeof hubPintarUsuario==='function'){ const _hpu=hubPintarUsuario; hubPintarUsuario=function(){ const r=_hpu.apply(this,arguments); try{ segAplicarAcceso(); }catch(e){} return r; }; }
document.addEventListener('DOMContentLoaded',()=>{ if(window.HUB_ONLINE) segAplicarAcceso(); });

// refrescar si la pantalla está abierta y cambian los datos
['renderContenedores','renderNp','renderDespachos'].forEach(n=>{ const f=window[n]; if(typeof f!=='function') return; window[n]=function(){ const r=f.apply(this,arguments); const t=document.getElementById('tab-seguro'); if(t&&t.classList.contains('active')){ clearTimeout(window._segT); window._segT=setTimeout(()=>{ try{ segRender(); }catch(e){} },300); } return r; }; });

// ════════════════════════════════════════════════════════════════
//  TRÁMITES — referencias en carga con documentos completos.
//  Tráfico marca Factura UL · DT · Carta porte en Despacho;
//  el administrador define el orden 1, 2, 3…; trámites registra
//  estado (Pendiente → En trámite → Listo) y N.º de declaración.
// ════════════════════════════════════════════════════════════════
let tramLista = [];
const TRAM_DOCS = [{k:'fac', l:'Factura UL', c:'Factura'}, {k:'dt', l:'DT', c:'DT'}, {k:'cp', l:'Carta porte / BL terrestre', c:'C. porte'}];
const TRAM_ESTADOS = ['PENDIENTE','EN PROCESO','TRAMITADO'];
const TRAM_CARGA = ['EN PROCESO DE CARGA','CARGADO'];
const TRAM_LS = 'hubul_tramites_v1';
const TRAM_CLS = {'PENDIENTE':'pend','EN PROCESO':'proc','TRAMITADO':'listo'};
// estados anteriores → nuevos
function tramEstadoN(e){ e=String(e||'').toUpperCase(); if(e==='LISTO'||e==='TRAMITADO') return 'TRAMITADO'; if(e==='EN PROCESO'||e==='EN TRÁMITE') return 'EN PROCESO'; return 'PENDIENTE'; }

if(typeof HUB_MODULOS!=='undefined'){
  HUB_MODULOS.push({k:'tramites', l:'Trámites (estado y declaración)', c:'Trámites'});
  HUB_ROLES.admin.p.tramites='editar'; HUB_ROLES.trafico.p.tramites='ver'; HUB_ROLES.bodega.p.tramites='ver'; HUB_ROLES.consulta.p.tramites='ver';
  HUB_ROLES.tramites={l:'Trámites', p:Object.fromEntries(HUB_MODULOS.map(m=>[m.k,'ver']))};
  HUB_ROLES.tramites.p.tramites='editar';
  HUB_COLS.push({c:'hub_tramites', m:['despacho','tramites'], l:'Trámites', get:()=>tramLista, render:()=>{ tramRender(); try{ renderDespachos(); }catch(e){} }});
}
const tramN = s => String(s||'').trim().toUpperCase();
const tramEsc = s => String(s==null?'':s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
function tramQuien(){ return (typeof hubPerfil!=='undefined'&&hubPerfil) ? (hubPerfil.nombre||hubPerfil.usuario) : ''; }
function tramPuedeDocs(){ return !window.HUB_ONLINE || hubPuede('despacho'); }
function tramPuedeEstado(){ return !window.HUB_ONLINE || hubPuede('tramites'); }
function tramPuedeOrden(){ return !window.HUB_ONLINE || hubEsAdmin(); }
function tramGuardarLocal(){ if(window.HUB_ONLINE) return; try{ localStorage.setItem(TRAM_LS, JSON.stringify(tramLista)); }catch(e){} }
function tramCargarLocal(){ if(window.HUB_ONLINE) return; try{ const a=JSON.parse(localStorage.getItem(TRAM_LS)||'[]'); if(Array.isArray(a)){ tramLista.length=0; a.forEach(x=>tramLista.push(x)); } }catch(e){} }
function tramReg(ref, crear){
  let r=tramLista.find(x=>tramN(x.ref)===tramN(ref));
  if(!r && crear){ r={ref:String(ref).trim(), docs:{fac:false,dt:false,cp:false}, orden:null, estado:'PENDIENTE', decl:'', nota:''}; tramLista.push(r); }
  return r;
}
function tramNormalizar(){ tramLista.forEach(r=>{ const n=tramEstadoN(r.estado); if(r.estado!==n) r.estado=n; }); }
function tramDocsOk(r){ return !!r && TRAM_DOCS.every(d=>r.docs&&r.docs[d.k]); }
function tramHace(ms){ if(!ms) return ''; const m=Math.max(0,Math.floor((Date.now()-ms)/60000)); if(m<60) return `hace ${m} min`; const h=Math.floor(m/60); if(h<48) return `hace ${h} h`; return `hace ${Math.floor(h/24)} d`; }
function tramHora(ms){ return ms ? new Date(ms).toLocaleString('es-SV',{day:'2-digit',month:'short',hour:'2-digit',minute:'2-digit'}) : ''; }

// Referencias de Despacho agrupadas
function tramRefs(){
  const g={};
  (despachos||[]).forEach(r=>{ const k=tramN(r.ref); if(!k) return; (g[k]=g[k]||{ref:String(r.ref).trim(), rows:[]}).rows.push(r); });
  return Object.values(g).map(x=>{
    const st=x.rows.map(r=>String(r.status||'').toUpperCase());
    const enCarga=st.some(s=>TRAM_CARGA.includes(s));
    const activa=st.some(s=>s!=='DESPACHADO');   // programada, en carga o cargada
    const cargado=st.every(s=>s==='CARGADO');
    const dest=[...new Set(x.rows.map(r=>r.dest).filter(Boolean))].join(', ');
    const peso=x.rows.reduce((a,r)=>a+(parseFloat(r.peso)||0),0);
    const pallets=x.rows.reduce((a,r)=>a+(parseFloat(r.pallets)||0),0);
    const fcarga=x.rows.map(r=>r.fcarga).filter(Boolean).sort()[0]||'';
    const cort=[...new Set(x.rows.map(r=>r.edif&&r.cortina?`E${r.edif}·C${r.cortina}`:'').filter(Boolean))].join(', ');
    const remolque=[...new Set(x.rows.map(r=>[r.camion,r.remolque].filter(Boolean).join(' · ')).filter(Boolean))].join(', ');
    const piloto=[...new Set(x.rows.map(r=>r.piloto?(r.piloto+(r.licencia?' · Lic. '+r.licencia:'')):'').filter(Boolean))].join(', ');
    return {...x, enCarga, activa, cargado, dest, peso, pallets, fcarga, cort, remolque, piloto, equipo:x.rows[0].equipo||'', reg:tramReg(x.ref,false)};
  });
}

// ---------- checklist en Despacho ----------
function tramChips(ref){
  const r=tramReg(ref,false), ok=tramDocsOk(r), ed=tramPuedeDocs();
  const chips=TRAM_DOCS.map(d=>{ const on=!!(r&&r.docs&&r.docs[d.k]);
    return `<button class="tram-chip ${on?'on':''}" ${ed?`onclick="tramToggleDoc('${tramEsc(ref)}','${d.k}')"`:'disabled'} title="${d.l}${on?' — recibido':' — pendiente'}" aria-pressed="${on}">${on?'✓':'○'} ${d.c}</button>`; }).join('');
  const en=ok?tramEstadoN(r.estado):'';
  const est = !ok ? '' : en==='TRAMITADO' ? `<span class="tram-ok done" title="Tramitado${r.decl?' · '+tramEsc(r.decl):''}">✓ Tramitado${r.decl?' · '+tramEsc(r.decl):''}</span>`
    : en==='EN PROCESO' ? `<span class="tram-ok proc" title="En proceso de trámite desde ${tramHora(r.inicioEn)}">⏳ En proceso de trámite</span>`
    : `<span class="tram-ok" title="Documentos completos${r.docsEn?' · '+tramHora(r.docsEn):''}">📄 Docs completos · pendiente de trámite</span>`;
  return `<span class="tram-chips" aria-label="Documentos para trámite">${chips}${est}</span>`;
}
function tramToggleDoc(ref, k){
  if(!tramPuedeDocs()) return;
  const r=tramReg(ref,true); const antes=tramDocsOk(r);
  r.docs=r.docs||{}; r.docs[k]=!r.docs[k];
  const ahora=tramDocsOk(r);
  if(ahora && !antes){
    r.docsEn=Date.now(); r.docsPor=tramQuien();
    if(r.orden==null){ const max=tramLista.reduce((a,x)=>Math.max(a, x.orden||0),0); r.orden=max+1; }
  }
  if(!ahora && antes){ r.docsEn=null; }
  tramGuardarLocal();
  try{ renderDespachos(); }catch(e){}
  tramRender();
}

// ---------- pantalla ----------
function tramRender(){
  const body=document.getElementById('tram-body');
  tramNormalizar();
  const refs=tramRefs();
  const soloHN=window.HUB_ONLINE&&typeof hubPerfil!=='undefined'&&hubPerfil&&hubPerfil.rol==='honduras';
  const listas=refs.filter(x=>x.activa && tramDocsOk(x.reg) && (!soloHN||vhnEsHN(x)));
  const espera=refs.filter(x=>x.activa && !tramDocsOk(x.reg) && (!soloHN||vhnEsHN(x)));
  const pend=listas.filter(x=>x.reg.estado!=='TRAMITADO');
  const b=document.getElementById('tab-count-tramites'); if(b){ b.textContent=pend.length; b.className='tab-badge '+(pend.length?'':'gray'); }
  if(!body) return;
  const ord=(a,b)=>((a.reg.estado==='TRAMITADO')-(b.reg.estado==='TRAMITADO')) || ((a.reg.orden??9999)-(b.reg.orden??9999)) || String(a.fcarga).localeCompare(String(b.fcarga));
  listas.sort(ord);
  document.getElementById('tram-k-listas').textContent=listas.filter(x=>x.reg.estado==='PENDIENTE').length;
  document.getElementById('tram-k-proc').textContent=listas.filter(x=>x.reg.estado==='EN PROCESO').length;
  document.getElementById('tram-k-ok').textContent=listas.filter(x=>x.reg.estado==='TRAMITADO').length;
  document.getElementById('tram-k-espera').textContent=espera.length;
  document.getElementById('tram-count').textContent=`${listas.length} referencia${listas.length===1?'':'s'}`;
  const eo=tramPuedeOrden(), ee=tramPuedeEstado();
  let pos=0;
  body.innerHTML = listas.length ? listas.map(x=>{
    const r=x.reg, listo=r.estado==='TRAMITADO'; if(!listo) pos++;
    return `<tr class="tram-row ${listo?'listo':''} ${r.estado==='EN PROCESO'?'proc':''}">
      <td class="tram-ord">${listo?'<span class="tram-n done">✓</span>':(eo?`<input type="number" min="1" class="tram-in-ord" value="${pos}" onchange="tramMover('${tramEsc(x.ref)}',this.value)" aria-label="Orden de ${tramEsc(x.ref)}">`:`<span class="tram-n">${pos}</span>`)}</td>
      <td><b class="tram-ref">${tramEsc(x.ref)}</b><small>${x.rows.length} pedido${x.rows.length===1?'':'s'} · ${tramEsc(x.dest||'—')}</small>${vhnChip(x)}</td>
      <td>${statusBadge(x.cargado?'CARGADO':x.enCarga?'EN PROCESO DE CARGA':'PROGRAMADO')}<small>${[x.cort,x.equipo].filter(Boolean).map(tramEsc).join(' · ')||'&nbsp;'}</small><small class="tram-transp">${x.remolque?'🚚 '+tramEsc(x.remolque):'<span class="tram-falta">🚚 sin datos de transporte</span>'}${x.piloto?'<br>👤 '+tramEsc(x.piloto):''}</small></td>
      <td class="num">${(x.pallets||0).toLocaleString('en-US')}<small>${x.peso.toLocaleString('en-US',{maximumFractionDigits:0})} kg</small></td>
      <td><span class="tram-docs-ok">✓ Completos</span><small>${tramEsc(r.docsPor||'')}${r.docsEn?' · '+tramHace(r.docsEn):''}</small></td>
      <td>${listo
          ? `<span class="tram-est listo">✓ Tramitado</span><small>${r.listoEn?tramHora(r.listoEn):''}</small>${ee?`<button class="tram-undo" onclick="tramEstado('${tramEsc(x.ref)}','EN PROCESO')">deshacer</button>`:''}`
          : r.estado==='EN PROCESO'
            ? `<span class="tram-est proc">⏳ En proceso</span><small>${r.inicioEn?'desde '+tramHace(r.inicioEn):''}${r.inicioPor?' · '+tramEsc(r.inicioPor):''}</small>${ee?`<button class="tram-btn ok" onclick="tramEstado('${tramEsc(x.ref)}','TRAMITADO')">✓ Marcar tramitado</button><button class="tram-undo" onclick="tramEstado('${tramEsc(x.ref)}','PENDIENTE')">deshacer</button>`:''}`
            : (ee?`<button class="tram-btn" onclick="tramEstado('${tramEsc(x.ref)}','EN PROCESO')">▶ Iniciar trámite</button>`:`<span class="tram-est pend">Pendiente</span>`)}</td>
      <td>${ee?`<input class="tram-in-decl" value="${tramEsc(r.decl||'')}" placeholder="N.º declaración" onchange="tramDecl('${tramEsc(x.ref)}',this.value)" aria-label="Número de declaración">`:`<span class="mono">${tramEsc(r.decl||'—')}</span>`}</td>
      <td><small class="tram-upd">${r.avance?`${tramEsc(r.avance.por||'')} · ${tramHace(r.avance.en)}`:'—'}</small></td>
      <td>${eo?`<input class="tram-in-nota" value="${tramEsc(r.nota||'')}" placeholder="Nota de prioridad" onchange="tramNota('${tramEsc(x.ref)}',this.value)" aria-label="Nota">`:`<small>${tramEsc(r.nota||'')}</small>`}</td>
    </tr>`; }).join('')
    : `<tr><td colspan="9"><div class="empty"><strong>Sin referencias listas para trámite</strong>Aparecen aquí cuando tráfico marca Factura UL, DT y Carta porte de una referencia</div></td></tr>`;
  const eb=document.getElementById('tram-espera');
  eb.innerHTML = espera.length ? espera.map(x=>{ const r=x.reg; const falt=TRAM_DOCS.filter(d=>!(r&&r.docs&&r.docs[d.k])).map(d=>d.c);
    return `<div class="tram-esp"><b>${tramEsc(x.ref)}</b><small>${tramEsc(x.dest||'')} · ${x.cargado?'Cargado':x.enCarga?'En proceso de carga':'Programado'}</small><span>Falta: ${falt.map(f=>`<i>${f}</i>`).join(' ')}</span>${vhnChip(x)}</div>`; }).join('')
    : '<div class="tram-esp-vacio">Nada en espera: todo lo que está en carga tiene documentos completos.</div>';
}
function tramAvance(r){ r.avance={por:tramQuien(), en:Date.now()}; }
function tramEstado(ref, v){
  if(!tramPuedeEstado()) return; const r=tramReg(ref,true);
  const antes=tramEstadoN(r.estado);
  if(v==='TRAMITADO'){ const x=tramRefs().find(z=>tramN(z.ref)===tramN(ref)); if(x&&vhnEsHN(x)&&!(r.vhn&&r.vhn.estado==='APROBADO')){ alert(`🔒 ${ref} va a Honduras: primero Honduras debe aprobar los valores en aduanas.\n\nEstado: ${r.vhn?VHN_EST[r.vhn.estado].l:'sin calcular'}.`); tramRender(); return; } }
  if(v==='TRAMITADO' && !String(r.decl||'').trim()){ const d=prompt(`N.º de declaración de ${ref}:`, ''); if(d==null){ tramRender(); return; } r.decl=d.trim(); }
  if(TRAM_ESTADOS.indexOf(v)<TRAM_ESTADOS.indexOf(antes) && !confirm(`¿Regresar ${ref} a "${v==='PENDIENTE'?'Pendiente':'En proceso'}"?`)){ tramRender(); return; }
  if(v==='EN PROCESO' && antes==='PENDIENTE'){ r.inicioEn=Date.now(); r.inicioPor=tramQuien(); }
  if(v==='PENDIENTE'){ r.inicioEn=null; r.inicioPor=''; }
  r.estado=v; tramAvance(r); r.listoEn = v==='TRAMITADO' ? Date.now() : null;
  if(v==='TRAMITADO') r.listoPor=tramQuien();
  tramGuardarLocal(); tramRender(); try{ renderDespachos(); }catch(e){}
}
function tramDecl(ref, v){ if(!tramPuedeEstado()) return; const r=tramReg(ref,true); r.decl=String(v||'').trim(); tramAvance(r); tramGuardarLocal(); tramRender(); }
function tramNota(ref, v){ if(!tramPuedeOrden()) return; const r=tramReg(ref,true); r.nota=String(v||'').trim(); tramGuardarLocal(); }
// Mueve una referencia a la posición indicada y renumera 1..n (solo las pendientes / en trámite)
function tramMover(ref, pos){
  if(!tramPuedeOrden()) return;
  const act=tramRefs().filter(x=>x.activa && tramDocsOk(x.reg) && x.reg.estado!=='TRAMITADO')
    .sort((a,b)=>((a.reg.orden??9999)-(b.reg.orden??9999)) || String(a.fcarga).localeCompare(String(b.fcarga)));
  const i=act.findIndex(x=>tramN(x.ref)===tramN(ref)); if(i<0) return;
  const [it]=act.splice(i,1); const p=Math.max(1,Math.min(act.length+1, parseInt(pos,10)||1));
  act.splice(p-1,0,it);
  act.forEach((x,k)=>x.reg.orden=k+1);
  tramGuardarLocal(); tramRender();
}

// ════════ VALOR EN ADUANAS · HONDURAS (aprobación de valores) ════════
// Réplica de "VALOR EN ADUANAS UNILEVER": FOB = facturas − otros gastos en factura; Flete = HBL + carta porte;
// Seguro = (FOB + OG) × %; Cánon = CIF sin cánon × %; OG final = OG + cánon; CIF; CIF L = CIF × TC; DAI, ISV, STD.
const VHN_DEF={seg:0.0265154, canon:22.05, tc:27, dai:15, isv:15, std:135};
const VHN_BCH='https://www.bch.hn/politica-institucional/politica-cambiaria/cotizaciones-internacionales/principales-monedas';
const VHN_EST={BORRADOR:{l:'Borrador',c:'b'}, ENVIADO:{l:'Enviado a Honduras',c:'e'}, APROBADO:{l:'Aprobado',c:'a'}, RECHAZADO:{l:'Rechazado',c:'r'}};
if(typeof HUB_MODULOS!=='undefined'){
  HUB_MODULOS.push({k:'honduras', l:'Aprobar valores Honduras', c:'Valores HN'});
  HUB_ROLES.admin.p.honduras='editar'; ['trafico','bodega','consulta','tramites'].forEach(k=>{ if(HUB_ROLES[k]) HUB_ROLES[k].p.honduras='ver'; });
  HUB_ROLES.honduras={l:'Honduras (aprueba valores)', p:Object.fromEntries(HUB_MODULOS.map(m=>[m.k,'ver']))};
  HUB_ROLES.honduras.p.honduras='editar';
  const d=HUB_COLS.find(x=>x.c==='hub_tramites'); if(d) d.m=['despacho','tramites','honduras'];
}
let vhnRef=null, vhnBorr=null;
function vhnEsHN(x){ return /HONDURAS/i.test(x.dest||'') || /-HN$/i.test(String(x.ref||'').trim()); }
function vhnPuedeEditar(){ return !window.HUB_ONLINE || hubPuede(['despacho','tramites']); }
function vhnPuedeAprobar(){ return !window.HUB_ONLINE || hubPuede(['despacho','tramites','honduras']); }  // Honduras confirma por correo; lo registra tráfico/trámites
function vhnN(v){ const n=parseFloat(String(v==null?'':v).replace(/[$,\s]/g,'')); return isFinite(n)?n:0; }
function vhnF(n,d){ return (Number(n)||0).toLocaleString('en-US',{minimumFractionDigits:d==null?2:d,maximumFractionDigits:d==null?2:d}); }
function vhnCalc(v){
  const p={...VHN_DEF,...(v.p||{})}, tcE=v.moneda==='EUR'?vhnN(v.tcEur):1;
  const fac=vhnN(v.facturas)*tcE, og=vhnN(v.og)*tcE;
  const fob=fac-og, flete=(v.fletes||[]).reduce((a,x)=>a+vhnN(x.m),0);
  const seguro=(fob+og)*p.seg/100, cifSin=fob+flete+seguro+og, canon=cifSin*p.canon/100, og2=og+canon;
  const cif=fob+flete+seguro+og2, cifL=cif*p.tc, dai=cifL*p.dai/100, isv=(cifL+dai)*p.isv/100, std=vhnN(p.std);
  return {p,fac,og,fob,flete,seguro,cifSin,canon,og2,cif,cifL,dai,isv,std,total:dai+isv+std};
}
function vhnOrigenes(rows){
  const peds=new Set(rows.map(r=>String(r.no_pedido||'').trim()).filter(Boolean)), o=new Set();
  [...(contenedores||[]),...(historialCont||[])].forEach(c=>contPedidos(c).forEach(p=>{ if(peds.has(String(p.pedido).trim())&&c.origen) o.add(String(c.origen).toUpperCase()); }));
  return [...o];
}
function vhnChip(x){
  if(!vhnEsHN(x)) return '';
  const v=x.reg&&x.reg.vhn, e=v?VHN_EST[v.estado]||VHN_EST.BORRADOR:null;
  const t=v&&v.estado==='APROBADO'?`✓ Valores HN aprobados`:v&&v.estado==='ENVIADO'?`⏳ Valores HN por aprobar`:v&&v.estado==='RECHAZADO'?`✕ Valores HN rechazados`:'💲 Valor en aduanas HN';
  return `<button class="vhn-chip ${e?e.c:'n'}" onclick="vhnAbrir('${tramEsc(x.ref)}')">${t}</button>`;
}
function vhnAbrir(ref){
  const x=tramRefs().find(r=>tramN(r.ref)===tramN(ref)); if(!x) return;
  vhnRef=x.ref; const reg=tramReg(ref,false);
  const valorPed=x.rows.reduce((a,r)=>a+vhnN(r.valor),0), ori=vhnOrigenes(x.rows);
  vhnBorr=reg&&reg.vhn?JSON.parse(JSON.stringify(reg.vhn)):{estado:'BORRADOR', moneda:ori.some(o=>/ALEMANIA|GERMANY/.test(o))?'EUR':'USD', facturas:valorPed||'', og:'', tcEur:'', tcEurFecha:'',
    fletes:[{d:'Flete HBL',m:''},{d:'Carta porte (Girón)',m:''}], p:{...VHN_DEF}, origen:ori.join(', ')};
  vhnBorr._valorPed=valorPed; vhnBorr._peds=x.rows.length; vhnBorr._dest=x.dest;
  vhnPintar(); document.getElementById('modal-vhn').classList.add('open');
}
function vhnSet(k,v){ vhnBorr[k]=v; vhnPintar(k); }
function vhnSetP(k,v){ vhnBorr.p=vhnBorr.p||{...VHN_DEF}; vhnBorr.p[k]=vhnN(v); vhnPintar(); }
function vhnFlete(i,k,v){ vhnBorr.fletes[i][k]=v; vhnPintar(); }
function vhnFleteAdd(){ vhnBorr.fletes.push({d:'',m:''}); vhnPintar(); }
function vhnFleteDel(i){ vhnBorr.fletes.splice(i,1); vhnPintar(); }
function vhnPintar(){
  const v=vhnBorr, C=vhnCalc(v), ed=vhnPuedeEditar()&&v.estado!=='APROBADO'&&v.estado!=='ENVIADO', ap=vhnPuedeAprobar(), E=VHN_EST[v.estado]||VHN_EST.BORRADOR;
  const dis=ed?'':'disabled', eur=v.moneda==='EUR';
  const fila=(l,val,cls,nota)=>`<tr class="${cls||''}"><td>${l}${nota?`<small>${nota}</small>`:''}</td><td class="num">${val}</td></tr>`;
  document.getElementById('vhn-tit').innerHTML=`Valor en aduanas · Honduras <span class="vhn-ref">${tramEsc(vhnRef)}</span> <span class="vhn-est ${E.c}">${E.l}</span>`;
  document.getElementById('vhn-body').innerHTML=`
  <p class="vhn-sub">${v._peds} pedido${v._peds===1?'':'s'} · valor de factura en el HUB ${vhnF(v._valorPed)}${v.origen?` · origen ${tramEsc(v.origen)}`:''}</p>
  <div class="vhn-grid">
    <div class="vhn-in">
      <div class="vhn-row2">
        <div class="form-group"><label>Moneda de la factura</label><select ${dis} onchange="vhnSet('moneda',this.value)"><option value="USD" ${!eur?'selected':''}>USD</option><option value="EUR" ${eur?'selected':''}>EUR (Alemania)</option></select></div>
        ${eur?`<div class="form-group"><label>Tipo de cambio EUR → USD <a href="${VHN_BCH}" target="_blank" rel="noopener">ver BCH ↗</a></label><input ${dis} inputmode="decimal" value="${tramEsc(v.tcEur)}" placeholder="ej. 1.12097" onchange="vhnSet('tcEur',this.value)"></div>`:'<div></div>'}
      </div>
      <div class="vhn-row2">
        <div class="form-group"><label>Total facturas comerciales${eur?' (EUR)':''}</label><input ${dis} inputmode="decimal" value="${tramEsc(v.facturas)}" onchange="vhnSet('facturas',this.value)"></div>
        <div class="form-group"><label>Otros gastos en factura${eur?' (EUR)':''}</label><input ${dis} inputmode="decimal" value="${tramEsc(v.og)}" onchange="vhnSet('og',this.value)"></div>
      </div>
      <div class="vhn-fl"><label>Fletes (USD) <small>sumatoria de HBL + carta porte de Girón · si es remanejo, no tomar factura para flete</small></label>
        ${v.fletes.map((x,i)=>`<div class="vhn-fl-r"><input ${dis} value="${tramEsc(x.d)}" placeholder="Concepto" onchange="vhnFlete(${i},'d',this.value)"><input ${dis} inputmode="decimal" class="num" value="${tramEsc(x.m)}" placeholder="0.00" onchange="vhnFlete(${i},'m',this.value)">${ed?`<button onclick="vhnFleteDel(${i})" aria-label="Quitar">×</button>`:''}</div>`).join('')}
        ${ed?'<button class="vhn-add" onclick="vhnFleteAdd()">+ agregar flete</button>':''}
      </div>
      <details class="vhn-par"><summary>Parámetros (seguro, cánon, tipo de cambio, impuestos)</summary>
        <div class="vhn-row3">
          <div class="form-group"><label>% seguro</label><input ${dis} value="${C.p.seg}" onchange="vhnSetP('seg',this.value)"></div>
          <div class="form-group"><label>% cánon</label><input ${dis} value="${C.p.canon}" onchange="vhnSetP('canon',this.value)"></div>
          <div class="form-group"><label>Tipo de cambio L</label><input ${dis} value="${C.p.tc}" onchange="vhnSetP('tc',this.value)"></div>
          <div class="form-group"><label>% DAI</label><input ${dis} value="${C.p.dai}" onchange="vhnSetP('dai',this.value)"></div>
          <div class="form-group"><label>% ISV</label><input ${dis} value="${C.p.isv}" onchange="vhnSetP('isv',this.value)"></div>
          <div class="form-group"><label>STD (L)</label><input ${dis} value="${C.p.std}" onchange="vhnSetP('std',this.value)"></div>
        </div></details>
    </div>
    <div class="vhn-res">
      <table>
        ${fila('FOB',vhnF(C.fob),'',`facturas ${vhnF(C.fac)} − OG ${vhnF(C.og)}${eur?' (convertido a USD)':''}`)}
        ${fila('Flete',vhnF(C.flete))}
        ${fila('Seguro',vhnF(C.seguro),'',`(FOB + OG) × ${C.p.seg}%`)}
        ${fila('Otros gastos',vhnF(C.og))}
        ${fila('CIF sin cánon',vhnF(C.cifSin),'sub')}
        ${fila('Cánon',vhnF(C.canon),'',`CIF sin cánon × ${C.p.canon}%`)}
        ${fila('Otros gastos + cánon',vhnF(C.og2))}
        ${fila('CIF (USD)',vhnF(C.cif),'big')}
        ${fila('CIF (L)',vhnF(C.cifL),'sub',`× ${C.p.tc}`)}
        ${fila('DAI',vhnF(C.dai),'',`${C.p.dai}%`)}
        ${fila('ISV',vhnF(C.isv),'',`(CIF L + DAI) × ${C.p.isv}%`)}
        ${fila('STD',vhnF(C.std))}
        ${fila('Total impuestos (L)',vhnF(C.total),'big')}
      </table>
    </div>
  </div>
  ${v.enviado?`<p class="vhn-log">Enviado por ${tramEsc(v.enviado.por)} · ${tramHora(v.enviado.en)}</p>`:''}
  ${v.resuelto?`<p class="vhn-log ${v.estado==='RECHAZADO'?'r':''}">${v.estado==='APROBADO'?'✓ Honduras aprobó':'✕ Honduras rechazó'} · registrado por ${tramEsc(v.resuelto.por)} · ${tramHora(v.resuelto.en)}${v.resuelto.coment?` — “${tramEsc(v.resuelto.coment)}”`:''}</p>`:''}`;
  const btn=[];
  if(vhnPuedeEditar()&&(v.estado==='BORRADOR'||v.estado==='RECHAZADO')){ btn.push(`<button class="btn" onclick="vhnGuardar('BORRADOR')">Guardar</button>`); btn.push(`<button class="btn btn-accent" onclick="vhnGuardar('ENVIADO')">Enviar a Honduras</button>`); }
  if(vhnPuedeEditar()&&(v.estado==='ENVIADO'||v.estado==='APROBADO')) btn.push(`<button class="btn" onclick="vhnReabrir()">Corregir valores</button>`);
  if(ap&&v.estado==='ENVIADO'){ btn.push(`<button class="btn vhn-rech" onclick="vhnResolver('RECHAZADO')">✕ Honduras rechazó</button>`); btn.push(`<button class="btn btn-accent" onclick="vhnResolver('APROBADO')">✓ Honduras aprobó</button>`); }
  document.getElementById('vhn-btns').innerHTML=`<button class="btn" onclick="closeModals()">Cerrar</button>`+btn.join('');
}
function vhnPersistir(){
  const reg=tramReg(vhnRef,true), c=vhnCalc(vhnBorr);
  const o=JSON.parse(JSON.stringify(vhnBorr)); delete o._valorPed; delete o._peds; delete o._dest;
  o.calc={fob:c.fob,flete:c.flete,seguro:c.seguro,og:c.og2,cif:c.cif,cifL:c.cifL,dai:c.dai,isv:c.isv,std:c.std,total:c.total};
  reg.vhn=o; tramAvance(reg); tramGuardarLocal(); tramRender(); if(typeof hubProgramarSync==='function') hubProgramarSync(300);
}
function vhnGuardar(est){
  const v=vhnBorr;
  if(est==='ENVIADO'){
    const f=[]; if(!(vhnN(v.facturas)>0)) f.push('Total facturas'); if(!(v.fletes||[]).some(x=>vhnN(x.m)>0)) f.push('Al menos un flete'); if(v.moneda==='EUR'&&!(vhnN(v.tcEur)>0)) f.push('Tipo de cambio EUR → USD (BCH)');
    if(f.length){ alert('Falta para enviar:\n\n• '+f.join('\n• ')); return; }
    v.enviado={por:tramQuien(), en:Date.now()}; v.resuelto=null;
  }
  v.estado=est; vhnPersistir(); vhnPintar();
  if(est==='ENVIADO') hubToast('Valores enviados a Honduras para aprobación.');
}
function vhnReabrir(){
  if(vhnBorr.estado==='APROBADO'&&!confirm('Los valores ya están aprobados. Si los corriges, Honduras tendrá que aprobarlos de nuevo. ¿Continuar?')) return;
  vhnBorr.estado='BORRADOR'; vhnBorr.resuelto=null; vhnPersistir(); vhnPintar();
}
function vhnResolver(est){
  if(!vhnPuedeAprobar()) return;
  let coment='';
  if(est==='RECHAZADO'){ coment=prompt('¿Qué observó Honduras?',''); if(coment==null) return; }
  else { coment=prompt('¿Quién aprobó en Honduras? (opcional, ej. nombre o correo)',''); if(coment==null) return; }
  vhnBorr.estado=est; vhnBorr.resuelto={por:tramQuien(), en:Date.now(), coment:String(coment||'').trim()};
  vhnPersistir(); vhnPintar(); hubToast(est==='APROBADO'?'Valores aprobados.':'Valores rechazados.');
}

// asegurar _id sin conexión
function tramIds(){ tramLista.forEach(r=>{ if(!r._id) r._id='tr'+Date.now().toString(36)+Math.random().toString(36).slice(2,6); }); }
const _tramRenderBase=tramRender; tramRender=function(){ if(!window.HUB_ONLINE) tramIds(); return _tramRenderBase(); };

// Alertas: referencia lista para trámite (pendiente)
if(typeof alrCalcular==='function'){
  ALR_GRUPOS.tram='Trámites';
  const _alrCalc=alrCalcular;
  alrCalcular=function(){
    const L=_alrCalc();
    try{ tramRefs().filter(x=>x.enCarga && tramDocsOk(x.reg) && x.reg.estado==='PENDIENTE').forEach(x=>{
      const key=alrKey('tram',x.ref,x.reg.docsEn||0); if(alrCerradas[key]) return;
      L.push({key, g:'tram', nivel:'info', ico:'📄', tit:`${x.ref} lista para trámite${x.reg.orden?' · prioridad '+x.reg.orden:''}`, det:`${x.rows.length} pedido${x.rows.length===1?'':'s'} · ${x.dest||''} · documentos completos`, desde:x.reg.docsEn||0, ir:()=>goToTab('tramites')});
    }); }catch(e){}
    return L;
  };
}
// refrescar la pantalla cuando cambie Despacho
(function(){ const f=window.renderDespachos; if(typeof f!=='function') return; window.renderDespachos=function(){ const r=f.apply(this,arguments); try{ tramRender(); }catch(e){} return r; }; })();


// ---------- reparación única: pedidos retornados a NP con la versión anterior ----------
function npRetornadosViejos(){
  return (noProg||[]).filter(x=>/Retornado desde Despachos/i.test(String(x.notas||'')) && !x._reparado);
}
function npRepararRetornados(){
  const m=document.getElementById('hub-menu'); if(m) m.hidden=true;
  if(window.HUB_ONLINE && !hubEsAdmin()) return;
  const L=npRetornadosViejos();
  if(!L.length){ alert('No hay pedidos retornados pendientes de reparar.'); return; }
  const cambios=[]; let nCampos=0, sinIngreso=0;
  L.forEach(x=>{
    const ant={...x}, c0=[];
    // la versión anterior copiaba el DT en Doc y RC
    const dtViejo = (!x.dt && x.doc && x.doc===x.rc) ? x.doc : '';
    if(dtViejo){ x.dt=dtViejo; c0.push('DT'); }
    const I=npDatosIngreso(x.pedido);
    if(I){
      const c=I.c, p=I.p;
      if(dtViejo || !x.doc){ x.doc=c.doc||''; c0.push('Doc. transporte'); }
      if(dtViejo || !x.rc){ x.rc=c.rc||''; c0.push('RC'); }
      const fill=(k,v,l)=>{ if((x[k]==null||x[k]==='') && v!=null && v!==''){ x[k]=v; c0.push(l); } };
      fill('cont',c.cont,'Contenedor'); fill('rg',c.rg,'RG'); fill('origen',c.origen,'Origen'); fill('bl_cp',c.doc,'BL');
      fill('ot',p.ot,'OT'); fill('valor',p.valor,'Valor'); fill('fact_ul',p.factura,'Factura UL');
      if(!x.dt && p.dt){ x.dt=p.dt; c0.push('DT'); }
    } else {
      sinIngreso++;
      if(dtViejo){ x.doc=''; x.rc=''; }
    }
    // registros despachados con el mismo pedido: proveedor / F. solicitud si quedaron en historial
    const h=(historial||[]).concat(despachos||[]).find(r=>hubNormPed(r.no_pedido)===hubNormPed(x.pedido) && (r.proveedor||r.fsolicitud));
    if(h){ if(!x.proveedor&&h.proveedor){ x.proveedor=h.proveedor; c0.push('Proveedor'); } if(!x.fsolicitud&&h.fsolicitud){ x.fsolicitud=h.fsolicitud; c0.push('F. solicitud'); } }
    x._reparado=true;
    nCampos+=c0.length;
    cambios.push(`• ${x.pedido||'—'}: ${c0.length?[...new Set(c0)].join(', '):'sin datos para recuperar'}`);
  });
  renderNp();
  hubInteraccion=true; if(typeof hubProgramarSync==='function') hubProgramarSync(200);
  alert(`✅ Reparados ${L.length} pedido${L.length===1?'':'s'} retornados a NP\n\n${cambios.slice(0,20).join('\n')}${cambios.length>20?`\n… y ${cambios.length-20} más`:''}\n\n${sinIngreso?`${sinIngreso} sin contenedor en Ingreso (solo se corrigió el DT).\n`:''}Proveedor, F. solicitud, prioridad y fecha original no se guardaban: revísalos en "editar" si hacen falta.`);
}


// ---------- datos de transporte por referencia ----------
let transpRef=null;
function transpRows(ref){ return (despachos||[]).filter(r=>(r.ref||'SIN REF')===ref); }
function transpBoton(ref, rows){
  const r0=rows.find(r=>r.camion||r.remolque||r.piloto)||{};
  const distintos=new Set(rows.map(r=>[r.camion||'',r.remolque||'',r.piloto||''].join('|'))).size>1;
  const txt=r0.camion||r0.remolque||r0.piloto ? `🚚 ${[r0.camion,r0.remolque].filter(Boolean).join(' · ')||''}${r0.piloto?' · '+r0.piloto:''}${distintos?' (varios)':''}` : '🚚 Transporte';
  const ok=!!(r0.camion&&r0.remolque&&r0.piloto&&r0.licencia);
  const ed=typeof despPuedeDespachar==='function'?despPuedeDespachar():true;
  return `<button class="edit-btn tp-btn ${ok?'ok':''}" ${ed?`onclick="transpAbrir('${ref}')"`:'disabled'} title="Placa camión, placa remolque, piloto y licencia">${txt}</button>`;
}
function transpAbrir(ref){
  if(typeof despPuedeDespachar==='function' && !despPuedeDespachar()) return;
  transpRef=ref; const rows=transpRows(ref); const r0=rows.find(r=>r.camion||r.remolque||r.piloto)||{};
  document.getElementById('tp-ref').textContent=ref;
  document.getElementById('tp-n').textContent=`${rows.length} pedido${rows.length===1?'':'s'}`;
  document.getElementById('tp-camion').value=r0.camion||''; document.getElementById('tp-remolque').value=r0.remolque||'';
  document.getElementById('tp-piloto').value=r0.piloto||''; document.getElementById('tp-licencia').value=r0.licencia||'';
  document.getElementById('modal-transp').classList.add('open');
  setTimeout(()=>document.getElementById('tp-camion').focus(),60);
}
function transpGuardar(){
  const v={camion:document.getElementById('tp-camion').value.trim().toUpperCase(), remolque:document.getElementById('tp-remolque').value.trim().toUpperCase(),
           piloto:document.getElementById('tp-piloto').value.trim(), licencia:document.getElementById('tp-licencia').value.trim().toUpperCase()};
  const falta=[!v.camion&&'placa camión',!v.remolque&&'placa remolque',!v.piloto&&'piloto',!v.licencia&&'licencia'].filter(Boolean);
  if(falta.length && !confirm(`Falta: ${falta.join(', ')}.\n\n¿Guardar así de todos modos?`)) return;
  transpRows(transpRef).forEach(r=>Object.assign(r,v));
  closeModals(); renderDespachos();
  if(typeof gsSaveAll==='function') setTimeout(gsSaveAll,300);
}

const OC_LOGO='data:image/png;base64,';
// ════════════════════════════════════════════════════════════════
//  ORDEN DE CARGA (por referencia) — se habilita cuando están todos
//  los datos; mientras tanto indica qué falta.
// ════════════════════════════════════════════════════════════════
const OC_EMPRESAS = [
  {c:'90007', n:'UNILEVER SA (DT)'},
  {c:'21050', n:'UNILEVER EL SALVADOR SCC, S.A. DE C.V.'},
  {c:'21051', n:'UNILEVER EL SALVADOR SCC, SA DE CV (NACIONAL)'},
  {c:'17630', n:'UNILEVER DE CENTRO AMERICA S.A. DE C.V.'},
  {c:'17631', n:'UNILEVER DE CENTRO AMERICA S.A. (NACIONAL)'},
  {c:'17634', n:'UNILEVER DE CENTROAMERICA S.A. (PANAMA)'}
];
let ocRef=null, ocUsuariosTram=null;
const ocEsc = s => String(s==null?'':s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
function ocRows(ref){ return (despachos||[]).filter(r=>(r.ref||'SIN REF')===ref); }
function ocPrimero(rows,k){ const r=rows.find(x=>x[k]!=null&&String(x[k]).trim()!==''); return r?r[k]:''; }
function ocNum(v){ const n=parseFloat(String(v==null?'':v).replace(/,/g,'')); return isFinite(n)?n:0; }
function ocEdif(v){ const s=String(v||''); return s.includes('6')&&!s.includes('16')?'6':(s.includes('12')?'12':''); }

// Datos de la OC de una referencia + lo que falta
function ocDatos(ref){
  const rows=ocRows(ref);
  const pallets=rows.reduce((a,r)=>a+ocNum(r.pallets),0);
  const cajas=rows.reduce((a,r)=>a+ocNum(r.cajas),0);
  const d={
    ref, rows, pallets, cajas,
    fecha: ocPrimero(rows,'fcarga'),
    edif: ocEdif(ocPrimero(rows,'oc_edif')||ocPrimero(rows,'edif')),
    tramitador: ocPrimero(rows,'oc_tramitador'),
    medio: ocPrimero(rows,'oc_medio'),
    marchamo: ocPrimero(rows,'oc_marchamo'),
    empresa: ocPrimero(rows,'oc_empresa')||'90007',
    piloto: ocPrimero(rows,'piloto'), licencia: ocPrimero(rows,'licencia'),
    camion: ocPrimero(rows,'camion'), remolque: ocPrimero(rows,'remolque'),
    dts: rows.map(r=>String(r.dt||'').trim()).filter(Boolean)
  };
  const f=[];
  if(!d.fecha) f.push('Fecha de despacho');
  if(!d.edif) f.push('Edificio de carga');
  if(!(d.pallets>0)) f.push('Pallets');
  const sinDT=rows.filter(r=>!String(r.dt||'').trim()).length; if(sinDT) f.push(`DT en ${sinDT} pedido${sinDT===1?'':'s'}`);
  if(!d.tramitador) f.push('Tramitador');
  if(!d.medio) f.push('Transporte por');
  if(!d.marchamo) f.push('Colocar marchamo');
  if(!d.piloto) f.push('Piloto'); if(!d.licencia) f.push('Licencia');
  if(!d.camion) f.push('Placa cabezal'); if(!d.remolque) f.push('Placa remolque');
  d.faltan=f; d.completa=!f.length;
  return d;
}
function ocBoton(ref){
  const d=ocDatos(ref);
  return d.completa
    ? `<button class="edit-btn oc-btn ok" onclick="ocAbrir('${ref}')" title="Orden de carga lista para imprimir">🧾 Orden de carga</button>`
    : `<button class="edit-btn oc-btn falta" onclick="ocAbrir('${ref}')" title="Falta: ${ocEsc(d.faltan.join(', '))}">🧾 OC · falta ${d.faltan.length}</button>`;
}

// Catálogos: pilotos usados antes (para autocompletar licencia y placas) y tramitadores
function ocPilotos(){
  const m=new Map();
  [...(historial||[]), ...(despachos||[])].forEach(r=>{ if(r.piloto) m.set(String(r.piloto).trim().toUpperCase(), {piloto:r.piloto, licencia:r.licencia||'', camion:r.camion||'', remolque:r.remolque||''}); });
  return m;
}
async function ocTramitadores(){
  const s=new Set();
  [...(historial||[]), ...(despachos||[])].forEach(r=>{ if(r.oc_tramitador) s.add(String(r.oc_tramitador).trim().toUpperCase()); });
  if(window.HUB_ONLINE && hubDb){
    if(!ocUsuariosTram){ try{ const q=await hubDb.collection('hub_usuarios').get(); ocUsuariosTram=q.docs.map(x=>x.data()).filter(u=>u.activo&&u.rol==='tramites').map(u=>String(u.nombre||u.usuario).toUpperCase()); }catch(e){ ocUsuariosTram=[]; } }
    ocUsuariosTram.forEach(n=>s.add(n));
  }
  return [...s].sort();
}

// ---------- ventana ----------
async function ocAbrir(ref){
  ocRef=ref; const d=ocDatos(ref); const ed=typeof despPuedeDespachar==='function'?despPuedeDespachar():true;
  const pil=ocPilotos();
  document.getElementById('oc-ref').textContent=ref;
  document.getElementById('oc-fecha').value=String(d.fecha||'').slice(0,10);
  document.getElementById('oc-edif').value=d.edif;
  document.getElementById('oc-tram').value=d.tramitador;
  document.getElementById('oc-medio').value=d.medio;
  document.getElementById('oc-marchamo').value=d.marchamo;
  document.getElementById('oc-empresa').innerHTML=OC_EMPRESAS.map(e=>`<option value="${e.c}" ${e.c===d.empresa?'selected':''}>${e.c} · ${ocEsc(e.n)}</option>`).join('');
  document.getElementById('oc-piloto').value=d.piloto; document.getElementById('oc-licencia').value=d.licencia;
  document.getElementById('oc-camion').value=d.camion; document.getElementById('oc-remolque').value=d.remolque;
  document.getElementById('oc-dl-pilotos').innerHTML=[...pil.values()].map(p=>`<option value="${ocEsc(p.piloto)}">${ocEsc(p.licencia)} · ${ocEsc(p.camion)}</option>`).join('');
  document.getElementById('oc-dl-tram').innerHTML=(await ocTramitadores()).map(n=>`<option value="${ocEsc(n)}">`).join('');
  document.querySelectorAll('#modal-oc input, #modal-oc select').forEach(el=>el.disabled=!ed);
  ocPintarEstado();
  document.getElementById('modal-oc').classList.add('open');
}
function ocLeer(){
  const v=id=>document.getElementById(id).value.trim();
  return {fcarga:v('oc-fecha'), oc_edif:v('oc-edif'), oc_tramitador:v('oc-tram').toUpperCase(), oc_medio:v('oc-medio'), oc_marchamo:v('oc-marchamo'),
          oc_empresa:v('oc-empresa'), piloto:v('oc-piloto'), licencia:v('oc-licencia').toUpperCase(), camion:v('oc-camion').toUpperCase(), remolque:v('oc-remolque').toUpperCase()};
}
function ocPilotoCambio(){
  const p=ocPilotos().get(document.getElementById('oc-piloto').value.trim().toUpperCase()); if(!p) return;
  [['oc-licencia','licencia'],['oc-camion','camion'],['oc-remolque','remolque']].forEach(([id,k])=>{ const el=document.getElementById(id); if(!el.value && p[k]) el.value=p[k]; });
  ocPintarEstado();
}
// Vista previa del estado sin guardar
function ocPintarEstado(){
  const v=ocLeer(), rows=ocRows(ocRef);
  const tmp=rows.map(r=>({...r, ...Object.fromEntries(Object.entries(v).filter(([k,x])=>x!==''))}));
  const real=despachos; despachos=real.filter(r=>(r.ref||'SIN REF')!==ocRef).concat(tmp);
  let d; try{ d=ocDatos(ocRef); } finally { despachos=real; }
  const box=document.getElementById('oc-estado');
  const tot=`${d.pallets} PALLETS${d.cajas?` ${d.cajas} CAJAS`:''}`;
  box.className='oc-estado '+(d.completa?'ok':'falta');
  box.innerHTML = d.completa
    ? `✓ Todo completo · ${ocEsc(tot)} · ${d.dts.length} DT. Ya puedes imprimir la orden de carga.`
    : `<b>Falta para habilitar la orden:</b> ${d.faltan.map(x=>`<i>${ocEsc(x)}</i>`).join(' ')}${d.cajas?'':' <span class="oc-nota">(sin cajas registradas: saldrá solo el total de pallets)</span>'}`;
  document.getElementById('oc-imprimir').disabled=!d.completa;
  return d;
}
function ocGuardar(imprimir){
  if(typeof despPuedeDespachar==='function' && !despPuedeDespachar()){ if(imprimir) return ocImprimir(); return; }
  const v=ocLeer();
  ocRows(ocRef).forEach(r=>{ Object.entries(v).forEach(([k,x])=>{ if(x!=='' || k.startsWith('oc_')) r[k]=x; }); });
  if(typeof gsSaveAll==='function') setTimeout(gsSaveAll,300);
  const d=ocDatos(ocRef);
  if(imprimir){
    if(!d.completa){ alert('Falta: '+d.faltan.join(', ')); return; }
    ocRows(ocRef).forEach(r=>{ r.oc_emitida={por:(typeof hubPerfil!=='undefined'&&hubPerfil)?(hubPerfil.nombre||hubPerfil.usuario):'', en:Date.now()}; });
    ocImprimir();
  }
  closeModals(); renderDespachos();
}

// ---------- documento ----------
function ocDocumentoHTML(ref){
  const d=ocDatos(ref), E=ocEsc;
  const emp=OC_EMPRESAS.find(e=>e.c===d.empresa)||{n:d.empresa};
  const quien=(typeof hubPerfil!=='undefined'&&hubPerfil)?(hubPerfil.nombre||hubPerfil.usuario):'';
  const [y,m,dd]=String(d.fecha).slice(0,10).split('-').map(Number);
  let fecha=E(d.fecha);
  if(y){ const f=new Date(y,m-1,dd);
    fecha=f.toLocaleDateString('es-SV',{weekday:'long'})+', '+f.toLocaleDateString('es-SV',{month:'long'})+' '+String(dd).padStart(2,'0')+', '+y;
    fecha=fecha.charAt(0).toUpperCase()+fecha.slice(1); }
  const tot=`${d.pallets} PALLETS${d.cajas?` ${d.cajas} CAJAS`:''}`;
  const ped1=d.dts.slice(0,2).join(' '), ped2=d.dts.slice(2).join(' ');
  const L=(l,v,span)=>`<td class="l">${l}</td><td class="v"${span?` colspan="${span}"`:''}>${v}</td>`;
  return `<!doctype html><html lang="es"><head><meta charset="utf-8"><title>OC__${E(ref)}</title>
<meta name="viewport" content="width=device-width,initial-scale=1">
<style>
*{box-sizing:border-box;-webkit-print-color-adjust:exact;print-color-adjust:exact;}
body{margin:0;background:#E9EDF3;font-family:Arial,Helvetica,sans-serif;color:#000;font-size:12pt;}
.bar{position:sticky;top:0;display:flex;gap:8px;justify-content:center;padding:10px;background:#0E2D57;z-index:5;}
.bar button{border:none;border-radius:999px;padding:8px 18px;font:700 12px Arial,sans-serif;cursor:pointer;background:#fff;color:#0E2D57;}
.bar button.p{background:#4A8FD6;color:#fff;}
.page{width:216mm;min-height:279mm;margin:14px auto;background:#fff;padding:10mm 8mm;box-shadow:0 10px 30px -12px rgba(14,45,87,.35);}
.logo{text-align:center;padding:2mm 0 4mm;}
.logo img{height:82px;}
.band{background:#E4DFEC;font-family:Cambria,'Times New Roman',serif;font-weight:700;font-size:16pt;text-align:center;padding:9px 0;}
.band.b1{border-bottom:1.5px solid #0070C0;margin-bottom:10px;}
.band.b2{border-top:1.5px solid #000;border-bottom:1.5px solid #000;margin:6px 0 24px;}
table{width:100%;border-collapse:collapse;table-layout:fixed;}
td{height:37px;vertical-align:middle;font-size:11pt;}
td.l{text-align:right;padding-right:3px;white-space:nowrap;}
td.v{color:#0070C0;padding-left:2px;}
td.c{text-align:center;}
.firma{width:76%;border:1.3px solid #000;margin-top:24px;}
.firma td{height:30px;color:#002060;font-weight:700;padding-left:4px;font-size:10.5pt;}
.firma td.v{color:#0070C0;font-weight:400;font-size:11pt;}
@page{size:letter;margin:10mm;}
@media print{body{background:#fff;}.bar{display:none;}.page{margin:0;box-shadow:none;width:auto;min-height:auto;padding:0;}}
</style></head><body>
<div class="bar"><button class="p" onclick="window.print()">Imprimir / Guardar PDF</button><button onclick="window.close()">Cerrar</button></div>
<div class="page">
  <div class="logo"><img src="${OC_LOGO}" alt="Blue Logistics"></div>
  <div class="band b1">Orden de Carga de Mercaderia</div>
  <table>
    <colgroup><col style="width:18%"><col style="width:38%"><col style="width:23%"><col style="width:21%"></colgroup>
    <tr>${L('Fecha de despacho:',fecha)}<td class="l">Edificio de CARGA:</td><td class="v c">${E(d.edif)}</td></tr>
    <tr>${L('Total de',E(tot))}<td class="l">Tramitador:</td><td class="v c">${E(d.tramitador)}</td></tr>
    <tr>${L('Empresa',E(emp.n))}<td></td><td></td></tr>
    <tr>${L('Cliente:',E(ref))}<td class="l">Transporte por:</td><td class="v">${E(d.medio)}</td></tr>
    <tr>${L('Pedido:',E(ped1))}<td class="l">Colocar Marchamo:</td><td class="v">${E(d.marchamo)}</td></tr>
    <tr><td></td><td class="v" colspan="3">${E(ped2)}</td></tr>
  </table>
  <div class="band b2">Datos de Transporte</div>
  <table>
    <colgroup><col style="width:18%"><col></colgroup>
    <tr>${L('Piloto:',E(d.piloto))}</tr>
    <tr>${L('Licencia:',E(d.licencia))}</tr>
    <tr>${L('Placa Cabezal:',E(d.camion))}</tr>
    <tr>${L('Placa Remolque:',E(d.remolque))}</tr>
  </table>
  <table class="firma">
    <colgroup><col style="width:40%"><col></colgroup>
    <tr><td colspan="2">Recibida por:</td></tr>
    <tr><td>Notificación emitida por:</td><td class="v">${E(quien)}</td></tr>
  </table>
</div></body></html>`;
}
function ocImprimir(){
  const d=ocDatos(ocRef); if(!d.completa){ alert('Falta: '+d.faltan.join(', ')); return; }
  const w=window.open('','_blank');
  if(!w){ alert('El navegador bloqueó la ventana de impresión. Permite ventanas emergentes para este sitio.'); return; }
  w.document.open(); w.document.write(ocDocumentoHTML(ocRef)); w.document.close();
}


// ════════ RESUMEN OPERATIVO (narrativo) ════════
const RO_MESES=['enero','febrero','marzo','abril','mayo','junio','julio','agosto','septiembre','octubre','noviembre','diciembre'];
const RO_DIAS=['domingo','lunes','martes','miércoles','jueves','viernes','sábado'];
const RO_SALIO=['DESPACHADO'];
let roTexto='';
function roIso(d){ return dgIso(d); }
function roD(iso){ return dgFecha(iso); }
function roN(n,d){ return dgFmt(n,d||0); }
function roPl(n,s,p){ return roN(n)+' '+(Math.round(n)===1?s:(p||s+'s')); }
function roV(n,s,p){ return Math.round(n)===1?s:p; }
function roLista(a){ a=a.filter(Boolean); if(a.length<=1) return a.join(''); return a.slice(0,-1).join(', ')+' y '+a[a.length-1]; }
function roPaisL(n){ const P=DG_BY_N[n]; return P?P.l:(n?n.charAt(0)+n.slice(1).toLowerCase():'sin país'); }
function roFechaL(d,conDia){ return (conDia?RO_DIAS[d.getDay()]+' ':'')+d.getDate()+' de '+RO_MESES[d.getMonth()]; }
function roRangoL(a,b){
  if(+a===+b) return 'el '+roFechaL(a,true)+' de '+a.getFullYear();
  if(a.getFullYear()===b.getFullYear()&&a.getMonth()===b.getMonth()) return 'del '+a.getDate()+' al '+b.getDate()+' de '+RO_MESES[b.getMonth()]+' de '+b.getFullYear();
  if(a.getFullYear()===b.getFullYear()) return 'del '+roFechaL(a)+' al '+roFechaL(b)+' de '+b.getFullYear();
  return 'del '+roFechaL(a)+' de '+a.getFullYear()+' al '+roFechaL(b)+' de '+b.getFullYear();
}
function roEn(d,a,b){ return d&&d>=a&&d<=b; }
function roTop(obj,k){ return Object.entries(obj).sort((x,y)=>(y[1][k]||y[1])-(x[1][k]||x[1])); }

function roCalc(a,b,pais){
  // Pallets de cada pedido según NP / Despacho / Historial (la carga a granel llega en cajas y se paletiza en bodega)
  const palPed={};
  [...(noProg||[]),...(despachos||[]),...(historial||[]),...archHist()].forEach(x=>{ const k=String(x.pedido||x.no_pedido||'').trim(); if(!k) return; const o=palPed[k]=palPed[k]||{pal:0,cj:0}; o.pal=Math.max(o.pal,dgNum(x.pallets)); o.cj=Math.max(o.cj,dgNum(x.cajas)); });
  const R={desc:{conts:0,peds:0,bultos:0,pal:0,granel:0,granelCj:0,kg:0,orig:{},pais:{},dias:{}},
           desp:{peds:0,viajes:0,pal:0,kg:0,pais:{},edif:{},dias:[],fills:[],porDia:{},cargados:0,cargPal:0},
           cort:{carga:[],descarga:[]}};
  // ---- Descargas (contenedores con fecha de descarga en el rango) ----
  const vistos=new Set();
  [...(contenedores||[]),...(historialCont||[]),...archConts()].forEach(r=>{
    const key=(String(r.cont||'')+'|'+String(r.doc||'')).toUpperCase(); if(vistos.has(key)) return; vistos.add(key);
    const f=dgFecha(r.fdesc); if(!roEn(f,a,b)) return;
    let peds=0,bul=0,kg=0,pal=0,gr=0,grCj=0;
    const granelO=npEsGranelOrigen(r.origen);
    contPedidos(r).forEach(p=>{
      if(contVacio(p.pedido)) return; const P=DG_PAISES.find(x=>x.k===p.pais); const n=P?P.n:'';
      if(pais&&n!==pais) return;
      peds++; bul+=dgNum(p.bultos); kg+=dgNum(p.peso);
      const pp=palPed[String(p.pedido).trim()], b=dgNum(p.bultos);
      if(pp&&pp.pal>0) pal+=pp.pal;
      else if(!granelO&&b>0&&b<=60) pal+=b;                 // paletizado: los bultos son pallets
      else if(b>0||(pp&&pp.cj>0)){ gr++; grCj+=(pp&&pp.cj)||b; } // granel aún sin pallets
      R.desc.pais[n]=(R.desc.pais[n]||0)+1;
    });
    if(pais&&!peds) return;
    if(!pais) kg=dgNum(r.peso)||kg;
    R.desc.conts++; R.desc.peds+=peds; R.desc.bultos+=bul; R.desc.kg+=kg; R.desc.pal+=pal; R.desc.granel+=gr; R.desc.granelCj+=grCj;
    const o=dgOrigen(r.origen); R.desc.orig[o]=(R.desc.orig[o]||0)+1;
    const k=roIso(f); R.desc.dias[k]=(R.desc.dias[k]||0)+1;
  });
  // ---- Despachos ----
  const salidas=[];
  [...(historial||[]),...archHist()].forEach(r=>salidas.push({r,sal:true}));
  (despachos||[]).forEach(r=>{ const st=String(r.status||'').toUpperCase(); if(st==='DESPACHADO') salidas.push({r,sal:true}); else if(st==='CARGADO') salidas.push({r,sal:false}); });
  const viajes={};
  salidas.forEach(({r,sal})=>{
    const n=dgPais(r.dest); if(pais&&n!==pais) return;
    const f=dgFecha(sal?(r.fsalida||r.fcarga||r.fechaArchivo):(r.fcarga||r.fsalida)); if(!roEn(f,a,b)) return;
    const pal=dgNum(r.pallets), kg=dgNum(r.peso);
    if(!sal){ R.desp.cargados++; R.desp.cargPal+=pal; return; }
    R.desp.peds++; R.desp.pal+=pal; R.desp.kg+=kg;
    const ref=String(r.ref||'').trim().toUpperCase()||('P'+R.desp.peds);
    const v=viajes[ref]=viajes[ref]||{pal:0,kg:0,paises:new Set(),es3e:/3\s*EJES/i.test(r.equipo||'')};
    v.pal+=pal; v.kg+=kg; v.paises.add(n);
    const P=R.desp.pais[n]=R.desp.pais[n]||{peds:0,pal:0,viajes:new Set()}; P.peds++; P.pal+=pal; P.viajes.add(ref);
    const e=String(r.edif||'').replace(/\D/g,''); if(e) R.desp.edif[e]=(R.desp.edif[e]||0)+1;
    const ing=dgFecha(r.fingreso), d=dgDias(ing,f); if(d!=null) R.desp.dias.push(d);
    const k=roIso(f); R.desp.porDia[k]=(R.desp.porDia[k]||0)+1;
  });
  R.desp.viajes=Object.keys(viajes).length;
  Object.values(viajes).forEach(v=>{ const cap=(v.es3e||v.kg>DG_CAP.kg53)?DG_CAP.kg3e:DG_CAP.kg53; if(v.pal||v.kg) R.desp.fills.push(Math.min(100,Math.max(v.pal/DG_CAP.pal,v.kg/cap)*100)); });
  // ---- Cortinas (sin filtro de país) ----
  [12,6].forEach(ed=>{ ((edifState[ed]||{}).historial||[]).forEach(h=>{ if(!h) return; const f=dgFecha(h.fecha); if(!roEn(f,a,b)) return; const t=h.tipo==='carga'?'carga':'descarga'; R.cort[t].push({ed,min:dgNum(h.duracion)}); }); });
  return R;
}

function roVar(act,ant,unidad){
  if(!ant&&!act) return 'sin movimiento en ambos periodos';
  if(!ant) return `${roPl(act,unidad)} (en el periodo de comparación no hubo)`;
  const p=Math.round((act-ant)/ant*100);
  if(p===0) return `igual (${roPl(act,unidad)})`;
  return `${p>0?'subió':'bajó'} ${Math.abs(p)}% (de ${roN(ant)} a ${roN(act)} ${Math.round(act)===1?unidad:unidad+'s'})`;
}

function roSecciones(a,b,pais){
  const R=roCalc(a,b,pais);
  const dias=Math.round((b-a)/86400000)+1;
  const pa=new Date(a); pa.setDate(pa.getDate()-dias); const pb=new Date(a); pb.setDate(pb.getDate()-1);
  const A=roCalc(pa,pb,pais);
  const S=[]; const B=s=>`<b>${s}</b>`;
  const enPais=pais?` con destino a ${roPaisL(pais)}`:'';
  // Recepción
  let t=[];
  if(!R.desc.conts) t.push(`No se registraron descargas de contenedores${enPais} en el periodo.`);
  else{
    t.push(`${roV(R.desc.conts,'Se descargó','Se descargaron')} ${B(roPl(R.desc.conts,'contenedor','contenedores'))}${enPais}, con ${B(roPl(R.desc.peds,'pedido'))}, ${B(roPl(R.desc.pal,'pallet'))}`+(R.desc.kg?` y ${roN(R.desc.kg/1000,1)} toneladas`:'')+'.');
    if(R.desc.granel) t.push(`De esos, ${roPl(R.desc.granel,'pedido')} ${roV(R.desc.granel,'llegó','llegaron')} a granel y ${roV(R.desc.granel,'aún no tiene','aún no tienen')} pallets armados (${roPl(R.desc.granelCj,'caja')}); se ${roV(R.desc.granel,'sumará','sumarán')} al digitar sus pallets.`);
    const o=roTop(R.desc.orig);
    if(o.length===1) t.push(`Toda la carga vino de ${dgOrigenLabel(o[0][0])}.`);
    else if(o.length>1) t.push(`Por origen, los contenedores vinieron de ${roLista(o.map(([k,v])=>`${dgOrigenLabel(k)} (${v})`))}.`);
    const p=roTop(R.desc.pais).filter(([k])=>k);
    if(!pais&&p.length) t.push(`Los pedidos descargados van para ${roLista(p.map(([k,v])=>`${roPaisL(k)} (${v})`))}.`);
    const dd=roTop(R.desc.dias); if(dd.length>1&&dd[0][1]>1) t.push(`El día con más descargas fue el ${roFechaL(dgFecha(dd[0][0]),true)}, con ${roPl(dd[0][1],'contenedor','contenedores')}.`);
  }
  const cd=R.cort.descarga; if(cd.length&&!pais){ const pm=cd.reduce((s,x)=>s+x.min,0)/cd.length; t.push(`En cortina ${roV(cd.length,'se cerró','se cerraron')} ${roPl(cd.length,'descarga')}, con un tiempo promedio de ${roN(pm)} minutos por equipo.`); }
  S.push({ic:'▼',h:'Recepción y descarga',t});
  // Despacho
  t=[];
  if(!R.desp.peds) t.push(`No se despacharon pedidos${enPais} en el periodo.`);
  else{
    t.push(`${roV(R.desp.peds,'Se despachó','Se despacharon')} ${B(roPl(R.desp.peds,'pedido'))} en ${B(roPl(R.desp.viajes,'viaje'))}${enPais}, con un total de ${B(roPl(R.desp.pal,'pallet'))}`+(R.desp.kg?` y ${roN(R.desp.kg/1000,1)} toneladas`:'')+'.');
    if(R.desp.viajes) t.push(`En promedio salieron ${roN(R.desp.pal/R.desp.viajes,1)} pallets por viaje`+(R.desp.fills.length?`, con un llenado de unidad de ${roN(R.desp.fills.reduce((s,x)=>s+x,0)/R.desp.fills.length)}%`:'')+'.');
    const p=Object.entries(R.desp.pais).sort((x,y)=>y[1].pal-x[1].pal);
    if(!pais&&p.length>1) t.push(`Por destino: ${roLista(p.map(([k,v])=>`${roPaisL(k)} ${roPl(v.viajes.size,'viaje')} y ${roPl(v.pal,'pallet')}`))}. El destino con más volumen fue ${B(roPaisL(p[0][0]))}.`);
    else if(!pais&&p.length===1) t.push(`Todo salió hacia ${roPaisL(p[0][0])}.`);
    const e=Object.entries(R.desp.edif).sort((x,y)=>y[1]-x[1]);
    if(e.length) t.push(`Se cargó desde ${roLista(e.map(([k,v])=>`el Edificio ${k} (${roPl(v,'pedido')})`))}.`);
    if(R.desp.dias.length){ const pm=R.desp.dias.reduce((s,x)=>s+x,0)/R.desp.dias.length; t.push(`Cada pedido estuvo en promedio ${roN(pm,1)} días en bodega desde su descarga hasta su salida (el que más, ${roPl(Math.max(...R.desp.dias),'día')}).`); }
    const dd=roTop(R.desp.porDia); if(dd.length>1&&dd[0][1]>1) t.push(`El día con más despachos fue el ${roFechaL(dgFecha(dd[0][0]),true)}, con ${roPl(dd[0][1],'pedido')}.`);
  }
  if(R.desp.cargados) t.push(`Además, ${roPl(R.desp.cargados,'pedido')} (${roPl(R.desp.cargPal,'pallet')}) ${roV(R.desp.cargados,'quedó cargado y pendiente','quedaron cargados y pendientes')} de salida.`);
  const cc=R.cort.carga; if(cc.length&&!pais){ const pm=cc.reduce((s,x)=>s+x.min,0)/cc.length; t.push(`En cortina ${roV(cc.length,'se cerró','se cerraron')} ${roPl(cc.length,'carga')}, con un tiempo promedio de ${roN(pm)} minutos por unidad.`); }
  S.push({ic:'▲',h:'Despacho',t});
  // Comparación
  S.push({ic:'↔',h:'Comparado con el periodo anterior',t:[
    `Se toma como referencia ${roRangoL(pa,pb)} (${roPl(dias,'día')}).`,
    `Contenedores descargados: ${roVar(R.desc.conts,A.desc.conts,'contenedor').replace('contenedors','contenedores')}.`,
    `Pedidos despachados: ${roVar(R.desp.peds,A.desp.peds,'pedido')}.`,
    `Pallets despachados: ${roVar(R.desp.pal,A.desp.pal,'pallet')}.`]});
  // Mismo periodo del año anterior (y del anterior a ese), si hay datos
  [1,2].forEach(n=>{
    const ya=new Date(a), yb=new Date(b); ya.setFullYear(ya.getFullYear()-n); yb.setFullYear(yb.getFullYear()-n);
    const Y=roCalc(ya,yb,pais);
    if(!Y.desc.conts&&!Y.desp.peds) return;
    S.push({ic:'↺',h:`Comparado con el mismo periodo de ${yb.getFullYear()}`,t:[
      `Se toma ${roRangoL(ya,yb)}.`,
      `Contenedores descargados: ${roVar(R.desc.conts,Y.desc.conts,'contenedor').replace('contenedors','contenedores')}.`,
      `Pedidos despachados: ${roVar(R.desp.peds,Y.desp.peds,'pedido')}.`,
      `Viajes: ${roVar(R.desp.viajes,Y.desp.viajes,'viaje')}.`,
      `Pallets despachados: ${roVar(R.desp.pal,Y.desp.pal,'pallet')}.`]});
  });
  // Situación actual
  t=[];
  const hoy=dgHoy();
  const np=(noProg||[]).filter(r=>!pais||dgPais(r.dest||r.pais)===pais);
  if(np.length){
    const pal=np.reduce((s,r)=>s+dgNum(r.pallets),0);
    const gr=np.filter(r=>dgNum(r.cajas)>0&&!(dgNum(r.pallets)>0)), grCj=gr.reduce((s,r)=>s+dgNum(r.cajas),0);
    const viejos=np.filter(r=>{ const f=dgFecha(r.fdescarga); return f&&(hoy-f)/86400000>7; }).length;
    t.push(`${roV(np.length,'Hay','Hay')} ${B(roPl(np.length,'pedido'))} en No programados (${roPl(pal,'pallet')})`+(viejos?(np.length===1?'; lleva más de 7 días desde su descarga':`; ${B(roN(viejos))} de ellos ${roV(viejos,'lleva','llevan')} más de 7 días desde su descarga`):'')+'.');
    if(gr.length) t.push(`${roPl(gr.length,'pedido')} a granel ${roV(gr.length,'espera','esperan')} que se digiten sus pallets (${roPl(grCj,'caja')}).`);
  } else t.push('No hay pedidos en No programados.');
  const dp=(despachos||[]).filter(r=>(!pais||dgPais(r.dest)===pais)&&!['CARGADO','DESPACHADO'].includes(String(r.status||'').toUpperCase()));
  if(dp.length) t.push(`En Despacho hay ${roPl(dp.length,'pedido')} ${roV(dp.length,'programado','programados')} esperando carga (${roPl(dp.reduce((s,r)=>s+dgNum(r.pallets),0),'pallet')}).`);
  if(!pais){
    const est=e=>(contenedores||[]).filter(r=>!(r.enviado&&String(r.enviado)!=='false')&&String(r.estado||'').toUpperCase().startsWith(e)).length;
    const camino=est('01')+est('02')+est('03'), pos=est('04'), endesc=est('05');
    const fr=[]; if(camino) fr.push(`${roPl(camino,'contenedor','contenedores')} en camino (marítimo, puerto o terrestre)`); if(pos) fr.push(`${roN(pos)} posicionado${pos===1?'':'s'} en Blue esperando descarga`); if(endesc) fr.push(`${roN(endesc)} en descarga en este momento`);
    if(fr.length) t.push(`Hay ${roLista(fr)}.`);
  }
  S.push({ic:'●',h:'Situación al momento del reporte',t});
  return {S,dias,R,A,pa,pb};
}

let roCharts={}, roKpis=[];
function roDelta(act,ant,inv){
  if(!ant||act==null) return '';
  const d=(act-ant)/Math.abs(ant)*100;
  if(Math.abs(d)<0.5) return `<span class="dg-delta flat" title="Igual que el periodo anterior">= anterior</span>`;
  const bueno=inv?d<0:d>0;
  return `<span class="dg-delta ${bueno?'up':'down'}" title="Contra el periodo anterior">${d>0?'▲':'▼'} ${Math.abs(d).toFixed(0)}% vs anterior</span>`;
}
function roPanel(R,A,dias,a,b){
  const avg=x=>x.length?x.reduce((s,v)=>s+v,0)/x.length:null;
  const fill=avg(R.desp.fills), fillA=avg(A.desp.fills), dm=avg(R.desp.dias), dmA=avg(A.desp.dias);
  roKpis=[
    {hero:1,l:'Despachos realizados',v:roN(R.desp.peds),u:'pedidos',s:`en ${roPl(R.desp.viajes,'viaje')}`,d:roDelta(R.desp.peds,A.desp.peds)},
    {l:'Pallets despachados',v:roN(R.desp.pal),u:'pallets',s:R.desp.viajes?`${roN(R.desp.pal/R.desp.viajes,1)} pallets por viaje`:'sin viajes',d:roDelta(R.desp.pal,A.desp.pal)},
    {l:'Toneladas despachadas',v:roN(R.desp.kg/1000,1),u:'tn',s:R.desp.viajes?`${roN(R.desp.kg/1000/R.desp.viajes,1)} tn por viaje`:'—',d:roDelta(R.desp.kg,A.desp.kg)},
    {l:'Contenedores descargados',v:roN(R.desc.conts),u:'cont.',s:`${roPl(R.desc.peds,'pedido')} · ${roPl(R.desc.pal,'pallet')} · ${roN(R.desc.kg/1000,1)} tn`,d:roDelta(R.desc.conts,A.desc.conts)},
    {l:'Llenado de unidades',v:fill==null?'—':roN(fill),u:fill==null?'':'%',s:'promedio por viaje',d:fill==null?'':roDelta(fill,fillA)},
    {l:'Días en bodega',v:dm==null?'—':roN(dm,1),u:dm==null?'':'días',s:'de la descarga a la salida',d:dm==null?'':roDelta(dm,dmA,true)}
  ];
  document.getElementById('ro-kpis').innerHTML=roKpis.map(k=>`<div class="dg-kpi ${k.hero?'hero':''}"><div class="dg-kpi-label">${k.l}</div><div class="dg-kpi-val">${k.v}<small>${k.u}</small></div><div class="dg-kpi-sub">${k.s}${k.d?'<br>'+k.d:''}</div></div>`).join('');
  // ---- gráfica por día (o por semana si el rango es largo) ----
  Object.values(roCharts).forEach(c=>{ try{ c.destroy(); }catch(e){} }); roCharts={};
  if(typeof Chart==='undefined') return;
  const semanal=dias>45, keys=[], lab=[];
  const cur=new Date(a);
  if(semanal) cur.setDate(cur.getDate()-((cur.getDay()+6)%7));
  while(cur<=b){ keys.push(roIso(cur)); lab.push((semanal?'sem ':'')+cur.getDate()+' '+DG_MES_CORTO[cur.getMonth()].toLowerCase()); cur.setDate(cur.getDate()+(semanal?7:1)); }
  const idx=iso=>{ if(!semanal) return keys.indexOf(iso); const d=dgFecha(iso); d.setDate(d.getDate()-((d.getDay()+6)%7)); return keys.indexOf(roIso(d)); };
  const dp=keys.map(()=>0), dc=keys.map(()=>0);
  Object.entries(R.desp.porDia).forEach(([k,v])=>{ const i=idx(k); if(i>=0) dp[i]+=v; });
  Object.entries(R.desc.dias).forEach(([k,v])=>{ const i=idx(k); if(i>=0) dc[i]+=v; });
  document.getElementById('ro-t-dia').textContent=semanal?'Movimiento por semana':'Movimiento por día';
  const bar=(l,d,c)=>({label:l,data:d,backgroundColor:c,borderRadius:{topLeft:4,topRight:4},borderSkipped:false,maxBarThickness:22});
  const c1=document.getElementById('ro-c-dia');
  roCharts.dia=new Chart(c1,{type:'bar',data:{labels:lab,datasets:[bar('Pedidos despachados',dp,DG_C.deep),bar('Contenedores descargados',dc,DG_C.sky)]},
    options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false},tooltip:{mode:'index',intersect:false}},scales:dgAxes(v=>Number.isInteger(v)?v:'')}});
  document.getElementById('ro-leg').innerHTML=`<span><i style="background:${DG_C.deep}"></i>Pedidos despachados</span><span><i style="background:${DG_C.sky}"></i>Contenedores descargados</span>`;
  const P=Object.entries(R.desp.pais).sort((x,y)=>y[1].pal-x[1].pal);
  const c2=document.getElementById('ro-c-pais'), wrap=c2.parentElement; wrap.querySelectorAll('.dg-empty').forEach(e=>e.remove()); c2.style.display='';
  if(!P.length){ dgEmpty('ro-c-pais','Sin despachos en el rango','Cuando salgan pedidos, aquí verás los pallets por país.'); return; }
  roCharts.pais=new Chart(c2,{type:'bar',data:{labels:P.map(([k])=>roPaisL(k)),datasets:[{label:'Pallets',data:P.map(([,v])=>v.pal),backgroundColor:P.map(([k])=>(DG_BY_N[k]||{}).c||DG_C.blue),borderRadius:4,maxBarThickness:26}]},
    options:{indexAxis:'y',responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false},tooltip:{callbacks:{label:c=>{ const v=P[c.dataIndex][1]; return ` ${roPl(v.pal,'pallet')} · ${roPl(v.peds,'pedido')} · ${roPl(v.viajes.size,'viaje')}`; }}}},
      scales:{x:{beginAtZero:true,grid:{color:DG_C.grid},border:{display:false},ticks:{color:DG_C.hint,maxTicksLimit:5}},y:{grid:{display:false},ticks:{color:DG_C.muted,font:{weight:'600'}}}}}});
}
function roDocPrint(){
  const doc=document.getElementById('ro-doc').innerHTML.replace(/<div class="ro-palabras">.*?<\/div>/,'');
  const k='<div class="ro-pk">'+roKpis.map(k=>'<div><span>'+k.l+'</span><b>'+k.v+'<small>'+k.u+'</small></b><em>'+k.s+'</em></div>').join('')+'</div>';
  const img=(c,t)=>{ try{ if(c){ c.stop(); c.update('none'); } return c&&c.canvas&&c.canvas.style.display!=='none'?'<figure><figcaption>'+t+'</figcaption><img src="'+c.toBase64Image()+'"></figure>':''; }catch(e){ return ''; } };
  const g='<div class="ro-gr">'+img(roCharts.dia,document.getElementById('ro-t-dia').textContent+' · pedidos despachados (oscuro) y contenedores descargados (claro)')+img(roCharts.pais,'Pallets despachados por destino')+'</div>';
  const i=doc.indexOf('<section');
  return i<0?doc+k+g:doc.slice(0,i)+k+g+doc.slice(i);
}

// ════════ ARCHIVO HISTÓRICO (años anteriores, solo para reportes) ════════
// Se guarda en hub_archivo/{año} como texto JSON (1 lectura por año). No toca Ingreso / NP / Despacho.
var hubArch={anios:{}, listo:false, cargando:null, cache:null};
var archPrev=null;   // datos leídos del Excel, antes de guardar
function archPlaca(p){ const t=String(p||'').toUpperCase().replace(/-/g,'').match(/[A-Z]+\d+[A-Z0-9]*/g)||[]; return [...new Set(t)].sort().join('|'); }
function archDT(s){ return String(s||'').trim().toUpperCase().replace(/^DT-?/,''); }
function archAnios(){ return Object.keys(hubArch.anios).sort(); }
function archNum(v){ const n=parseFloat(String(v==null?'':v).replace(/,/g,'')); return isFinite(n)?n:0; }

// ---- Lectura del Excel (hojas de ingresos y despachos) ----
function archElegir(){ const i=document.getElementById('arch-file'); i.value=''; i.click(); }
function archLeer(input){
  const file=input.files&&input.files[0]; if(!file) return;
  if(typeof XLSX==='undefined'){ alert('No se pudo cargar el lector de Excel. Revisa la conexión a internet.'); return; }
  const fr=new FileReader();
  fr.onload=e=>{ try{ archProcesar(XLSX.read(new Uint8Array(e.target.result),{type:'array',cellDates:true}),file.name); }catch(err){ console.error(err); alert('No se pudo leer el archivo: '+err.message); } };
  fr.readAsArrayBuffer(file);
}
function archHoja(wb,pred){
  for(const n of wb.SheetNames){ const a=XLSX.utils.sheet_to_json(wb.Sheets[n],{header:1,defval:'',raw:true}); const h=(a[0]||[]).map(impNorm); if(pred(h)) return {h,rows:a.slice(1).filter(r=>r.some(v=>String(v).trim()!=='')),hoja:n}; }
  return null;
}
function archProcesar(wb,nombre){
  const HI=archHoja(wb,h=>h.includes('DT')&&h.includes('PEDIDO')&&h.includes('CONSIGNATARIO')&&h.includes('PLACA'));
  const HD=archHoja(wb,h=>h.includes('REFERENCIA')&&h.includes('PALLETS')&&h.some(x=>/FECHA DE SALIDA|FECHA DE CARGA/.test(x)));
  const RC=dgCostosDeLibro(wb,nombre), CO=RC.costos||null;
  if(!HI&&!HD&&!CO){ alert('No encontré las hojas de ingresos ni de despachos.\n\nIngresos: columnas DT, pedido, Consignatario, Placa, Descargo.\nDespachos: columnas Referencia, Pallets, Fecha de Carga / Salida.'); return; }
  const anios={}, A=y=>anios[y]=anios[y]||{ing:[],desp:[]};
  const porDT={};
  if(HI){
    const c=n=>HI.h.indexOf(n), C={man:c('MANIFIESTO'),con:c('CONSIGNATARIO'),dt:c('DT'),ot:c('OT'),arr:c('ARRIBO'),des:c('DESCARGO'),bul:c('NO. BULTOS'),peso:c('PESO'),placa:c('PLACA'),ori:c('ORIGEN'),ped:c('PEDIDO')};
    HI.rows.forEach(r=>{
      const f=impFecha(r[C.des])||impFecha(r[C.arr]); if(!f) return;
      const row=[impIso(f),String(r[C.man]||'').trim(),impPaisKey(r[C.con]),String(r[C.ped]||'').trim(),archDT(r[C.dt]),archNum(r[C.bul]),archNum(r[C.peso]),impNorm(r[C.ori]),archPlaca(r[C.placa]),String(C.ot>=0?r[C.ot]:'').trim()];
      A(f.getFullYear()).ing.push(row);
      if(row[4]) porDT[row[4]]=row;
    });
  }
  if(HD){
    const c=n=>HD.h.indexOf(n), ci=re=>HD.h.findIndex(x=>re.test(x));
    const C={ref:c('REFERENCIA'),dt:ci(/DT\)?$/),dest:c('DESTINO'),pal:c('PALLETS'),gr:c('A GRANEL'),rem:c('REMOLQUE'),ed:c('#'),fc:c('FECHA DE CARGA'),fs:c('FECHA DE SALIDA'),an:ci(/^A[NÑ]O$/),oc:c('OCUPACION')};
    HD.rows.forEach(r=>{
      const fs=impFecha(r[C.fs]), fc=impFecha(r[C.fc]), f=fs||fc;
      const y=f?f.getFullYear():parseInt(r[C.an]); if(!y) return;
      const dt=archDT(r[C.dt]); const I=porDT[dt];
      const pais=impPaisKey(r[C.dest])||(I?I[2]:'');
      const ed=String(C.ed>=0?r[C.ed]:'').replace(/\D/g,'');
      A(y).desp.push([String(r[C.ref]||'').trim().toUpperCase().replace(/^\s*UL\s*-?\s*/,'UL-'),dt,pais,archNum(r[C.pal]),archNum(C.gr>=0?r[C.gr]:0),impIso(fc),impIso(fs),ed,archNum(C.oc>=0?r[C.oc]:0),String(C.rem>=0?r[C.rem]:'').trim()]);
    });
  }
  // Costos por año de factura y relación pedido ↔ costo
  const costoAnio={};
  if(CO) Object.values(CO.peds).forEach(o=>{ const y=(o.kFac||o.fSal||'').slice(0,4); if(!y) return; const c=costoAnio[y]=costoAnio[y]||{total:0,peds:new Set()}; c.total+=o.total; c.peds.add(o.pedido); });
  const pedConCosto=new Set(CO?Object.values(CO.peds).map(o=>o.pedido):[]);
  const res={};
  Object.keys(costoAnio).forEach(y=>A(y));
  Object.entries(anios).forEach(([y,d])=>{
    const R=res[y]=archResumen(d);
    const ingDT={}; d.ing.forEach(r=>{ if(r[4]) ingDT[r[4]]=r; });
    let lig=0, conCosto=0;
    d.desp.forEach(r=>{ const I=porDT[r[1]]; if(I){ lig++; if(pedConCosto.has(I[3])) conCosto++; } });
    R.ligados=lig; R.conCosto=conCosto;
    R.costo=costoAnio[y]?costoAnio[y].total:0; R.pedCosto=costoAnio[y]?costoAnio[y].peds.size:0;
  });
  archPrev={anios,res,nombre,costos:CO,hojas:[HI&&HI.hoja,HD&&HD.hoja,CO&&'costos'].filter(Boolean)};
  archRenderModal();
}
function archResumen(d){
  const eq=new Set(), man=new Set(); let kg=0, sinPais=0;
  d.ing.forEach(r=>{ eq.add(r[0]+'|'+(r[8]||r[1])); man.add(r[1]); kg+=r[6]; });
  const refs=new Set(); let pal=0, cj=0;
  d.desp.forEach(r=>{ refs.add(r[0]||('?'+r[1])); pal+=r[3]; cj+=r[4]; if(!r[2]) sinPais++; });
  return {conts:eq.size, pedIng:d.ing.length, man:man.size, tn:kg/1000, pedDesp:d.desp.length, viajes:refs.size, pal, cj, sinPais};
}
function archAbrir(){ archPrev=null; archRenderModal(); document.getElementById('modal-arch').classList.add('open'); }
function archRenderModal(){
  const cur=dgHoy().getFullYear(), ya=archAnios();
  const box=document.getElementById('arch-body');
  const cargados=ya.length?`<p class="arch-ya">Ya cargados: ${ya.map(y=>`<b>${y}</b>`).join(', ')}. Si vuelves a cargar un año, se reemplaza.</p>`:'';
  if(!archPrev){ box.innerHTML=cargados+`<p>Elige el Excel de seguimiento (hojas de <b>ingresos</b> y <b>despachos</b>). Los años anteriores quedan guardados <b>solo para los reportes</b>: no aparecen en Ingreso, No programados ni Despacho.</p><button class="btn btn-accent" onclick="archElegir()">Elegir archivo…</button>`; document.getElementById('arch-guardar').style.display='none'; return; }
  const ys=Object.keys(archPrev.anios).sort();
  const f=(n,d)=>dgFmt(n,d||0);
  box.innerHTML=cargados+`<p class="arch-file">${dgEsc(archPrev.nombre)} · hojas: ${archPrev.hojas.map(dgEsc).join(', ')}</p>
  <table class="arch-t"><thead><tr><th></th><th>Año</th><th class="num">Contenedores</th><th class="num">Pedidos ingresados</th><th class="num">Toneladas</th><th class="num">Pedidos despachados</th><th class="num">Viajes</th><th class="num">Pallets</th><th class="num">Costos facturados</th><th class="num">Relación</th></tr></thead><tbody>
  ${ys.map(y=>{ const R=archPrev.res[y], esCur=+y>=cur; return `<tr class="${esCur?'arch-off':''}"><td><input type="checkbox" class="arch-chk" value="${y}" ${esCur?'disabled':'checked'}></td><td><b>${y}</b>${esCur?'<small> ya está en el HUB</small>':''}</td>
    <td class="num">${f(R.conts)}</td><td class="num">${f(R.pedIng)}</td><td class="num">${f(R.tn,1)}</td><td class="num">${f(R.pedDesp)}</td><td class="num">${f(R.viajes)}</td><td class="num">${f(R.pal)}</td><td class="num">${R.costo?dgUsd(R.costo):'—'}<small class="arch-sub">${R.pedCosto?f(R.pedCosto)+' pedidos':''}</small></td>
    <td class="num">${R.pedDesp?`<span title="Despachos ligados a su ingreso por DT">${Math.round(R.ligados/R.pedDesp*100)}% ingreso</span><small class="arch-sub" title="Despachos con costo facturado">${Math.round(R.conCosto/R.pedDesp*100)}% costo</small>`:'—'}</td></tr>`; }).join('')}
  </tbody></table>
  <p class="arch-nota">Todo queda relacionado: <b>despacho ↔ ingreso</b> por el DT (de ahí salen país, pedido, peso y días en bodega) y <b>pedido ↔ costo</b> por el número de pedido de la factura. Contenedores = cada cabezal + remolque que descargó en una fecha. Del año en curso solo se toman los <b>costos</b> si los marcas.</p>`;
  document.getElementById('arch-guardar').style.display='';
}
async function archGuardar(){
  if(!archPrev) return;
  const ys=[...document.querySelectorAll('.arch-chk:checked')].map(x=>x.value);
  if(!ys.length){ alert('Marca al menos un año.'); return; }
  if(!confirm(`Guardar ${ys.join(' y ')} como archivo histórico para los reportes?\n\nNo se modifica nada de Ingreso, No programados ni Despacho.`)) return;
  const quien=(hubPerfil&&(hubPerfil.nombre||hubPerfil.usuario))||'';
  try{
    for(const y of ys){
      const d=archPrev.anios[y], doc={anio:+y, data:JSON.stringify(d), resumen:archPrev.res[y], archivo:archPrev.nombre, por:quien, en:new Date().toISOString()};
      if(window.HUB_ONLINE&&hubDb) await hubDb.collection('hub_archivo').doc(String(y)).set(doc);
      hubArch.anios[y]=d;
    }
    // Costos de esos años: se integran a los costos del reporte (los de otros años no se tocan)
    if(archPrev.costos){
      const prev=dgCargarCostos(), peds={};
      if(prev&&prev.peds) Object.entries(prev.peds).forEach(([k,o])=>{ if(!ys.includes((o.kFac||o.fSal||'').slice(0,4))) peds[k]=o; });
      Object.entries(archPrev.costos.peds).forEach(([k,o])=>{ if(ys.includes((o.kFac||o.fSal||'').slice(0,4))) peds[k]=o; });
      const L=Object.values(peds), m0=(prev&&prev.meta)||{};
      dgCostos={v:3,meta:{archivo:m0.archivo&&!String(m0.archivo).includes(archPrev.nombre)?m0.archivo+' + '+archPrev.nombre:archPrev.nombre,cargado:dgIso(dgHoy()),
        renglones:(m0.renglones||0), pedidos:new Set(L.map(o=>o.pedido)).size, sinPedido:m0.sinPedido||0, montoSin:m0.montoSin||0, compartidos:m0.compartidos||0, sinFecha:m0.sinFecha||0,
        total:Math.round(L.reduce((a,o)=>a+o.total,0)*100)/100}, peds};
      try{ localStorage.setItem(DG_LS_COSTOS, JSON.stringify(dgCostos)); }catch(e){}
      if(typeof hubProgramarSync==='function') hubProgramarSync(200);
    }
  }catch(err){ console.error(err); alert('No se pudo guardar: '+err.message+(String(err.code||'').includes('permission')?'\n\nFalta agregar la regla de hub_archivo en Firestore.':'')); return; }
  hubArch.listo=true; hubArch.cache=null; closeModals();
  hubToast(`Archivo histórico guardado: ${ys.join(', ')}.`);
  archRefrescar();
}
// ---- Carga perezosa (solo al abrir reportes) ----
function archAsegurar(){
  if(hubArch.listo||hubArch.cargando||!window.HUB_ONLINE||!hubDb) return hubArch.cargando||Promise.resolve(false);
  hubArch.cargando=hubDb.collection('hub_archivo').get().then(snap=>{
    (snap.docs||[]).forEach(d=>{ try{ const o=d.data(); hubArch.anios[d.id]=JSON.parse(o.data); }catch(e){ console.warn('archivo',d.id,e); } });
    hubArch.listo=true; hubArch.cache=null; hubArch.cargando=null;
    if(archAnios().length) archRefrescar();
    return true;
  }).catch(e=>{ console.warn('hub_archivo',e); hubArch.listo=true; hubArch.cargando=null; return false; });
  return hubArch.cargando;
}
function archRefrescar(){
  const act=document.querySelector('.tab-content.active'); const id=act&&act.id;
  if(id==='tab-dashboard'){ try{ dashInit(); }catch(e){} }
  if(id==='tab-resumen'){ try{ roRender(true); }catch(e){} }
  if(id==='tab-buscar'&&document.getElementById('bp-q').value){ try{ bpBuscar(); }catch(e){} }
}
// ---- Registros en el formato de los reportes (sin duplicar lo que ya está en el HUB) ----
function archDatos(){
  if(hubArch.cache) return hubArch.cache;
  const vivosPed=new Set(), vivosDT=new Set();
  const addP=v=>{ v=String(v||'').trim(); if(v) vivosPed.add(v); }, addD=v=>{ v=archDT(v); if(v) vivosDT.add(v); };
  [...(contenedores||[]),...(historialCont||[])].forEach(r=>contPedidos(r).forEach(p=>{ addP(p.pedido); addD(p.dt); }));
  [...(noProg||[]),...(despachos||[]),...(historial||[])].forEach(r=>{ addP(r.pedido||r.no_pedido); addD(r.dt); });
  const hist=[], conts={};
  archAnios().forEach(y=>{
    const d=hubArch.anios[y]||{ing:[],desp:[]};
    const porDT={}; d.ing.forEach(r=>{ if(r[4]) porDT[r[4]]=r; });
    Object.values(hubArch.anios).forEach(o=>(o.ing||[]).forEach(r=>{ if(r[4]&&!porDT[r[4]]) porDT[r[4]]=r; }));
    d.ing.forEach(r=>{
      if((r[3]&&vivosPed.has(r[3]))||(r[4]&&vivosDT.has(r[4]))) return;
      const k=r[0]+'|'+(r[8]||r[1]);
      const c=conts[k]=conts[k]||{cont:(r[8]||'').replace(/\|/g,' // ')||r[1], doc:r[1]+' · '+r[0], origen:r[7], fdesc:r[0], peso:0, pedidos:[], _arch:1, mes:''};
      c.peso+=r[6]; c.pedidos.push({pais:r[2], pedido:r[3]||r[4], dt:r[4], bultos:r[5], peso:r[6]});
    });
    d.desp.forEach(r=>{
      if(r[1]&&vivosDT.has(r[1])) return;
      const I=porDT[r[1]];
      hist.push({ref:r[0]?r[0]+'/'+String(y).slice(2):'', no_pedido:(I&&I[3])||r[1], dt:r[1]?'DT-'+r[1]:'', dest:npNormPais((r[2]||'').toUpperCase())||'', pallets:r[3]||'', cajas:r[4]||'',
        peso:I?I[6]:'', fingreso:I?I[0]:'', fcarga:r[5], fsalida:r[6]||r[5], edif:r[7], remolque:r[9], status:'DESPACHADO', _arch:1, mes:''});
    });
  });
  hubArch.cache={hist, conts:Object.values(conts)};
  return hubArch.cache;
}
function archHist(){ return archAnios().length?archDatos().hist:[]; }
function archConts(){ return archAnios().length?archDatos().conts:[]; }

// ════════ BUSCAR PEDIDO: ingreso → despacho → facturación ════════
function bpEsc(v){ return dgEsc(String(v==null?'':v)); }
function bpF(iso){ const d=dgFecha(iso); return d?d.toLocaleDateString('es-SV',{day:'2-digit',month:'short',year:'numeric'}):'—'; }
function bpBuscar(){
  const qRaw=(document.getElementById('bp-q').value||'').trim(); const out=document.getElementById('bp-out');
  if(!qRaw){ out.innerHTML=''; return; }
  hubArch.cache=null;
  const q=qRaw.toUpperCase(), qDT=archDT(q);
  const eqP=v=>String(v||'').trim().toUpperCase()===q, eqD=v=>{ const d=archDT(v); return !!d&&d===qDT; };
  // 1) Ingreso
  const ing=[];
  [...(contenedores||[]).map(r=>[r,'Ingreso de equipo']),...(historialCont||[]).map(r=>[r,'Historial de ingresos']),...archConts().map(r=>[r,'Archivo '+String(r.fdesc||'').slice(0,4)])].forEach(([r,fuente])=>{
    contPedidos(r).forEach(p=>{ if(eqP(p.pedido)||eqD(p.dt)) ing.push({r,p,fuente}); });
  });
  // 2) No programados y despacho
  const np=(noProg||[]).filter(r=>eqP(r.pedido)||eqD(r.dt));
  const desp=[...(despachos||[]).map(r=>[r,'Despacho']),...(historial||[]).map(r=>[r,'Historial de despachos']),...archHist().map(r=>[r,'Archivo '+String(r.fsalida||r.fcarga||'').slice(0,4)])]
    .filter(([r])=>eqP(r.no_pedido)||eqD(r.dt));
  // número de pedido (para la facturación)
  const pedidos=new Set();
  if(/^\d{6,}$/.test(q)) pedidos.add(q);
  ing.forEach(x=>{ if(/^\d{6,}$/.test(String(x.p.pedido))) pedidos.add(String(x.p.pedido)); });
  np.forEach(r=>{ if(/^\d{6,}$/.test(String(r.pedido))) pedidos.add(String(r.pedido)); });
  desp.forEach(([r])=>{ if(/^\d{6,}$/.test(String(r.no_pedido))) pedidos.add(String(r.no_pedido)); });
  // 3) Facturación
  const CO=dgCargarCostos();
  const fac=CO?Object.values(CO.peds).filter(o=>pedidos.has(String(o.pedido))).sort((a,b)=>String(a.fFac||a.kFac).localeCompare(String(b.fFac||b.kFac))):[];
  const capt=[]; desp.forEach(([r])=>{ const l=costLista(r); if(l&&l.length) capt.push({r,res:costResumen(l)}); });
  if(!ing.length&&!np.length&&!desp.length&&!fac.length){
    out.innerHTML=`<div class="bp-vacio"><b>No encontré "${bpEsc(qRaw)}".</b><span>Busca por número de pedido (ej. 4505787653) o por DT (ej. DT-0002-01-25 o 0002-01-25).${archAnios().length?'':' Los años anteriores aún no están cargados.'}</span></div>`; return;
  }
  const I=ing[0], D=desp[0]&&desp[0][0];
  const pedNum=[...pedidos][0]||(I&&I.p.pedido)||q, dt=(D&&D.dt)||(I&&I.p.dt)||(np[0]&&np[0].dt)||'';
  const paisN=(D&&dgPais(D.dest))||(I&&(DG_PAISES.find(x=>x.k===I.p.pais)||{}).n)||(np[0]&&dgPais(np[0].dest||np[0].pais))||'';
  const P=DG_BY_N[paisN];
  // estado actual
  let estado='—';
  if(D){ const st=String(D.status||'').toUpperCase(); estado=st==='DESPACHADO'||D._arch||desp[0][1].startsWith('Historial')?'Despachado':st==='CARGADO'?'Cargado, pendiente de salida':'Programado en Despacho'; }
  else if(np.length) estado='En No programados';
  else if(I) estado=I.r.enviado?'Enviado a NP':'En ingreso · '+(String(I.r.estado||'').replace(/^\d+\s*-\s*/,'').toLowerCase()||'sin estado');
  const fIng=(I&&I.r.fdesc)||(D&&D.fingreso)||(np[0]&&np[0].fdescarga)||'', fSal=D?(D.fsalida||D.fcarga):'';
  const dias=dgDias(dgFecha(fIng),dgFecha(fSal));
  const totFac=fac.reduce((a,o)=>a+o.total,0)+capt.filter(c=>!fac.length).reduce((a,c)=>a+c.res.total,0);
  const fila=(l,v)=>v===''||v==null||v==='—'?'':`<div><span>${l}</span><b>${v}</b></div>`;
  let h=`<div class="bp-head">
    <div><div class="bp-k">Pedido</div><div class="bp-ped">${bpEsc(pedNum)}</div><div class="bp-sub">${dt?bpEsc(/^DT/i.test(dt)?dt:'DT-'+dt):''}${P?` · <i class="bp-dot" style="--c:${P.c}"></i>${bpEsc(P.l)}`:''}</div></div>
    <div class="bp-chips"><span class="bp-chip">${bpEsc(estado)}</span>${dias!=null?`<span class="bp-chip">${dias} día${dias===1?'':'s'} en bodega</span>`:''}${fac.length||capt.length?`<span class="bp-chip bp-money">Facturado ${dgUsd(totFac,2)}</span>`:''}</div></div>
  <div class="bp-grid">`;
  // Ingreso
  h+=`<section class="bp-card"><h4><i>1</i>Ingreso</h4>`+(I?`<div class="bp-rows">
      ${fila('Fecha de descarga',bpF(I.r.fdesc))}${fila('Contenedor / placa',bpEsc(I.r.cont||'—'))}${fila('BL / manifiesto',bpEsc(String(I.r.doc||'').split(' · ')[0]))}
      ${fila('Origen',bpEsc(dgOrigenLabel(dgOrigen(I.r.origen))))}${fila('Bultos',I.p.bultos?dgFmt(I.p.bultos):'')}${fila('Peso',I.p.peso?dgFmt(I.p.peso,1)+' kg':'')}${fila('RC',bpEsc(I.r.rc||''))}
    </div><p class="bp-src">${bpEsc(I.fuente)}</p>`:`<p class="bp-na">Sin registro de ingreso.</p>`)+`</section>`;
  // Despacho
  const Dd=D||np[0];
  h+=`<section class="bp-card"><h4><i>2</i>Despacho</h4>`+(D?`<div class="bp-rows">
      ${fila('Fecha de salida',bpF(D.fsalida||D.fcarga))}${fila('Referencia',bpEsc(D.ref||'—'))}${fila('Destino',bpEsc(P?P.l:D.dest||'—'))}
      ${fila('Pallets',D.pallets?dgFmt(dgNum(D.pallets)):'')}${fila('Cajas',dgNum(D.cajas)?dgFmt(dgNum(D.cajas)):'')}${fila('Edificio',D.edif?'Edificio '+bpEsc(D.edif):'')}
      ${fila('Unidad',bpEsc([D.camion,D.remolque].filter(Boolean).join(' · ')))}${fila('Piloto',bpEsc(D.piloto||''))}
    </div><p class="bp-src">${bpEsc(desp[0][1])}${desp.length>1?` · ${desp.length} registros`:''}</p>`
    : np.length?`<div class="bp-rows">${fila('Estado','En No programados')}${fila('Pallets',np[0].pallets||'')}${fila('Cajas',np[0].cajas||'')}${fila('Referencia',bpEsc(np[0].ref||''))}</div>`
    : `<p class="bp-na">Todavía no se ha despachado.</p>`)+`</section>`;
  // Facturación
  h+=`<section class="bp-card bp-fac"><h4><i>3</i>Facturación <small>por fecha de impresión</small></h4>`;
  if(fac.length){
    const cats={}; fac.forEach(o=>Object.entries(o.cats||{}).forEach(([k,v])=>cats[k]=(cats[k]||0)+v));
    const serv=fac.reduce((a,o)=>a+o.serv,0), reint=fac.reduce((a,o)=>a+o.reint,0);
    const conds={}; fac.forEach(o=>Object.entries(o.conds||{}).forEach(([k,v])=>conds[k]=(conds[k]||0)+v));
    const filas=[]; fac.forEach(o=>{ if(o.det&&Object.keys(o.det).length) Object.entries(o.det).forEach(([n,d])=>filas.push({f:d.f||o.fFac,n,c:d.c||null,m:d.m,cx:o.compartido,o})); else filas.push({f:o.fFac,k:o.kFac,n:(o.facturas||[]).join(', '),c:o.conds||{},m:o.total,cx:o.compartido,o}); });
    filas.sort((a,b)=>String(a.f||a.k).localeCompare(String(b.f||b.k)));
    const sinDet=filas.some(x=>!x.c);
    const celC=(x,k)=>x.c?dgUsd(x.c[k]||0,2):'<span class="bp-nd" title="Vuelve a cargar el archivo para ver la condición por factura">—</span>';
    h+=`<table class="bp-t"><thead><tr><th>Impresión</th><th>Factura</th>${COND_ORDEN.map(k=>`<th class="num" title="${bpEsc(COND_INFO[k])}">${k}<small class="bp-th">${bpEsc(COND_INFO[k])}</small></th>`).join('')}<th class="num">Total</th></tr></thead><tbody>
      ${filas.map(x=>`<tr><td>${x.f?bpF(x.f):dgKeyLargo(x.k||'')}</td><td class="mono">${bpEsc(x.n||'—')}${x.cx?' <small title="La factura incluye otros pedidos: se repartió en partes iguales">compartida</small>':''}</td>${COND_ORDEN.map(k=>`<td class="num">${celC(x,k)}</td>`).join('')}<td class="num"><b>${dgUsd(x.m,2)}</b></td></tr>`).join('')}
      </tbody><tfoot><tr><td colspan="2">Total facturado</td>${COND_ORDEN.map(k=>`<td class="num">${dgUsd(conds[k]||0,2)}</td>`).join('')}<td class="num">${dgUsd(totFac,2)}</td></tr></tfoot></table>
      ${sinDet?'<p class="bp-src">Algunas facturas se cargaron antes de guardar la condición por factura: el total por condición sí es correcto; para verla factura por factura, vuelve a cargar el archivo.</p>':''}
      <div class="bp-cats">${Object.entries(cats).sort((a,b)=>b[1]-a[1]).map(([k,v])=>`<span>${bpEsc(k)} <b>${dgUsd(v,2)}</b></span>`).join('')}</div>`;
  } else if(capt.length){
    const c=capt[0].res;
    h+=`<div class="bp-rows">${fila('Total registrado en Despacho',dgUsd(c.total,2))}${fila('Servicios',dgUsd(c.serv,2))}${fila('Reintegros',dgUsd(c.reint,2))}</div><p class="bp-src">Costos capturados en Despacho (aún sin factura importada)</p>`;
  } else h+=`<p class="bp-na">Sin facturas con este número de pedido.</p>`;
  h+=`</section></div>`;
  out.innerHTML=h;
}

// ════════ REPORTE SEMANAL DE POSICIONAMIENTO (Programados) ════════
// Posicionada = la unidad ya llegó: tiene camión/remolque o pasó a En proceso de carga / Cargado / Despachado.
// Días sin posicionar = desde la fecha de solicitud (si no hay, desde que se programó) hasta hoy o hasta que se posicionó.
let posSemIni=null;
function posHoyIso(){ return dgIso(dgHoy()); }
function posEsPos(r){ const st=String(r.status||'').toUpperCase(); return !!(String(r.camion||'').trim()||String(r.remolque||'').trim()) || ['EN PROCESO DE CARGA','CARGADO','DESPACHADO'].includes(st); }
// Marca fechas de posicionamiento (se llama al pintar Despacho)
function posMarcar(){
  const hoy=posHoyIso();
  (despachos||[]).forEach(r=>{
    if(!posEsPos(r)){ if(!r._sinPos) r._sinPos=true; return; }
    if(!r.fposic) r.fposic = r._sinPos ? hoy : (dgIso(dgFecha(r.fcarga))||'');
  });
}
function posRefs(){
  const g={};
  [...(despachos||[]).map(r=>[r,false]),...(historial||[]).map(r=>[r,true])].forEach(([r,h])=>{
    const k=String(r.ref||'').trim().toUpperCase(); if(!k) return;
    const o=g[k]=g[k]||{ref:String(r.ref).trim(),rows:[],hist:false}; o.rows.push(r); if(h) o.hist=true;
  });
  return Object.values(g).map(o=>{
    const R=o.rows, min=a=>a.filter(Boolean).sort()[0]||'';
    const fsol=min(R.map(r=>dgIso(dgFecha(r.fsolicitud)))), fprog=min(R.map(r=>dgIso(dgFecha(r.fprog))));
    const pos=o.hist||R.some(posEsPos);
    let fpos=min(R.map(r=>r.fposic)); if(pos&&!fpos) fpos=min(R.map(r=>dgIso(dgFecha(r.fcarga))))||min(R.map(r=>dgIso(dgFecha(r.fsalida))));
    return {ref:o.ref, rows:R, hist:o.hist, pos, fsol, fprog, base:fsol||fprog, fpos,
      dest:[...new Set(R.map(r=>dgPais(r.dest)).filter(Boolean))], pal:R.reduce((a,r)=>a+dgNum(r.pallets),0), kg:R.reduce((a,r)=>a+dgNum(r.peso),0),
      equipo:R[0].equipo||'', unidad:[...new Set(R.map(r=>[r.camion,r.remolque].filter(Boolean).join(' · ')).filter(Boolean))].join(', '),
      status:String(R[0].status||'').toUpperCase()};
  });
}
function posDias(a,b){ const x=dgFecha(a), y=dgFecha(b); return x&&y?Math.max(0,Math.round((y-x)/86400000)):null; }
function posSemana(d){ const x=new Date(d); x.setHours(0,0,0,0); x.setDate(x.getDate()-((x.getDay()+6)%7)); return x; }
function posDatos(){
  const ini=posSemIni||posSemana(dgHoy()), fin=new Date(ini); fin.setDate(fin.getDate()+6);
  const hoy=dgHoy(), corte=fin<hoy?fin:hoy, cIso=dgIso(corte), iIso=dgIso(ini), fIso=dgIso(fin);
  const refs=posRefs();
  const pend=refs.filter(x=>x.base&&x.base<=cIso&&(!x.pos||!x.fpos||x.fpos>cIso)&&!(x.pos&&!x.fpos)).map(x=>({...x,dias:posDias(x.base,cIso)})).sort((a,b)=>b.dias-a.dias);
  const hechas=refs.filter(x=>x.pos&&x.fpos&&x.fpos>=iIso&&x.fpos<=fIso).map(x=>({...x,dias:x.base?posDias(x.base,x.fpos):null})).sort((a,b)=>String(a.fpos).localeCompare(String(b.fpos)));
  const prom=a=>{ const v=a.map(x=>x.dias).filter(x=>x!=null); return v.length?v.reduce((s,x)=>s+x,0)/v.length:null; };
  return {ini,fin,corte,pend,hechas,promPend:prom(pend),promHechas:prom(hechas),max:pend.length?pend[0].dias:0,crit:pend.filter(x=>x.dias>=5).length,alerta:pend.filter(x=>x.dias>=3&&x.dias<5).length};
}

const POS_PAISES=[['COSTA RICA','CR'],['NICARAGUA','NIC'],['HONDURAS','HN'],['GUATEMALA','GT'],['EL SALVADOR','SV'],['PANAMA','PAN']];
const POS_COD=Object.fromEntries(POS_PAISES);
function posSemIso(iso){ const d=dgFecha(iso); if(!d) return null; const t=new Date(Date.UTC(d.getFullYear(),d.getMonth(),d.getDate())); const dn=t.getUTCDay()||7; t.setUTCDate(t.getUTCDate()+4-dn); const y0=new Date(Date.UTC(t.getUTCFullYear(),0,1)); return {y:t.getUTCFullYear(), w:Math.ceil(((t-y0)/86400000+1)/7)}; }
function posMatriz(D){
  if(!D.pend.length) return '<p class="vacio">Todas las referencias programadas tienen unidad posicionada. ✓</p>';
  const sem={}, cel={};
  D.pend.forEach(x=>{ const w=posSemIso(x.base)||{y:0,w:0}; const k=w.y*100+w.w; sem[k]=w;
    (x.dest.length?x.dest:['—']).forEach(p=>{ const c=(cel[p]=cel[p]||{}); (c[k]=c[k]||[]).push(x); }); });
  const ks=Object.keys(sem).map(Number).sort((a,b)=>a-b);
  const paises=[...POS_PAISES.map(x=>x[0]), ...Object.keys(cel).filter(p=>!POS_COD[p])];
  const chip=x=>`<span class="c">${dgEsc(x.ref)}<em class="${posNivel(x.dias)}">${x.dias}d</em></span>`;
  const rangoSem=k=>{ const s=sem[k]; if(!s.y) return ''; const j4=new Date(s.y,0,4), l=new Date(j4); l.setDate(j4.getDate()-((j4.getDay()+6)%7)+(s.w-1)*7); const f=new Date(l); f.setDate(l.getDate()+6); const o={day:'numeric',month:'short'}; return l.toLocaleDateString('es-SV',o)+' – '+f.toLocaleDateString('es-SV',o); };
  let tot=0; const totW={};
  const filas=paises.map(p=>{ const c=cel[p]||{}; const n=ks.reduce((a,k)=>a+(c[k]||[]).length,0); tot+=n; ks.forEach(k=>totW[k]=(totW[k]||0)+(c[k]||[]).length);
    return `<tr><td class="p">${dgEsc(POS_COD[p]||roPaisL(p))}</td>${ks.map(k=>`<td class="w">${(c[k]||[]).sort((a,b)=>b.dias-a.dias).map(chip).join('')}</td>`).join('')}<td class="t">${n||''}</td></tr>`; }).join('');
  return `<table class="mx"><thead><tr><th>País</th>${ks.map(k=>`<th class="w">Semana ${sem[k].w||'—'}<small>${rangoSem(k)}</small></th>`).join('')}<th class="t">Total</th></tr></thead><tbody>${filas}</tbody>
    <tfoot><tr><td>TOTAL</td>${ks.map(k=>`<td class="w">${totW[k]||''}</td>`).join('')}<td class="t">${tot}</td></tr></tfoot></table>`;
}
function posNivel(d){ return d==null?'n':d>=5?'r':d>=3?'a':'v'; }
function posFechaC(iso){ const d=dgFecha(iso); return d?d.toLocaleDateString('es-SV',{day:'2-digit',month:'short'}).replace('.',''):'—'; }
function posRango(D){ const o={day:'numeric',month:'long'}; return `${D.ini.toLocaleDateString('es-SV',o)} al ${D.fin.toLocaleDateString('es-SV',{...o,year:'numeric'})}`; }
function posTexto(D){
  const L=[]; const pl=(n,s,p)=>`${n} ${n===1?s:p}`;
  if(!D.pend.length) L.push(`Al ${D.corte.toLocaleDateString('es-SV',{day:'numeric',month:'long'})} no hay referencias programadas esperando unidad.`);
  else{
    L.push(`Al ${D.corte.toLocaleDateString('es-SV',{day:'numeric',month:'long'})} hay ${pl(D.pend.length,'referencia','referencias')} programada${D.pend.length===1?'':'s'} sin posicionar, con ${dgFmt(D.pend.reduce((a,x)=>a+x.pal,0))} pallets en espera. En promedio llevan ${dgFmt(D.promPend,1)} días esperando unidad; la más antigua, ${D.pend[0].ref}, lleva ${pl(D.max,'día','días')}.`);
    if(D.crit||D.alerta) L.push(`${D.crit?pl(D.crit,'referencia supera','referencias superan')+' los 5 días':''}${D.crit&&D.alerta?' y ':''}${D.alerta?pl(D.alerta,'referencia está','referencias están')+' entre 3 y 4 días':''}.`);
    const pd={}; D.pend.forEach(x=>(x.dest.length?x.dest:['—']).forEach(p=>pd[p]=(pd[p]||0)+1));
    const top=Object.entries(pd).sort((a,b)=>b[1]-a[1]);
    if(top.length>1) L.push(`Por destino: ${top.map(([p,n])=>`${roPaisL(p)} ${n}`).join(', ')}.`);
    else if(top.length) L.push(`Todas van a ${roPaisL(top[0][0])}.`);
  }
  if(D.hechas.length) L.push(`En la semana se posicionaron ${pl(D.hechas.length,'referencia','referencias')}${D.promHechas!=null?`, con un tiempo promedio de ${dgFmt(D.promHechas,1)} días desde la solicitud`:''}.`);
  else L.push('En la semana no se registraron posicionamientos.');
  return L;
}
function posDocHTML(D, paraImprimir){
  const fila=x=>`<tr><td><b class="ref">${dgEsc(x.ref)}</b><small>${x.rows.length} pedido${x.rows.length===1?'':'s'} · ${dgFmt(x.pal)} pallets</small></td>
    <td>${x.dest.map(p=>`<span class="pais"><i style="background:${(DG_BY_N[p]||{}).c||'#94A3B8'}"></i>${dgEsc(roPaisL(p))}</span>`).join(' ')||'—'}</td>
    <td>${dgEsc(x.equipo||'—')}</td><td>${posFechaC(x.fsol)}</td><td>${posFechaC(x.fprog)}</td>`;
  const T=posTexto(D);
  return `<!doctype html><html lang="es"><head><meta charset="utf-8"><title>Posicionamiento ${dgIso(D.ini)}</title>
<style>
*{box-sizing:border-box;-webkit-print-color-adjust:exact;print-color-adjust:exact;}
body{margin:0;background:${paraImprimir?'#E9EDF3':'#fff'};font-family:Manrope,'Segoe UI',system-ui,sans-serif;color:#14213A;font-size:12px;}
.bar{position:sticky;top:0;display:flex;gap:8px;justify-content:center;padding:10px;background:#0E2D57;}.bar button{border:none;border-radius:999px;padding:8px 18px;font:700 12px inherit;cursor:pointer;background:#fff;color:#0E2D57;}.bar .p{background:#4A8FD6;color:#fff;}
.page{max-width:216mm;margin:${paraImprimir?'14px auto':'0 auto'};background:#fff;padding:${paraImprimir?'14mm 14mm':'4px 2px'};}
.top{display:flex;justify-content:space-between;align-items:center;border-bottom:2px solid #0E2D57;padding-bottom:10px;}
.top img{height:44px;}.top .t{text-align:right;}.top .t span{display:block;font-size:10px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;color:#5B6B82;}.top .t b{font-size:19px;color:#0E2D57;}.top .t small{display:block;color:#5B6B82;font-size:11.5px;margin-top:2px;}
.kpis{display:grid;grid-template-columns:repeat(5,1fr);gap:8px;margin:14px 0;}
.k{border:1px solid #DCE3EC;border-radius:12px;padding:10px 12px;}.k span{display:block;font-size:9.5px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;color:#5B6B82;}.k b{font-size:22px;color:#0E2D57;font-weight:800;}.k small{display:block;font-size:10.5px;color:#5B6B82;}
.k.hero{background:linear-gradient(135deg,#0E2D57,#1D4E8C);border:none;}.k.hero span,.k.hero small{color:#BFD6F0;}.k.hero b{color:#fff;}
.k.r b{color:#B42318;}
.txt{background:#F4F7FB;border-radius:12px;padding:10px 14px;margin-bottom:14px;}.txt p{margin:3px 0;line-height:1.55;font-size:12.5px;}
h3{font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:#0E2D57;margin:16px 0 6px;display:flex;align-items:center;gap:8px;}h3:after{content:"";flex:1;height:1px;background:#DCE3EC;}
table{width:100%;border-collapse:collapse;}th{font-size:9.5px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;color:#5B6B82;text-align:left;padding:6px 8px;border-bottom:1.5px solid #0E2D57;}
td{padding:7px 8px;border-bottom:1px solid #E6EBF2;vertical-align:middle;}td small{display:block;font-size:10.5px;color:#5B6B82;}.ref{font-family:'JetBrains Mono',ui-monospace,monospace;font-size:12.5px;}
td.n{text-align:right;}.pais{display:inline-flex;align-items:center;gap:5px;white-space:nowrap;}.pais i{width:8px;height:8px;border-radius:50%;display:inline-block;}
.d{display:inline-block;min-width:54px;text-align:center;border-radius:999px;padding:3px 10px;font-weight:800;font-size:12px;}
.d.v{background:#E3F5E9;color:#166534;}.d.a{background:#FFF4D6;color:#8A5A00;}.d.r{background:#FDECEC;color:#B42318;}.d.n{background:#EEF1F5;color:#5B6B82;}
.vacio{color:#5B6B82;padding:12px 8px;font-size:12px;}
.ley{display:flex;flex-wrap:wrap;gap:6px 14px;font-size:10.5px;color:#5B6B82;margin-top:8px;align-items:center;}.ley span{display:inline-flex;align-items:center;gap:5px;white-space:nowrap;}.ley span:last-child{white-space:normal;flex-basis:100%;}.ley i.d{white-space:nowrap;font-style:normal;font-size:10.5px;}
.pie{margin-top:16px;font-size:10px;color:#94A3B8;text-align:right;}
.mx th.w,.mx td.w{text-align:left;}.mx td{vertical-align:top;}.mx td.p{font-weight:800;color:#0E2D57;white-space:nowrap;width:70px;}.mx td.t,.mx th.t{text-align:center;width:60px;font-weight:800;}
.mx .c{display:inline-flex;align-items:center;gap:4px;margin:2px 6px 2px 0;font-family:'JetBrains Mono',ui-monospace,monospace;font-size:11.5px;font-weight:700;white-space:nowrap;}
.mx .c em{font-style:normal;font-family:inherit;font-size:10px;border-radius:999px;padding:1px 6px;}
.mx .c em.v{background:#E3F5E9;color:#166534;}.mx .c em.a{background:#FFF4D6;color:#8A5A00;}.mx .c em.r{background:#FDECEC;color:#B42318;}.mx .c em.n{background:#EEF1F5;color:#5B6B82;}
.mx tfoot td{border-top:2px solid #0E2D57;font-weight:800;color:#0E2D57;}
.mx th.w small{display:block;font-weight:600;letter-spacing:0;text-transform:none;font-size:9.5px;}
@page{size:letter;margin:11mm;}@media print{body{background:#fff;}.bar{display:none;}.page{margin:0;padding:0;}}
</style></head><body>
${paraImprimir?'<div class="bar"><button class="p" onclick="window.print()">Imprimir / Guardar PDF</button><button onclick="window.close()">Cerrar</button></div>':''}
<div class="page">
  <div class="top"><img src="${OC_LOGO}" alt="Blue Logistics"><div class="t"><span>Reporte semanal · Programados</span><b>Posicionamiento de unidades</b><small>Semana del ${posRango(D)}${D.corte<D.fin?` · corte al ${D.corte.toLocaleDateString('es-SV',{day:'numeric',month:'long'})}`:''}</small></div></div>
  <div class="kpis">
    <div class="k hero"><span>Sin posicionar</span><b>${D.pend.length}</b><small>referencias</small></div>
    <div class="k"><span>Promedio de espera</span><b>${D.promPend==null?'—':dgFmt(D.promPend,1)}</b><small>días</small></div>
    <div class="k ${D.max>=5?'r':''}"><span>Más antigua</span><b>${D.pend.length?D.max:'—'}</b><small>${D.pend.length?dgEsc(D.pend[0].ref):'días'}</small></div>
    <div class="k ${D.crit?'r':''}"><span>Más de 5 días</span><b>${D.crit}</b><small>referencias</small></div>
    <div class="k"><span>Posicionadas en la semana</span><b>${D.hechas.length}</b><small>${D.promHechas==null?'—':dgFmt(D.promHechas,1)+' días promedio'}</small></div>
  </div>
  <h3>Esperando unidad · por país y semana</h3>
  ${posMatriz(D)}
  <div class="ley"><span><i class="d v" style="min-width:0;padding:0 6px">0–2</i> a tiempo</span><span><i class="d a" style="min-width:0;padding:0 6px">3–4</i> en alerta</span><span><i class="d r" style="min-width:0;padding:0 6px">5+</i> crítico</span><span>Días sin posicionar, contados desde la solicitud (o desde que se programó). Semana = semana de la solicitud.</span></div>
  <h3>Posicionadas en la semana</h3>
  <table><thead><tr><th>Referencia</th><th>País</th><th>Solicitada</th><th>Posicionada</th><th class="n">Días que tardó</th></tr></thead><tbody>
  ${D.hechas.length?D.hechas.map(x=>`<tr><td><b class="ref">${dgEsc(x.ref)}</b></td><td>${x.dest.map(p=>dgEsc(POS_COD[p]||roPaisL(p))).join(', ')||'—'}</td><td>${posFechaC(x.fsol||x.fprog)}</td><td>${posFechaC(x.fpos)}</td><td class="n"><span class="d ${posNivel(x.dias)}">${x.dias==null?'—':x.dias+' día'+(x.dias===1?'':'s')}</span></td></tr>`).join(''):'<tr><td colspan="5" class="vacio">Sin posicionamientos en la semana.</td></tr>'}
  </tbody></table>
  <div class="pie">Generado ${new Date().toLocaleString('es-SV',{dateStyle:'medium',timeStyle:'short'})}${typeof hubPerfil!=='undefined'&&hubPerfil?' · '+dgEsc(hubPerfil.nombre||hubPerfil.usuario):''} · HUB UL</div>
</div></body></html>`;
}
function posAbrir(){ posSemIni=posSemana(dgHoy()); posPintar(); document.getElementById('modal-pos').classList.add('open'); }
function posMover(n){ const d=new Date(posSemIni); d.setDate(d.getDate()+7*n); if(d>dgHoy()) return; posSemIni=d; posPintar(); }
function posPintar(){
  posMarcar(); const D=posDatos();
  document.getElementById('pos-sem').textContent='Semana del '+posRango(D);
  document.getElementById('pos-sig').disabled = posSemana(dgHoy())<=D.ini;
  document.getElementById('pos-frame').srcdoc=posDocHTML(D,false);
}
function posImprimir(){ const w=window.open('','_blank'); if(!w){ alert('Permite ventanas emergentes para imprimir.'); return; } w.document.open(); w.document.write(posDocHTML(posDatos(),true)); w.document.close(); }
function posTextoPlano(D){
  const ks=[...new Set(D.pend.map(x=>{ const w=posSemIso(x.base); return w?w.w:0; }))].sort((a,b)=>a-b);
  const lin=POS_PAISES.map(([p,c])=>{ const xs=D.pend.filter(x=>x.dest.includes(p)); return [c,...ks.map(w=>xs.filter(x=>(posSemIso(x.base)||{}).w===w).map(x=>`${x.ref} (${x.dias}d)`).join(', ')),xs.length||''].join('\t'); });
  const t=['Detalle de referencias sin posicionar · semana del '+posRango(D),'',['PAIS',...ks.map(w=>'SEMANA '+w),'Total'].join('\t'),...lin,['TOTAL',...ks.map(()=>''),D.pend.length].join('\t')].join('\n');
  return t;
}
// Cuadro con formato para pegar en correo (estilos en línea, compatible con Outlook/Gmail)
function posCorreoHTML(D){
  const F="font-family:Calibri,Arial,sans-serif;", th=F+"background:#0E2D57;color:#fff;font-size:12px;font-weight:bold;padding:6px 10px;border:1px solid #0E2D57;text-align:left;";
  const td=F+"font-size:12px;padding:6px 10px;border:1px solid #CBD5E1;vertical-align:top;", tdc=td+"text-align:center;font-weight:bold;";
  const col={v:['#E3F5E9','#166534'],a:['#FFF4D6','#8A5A00'],r:['#FDECEC','#B42318'],n:['#EEF1F5','#5B6B82']};
  const chip=x=>{ const c=col[posNivel(x.dias)]; return `<span style="${F}font-size:12px;font-weight:bold;white-space:nowrap;">${dgEsc(x.ref)}</span>&nbsp;<span style="${F}font-size:11px;font-weight:bold;background:${c[0]};color:${c[1]};padding:1px 6px;border-radius:8px;">${x.dias}d</span>`; };
  const sem={}, cel={};
  D.pend.forEach(x=>{ const w=posSemIso(x.base)||{y:0,w:0}, k=w.y*100+w.w; sem[k]=w; (x.dest.length?x.dest:['—']).forEach(p=>{ const c=(cel[p]=cel[p]||{}); (c[k]=c[k]||[]).push(x); }); });
  const ks=Object.keys(sem).map(Number).sort((a,b)=>a-b);
  const paises=[...POS_PAISES.map(x=>x[0]), ...Object.keys(cel).filter(p=>!POS_COD[p])];
  let tot=0; const tw={};
  const filas=paises.map((p,i)=>{ const c=cel[p]||{}, n=ks.reduce((a,k)=>a+(c[k]||[]).length,0); tot+=n; ks.forEach(k=>tw[k]=(tw[k]||0)+(c[k]||[]).length);
    const bg=i%2?'background:#F7F9FC;':'';
    return `<tr><td style="${td}${bg}font-weight:bold;color:#0E2D57;">${dgEsc(POS_COD[p]||roPaisL(p))}</td>${ks.map(k=>`<td style="${td}${bg}">${(c[k]||[]).sort((a,b)=>b.dias-a.dias).map(chip).join('<br>')||'&nbsp;'}</td>`).join('')}<td style="${tdc}${bg}">${n||'&nbsp;'}</td></tr>`; }).join('');
  const tf=F+"font-size:12px;font-weight:bold;padding:6px 10px;border:1px solid #0E2D57;background:#DCE6F2;color:#0E2D57;";
  let h=`<p style="${F}font-size:14px;margin:0 0 4px;"><b style="color:#0E2D57;">Posicionamiento de unidades</b> · semana del ${posRango(D)}</p>
  <p style="${F}font-size:12px;color:#5B6B82;margin:0 0 8px;">Sin posicionar: <b style="color:#0E2D57;">${D.pend.length}</b> · Promedio de espera: <b style="color:#0E2D57;">${D.promPend==null?'—':dgFmt(D.promPend,1)} días</b> · Más de 5 días: <b style="color:#B42318;">${D.crit}</b> · Posicionadas en la semana: <b style="color:#0E2D57;">${D.hechas.length}</b></p>`;
  h+= D.pend.length ? `<table cellspacing="0" cellpadding="0" style="border-collapse:collapse;"><tr><th style="${th}">PAÍS</th>${ks.map(k=>`<th style="${th}">SEMANA ${sem[k].w||'—'}</th>`).join('')}<th style="${th}text-align:center;">TOTAL</th></tr>${filas}
    <tr><td style="${tf}">TOTAL</td>${ks.map(k=>`<td style="${tf}">${tw[k]||''}</td>`).join('')}<td style="${tf}text-align:center;">${tot}</td></tr></table>`
    : `<p style="${F}font-size:12px;">Todas las referencias programadas tienen unidad posicionada.</p>`;
  h+=`<p style="${F}font-size:11px;color:#5B6B82;margin:6px 0 0;">Días sin posicionar desde la solicitud · <span style="background:#E3F5E9;color:#166534;padding:0 5px;">0–2</span> <span style="background:#FFF4D6;color:#8A5A00;padding:0 5px;">3–4</span> <span style="background:#FDECEC;color:#B42318;padding:0 5px;">5+</span></p>`;
  return h;
}
async function posCopiarRico(){
  const D=posDatos(), html=posCorreoHTML(D);
  let ok=false;
  try{ if(navigator.clipboard&&window.ClipboardItem){ await navigator.clipboard.write([new ClipboardItem({'text/html':new Blob([html],{type:'text/html'}),'text/plain':new Blob([posTextoPlano(D)],{type:'text/plain'})})]); ok=true; } }catch(e){}
  if(!ok){
    const d=document.createElement('div'); d.contentEditable='true'; d.style.cssText='position:fixed;left:-9999px;top:0;'; d.innerHTML=html; document.body.appendChild(d);
    const rg=document.createRange(); rg.selectNodeContents(d); const sel=getSelection(); sel.removeAllRanges(); sel.addRange(rg);
    try{ ok=document.execCommand('copy'); }catch(e){} sel.removeAllRanges(); d.remove();
  }
  hubToast(ok?'Cuadro copiado con formato. Pégalo en el correo.':'No se pudo copiar.');
}
function roPreset(p){
  const h=dgHoy(); let a=new Date(h), b=new Date(h);
  if(p==='ayer'){ a.setDate(a.getDate()-1); b=new Date(a); }
  else if(p==='semana'){ const w=(h.getDay()+6)%7; a.setDate(a.getDate()-w); }
  else if(p==='semana_ant'){ const w=(h.getDay()+6)%7; a.setDate(a.getDate()-w-7); b=new Date(a); b.setDate(b.getDate()+6); }
  else if(p==='mes'){ a=new Date(h.getFullYear(),h.getMonth(),1); }
  else if(p==='mes_ant'){ a=new Date(h.getFullYear(),h.getMonth()-1,1); b=new Date(h.getFullYear(),h.getMonth(),0); }
  document.getElementById('ro-desde').value=roIso(a); document.getElementById('ro-hasta').value=roIso(b);
  document.querySelectorAll('#ro-presets button').forEach(x=>x.classList.toggle('on',x.dataset.p===p));
  roRender(true);
}
function roRender(keep){
  const de=document.getElementById('ro-desde'), ha=document.getElementById('ro-hasta'); if(!de) return;
  if(!de.value||!ha.value){ const h=dgHoy(); de.value=roIso(new Date(h.getFullYear(),h.getMonth(),1)); ha.value=roIso(h); }
  if(!keep) document.querySelectorAll('#ro-presets button').forEach(x=>x.classList.remove('on'));
  hubArch.cache=null;
  let a=roD(de.value), b=roD(ha.value); if(a>b){ const t=a; a=b; b=t; }
  const pais=document.getElementById('ro-pais').value;
  const {S,dias,R:RR,A:AA}=roSecciones(a,b,pais);
  roPanel(RR,AA,dias,a,b);
  const tit=`Resumen operativo ${roRangoL(a,b)}`;
  const sub=`${roPl(dias,'día')}${pais?' · destino '+roPaisL(pais):' · todos los destinos'} · generado ${new Date().toLocaleString('es-SV',{dateStyle:'medium',timeStyle:'short'})}`;
  document.getElementById('ro-doc').innerHTML=`<div class="ro-palabras">En palabras</div><h3 class="ro-tit">${dgEsc(tit.charAt(0).toUpperCase()+tit.slice(1))}</h3><div class="ro-sub">${dgEsc(sub)}</div>`+
    S.map(s=>`<section class="ro-sec"><h4><i>${s.ic}</i>${s.h}</h4>${s.t.map(x=>`<p>${x}</p>`).join('')}</section>`).join('');
  roTexto=tit+'\n'+sub+'\n\n'+S.map(s=>s.h.toUpperCase()+'\n'+s.t.map(x=>'• '+x.replace(/<[^>]+>/g,'')).join('\n')).join('\n\n');
}
function roCopiar(){
  const ok=()=>hubToast('Resumen copiado. Pégalo en un correo o WhatsApp.');
  if(navigator.clipboard&&navigator.clipboard.writeText) navigator.clipboard.writeText(roTexto).then(ok,()=>roCopiarViejo(ok)); else roCopiarViejo(ok);
}
function roCopiarViejo(ok){ const t=document.createElement('textarea'); t.value=roTexto; document.body.appendChild(t); t.select(); try{ document.execCommand('copy'); ok(); }catch(e){} t.remove(); }
function roImprimir(){
  const w=window.open('','_blank'); if(!w){ alert('El navegador bloqueó la ventana de impresión. Permite ventanas emergentes para este sitio.'); return; }
  w.document.open(); w.document.write(`<!doctype html><html lang="es"><head><meta charset="utf-8"><title>Resumen operativo</title><style>
*{-webkit-print-color-adjust:exact;print-color-adjust:exact;}body{margin:0;background:#E9EDF3;font-family:Arial,Helvetica,sans-serif;color:#14213A;}
.bar{position:sticky;top:0;display:flex;gap:8px;justify-content:center;padding:10px;background:#0E2D57;}.bar button{border:none;border-radius:999px;padding:8px 18px;font:700 12px Arial;cursor:pointer;background:#fff;color:#0E2D57;}.bar .p{background:#4A8FD6;color:#fff;}
.page{width:216mm;min-height:279mm;margin:14px auto;background:#fff;padding:16mm 18mm;}
.top{display:flex;justify-content:space-between;align-items:center;border-bottom:2px solid #0E2D57;padding-bottom:8px;margin-bottom:14px;}.top img{height:46px;}.top span{font-size:11px;color:#5B6B82;font-weight:700;letter-spacing:.06em;text-transform:uppercase;}
.ro-tit{font-size:19px;margin:0 0 3px;color:#0E2D57;}.ro-sub{font-size:11px;color:#5B6B82;margin-bottom:12px;}
.ro-sec{margin:0 0 14px;page-break-inside:avoid;}.ro-sec h4{font-size:12.5px;text-transform:uppercase;letter-spacing:.05em;color:#2E6CB5;margin:0 0 5px;border-bottom:1px solid #DCE3EC;padding-bottom:4px;}.ro-sec h4 i{font-style:normal;margin-right:6px;}
.ro-sec p{font-size:12.5px;line-height:1.6;margin:0 0 5px;}.ro-sec b{color:#0E2D57;}
.ro-pk{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin:0 0 12px;}.ro-pk div{border:1px solid #DCE3EC;border-radius:10px;padding:8px 10px;}.ro-pk span{display:block;font-size:10px;font-weight:700;color:#5B6B82;text-transform:uppercase;letter-spacing:.04em;}.ro-pk b{font-size:18px;color:#0E2D57;}.ro-pk b small{font-size:11px;margin-left:3px;color:#5B6B82;}.ro-pk em{font-style:normal;font-size:10.5px;color:#5B6B82;display:block;}
.ro-gr{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:0 0 16px;}.ro-gr figure{margin:0;border:1px solid #DCE3EC;border-radius:10px;padding:8px;}.ro-gr figcaption{font-size:10.5px;font-weight:700;color:#0E2D57;margin-bottom:4px;}.ro-gr img{width:100%;display:block;}
@page{size:letter;margin:12mm;}@media print{body{background:#fff;}.bar{display:none;}.page{margin:0;padding:0;width:auto;min-height:0;}}
</style></head><body><div class="bar"><button class="p" onclick="window.print()">Imprimir / Guardar PDF</button><button onclick="window.close()">Cerrar</button></div>
<div class="page"><div class="top"><img src="${OC_LOGO}" alt="Blue Logistics"><span>Operación Unilever · HUB UL</span></div>${roDocPrint()}</div></body></html>`);
  w.document.close();
}

// ---------- avisos ----------
function hubToast(msg, tipo){
  let t=document.getElementById('hub-toast');
  if(!t){ t=document.createElement('div'); t.id='hub-toast'; t.setAttribute('role','status'); document.body.appendChild(t); }
  t.className=tipo==='err'?'err':''; t.textContent=msg; t.hidden=false;
  clearTimeout(t._h); t._h=setTimeout(()=>{ t.hidden=true; }, 6000);
}

</script>
</body>
</html>
