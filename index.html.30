<script>

// ── Global error tracker ──
window.addEventListener('error', function(e){
  console.error('LINE:', e.lineno, 'COL:', e.colno, 'MSG:', e.message, 'FILE:', e.filename);
  if(e.error && e.error.stack) console.error('STACK:', e.error.stack);
});

// ============================================================
// GOOGLE SHEETS SYNC ENGINE
// ============================================================
const GS_URL = 'https://script.google.com/macros/s/AKfycbyGhO2yAtNYIaWI4NR5YUmrwVSD89yH11gjM4n1QyGWNxvrVf4DK_5ubfb5qD6kdGm1/exec';
const SHEETDB_URL = 'https://sheetdb.io/api/v1/iqr8u7hp7h8r7';

async function sheetdbSave(hoja, datos, campos){
  if(window.HUB_ONLINE) return true;
  try {
    if(!datos.length) return true;
    const filas = datos.map(r => {
      const obj = {};
      campos.forEach(k => { obj[k] = r[k]!==undefined ? String(r[k]) : ''; });
      return obj;
    });
    // Step 1: Insert new data first
    const insertResp = await fetch(SHEETDB_URL+'?sheet='+encodeURIComponent(hoja), {
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body: JSON.stringify({data: filas})
    });
    const insertResult = await insertResp.json();
    if(!insertResult.created) {
      console.error('sheetdbSave insert failed ['+hoja+']:', JSON.stringify(insertResult));
      return false;
    }
    // Step 2: Only delete old data if insert succeeded
    await fetch(SHEETDB_URL+'/all?sheet='+encodeURIComponent(hoja)+'&limit='+insertResult.created, {
      method:'DELETE',
      headers:{'Content-Type':'application/json'}
    });
    console.log('sheetdbSave ['+hoja+']: ok, created='+insertResult.created);
    return true;
  } catch(e){
    console.error('sheetdbSave error ['+hoja+']:', e);
    return false;
  }
}

async function sheetdbAppendRow(hoja, campos, r){
  if(window.HUB_ONLINE) return true;
  try {
    const obj = {};
    campos.forEach(k => { obj[k] = r[k]!==undefined ? String(r[k]) : ''; });
    const resp = await fetch(SHEETDB_URL+'?sheet='+encodeURIComponent(hoja), {
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body: JSON.stringify({data: [obj]})
    });
    const result = await resp.json();
    console.log('sheetdbAppend ['+hoja+']:', JSON.stringify(result));
    return true;
  } catch(e){
    console.error('sheetdbAppend error:', e);
    return false;
  }
}

// Indicator element
function gsSyncIndicator(estado){
  let el = document.getElementById('gs-sync-indicator');
  if(!el){
    el = document.createElement('div');
    el.id = 'gs-sync-indicator';
    el.style.cssText = 'position:fixed;bottom:16px;right:16px;z-index:9999;padding:6px 14px;border-radius:999px;font-size:11px;font-family:var(--mono);font-weight:600;display:flex;align-items:center;gap:6px;box-shadow:0 2px 8px rgba(0,0,0,.12);transition:all .3s;';
    document.body.appendChild(el);
  }
  const estados = {
    guardando: {bg:'#FEF3C7',color:'#92400E',dot:'#F59E0B',txt:'Guardando...'},
    guardado:  {bg:'#F0FDF4',color:'#15803D',dot:'#22C55E',txt:'✓ Guardado en la nube'},
    cargando:  {bg:'#EFF6FF',color:'#1D4ED8',dot:'#3B82F6',txt:'Cargando datos...'},
    error:     {bg:'#FEF2F2',color:'#991B1B',dot:'#EF4444',txt:'Error al sincronizar'},
    listo:     {bg:'#F0FDF4',color:'#15803D',dot:'#22C55E',txt:'✓ Sincronizado'}
  };
  const cfg = estados[estado] || estados.listo;
  el.style.background = cfg.bg;
  el.style.color = cfg.color;
  el.innerHTML = `<span style="width:7px;height:7px;border-radius:50%;background:${cfg.dot};display:inline-block;"></span>${cfg.txt}`;
  if(estado==='guardado'||estado==='listo'){
    setTimeout(()=>{ if(el) el.style.opacity='0'; setTimeout(()=>{ if(el) el.style.display='none'; },500); },3000);
  } else {
    el.style.opacity='1'; el.style.display='flex';
  }
}

// Serialize arrays to rows for Google Sheets
function gsSerialize(arr, campos){
  if(!arr.length) return [campos]; // just header
  const rows = [campos];
  arr.forEach(r => rows.push(campos.map(k => r[k]!==undefined ? String(r[k]) : '')));
  return rows;
}

// Deserialize rows from Google Sheets back to objects
function gsDeserialize(filas){
  if(!filas||filas.length<2) return [];
  const headers = filas[0];
  return filas.slice(1).map(row => {
    const obj = {};
    headers.forEach((h,i) => { obj[h] = row[i] || ''; });
    return obj;
  });
}

// Field definitions per sheet
const GS_CAMPOS = {
  Contenedores: ['mes','doc','cont','eta_pto','eta_blue','cant','peso','origen','estado','flete','bl','report_esa','rg','rc','fdesc','sv','hn','cr','ni','gt','pa','sv_bultos','sv_peso','hn_bultos','hn_peso','cr_bultos','cr_peso','ni_bultos','ni_peso','gt_bultos','gt_peso','pa_bultos','pa_peso','enviado','fechaEnvioNP','pedidos_json'],
  PedidosNoProgramados: ['fecha','doc','rc','rg','origen','pais','dest','pedido','ref','prio','pallets','peso','equipo','truckFill','proveedor','fsolicitud','fdescarga','notas','programado','equipoAsignado','ot','cajas','valor','fact_ul','bl_cp','flete'],
  PedidosDespacho: ['mes','ref','dt','no_pedido','dest','pallets','remolque','regimen','edif','cortina','fcarga','fsalida','status','peso','vol','equipo','fsolicitud','fromNP','fingreso','proveedor','ot','cajas','valor','fact_ul','bl_cp','flete','costos_json','costo_total'],
  HistorialDespachos: ['mes','ref','dt','no_pedido','dest','pallets','remolque','edif','cortina','fcarga','fsalida','fechaArchivo','peso','factura','gr','scan_id','fingreso','proveedor','ot','cajas','valor','fact_ul','bl_cp','flete','costos_json','costo_total'],
  HistorialContenedores: ['mes','doc','cont','eta_pto','eta_blue','cant','peso','origen','estado','flete','bl','rc','fdesc','fechaEnvioNP','sv','hn','cr','ni','gt','pa','sv_bultos','sv_peso','hn_bultos','hn_peso','cr_bultos','cr_peso','ni_bultos','ni_peso','gt_bultos','gt_peso','pa_bultos','pa_peso','pedidos_json']
};

// Save one sheet to Google Sheets
// Save a single row to a sheet (append if new, update if existing)
function gsSaveRow(hoja, fila, rowNum){
  if(window.HUB_ONLINE) return Promise.resolve(true);
  return new Promise((resolve)=>{
    try {
      // Sanitize values
      const filaClean = fila.map(v=>{
        if(v===null||v===undefined) return '';
        return String(v).replace(/[\u0000-\u001F]/g,' ').normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/[^\x00-\x7F]/g,'?');
      });
      const payload_obj = rowNum
        ? {accion:'update_row', hoja, fila:filaClean, row: rowNum}
        : {accion:'append', hoja, filas:[filaClean]};
      console.log('gsSaveRow attempting ['+hoja+'] row='+rowNum+' filaLen='+fila.length);
      const cbName = 'gsSaveRowCb_'+Date.now();
      const script = document.createElement('script');
      const json = JSON.stringify(payload_obj);
      // Properly encode UTF-8 to base64
      const payload = btoa(encodeURIComponent(json).replace(/%([0-9A-F]{2})/g, function(match, p1) {
        return String.fromCharCode(parseInt(p1, 16));
      }));
      console.log('gsSaveRow payload length:', payload.length);
      const timeout = setTimeout(()=>{
        delete window[cbName];
        try{if(script.parentNode)script.parentNode.removeChild(script);}catch(e){}
        console.warn('gsSaveRow timeout ['+hoja+']');
        resolve(false);
      }, 30000);
      window[cbName] = (data)=>{
        clearTimeout(timeout);
        delete window[cbName];
        try{if(script.parentNode)script.parentNode.removeChild(script);}catch(e){}
        console.log('gsSaveRow response ['+hoja+']:', JSON.stringify(data));
        resolve(data && data.ok);
      };
      script.src = GS_URL+'?action=save&payload='+encodeURIComponent(payload)+'&callback='+cbName;
      script.onerror = (err)=>{
        clearTimeout(timeout);
        delete window[cbName];
        console.error('gsSaveRow script error ['+hoja+']:', err);
        resolve(false);
      };
      document.body.appendChild(script);
    } catch(e){ console.error('gsSaveRow error:',e); resolve(false); }
  });
}

function gsDeleteRow(hoja, rowNum){
  return new Promise((resolve)=>{
    try {
      const cbName = 'gsDeleteRowCb_'+Date.now();
      const script = document.createElement('script');
      const json = JSON.stringify({accion:'delete_row', hoja, row: rowNum});
      const bytes = new TextEncoder().encode(json);
      let binary = '';
      bytes.forEach(b => binary += String.fromCharCode(b));
      const payload = btoa(binary);
      const timeout = setTimeout(()=>{ delete window[cbName]; resolve(false); }, 30000);
      window[cbName] = (data)=>{ clearTimeout(timeout); delete window[cbName]; resolve(data&&data.ok); };
      script.src = GS_URL+'?action=save&payload='+encodeURIComponent(payload)+'&callback='+cbName;
      script.onerror = ()=>{ clearTimeout(timeout); delete window[cbName]; resolve(false); };
      document.body.appendChild(script);
    } catch(e){ resolve(false); }
  });
}

function gsSave(hoja, datos, campos){
  if(window.HUB_ONLINE) return Promise.resolve(true);
  return new Promise((resolve)=>{
    try {
      const filas = gsSerialize(datos, campos);
      const cbName = 'gsSaveCb_'+hoja.replace(/[^a-z]/gi,'')+'_'+Date.now();
      const script = document.createElement('script');
      const json = JSON.stringify({accion:'guardar',hoja,filas});
      const payload = btoa(encodeURIComponent(json).replace(/%([0-9A-F]{2})/g, function(match, p1) {
        return String.fromCharCode(parseInt(p1, 16));
      }));
      const timeout = setTimeout(()=>{
        delete window[cbName];
        try{if(script.parentNode)script.parentNode.removeChild(script);}catch(e){}
        console.warn('gsSave timeout ['+hoja+']');
        resolve(false);
      }, 45000);
      window[cbName] = (data)=>{
        clearTimeout(timeout);
        delete window[cbName];
        try{if(script.parentNode)script.parentNode.removeChild(script);}catch(e){}
        console.log('gsSave response ['+hoja+']:', JSON.stringify(data));
        resolve(data && data.ok);
      };
      script.src = GS_URL+'?action=save&payload='+encodeURIComponent(payload)+'&callback='+cbName;
      script.onerror = (err)=>{
        clearTimeout(timeout);
        delete window[cbName];
        console.error('gsSave script error ['+hoja+']:', err);
        resolve(false);
      };
      document.body.appendChild(script);
    } catch(e){ console.error('gsSave error:',e); resolve(false); }
  });
}

// Load one sheet from Google Sheets via JSONP trick
function gsLoad(hoja){
  return new Promise((resolve)=>{
    const cbName = 'gsCallback_'+hoja+'_'+Date.now();
    const script = document.createElement('script');
    const timeout = setTimeout(()=>{
      delete window[cbName];
      try{if(script.parentNode)script.parentNode.removeChild(script);}catch(e){}
      console.warn('gsLoad timeout ['+hoja+']');
      resolve(null);
    }, 20000);
    window[cbName] = (data)=>{
      clearTimeout(timeout);
      delete window[cbName];
      try{ if(script.parentNode===document.body) document.body.removeChild(script); }catch(e){}
      const rows = data && data.filas ? gsDeserialize(data.filas) : null;
      console.log('gsLoad ['+hoja+']:', rows ? rows.length+' registros' : 'null');
      resolve(rows);
    };
    script.src = `${GS_URL}?hoja=${hoja}&callback=${cbName}`;
    script.onerror = ()=>{ 
      clearTimeout(timeout); 
      delete window[cbName]; 
      try{if(script.parentNode)script.parentNode.removeChild(script);}catch(e){}
      console.error('gsLoad script error ['+hoja+']');
      resolve(null); 
    };
    document.body.appendChild(script);
  });
}

