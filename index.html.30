      <div class="st"><span>Requisiciones</span><b id="rc-k-n">0</b></div>
      <div class="st"><span>Por pagar</span><b id="rc-k-pend">—</b></div>
      <div class="st"><span>Pagado este mes</span><b id="rc-k-mes">—</b></div>
      <div class="st"><span>Contenedores sin RC</span><b id="rc-k-sin">0</b></div>
    </div>
