<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>HUB UL — Blue Logistics</title>
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&family=Sora:wght@600;700;800&display=swap" rel="stylesheet">
<style>
:root {
  /* Paleta HUB UL — portal Blue Logistics (claro, esferas azules) */
  --sky:#7DB9EC; --blue-1:#4A8FD6; --blue-2:#2E6CB5; --blue-3:#1D4E8C; --deep:#0E2D57;
  --sphere:radial-gradient(circle at 32% 28%,#BFE0FA 0%,#6AAAE6 22%,#2E6CB5 62%,#14396B 100%);
  --sphere-deep:radial-gradient(circle at 32% 28%,#8FB8E6 0%,#3F78BE 25%,#1A467F 62%,#0B2447 100%);
  --bg:#EEF1F5; --surface:#FFFFFF; --surface-2:#F5F7FA;
  --border:#E3E8EF; --border-strong:#CDD5E0;
  --text:#14213A; --text-muted:#5D6B82; --text-hint:#8F9BB0;
  --accent:#2E6CB5; --accent-hover:#1D4E8C; --accent-light:#EAF2FC; --accent-text:#1D4E8C;
  --shadow-1:0 1px 2px rgba(20,33,58,.05);
  --shadow-2:0 2px 4px rgba(20,33,58,.04),0 10px 28px -10px rgba(20,33,58,.14);
  --shadow-3:0 4px 10px rgba(20,33,58,.06),0 18px 40px -14px rgba(20,33,58,.22);
  --display:'Sora','Manrope',system-ui,sans-serif;
  --mono:'JetBrains Mono',ui-monospace,monospace; --sans:'Manrope',system-ui,sans-serif;
}
*{box-sizing:border-box;margin:0;padding:0;}
body{background:var(--bg);font-family:var(--sans);color:var(--text);min-height:100vh;}

.header{background:var(--text);color:#F7F6F2;padding:1.25rem 2rem;display:flex;align-items:center;justify-content:space-between;gap:1rem;flex-wrap:wrap;}
.header-left{display:flex;align-items:center;gap:14px;}
.dot-live{width:9px;height:9px;border-radius:50%;background:#4ADE80;animation:pulse 2s infinite;flex-shrink:0;}
@keyframes pulse{0%,100%{opacity:1;}50%{opacity:.4;}}
.header-title{font-size:17px;font-weight:600;letter-spacing:.02em;}
.header-sub{font-size:12px;color:#A8A59C;font-family:var(--mono);margin-top:2px;}
.header-actions{display:flex;gap:8px;align-items:center;}

.btn{display:inline-flex;align-items:center;gap:6px;height:34px;padding:0 14px;font-size:12px;font-family:var(--sans);font-weight:500;border-radius:6px;border:1px solid var(--border-strong);background:var(--surface);color:var(--text);cursor:pointer;transition:background .15s,transform .1s;white-space:nowrap;}
.btn:hover{background:var(--bg);}
.btn:active{transform:scale(.98);}
.btn-accent{background:var(--accent);color:#fff;border-color:var(--accent);}
.btn-accent:hover{background:#0F3D26;}
.btn-ghost{background:transparent;border-color:rgba(247,246,242,.25);color:#F7F6F2;}
.btn-ghost:hover{background:rgba(255,255,255,.08);}
.btn-sm{height:28px;padding:0 10px;font-size:11px;}
.btn-danger{background:#FEE2E2;color:#991B1B;border-color:#FECACA;}
.btn-danger:hover{background:#FECACA;}
.btn-promote{background:#EEF2FF;color:#3730A3;border-color:#C7D2FE;font-weight:600;}
.btn-promote:hover{background:#C7D2FE;}

/* SIDEBAR */
.layout{display:flex;align-items:stretch;min-height:calc(100vh - 130px);}
.sidebar{width:240px;flex-shrink:0;background:var(--surface);border-right:1px solid var(--border);padding:1.25rem 0;overflow-y:auto;}
.sidebar-title{font-size:10px;text-transform:uppercase;color:var(--text-hint);letter-spacing:.1em;padding:0 1.25rem;margin-bottom:.85rem;font-weight:600;}
.op-group{margin-bottom:.25rem;}
.op-header{width:100%;display:flex;align-items:center;gap:10px;padding:11px 1.25rem;background:transparent;border:none;cursor:pointer;font-family:var(--sans);font-size:13px;font-weight:600;color:var(--text);text-align:left;transition:background .15s;}
.op-header:hover{background:var(--bg);}
.op-chevron{font-size:9px;color:var(--text-muted);transition:transform .2s;display:inline-block;width:10px;}
.op-group.collapsed .op-chevron{transform:rotate(-90deg);}
.op-group.collapsed .op-children{display:none;}
.op-icon{display:inline-flex;align-items:center;justify-content:center;width:22px;height:22px;border-radius:5px;background:var(--accent-light);color:var(--accent-text);font-size:11px;font-weight:700;flex-shrink:0;}
.op-children{display:flex;flex-direction:column;padding:.25rem 0;}
.op-tab{display:flex;align-items:center;justify-content:space-between;gap:8px;padding:8px 1.25rem 8px 3rem;background:transparent;border:none;border-left:2px solid transparent;cursor:pointer;font-family:var(--sans);font-size:13px;color:var(--text-muted);text-align:left;transition:all .15s;width:100%;}
.op-tab:hover{color:var(--text);background:var(--bg);}
.op-tab.active{color:var(--accent);background:var(--accent-light);border-left-color:var(--accent);font-weight:600;}
.tab-badge{display:inline-flex;align-items:center;justify-content:center;min-width:18px;height:18px;border-radius:999px;font-size:10px;font-weight:600;padding:0 5px;background:#E0F2FE;color:#0369A1;}
.tab-badge.gray{background:#E2E0D8;color:#6B6960;}
.tab-badge.red{background:#FEE2E2;color:#991B1B;}
.content-col{flex:1;min-width:0;display:flex;flex-direction:column;}

.import-bar{background:var(--surface);border-bottom:1px solid var(--border);padding:.5rem 1.5rem;display:flex;align-items:center;gap:10px;flex-wrap:wrap;}
.import-bar-label{font-size:11px;color:var(--text-hint);font-family:var(--mono);letter-spacing:.04em;text-transform:uppercase;white-space:nowrap;}
#csv-input{display:none;}
.drop-zone{display:inline-flex;align-items:center;gap:5px;border:1px solid var(--border-strong);border-radius:6px;padding:4px 10px;font-size:11px;color:var(--text-muted);cursor:pointer;transition:all .15s;font-family:var(--mono);background:var(--bg);white-space:nowrap;}
.drop-zone:hover{background:var(--accent-light);color:var(--accent-text);border-color:#6FAA88;}
.drop-zone.dragover{background:var(--accent-light);border-color:var(--accent);}
.import-divider{width:1px;height:16px;background:var(--border);flex-shrink:0;}
#file-name{font-size:11px;color:var(--accent-text);font-family:var(--mono);}

.main{padding:1.5rem 2rem;}
.tab-content{display:none;}
.tab-content.active{display:block;}

.how-to{background:var(--surface);border:1px solid var(--border);border-radius:10px;padding:1rem 1.25rem;margin-bottom:1.5rem;display:flex;align-items:center;gap:16px;flex-wrap:wrap;}
.how-to-step{display:flex;align-items:center;gap:8px;font-size:12px;color:var(--text-muted);}
.how-to-step .num{width:22px;height:22px;border-radius:50%;background:var(--text);color:var(--bg);font-size:11px;font-weight:700;display:flex;align-items:center;justify-content:center;flex-shrink:0;}
.how-to-arrow{color:var(--border-strong);font-size:16px;}

.metrics{display:grid;grid-template-columns:repeat(auto-fit,minmax(120px,1fr));gap:10px;margin-bottom:1.5rem;}
.metric{background:var(--surface);border:1px solid var(--border);border-radius:10px;padding:12px 14px;}
.metric-label{font-size:11px;color:var(--text-hint);text-transform:uppercase;letter-spacing:.06em;margin-bottom:6px;}
.metric-value{font-size:22px;font-weight:700;color:var(--text);line-height:1;}
.metric-sub{font-size:11px;color:var(--text-muted);margin-top:4px;font-family:var(--mono);}

/* STATUS BADGES */
.badge{display:inline-flex;align-items:center;gap:4px;padding:3px 9px;border-radius:999px;font-size:11px;font-weight:500;white-space:nowrap;}
.badge::before{content:'';width:5px;height:5px;border-radius:50%;flex-shrink:0;}
.s-noprog    {background:#EEF2FF;color:#3730A3;} .s-noprog::before    {background:#6366F1;}
.s-prog      {background:#EFF6FF;color:#1D4ED8;} .s-prog::before      {background:#3B82F6;}
.s-enproceso {background:#FFF7ED;color:#C2410C;} .s-enproceso::before {background:#F97316;}
.s-cargado   {background:#F0FDF4;color:#15803D;} .s-cargado::before   {background:#22C55E;}
.s-despachado{background:#F0F9FF;color:#0369A1;} .s-despachado::before{background:#0EA5E9;}
.s-prio-alta  {background:#FEF3C7;color:#92400E;} .s-prio-alta::before  {background:#F59E0B;}
.s-prio-urg   {background:#FEE2E2;color:#991B1B;} .s-prio-urg::before   {background:#EF4444;}

.filters{display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin-bottom:1rem;}
.filters select,.filters input{height:34px;padding:0 10px;font-size:13px;font-family:var(--sans);border:1px solid var(--border-strong);border-radius:6px;background:var(--surface);color:var(--text);}
.filters input{width:200px;}
.filter-label{font-size:12px;color:var(--text-muted);}

.table-card{background:var(--surface);border:1px solid var(--border);border-radius:12px;overflow:visible;}
.table-header{display:flex;align-items:center;justify-content:space-between;padding:.85rem 1.25rem;border-bottom:1px solid var(--border);gap:8px;flex-wrap:wrap;}
.table-title{font-size:13px;font-weight:600;}
.table-count{font-size:12px;color:var(--text-muted);font-family:var(--mono);}
.table-wrap{overflow-x:scroll;scrollbar-width:auto;scrollbar-color:#94A3B8 #F1F5F9;border-radius:0 0 12px 12px;}
.table-wrap::-webkit-scrollbar{height:10px;display:block;}
.table-wrap::-webkit-scrollbar-track{background:#F1F5F9;border-radius:999px;margin:0 4px;}
.table-wrap::-webkit-scrollbar-thumb{background:#94A3B8;border-radius:999px;border:2px solid #F1F5F9;}
.table-wrap::-webkit-scrollbar-thumb:hover{background:#64748B;}
table{width:100%;border-collapse:collapse;font-size:13px;}
thead th{background:var(--bg);padding:9px 12px;text-align:left;font-size:11px;font-weight:600;color:var(--text-muted);text-transform:uppercase;letter-spacing:.05em;border-bottom:1px solid var(--border);white-space:nowrap;}
thead th.num{text-align:right;}
tbody tr{border-bottom:1px solid var(--border);transition:background .1s;}
tbody tr:last-child{border-bottom:none;}
tbody tr:hover{background:var(--bg);}
tbody td{padding:9px 12px;color:var(--text);white-space:nowrap;}
tbody td.num{text-align:right;font-family:var(--mono);font-size:12px;}
tbody td.mono{font-family:var(--mono);font-size:11px;color:var(--text-muted);}
.dest-cr{color:#185FA5;font-weight:600;} .dest-ni{color:#3B6D11;font-weight:600;} .dest-gt{color:#854F0B;font-weight:600;}
.dest-hn{color:#7A1F5A;font-weight:600;} .dest-pa{color:#0F6E56;font-weight:600;} .dest-sv{color:#A32D2D;font-weight:600;}
.edit-btn{font-size:11px;color:var(--text-hint);background:none;border:1px solid var(--border);border-radius:4px;padding:2px 8px;cursor:pointer;font-family:var(--sans);transition:all .15s;}
.edit-btn:hover{background:var(--accent-light);color:var(--accent-text);border-color:#B8D9C6;}
.btn-enviar{font-size:11px;color:#92400E;background:#FEF3C7;border:1px solid #FDE68A;border-radius:4px;padding:3px 9px;cursor:pointer;font-family:var(--sans);font-weight:600;transition:all .15s;white-space:nowrap;}
.btn-enviar:hover{background:#FDE68A;color:#78350F;}
.btn-enviar:disabled{background:#F3F4F6;color:#9CA3AF;border-color:#E5E7EB;cursor:not-allowed;}
.row-enviado{opacity:.45;background:#F9FAFB;}
.row-enviado select{pointer-events:none;background:#F3F4F6 !important;}
.badge-enviado{display:inline-flex;align-items:center;gap:3px;background:#DCFCE7;color:#166534;font-size:10px;font-weight:700;padding:2px 7px;border-radius:999px;margin-left:6px;letter-spacing:.02em;}
.pais-tag{display:inline-block;font-family:var(--mono);font-size:10px;font-weight:700;padding:2px 6px;border-radius:4px;letter-spacing:.04em;}
.pais-sv{background:#FEE2E2;color:#A32D2D;} .pais-hn{background:#FCE7F3;color:#7A1F5A;}
.pais-cr{background:#DBEAFE;color:#185FA5;} .pais-ni{background:#DCFCE7;color:#3B6D11;}
.pais-gt{background:#FEF3C7;color:#854F0B;} .pais-pa{background:#D1FAE5;color:#0F6E56;}
.empty{padding:3rem;text-align:center;color:var(--text-hint);font-size:14px;}
.empty strong{display:block;font-size:16px;color:var(--text-muted);margin-bottom:6px;}

.np-info{background:#EEF2FF;border:1px solid #C7D2FE;border-radius:10px;padding:1rem 1.25rem;margin-bottom:1.25rem;font-size:13px;color:#3730A3;display:flex;align-items:flex-start;gap:10px;}

.modal-bg{display:none;position:fixed;inset:0;background:rgba(26,25,23,.5);z-index:200;align-items:center;justify-content:center;padding:1rem;}
.modal-bg.open{display:flex;}
.modal{background:var(--surface);border-radius:14px;border:1px solid var(--border);padding:1.75rem;width:620px;max-width:100%;max-height:90vh;overflow-y:auto;}
.modal h3{font-size:16px;font-weight:600;margin-bottom:1.25rem;}
.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;}
.form-group{display:flex;flex-direction:column;gap:5px;}
.form-group label{font-size:11px;font-weight:600;color:var(--text-muted);text-transform:uppercase;letter-spacing:.05em;}
.form-group input,.form-group select,.form-group textarea{font-size:13px;font-family:var(--sans);border:1px solid var(--border-strong);border-radius:6px;background:var(--surface);color:var(--text);padding:0 10px;height:36px;}
.form-group textarea{height:72px;padding:8px 10px;resize:vertical;}
.form-group input:focus,.form-group select:focus{outline:2px solid var(--accent);outline-offset:1px;}
.modal-footer{display:flex;gap:8px;justify-content:flex-end;margin-top:1.5rem;border-top:1px solid var(--border);padding-top:1.25rem;}

.footer{padding:1rem 2rem;font-size:11px;color:var(--text-hint);font-family:var(--mono);border-top:1px solid var(--border);background:var(--surface);display:flex;justify-content:space-between;flex-wrap:wrap;gap:8px;}

/* =====================================================================
   TEMA HUB UL — mismo lenguaje del portal Blue Logistics
   Claro, tarjetas píldora con sombra difusa, esferas azul celeste→marino
   ===================================================================== */
html{background:#EEF1F5;}
body{background:#EEF1F5;font-feature-settings:"tnum" 1;-webkit-font-smoothing:antialiased;}
::selection{background:#CFE3F8;}

/* Header */
.header{background:rgba(255,255,255,.86);backdrop-filter:blur(10px);color:var(--text);height:72px;padding:0 1.75rem 0 0;border-bottom:1px solid var(--border);flex-wrap:nowrap;position:sticky;top:0;z-index:100;}
.header-left{gap:0;height:100%;}
.brand{display:flex;align-items:center;gap:12px;width:256px;padding-left:1.5rem;height:100%;flex-shrink:0;}
.brand-mark{width:42px;height:42px;border-radius:50%;background:var(--sphere-deep);display:flex;align-items:center;justify-content:center;
  font-family:var(--display);font-weight:800;font-size:14px;color:#fff;box-shadow:0 6px 14px -4px rgba(14,45,87,.5),inset 0 -3px 6px rgba(0,0,0,.18);}
.brand-name{font-family:var(--display);font-weight:700;font-size:14px;color:var(--text);line-height:1.2;}
.brand-name small{display:block;font-family:var(--sans);font-weight:500;font-size:11.5px;color:var(--text-hint);}
.header-titles{padding-left:1.25rem;border-left:1px solid var(--border);height:40px;display:flex;flex-direction:column;justify-content:center;}
.header-title{font-family:var(--display);font-size:18px;font-weight:800;letter-spacing:-.02em;color:var(--text);}
.header-sub{font-family:var(--sans);font-size:12px;font-weight:500;color:var(--text-hint);margin-top:1px;}
#edif-reloj-header{color:var(--text-muted)!important;font-weight:600;padding:0 14px;height:36px;border-radius:999px;background:var(--surface);box-shadow:var(--shadow-2);}
#edif-reloj-header > div{background:#22C55E!important;box-shadow:0 0 0 3px rgba(34,197,94,.18);}
.btn-ghost{background:var(--surface);border:none;color:var(--text)!important;border-radius:999px!important;height:36px!important;padding:0 16px!important;box-shadow:var(--shadow-2);}
.btn-ghost:hover{background:var(--accent-light);}

/* Sidebar */
.layout{min-height:calc(100vh - 72px - 44px);}
.sidebar{width:256px;background:transparent;border-right:none;padding:1.25rem .9rem 1.5rem 1rem;}
.sidebar-title{text-transform:none;letter-spacing:0;font-size:12px;font-weight:600;color:var(--text-hint);padding:0 .6rem;}
.op-group{margin-bottom:.5rem;}
.op-header{color:var(--text);font-family:var(--display);font-size:13.5px;font-weight:700;padding:10px .6rem;border-radius:14px;}
.op-header:hover{background:rgba(255,255,255,.7);}
.op-chevron{color:var(--text-hint);}
.op-icon{width:30px;height:30px;border-radius:50%;background:var(--sphere);color:#fff;font-family:var(--display);font-weight:800;font-size:12px;
  box-shadow:0 4px 10px -3px rgba(46,108,181,.55),inset 0 -2px 4px rgba(0,0,0,.15);}
.op-children{gap:4px;padding:.4rem 0 .2rem;}
.op-tab{color:var(--text-muted);font-size:13px;font-weight:600;padding:10px 12px 10px 1.15rem;border-left:none;border-radius:999px;margin-left:.6rem;width:calc(100% - .6rem);}
.op-tab:hover{color:var(--text);background:rgba(255,255,255,.75);}
.op-tab.active{color:var(--text);background:var(--surface);font-weight:700;box-shadow:var(--shadow-2);}
.op-tab.active::before{content:"";width:8px;height:8px;border-radius:50%;background:var(--sphere);margin-right:-2px;flex-shrink:0;box-shadow:0 0 0 3px #EAF2FC;}
.tab-badge{background:var(--surface-2);color:var(--text-muted);font-family:var(--sans);font-weight:700;min-width:24px;height:22px;border-radius:999px;}
.tab-badge.gray{background:var(--surface-2);color:var(--text-hint);}
.tab-badge.red{background:#FDECEC;color:#C0362C;}
.op-tab.active .tab-badge:not(.red){background:var(--accent);color:#fff;}

/* Barra de datos */
.import-bar{background:transparent;border-bottom:none;padding:1rem 2rem 0;}
.import-bar-label{text-transform:none;letter-spacing:0;font-family:var(--sans);font-weight:600;color:var(--text-hint);}
.import-divider{background:var(--border-strong);}
.drop-zone{background:var(--surface);border:none;border-radius:999px;font-family:var(--sans);font-weight:600;color:var(--text-muted);padding:6px 14px;box-shadow:var(--shadow-1);}
.drop-zone:hover{background:var(--accent-light);color:var(--accent-text);}

/* Contenido */
.main{padding:1.25rem 2rem 2.5rem;}

/* Botones */
.btn{height:38px;border-radius:999px;font-weight:700;font-size:12.5px;padding:0 18px;border:none;background:var(--surface);box-shadow:var(--shadow-2);}
.btn:hover{background:var(--accent-light);}
.btn-accent{background:linear-gradient(135deg,#4A8FD6 0%,#2E6CB5 55%,#1D4E8C 100%);color:#fff;box-shadow:0 6px 16px -6px rgba(29,78,140,.6),inset 0 -2px 0 rgba(0,0,0,.12);}
.btn-accent:hover{background:linear-gradient(135deg,#3F82CB 0%,#245DA0 55%,#163F74 100%);}
.btn-danger{background:#FDECEC;color:#B42318;}
.btn-sm{height:32px;padding:0 14px;}

/* KPIs: tarjetas píldora */
.metrics{gap:14px;}
.metric{border:none;border-radius:20px;padding:16px 18px;box-shadow:var(--shadow-2);background:var(--surface);}
.metric-label{text-transform:none;letter-spacing:0;font-size:12.5px;font-weight:600;color:var(--text-muted);margin-bottom:8px;}
.metric-value{font-family:var(--display);font-size:30px;font-weight:800;letter-spacing:-.03em;}
.metric-sub{font-family:var(--sans);font-size:11.5px;color:var(--text-hint);margin-top:6px;}

/* Filtros */
.filters select,.filters input{height:40px;border-radius:999px;border:1px solid transparent;padding:0 16px;font-size:13px;font-weight:600;color:var(--text);background-color:var(--surface);box-shadow:var(--shadow-2);}
.filters select:focus,.filters input:focus{outline:none;border-color:var(--blue-1);box-shadow:0 0 0 4px rgba(74,143,214,.18);}
.filter-label{font-weight:600;color:var(--text-muted);}

/* Tablas */
.table-card{border:none;border-radius:22px;box-shadow:var(--shadow-3);background:var(--surface);}
.table-header{padding:1.1rem 1.5rem;border-bottom:1px solid var(--border);}
.table-title{font-family:var(--display);font-size:16px;font-weight:700;letter-spacing:-.015em;}
.table-count{font-family:var(--sans);font-weight:600;color:var(--text-hint);}
thead th{background:var(--surface-2);color:var(--text-muted);text-transform:none;letter-spacing:0;font-size:12px;font-weight:700;padding:12px 14px;border-bottom:1px solid var(--border);}
tbody tr{border-bottom:1px solid #EEF1F5;}
tbody tr:hover{background:#F6FAFE;}
tbody td{padding:12px 14px;}
.table-wrap{border-radius:0 0 22px 22px;scrollbar-color:var(--border-strong) transparent;}
.table-wrap::-webkit-scrollbar-track{background:transparent;}
.table-wrap::-webkit-scrollbar-thumb{background:var(--border-strong);border-color:var(--surface);}
.edit-btn{border-radius:999px;color:var(--text-muted);border:1px solid var(--border-strong);font-weight:700;padding:4px 12px;background:var(--surface);}
.edit-btn:hover{background:var(--accent-light);color:var(--accent-text);border-color:#BFD6F0;}
.btn-enviar{border-radius:999px;padding:5px 13px;background:linear-gradient(135deg,#4A8FD6,#1D4E8C);color:#fff;border:none;box-shadow:0 4px 10px -4px rgba(29,78,140,.6);}
.btn-enviar:hover{background:linear-gradient(135deg,#3F82CB,#163F74);color:#fff;}
.btn-enviar:disabled{background:var(--surface-2);color:var(--text-hint);box-shadow:none;}
.row-enviado{opacity:.5;background:var(--surface-2);}
.pos-head{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:10px;}.pos-head h3{margin:0;}
.pos-nav{display:flex;align-items:center;gap:8px;font-weight:700;font-size:13px;color:var(--text-muted);}

.vhn-chip{display:inline-block;margin-top:5px;border:1px solid #CFE0F3;background:#EEF5FD;color:#1D4E8C;border-radius:999px;font:inherit;font-size:11px;font-weight:800;padding:3px 10px;cursor:pointer;white-space:nowrap;}
.vhn-chip.e{background:#FFF4D6;border-color:#F3D98B;color:#8A5A00;}
.vhn-chip.a{background:#E3F5E9;border-color:#A7DDB8;color:#166534;}
.vhn-chip.r{background:#FDECEC;border-color:#F5B5B5;color:#A4251B;}
#modal-vhn h3{display:flex;align-items:center;gap:10px;flex-wrap:wrap;}
.vhn-ref{font-family:var(--mono);font-size:15px;color:var(--accent-text);}
.vhn-est{font-size:11px;font-weight:800;border-radius:999px;padding:3px 10px;background:#EEF1F5;color:#4A5A72;}
.vhn-est.e{background:#FFF4D6;color:#8A5A00;}.vhn-est.a{background:#E3F5E9;color:#166534;}.vhn-est.r{background:#FDECEC;color:#A4251B;}
.vhn-sub{font-size:12.5px;color:var(--text-muted);margin:-4px 0 14px;}
.vhn-grid{display:grid;grid-template-columns:1.15fr 1fr;gap:18px;}
.vhn-row2{display:grid;grid-template-columns:1fr 1fr;gap:10px;}
.vhn-row3{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:8px;}
.vhn-in .form-group label a{font-size:11px;margin-left:6px;}
.vhn-fl{margin-top:4px;}
.vhn-fl>label{display:block;font-size:12px;font-weight:700;color:var(--text-muted);margin-bottom:6px;}
.vhn-fl>label small{display:block;font-weight:500;color:var(--text-hint);font-size:11px;}
.vhn-fl-r{display:grid;grid-template-columns:1fr 130px 28px;gap:6px;margin-bottom:6px;}
.vhn-fl-r input{padding:8px 10px;border-radius:10px;border:1px solid var(--border);background:var(--surface-2);font:inherit;font-size:13px;}
.vhn-fl-r input.num{text-align:right;font-family:var(--mono);}
.vhn-fl-r button{border:none;background:transparent;color:var(--text-hint);font-size:18px;cursor:pointer;}
.vhn-add{border:1px dashed var(--border);background:transparent;border-radius:10px;padding:6px 12px;font:inherit;font-size:12px;font-weight:700;color:var(--accent-text);cursor:pointer;}
.vhn-par{margin-top:12px;font-size:12.5px;}
.vhn-par summary{cursor:pointer;color:var(--text-muted);font-weight:700;}
.vhn-res{background:var(--surface-2);border-radius:16px;padding:12px 14px;}
.vhn-res table{width:100%;border-collapse:collapse;font-size:13px;}
.vhn-res td{padding:5px 4px;border-bottom:1px solid var(--border);}
.vhn-res td small{display:block;font-size:10.5px;color:var(--text-hint);}
.vhn-res td.num{text-align:right;font-family:var(--mono);white-space:nowrap;}
.vhn-res tr.sub td{font-weight:700;}
.vhn-res tr.big td{font-weight:800;font-size:14.5px;color:#0E2D57;border-bottom:2px solid #0E2D57;}
.vhn-log{font-size:12px;color:#166534;background:#E3F5E9;border-radius:10px;padding:7px 12px;margin:12px 0 0;}
.vhn-log.r{color:#A4251B;background:#FDECEC;}
.vhn-rech{color:#A4251B !important;}
body.rol-hn .op-tab:not([data-tab="tramites"]){display:none !important;}
@media (max-width:820px){ .vhn-grid,.vhn-row2{grid-template-columns:1fr;} }
.bp-form{display:flex;gap:10px;margin-bottom:18px;max-width:640px;}
.bp-form input{flex:1;font-size:16px;padding:12px 16px;border-radius:14px;border:1px solid var(--border);background:var(--surface);font-family:var(--mono);}
.bp-vacio{background:var(--surface);border-radius:18px;padding:22px;box-shadow:var(--shadow-1);display:flex;flex-direction:column;gap:6px;color:var(--text-muted);font-size:14px;}
.bp-vacio b{color:var(--text);}
.bp-head{display:flex;justify-content:space-between;align-items:flex-end;flex-wrap:wrap;gap:14px;background:radial-gradient(120% 140% at 0% 0%,#3F78BE 0%,#1D4E8C 45%,#0E2D57 100%);color:#fff;border-radius:22px;padding:20px 24px;margin-bottom:14px;box-shadow:0 14px 30px -14px rgba(14,45,87,.7);}
.bp-k{font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:#BFD6F0;}
.bp-ped{font-family:var(--display);font-size:32px;font-weight:800;letter-spacing:-.03em;line-height:1.1;}
.bp-sub{font-size:13px;color:#DCE8F7;margin-top:4px;font-family:var(--mono);display:flex;align-items:center;gap:6px;}
.bp-dot{display:inline-block;width:9px;height:9px;border-radius:50%;background:var(--c);}
.bp-chips{display:flex;gap:8px;flex-wrap:wrap;}
.bp-chip{background:rgba(255,255,255,.15);border-radius:999px;padding:6px 12px;font-size:12.5px;font-weight:700;}
.bp-chip.bp-money{background:#fff;color:#0E2D57;font-size:14px;}
.bp-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;}
.bp-card{background:var(--surface);border-radius:20px;padding:18px 20px;box-shadow:var(--shadow-2);min-width:0;}
.bp-card.bp-fac{grid-column:1/-1;}
.bp-card h4{display:flex;align-items:center;gap:8px;font-family:var(--display);font-size:15px;margin:0 0 12px;}
.bp-card h4 i{font-style:normal;width:22px;height:22px;border-radius:50%;background:var(--accent-light);color:var(--accent-text);display:inline-flex;align-items:center;justify-content:center;font-size:12px;}
.bp-card h4 small{font-family:inherit;font-size:11.5px;font-weight:600;color:var(--text-hint);}
.bp-rows{display:grid;grid-template-columns:1fr 1fr;gap:10px 18px;}
.bp-rows div{display:flex;flex-direction:column;gap:2px;min-width:0;}
.bp-rows span{font-size:11.5px;color:var(--text-hint);font-weight:600;}
.bp-rows b{font-size:14px;color:var(--text);overflow-wrap:anywhere;}
.bp-src{font-size:11px;color:var(--text-hint);margin:12px 0 0;}
.bp-na{color:var(--text-hint);font-size:13.5px;margin:0;}
.bp-t{width:100%;border-collapse:collapse;font-size:13px;}
.bp-t th{font-size:11.5px;color:var(--text-muted);text-align:left;padding:7px 8px;border-bottom:1px solid var(--border);}
.bp-t td{padding:8px;border-bottom:1px solid var(--border);}
.bp-t .num{text-align:right;font-variant-numeric:tabular-nums;}
.bp-t tfoot td{font-weight:800;border-top:2px solid #0E2D57;border-bottom:none;background:var(--accent-light);}
.bp-t small{font-size:10.5px;color:#92400E;background:#FEF3C7;border-radius:4px;padding:0 5px;margin-left:4px;}
.bp-cats{display:flex;flex-wrap:wrap;gap:6px;margin-top:12px;}
.bp-t th small.bp-th{display:block;background:none;padding:0;border-radius:0;font-size:9.5px;font-weight:500;color:var(--text-hint);text-transform:none;letter-spacing:0;max-width:130px;margin-left:auto;}
.bp-nd{color:var(--text-hint);}
.bp-cats span{font-size:12px;background:var(--surface-2);border-radius:999px;padding:4px 10px;color:var(--text-muted);}
.bp-cats b{color:var(--text);margin-left:4px;}
@media (max-width:820px){ .bp-grid{grid-template-columns:1fr;} .bp-rows{grid-template-columns:1fr;} }

#modal-arch p{font-size:13.5px;color:var(--text-muted);line-height:1.55;margin:0 0 12px;}
#modal-arch .arch-ya{background:var(--accent-light);color:var(--accent-text);border-radius:10px;padding:8px 12px;}
#modal-arch .arch-file{font-family:var(--mono);font-size:12px;}
#modal-arch .arch-nota{font-size:12px;color:var(--text-hint);margin-top:10px;}
.arch-t .arch-sub{display:block;font-size:10.5px;color:var(--text-hint);margin:1px 0 0;}
.arch-t{width:100%;border-collapse:collapse;font-size:13px;}
.arch-t th{font-size:11.5px;color:var(--text-muted);font-weight:700;text-align:left;padding:8px;border-bottom:1px solid var(--border);}
.arch-t td{padding:9px 8px;border-bottom:1px solid var(--border);}
.arch-t .num{text-align:right;font-variant-numeric:tabular-nums;}
.arch-t tr.arch-off td{color:var(--text-hint);}
.arch-t small{font-size:11px;margin-left:6px;}

.pal-cj{display:block;font-size:10.5px;font-weight:600;color:var(--text-hint);font-family:var(--mono);}
.np-granel-pend{display:inline-block;white-space:nowrap;font-size:11px;font-weight:700;color:#92400E;background:#FEF3C7;border-radius:999px;padding:2px 8px;}
.np-granel-tag{font-size:10px;font-weight:700;color:#92400E;background:#FEF3C7;border-radius:4px;padding:1px 6px;margin-left:4px;}

#modal-np .np-sub{display:flex;flex-wrap:wrap;align-items:center;gap:4px 8px;margin:-6px 0 16px;padding:9px 12px;background:var(--surface-2,#F3F6FA);border-radius:12px;font-size:12.5px;color:var(--text-muted);font-family:var(--mono);}
#modal-np .np-sub b{color:var(--text);font-weight:800;}
#modal-np .np-sub i{font-style:normal;color:var(--text-hint);}

/* ── Ingreso: separación sutil por BL ── */
#cont-tbody tr.bl-row.bl-b > td{background-color:#F4F7FB;}
#cont-tbody tr.bl-row.bl-first > td{border-top:2px solid #C9D6E6;}
#cont-tbody tr.bl-row:first-child > td{border-top:none;}
#cont-tbody tr.bl-row > td:first-child{box-shadow:inset 3px 0 0 #9DBBE0;}
#cont-tbody tr.bl-row.bl-b > td:first-child{box-shadow:inset 3px 0 0 #1D4E8C;}
#cont-tbody tr.bl-row:not(.bl-first) td.bl-doc{color:var(--text-hint);opacity:.55;}
#cont-tbody tr.bl-row.bl-first td.bl-doc{color:var(--text);font-weight:700;}
.bl-n{display:inline-block;margin-left:6px;font-family:var(--sans,inherit);font-size:10.5px;font-weight:700;color:#1D4E8C;background:#E6EFFA;border-radius:999px;padding:0 7px;line-height:17px;vertical-align:1px;}

.empty strong{color:var(--text);font-family:var(--display);font-weight:700;}

/* Badges */
.badge{font-weight:700;padding:4px 11px;}
.pais-tag{border-radius:999px;padding:3px 9px;}

/* Avisos / guía */
.np-info,.how-to{border:none!important;border-radius:20px!important;box-shadow:var(--shadow-2);}

/* Modales */
.modal-bg{background:rgba(20,33,58,.42);backdrop-filter:blur(4px);}
.modal{border:none;border-radius:24px;box-shadow:0 30px 70px -20px rgba(14,45,87,.45);padding:1.9rem 2rem;}
.modal h3{font-family:var(--display);font-size:20px;font-weight:800;letter-spacing:-.02em;}
.form-group label{text-transform:none;letter-spacing:0;font-size:12px;font-weight:700;color:var(--text-muted);}
.form-group input,.form-group select,.form-group textarea{height:42px;border-radius:12px;border:1px solid var(--border);background:var(--surface-2);font-weight:600;padding:0 12px;}
.form-group textarea{height:76px;padding:10px 12px;}
.form-group input:focus,.form-group select:focus,.form-group textarea:focus{outline:none;background:var(--surface);border-color:var(--blue-1);box-shadow:0 0 0 4px rgba(74,143,214,.18);}

/* Footer */
.footer{background:transparent;border-top:1px solid var(--border);font-family:var(--sans);font-weight:500;padding:.8rem 2rem;}

/* Tarjetas por país: punto de color en lugar de franja */
.metric-pais{padding:12px 16px!important;display:grid;grid-template-columns:auto 1fr;grid-template-rows:auto auto;column-gap:10px;align-items:center;}
.metric-pais::before{content:"";grid-row:1/3;width:12px;height:12px;border-radius:50%;background:var(--pc);box-shadow:0 0 0 4px color-mix(in srgb,var(--pc) 14%,transparent);}
.metric-pais .metric-label{margin-bottom:2px;}
.metric-pais .metric-value{font-size:20px!important;}
/* Intro de página */
.page-intro{flex:1;display:flex;align-items:center;gap:12px;background:var(--surface);border-radius:999px;padding:8px 20px 8px 8px;box-shadow:var(--shadow-2);font-size:12.5px;color:var(--text-muted);}
.page-intro-icon{width:36px;height:36px;border-radius:50%;background:var(--sphere);display:flex;align-items:center;justify-content:center;font-size:15px;flex-shrink:0;box-shadow:0 4px 10px -3px rgba(46,108,181,.55);}
.page-intro strong{font-family:var(--display);color:var(--text);font-weight:700;margin-right:8px;}

/* ===================== DASHBOARD GERENCIAL ===================== */
.dg-head{display:flex;align-items:flex-end;justify-content:space-between;gap:16px;flex-wrap:wrap;margin:.25rem 0 1.1rem;}
.dg-title{font-family:var(--display);font-size:28px;font-weight:800;letter-spacing:-.03em;color:var(--text);line-height:1.1;}
.dg-sub{font-size:13px;color:var(--text-muted);margin-top:6px;font-weight:500;}
.dg-actions{display:flex;gap:8px;}
.dg-filters{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-bottom:1.25rem;}
.dg-chips{display:flex;gap:6px;flex-wrap:wrap;}
.dg-chip{display:inline-flex;align-items:center;gap:8px;height:36px;padding:0 14px 0 12px;border-radius:999px;border:none;background:var(--surface);box-shadow:var(--shadow-1);
  font-family:var(--sans);font-size:12.5px;font-weight:700;color:var(--text-muted);cursor:pointer;transition:background .15s,color .15s,box-shadow .15s;}
.dg-chip:hover{color:var(--text);box-shadow:var(--shadow-2);}
.dg-chip .dot{width:9px;height:9px;border-radius:50%;background:var(--c,var(--sphere));}
.dg-chip[aria-pressed="true"]{background:var(--deep);color:#fff;box-shadow:0 6px 16px -6px rgba(14,45,87,.55);}
.dg-chip[aria-pressed="true"] .dot{box-shadow:0 0 0 2px #fff;}
.dg-mes{display:flex;align-items:center;gap:8px;font-size:12.5px;font-weight:600;color:var(--text-muted);}
.dg-mes select{height:36px;border-radius:999px;border:none;background:var(--surface);box-shadow:var(--shadow-1);padding:0 14px;font-family:var(--sans);font-weight:700;font-size:12.5px;color:var(--text);}

.dg-kpis{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:14px;margin-bottom:14px;}
.dg-kpi{background:var(--surface);border-radius:20px;padding:16px 18px 15px;box-shadow:var(--shadow-2);display:flex;flex-direction:column;min-width:0;}
.dg-kpi.hero{background:radial-gradient(120% 140% at 0% 0%,#3F78BE 0%,#1D4E8C 45%,#0E2D57 100%);color:#fff;box-shadow:0 14px 30px -14px rgba(14,45,87,.7);}
.dg-kpi-label{font-size:12.5px;font-weight:600;color:var(--text-muted);}
.dg-kpi.hero .dg-kpi-label{color:#BFD6F0;}
.dg-kpi-val{font-family:var(--display);font-size:30px;font-weight:800;letter-spacing:-.035em;line-height:1;margin:10px 0 8px;color:var(--text);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.dg-kpi.hero .dg-kpi-val{color:#fff;font-size:36px;}
.dg-kpi-val small{font-size:15px;font-weight:700;letter-spacing:-.01em;margin-left:3px;color:var(--text-hint);}
.dg-kpi.hero .dg-kpi-val small{color:#BFD6F0;}
.dg-kpi-sub{font-size:11.5px;color:var(--text-hint);font-weight:500;margin-top:auto;line-height:1.35;}
.dg-kpi.hero .dg-kpi-sub{color:#BFD6F0;}
.dg-delta{display:inline-flex;align-items:center;gap:3px;font-size:11px;font-weight:700;border-radius:999px;padding:2px 8px;margin-right:4px;}
.dg-delta.up{background:#E7F6EC;color:#11692F;} .dg-delta.down{background:#FDECEC;color:#A4251B;} .dg-delta.flat{background:var(--surface-2);color:var(--text-muted);}
.dg-kpi.hero .dg-delta{background:rgba(255,255,255,.16);color:#fff;}
.dg-meter{height:6px;border-radius:999px;background:var(--surface-2);position:relative;margin:2px 0 8px;overflow:visible;}
.dg-meter i{position:absolute;inset:0 auto 0 0;border-radius:999px;background:linear-gradient(90deg,#4A8FD6,#1D4E8C);}
.dg-meter b{position:absolute;top:-4px;width:2px;height:14px;background:var(--text);border-radius:2px;}
.dg-kpi-cta{margin-top:auto;align-self:flex-start;font-family:var(--sans);font-size:12px;font-weight:700;color:var(--accent);background:var(--accent-light);border:none;border-radius:999px;padding:6px 12px;cursor:pointer;}

.dg-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px;margin-bottom:14px;}
.dg-card{background:var(--surface);border-radius:22px;padding:18px 20px 16px;box-shadow:var(--shadow-2);min-width:0;display:flex;flex-direction:column;}
.dg-card header h3{font-family:var(--display);font-size:15px;font-weight:700;letter-spacing:-.015em;color:var(--text);}
.dg-card header p{font-size:12px;color:var(--text-hint);font-weight:500;margin-top:3px;}
.dg-plot{position:relative;height:230px;margin-top:12px;}
.dg-legend{display:flex;flex-wrap:wrap;gap:6px 14px;margin-top:12px;font-size:12px;font-weight:600;color:var(--text-muted);}
.dg-legend span{display:inline-flex;align-items:center;gap:6px;}
.dg-legend i{width:10px;height:10px;border-radius:3px;display:inline-block;}
.dg-legend i.line{height:3px;border-radius:2px;width:14px;}
.dg-empty{flex:1;min-height:200px;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;gap:8px;color:var(--text-hint);font-size:13px;font-weight:500;}
.dg-empty strong{font-family:var(--display);color:var(--text);font-size:14px;}

.dg-buckets{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-top:12px;}
.dg-bucket{background:var(--surface-2);border-radius:12px;padding:8px 10px;}
.dg-bucket span{display:block;font-size:11px;font-weight:600;color:var(--text-muted);}
.dg-bucket strong{font-family:var(--display);font-size:17px;font-weight:800;color:var(--text);}
.dg-bucket.ok{background:#EAF2FC;}

.dg-pipe{display:flex;flex-direction:column;gap:9px;margin-top:14px;}
.dg-pipe-row{display:grid;grid-template-columns:22px 170px 1fr 34px;align-items:center;gap:10px;font-size:12.5px;font-weight:600;color:var(--text-muted);}
.dg-pipe-row .n{width:22px;height:22px;border-radius:50%;background:var(--surface-2);color:var(--text-muted);font-size:10.5px;font-weight:800;display:flex;align-items:center;justify-content:center;font-family:var(--display);}
.dg-pipe-row.on .n{background:var(--sphere);color:#fff;}
.dg-pipe-row .bar{height:10px;border-radius:999px;background:var(--surface-2);overflow:hidden;}
.dg-pipe-row .bar i{display:block;height:100%;border-radius:999px;background:linear-gradient(90deg,#7DB9EC,#2E6CB5);}
.dg-pipe-row .v{font-family:var(--display);font-weight:800;color:var(--text);text-align:right;}

.dg-table{margin-bottom:14px;}
.dg-table tbody tr.dg-click{cursor:pointer;}
.dg-pais{display:inline-flex;align-items:center;gap:8px;font-weight:700;color:var(--text);}
.dg-pais i{width:10px;height:10px;border-radius:50%;}
.dg-tf{display:flex;align-items:center;gap:8px;min-width:140px;}
.dg-tf .bar{flex:1;height:7px;border-radius:999px;background:var(--surface-2);overflow:hidden;}
.dg-tf .bar i{display:block;height:100%;border-radius:999px;background:#2E6CB5;}
.dg-tf .bar i.low{background:#E0A100;}
.dg-tf span{font-family:var(--mono);font-size:11.5px;font-weight:600;color:var(--text);width:38px;text-align:right;}
.dg-total td{font-weight:800;background:var(--surface-2);}

.dg-tar-grid{display:grid;grid-template-columns:1fr 130px 130px;gap:8px 10px;align-items:center;}
.dg-tar-grid .h{font-size:12px;font-weight:700;color:var(--text-muted);}
.dg-tar-grid .p{display:flex;align-items:center;gap:8px;font-weight:700;font-size:13px;}
.dg-tar-grid .p i{width:10px;height:10px;border-radius:50%;}
.dg-tar-grid input{height:40px;border-radius:12px;border:1px solid var(--border);background:var(--surface-2);font-family:var(--mono);font-weight:600;padding:0 12px;width:100%;}
.dg-tar-grid input:focus{outline:none;background:var(--surface);border-color:var(--blue-1);box-shadow:0 0 0 4px rgba(74,143,214,.18);}

@media (max-width:1280px){ .dg-kpis{grid-template-columns:repeat(3,minmax(0,1fr));} }
@media (max-width:900px){ .dg-grid{grid-template-columns:1fr;} .dg-kpis{grid-template-columns:repeat(2,minmax(0,1fr));} .dg-pipe-row{grid-template-columns:22px 120px 1fr 30px;} }

/* Costos por referencia */
.cst-btn{font-weight:700;}
.cst-btn.ok{color:#11692F!important;border-color:#A7DDB8!important;background:#E7F6EC;}
.cst-link{border:none;background:none;font-family:var(--mono);font-size:12px;font-weight:700;color:var(--accent);cursor:pointer;text-decoration:underline dotted;}
.cst-prev{max-height:50vh;overflow:auto;margin-top:10px;}
.cst-t{width:100%;min-width:0!important;font-size:12.5px;}
.cst-t th{white-space:nowrap;}
.cst-t th em{font-style:normal;font-size:10px;color:#11692F;background:#E7F6EC;border-radius:999px;padding:1px 6px;margin-left:4px;}
.cst-t td,.cst-t th{padding:6px 10px!important;}
.cst-t td:first-child{white-space:normal;min-width:220px;}
.cst-t td.b{font-weight:800;}
.cst-t tr.sec td{background:var(--surface-2);font-family:var(--display);font-weight:700;font-size:12px;color:var(--text-muted);}
.cst-t tr.tot td{border-top:2px solid var(--deep);font-weight:800;background:#EAF2FC;}
.cst-t tr.det td{font-size:11.5px;color:var(--text-muted);white-space:normal;}
.cst-na{color:var(--text-hint);}
.cst-det{margin-top:10px;} .cst-det summary{cursor:pointer;font-weight:700;font-size:12.5px;color:var(--accent);}
.dg-hdr-row{display:flex;align-items:flex-start;justify-content:space-between;gap:10px;flex-wrap:wrap;}
.dg-seg{display:inline-flex;background:var(--surface-2);border-radius:999px;padding:3px;gap:2px;}
.dg-seg button{border:none;background:transparent;border-radius:999px;padding:5px 11px;font-family:var(--sans);font-size:11.5px;font-weight:700;color:var(--text-muted);cursor:pointer;}
.dg-seg button[aria-pressed="true"]{background:var(--surface);color:var(--text);box-shadow:var(--shadow-1);}

/* Despachar referencia */
.desp-go{border:none;border-radius:999px;padding:5px 14px;font-family:var(--sans);font-weight:700;font-size:12px;cursor:pointer;color:#fff;background:linear-gradient(135deg,#22A06B,#11692F);box-shadow:0 4px 10px -4px rgba(17,105,47,.6);}
.desp-go:disabled{background:var(--surface-2);color:var(--text-hint);box-shadow:none;cursor:not-allowed;}
.desp-lock{font-size:12px;font-weight:700;color:#8A5A00;background:#FFF4D6;border-radius:999px;padding:4px 10px;align-self:center;}

/* Cuadros para correo */
.np-grp-mail{border:1px solid #BFD6F0;border-radius:999px;padding:5px 12px;font-family:var(--sans);font-weight:700;font-size:12px;cursor:pointer;background:var(--surface);color:var(--accent-text);}
.np-grp-mail:hover{background:var(--accent-light);}
.cq-sub{font-size:12.5px;color:var(--text-hint);margin:-10px 0 12px;}
.cq-edit-wrap{max-height:30vh;overflow:auto;border:1px solid var(--border);border-radius:14px;}
.cq-edit-t{width:100%;min-width:900px;}
.cq-edit-t td{padding:5px 8px;}
.cq-edit-t input{width:100%;height:34px;border-radius:9px;border:1px solid var(--border);background:var(--surface-2);padding:0 8px;font-family:var(--mono);font-size:12px;font-weight:600;}
.cq-edit-t input:focus{outline:none;background:var(--surface);border-color:var(--blue-1);box-shadow:0 0 0 3px rgba(74,143,214,.18);}
.cq-flete{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin:12px 0;font-size:12.5px;font-weight:600;color:var(--text-muted);}
.cq-flete input{height:36px;width:150px;border-radius:10px;border:1px solid var(--border);background:var(--surface-2);padding:0 10px;font-family:var(--mono);font-weight:700;}
.cq-flete span{color:var(--text-hint);font-weight:500;}
.cq-prev{display:grid;grid-template-columns:1fr;gap:14px;}
.cq-prev section{display:flex;flex-direction:column;gap:8px;min-width:0;}
.cq-prev header{display:flex;align-items:center;justify-content:space-between;gap:8px;flex-wrap:wrap;}
.cq-prev header b{font-family:var(--display);font-size:14px;}
.cq-box{background:#fff;border:1px dashed var(--border-strong);border-radius:12px;padding:12px;overflow:auto;}
.cq-box table{min-width:0!important;width:auto!important;}
.cq-box tbody tr{border:none;} .cq-box tbody tr:hover{background:transparent;}
@media (max-width:900px){ .cq-prev{grid-template-columns:1fr;} }

/* NP agrupado por referencia */
tr.np-grp td{background:var(--surface-2);padding:8px 14px;border-top:2px solid var(--border);}
tr.np-grp.ok td{background:#EAF2FC;}
tr.np-grp.lock td{background:#FFF8E6;}
.np-grp-in{display:flex;align-items:center;gap:12px;flex-wrap:wrap;position:sticky;left:14px;max-width:calc(100vw - 360px);}
.np-grp-ref{font-family:var(--display);font-weight:800;font-size:14px;color:var(--text);}
.np-grp-dat{font-size:12px;font-weight:600;color:var(--text-muted);}
.np-grp-btn{border:none;border-radius:999px;padding:6px 14px;font-family:var(--sans);font-weight:700;font-size:12px;cursor:pointer;color:#fff;background:linear-gradient(135deg,#4A8FD6,#1D4E8C);box-shadow:0 4px 10px -4px rgba(29,78,140,.6);}
.np-grp-lock{font-size:12px;font-weight:700;color:#8A5A00;max-width:520px;}
.np-falta{display:inline-block;font-size:10.5px;font-weight:700;color:#A4251B;background:#FDECEC;border-radius:999px;padding:1px 8px;}

/* Pedidos del contenedor (lista) */
.cped{grid-column:1/-1;border-top:1px solid var(--border);padding-top:14px;margin-top:4px;display:flex;flex-direction:column;gap:8px;}
.cped-head{display:flex;align-items:center;justify-content:space-between;}
.cped-head>span{font-family:var(--display);font-weight:700;font-size:14px;color:var(--text);}
.cped-grid{display:grid;grid-template-columns:150px 112px minmax(0,1fr) 78px 104px 30px;gap:8px;align-items:center;}
.cped-cols{font-size:12px;font-weight:700;color:var(--text-muted);}
.cped-row select,.cped-row input{height:40px;border-radius:12px;border:1px solid var(--border);background:var(--surface-2);font-family:var(--sans);font-weight:600;font-size:13px;padding:0 10px;width:100%;color:var(--text);}
.cped-row .cp-dt,.cped-row .cp-ped{font-family:var(--mono);font-size:12.5px;}
.cped-row select:focus,.cped-row input:focus{outline:none;background:var(--surface);border-color:var(--blue-1);box-shadow:0 0 0 4px rgba(74,143,214,.18);}
.cped-row[data-salida]:not([data-salida=""]) .cp-ped{background:#EEF1F5;color:var(--text-muted);}
.cped-del{width:30px;height:30px;border-radius:50%;border:none;background:transparent;color:var(--text-hint);font-size:18px;cursor:pointer;}
.cped-del:hover{background:#FDECEC;color:#B42318;}
.cped-total{border-top:1px dashed var(--border);padding-top:8px;font-size:12.5px;font-weight:700;}
.cped-total #c-ped-bultos,.cped-total #c-ped-peso{font-family:var(--mono);padding-left:10px;}
@media (max-width:760px){ .cped-grid{grid-template-columns:1fr 1fr 30px;} .cped-cols{display:none;} .cped-row .cp-ped{grid-column:1/3;} }
/* Alerta de descarga en curso */
.desc-bar{position:sticky;top:72px;z-index:99;display:flex;align-items:center;gap:14px;padding:8px 1.75rem;background:#0E2D57;color:#fff;box-shadow:0 6px 18px -10px rgba(14,45,87,.6);overflow-x:auto;}
.desc-bar[hidden]{display:none;}
.desc-bar.has-late{background:linear-gradient(90deg,#7A1D14,#0E2D57 55%);}
.desc-tit{font-family:var(--display);font-size:13px;font-weight:700;white-space:nowrap;}
.desc-tit em{font-style:normal;color:#FFC9C2;}
.desc-items{display:flex;gap:8px;}
.desc-item{display:inline-flex;align-items:center;gap:8px;border:none;border-radius:999px;padding:5px 12px 5px 10px;background:rgba(255,255,255,.1);color:#fff;font-family:var(--sans);font-size:12px;cursor:pointer;white-space:nowrap;}
.desc-item:hover{background:rgba(255,255,255,.18);}
.desc-item i{width:9px;height:9px;border-radius:50%;background:#22C55E;box-shadow:0 0 0 3px rgba(34,197,94,.25);}
.desc-item.warn i{background:#F5B400;box-shadow:0 0 0 3px rgba(245,180,0,.3);}
.desc-item.late i{background:#F04438;box-shadow:0 0 0 3px rgba(240,68,56,.35);animation:descPulse 1.4s ease-in-out infinite;}
.desc-item b{font-family:var(--mono);font-weight:700;}
.desc-item span{color:#BFD6F0;font-weight:600;}
.desc-item strong{font-family:var(--display);font-weight:800;}
.desc-item small{color:#9DB3CE;font-size:11px;}
@keyframes descPulse{0%,100%{opacity:1}50%{opacity:.35}}
#desc-toasts{position:fixed;right:20px;bottom:64px;z-index:300;display:flex;flex-direction:column;gap:10px;max-width:360px;}
.desc-toast{background:var(--surface);border-radius:16px;padding:12px 14px;box-shadow:0 18px 40px -14px rgba(14,45,87,.45);border-left:4px solid #F04438;display:flex;flex-direction:column;gap:6px;font-size:12.5px;color:var(--text-muted);}
.desc-toast strong{font-family:var(--display);color:#A4251B;font-size:13.5px;}
.desc-toast div{display:flex;gap:8px;justify-content:flex-end;}
.desc-toast button{border:none;border-radius:999px;padding:5px 12px;font-family:var(--sans);font-weight:700;font-size:12px;cursor:pointer;background:var(--surface-2);color:var(--text);}
.desc-toast button.ver{background:var(--accent);color:#fff;}
.cc-chip.on.warn{background:#FFF4D6;color:#8A5A00;}
.cc-chip.on.late{background:#FDECEC;color:#A4251B;}
@media (max-width:820px){ .desc-bar{top:64px;padding:8px 1rem;} }

/* ===== Entorno limpio de trabajo ===== */
.main{padding:1.5rem 2rem 2.5rem;}
.pg-head{display:flex;align-items:flex-end;justify-content:space-between;gap:16px;flex-wrap:wrap;margin:0 0 1rem;}
.pg-head h2{font-family:var(--display);font-size:24px;font-weight:800;letter-spacing:-.025em;color:var(--text);line-height:1.15;}
.pg-head p{font-size:13px;color:var(--text-muted);margin-top:4px;max-width:72ch;line-height:1.45;}
.pg-act{display:flex;gap:8px;flex-wrap:wrap;align-items:center;}
.pg-act .btn{height:36px;}
.stat-strip{display:flex;flex-wrap:wrap;background:var(--surface);border-radius:16px;box-shadow:var(--shadow-1);margin-bottom:1rem;overflow:hidden;}
.stat-strip .st{flex:1 1 120px;padding:10px 16px;border-right:1px solid var(--border);display:flex;flex-direction:column;gap:2px;}
.stat-strip .st:last-child{border-right:none;}
.stat-strip .st span{font-size:11.5px;font-weight:600;color:var(--text-hint);}
.stat-strip .st b{font-family:var(--display);font-size:19px;font-weight:800;color:var(--text);letter-spacing:-.02em;}
.stat-strip .st b em{font-style:normal;}
.flow-strip{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:10px;}
.flow-strip button{display:flex;align-items:center;gap:8px;border:none;border-radius:12px;background:var(--surface);box-shadow:var(--shadow-1);padding:7px 12px;cursor:pointer;font-family:var(--sans);color:var(--text-hint);}
.flow-strip button b{font-family:var(--display);font-size:16px;font-weight:800;color:var(--text-hint);}
.flow-strip button span{font-size:12px;font-weight:600;}
.flow-strip button i{font-style:normal;font-family:var(--mono);font-size:10.5px;font-weight:700;background:var(--surface-2);border-radius:6px;padding:1px 5px;}
.flow-strip button.has b,.flow-strip button.has span{color:var(--text);}
.flow-strip button.on{background:var(--accent);box-shadow:0 4px 12px -6px rgba(29,78,140,.6);}
.flow-strip button.on b,.flow-strip button.on span{color:#fff;} .flow-strip button.on i{background:rgba(255,255,255,.2);color:#fff;}
.flow-strip .fl-all{padding-right:16px;}
.cont-top{position:sticky;top:72px;z-index:50;background:#EEF1F5;padding:2px 0 10px;margin-bottom:1rem;}
.filters{margin-bottom:1rem;gap:8px;}
.filters select,.filters input{height:36px;font-size:12.5px;}
tr.desp-grp td{background:var(--surface-2);border-top:2px solid var(--border);padding:8px 14px!important;}
.desp-grp-in{display:flex;align-items:center;gap:10px;flex-wrap:wrap;position:sticky;left:14px;max-width:calc(100vw - 340px);}
.desp-grp-act{display:inline-flex;gap:6px;align-items:center;margin-left:6px;}
/* Menú lateral por secciones */
.sidebar{width:232px;padding:1.1rem .75rem 1.5rem;}
.nav{display:flex;flex-direction:column;gap:2px;}
.nav-sec{font-size:11px;font-weight:700;color:var(--text-hint);padding:16px 12px 6px;letter-spacing:.01em;}
.nav-sec:first-child{padding-top:4px;}
.nav .op-tab{margin:0;width:100%;padding:9px 10px 9px 12px;border-radius:12px;font-size:13px;}
.nav .op-tab.active::before{display:none;}
.nav .op-tab.active{box-shadow:var(--shadow-2);}
.nav-l{display:inline-flex;align-items:center;gap:9px;}
.nav-n{font-style:normal;width:20px;height:20px;border-radius:50%;background:var(--surface-2);color:var(--text-muted);font-size:11px;font-weight:800;display:inline-flex;align-items:center;justify-content:center;font-family:var(--display);}
.op-tab.active .nav-n{background:var(--sphere);color:#fff;}
.nav-live{width:8px;height:8px;border-radius:50%;background:#22C55E;box-shadow:0 0 0 3px rgba(34,197,94,.18);margin:0 6px 0 6px;}
.foot-link{border:none;background:none;font:inherit;color:var(--accent);font-weight:700;cursor:pointer;margin-left:10px;}
#file-name:not(:empty)::before{content:" · ";}
@media (max-width:820px){ .cont-top{top:64px;} .stat-strip .st{flex-basis:45%;} }

/* Cortina desde Ingreso */
.cc-lock{font-size:11.5px;font-weight:600;color:#8A5A00;line-height:1.35;}
.cc-lock:empty{display:none;}
.cc-chip button{border:none;background:none;color:var(--text-hint);font-size:14px;line-height:1;cursor:pointer;padding:0 0 0 2px;}
.cc-chip button:hover{color:#B42318;}
select:disabled{opacity:.6;cursor:not-allowed;}
.cc-info{font-size:13px;color:var(--text-muted);margin:-8px 0 16px;font-weight:500;}
.cc-msg{font-size:12.5px;font-weight:600;color:#8A5A00;margin-top:10px;}
.cc-msg:empty{display:none;}
.cc-btn{font-family:var(--sans);font-size:11.5px;font-weight:700;border:none;border-radius:999px;padding:5px 12px;cursor:pointer;background:#FFF4D6;color:#8A5A00;box-shadow:0 0 0 1px #F5D27A inset;}
.cc-btn:hover{background:#FDE7A8;}
.cc-chip{display:inline-flex;align-items:center;gap:6px;font-family:var(--mono);font-size:11.5px;font-weight:700;border-radius:999px;padding:4px 10px;}
.cc-chip.on{background:var(--accent-light);color:var(--accent-text);}
.cc-chip.on em{font-style:normal;font-family:var(--sans);font-weight:600;color:var(--text-muted);font-size:11px;}
.cc-chip.cola{background:var(--surface-2);color:var(--text-muted);}

/* Pegar aviso */
.paste-box{background:var(--accent-light);border-radius:16px;padding:12px 14px;margin:-4px 0 16px;display:flex;flex-direction:column;gap:8px;}
.paste-box label{font-family:var(--display);font-weight:700;font-size:13.5px;color:var(--accent-text);}
.paste-box textarea{width:100%;min-height:64px;border-radius:12px;border:1px dashed #9DBDE6;background:var(--surface);padding:10px 12px;font-family:var(--mono);font-size:11.5px;resize:vertical;color:var(--text);}
.paste-box textarea:focus{outline:none;border-style:solid;border-color:var(--blue-1);box-shadow:0 0 0 4px rgba(74,143,214,.18);}
.paste-list{display:flex;flex-direction:column;gap:8px;max-height:260px;overflow:auto;}
.paste-cont{background:var(--surface);border-radius:12px;padding:9px 11px;display:flex;flex-direction:column;gap:6px;}
.paste-cont.dup{opacity:.55;}
.paste-cont-h{display:flex;flex-wrap:wrap;align-items:baseline;gap:4px 10px;font-size:12px;color:var(--text-muted);}
.paste-cont-h b{font-family:var(--mono);font-size:13px;color:var(--text);}
.paste-cont-h em{font-style:normal;font-weight:700;color:var(--text);margin-left:auto;}
.paste-msg{font-size:12.5px;font-weight:600;border-radius:10px;padding:7px 10px;}
.paste-msg.ok{background:#E7F6EC;color:#11692F;} .paste-msg.err{background:#FDECEC;color:#A4251B;}
.paste-btn{align-self:flex-start;}

/* Importar ingresos */
.imp-sub{font-size:12.5px;color:var(--text-hint);margin:-10px 0 14px;font-weight:500;}
.imp-rango{display:flex;gap:14px;flex-wrap:wrap;margin-bottom:12px;}
.imp-rango label{display:flex;align-items:center;gap:8px;font-size:12.5px;font-weight:600;color:var(--text-muted);}
.imp-rango select{height:36px;border-radius:999px;border:1px solid var(--border);background:var(--surface-2);padding:0 14px;font-family:var(--sans);font-weight:700;font-size:12.5px;color:var(--text);}
.imp-resumen{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:12px;}
.imp-chip{background:var(--surface-2);border-radius:14px;padding:8px 12px;display:flex;align-items:baseline;gap:6px;}
.imp-chip strong{font-family:var(--display);font-size:18px;font-weight:800;color:var(--text);}
.imp-chip span{font-size:12px;font-weight:600;color:var(--text-muted);}
.imp-chip.main{background:var(--accent);} .imp-chip.main strong,.imp-chip.main span{color:#fff;}
.imp-chip.warn{background:#FFF4D6;} .imp-chip.err{background:#FDECEC;}
.imp-tabla{max-height:46vh;overflow:auto;border:1px solid var(--border);border-radius:14px;}
.imp-tabla table{min-width:980px;}
.imp-tabla thead th{position:sticky;top:0;z-index:1;}
.imp-tabla td{vertical-align:top;white-space:normal;}
.imp-peds{display:flex;flex-wrap:wrap;gap:4px;}
.imp-ped{display:inline-flex;align-items:center;gap:5px;font-family:var(--mono);font-size:11px;font-weight:600;background:var(--surface-2);border-radius:999px;padding:2px 8px;white-space:nowrap;}
.imp-ped i{width:7px;height:7px;border-radius:50%;}
.imp-ped.dup{text-decoration:line-through;color:var(--text-hint);}
.imp-dest{font-size:11.5px;font-weight:700;border-radius:999px;padding:3px 9px;white-space:nowrap;}
.imp-dest.act{background:var(--accent-light);color:var(--accent-text);} .imp-dest.his{background:var(--surface-2);color:var(--text-muted);} .imp-dest.omi{background:#FFF4D6;color:#8A5A00;}
tr.imp-omi td{opacity:.55;}
.imp-obs{font-size:12px;color:#8A5A00;min-width:160px;}
.imp-errores{margin-top:10px;font-size:12.5px;color:#A4251B;}
.imp-errores summary{cursor:pointer;font-weight:700;}
.imp-errores ul{margin:6px 0 0 18px;color:var(--text-muted);}
.imp-nota{font-size:12px;color:var(--text-hint);margin-top:10px;line-height:1.5;}

/* Costos facturados */
.dg-costos-info{font-size:12px;color:var(--text-hint);margin-top:6px;font-weight:500;}
.dg-costos-info:empty{display:none;}
.dg-costos-info b{color:var(--text-muted);font-weight:700;}
.dg-costos-info button{margin-left:6px;border:none;background:none;color:var(--accent);font:inherit;font-weight:700;cursor:pointer;padding:0;}
.dg-est{font-style:normal;font-size:10.5px;font-weight:700;color:#8A5A00;background:#FFF4D6;border-radius:999px;padding:1px 7px;margin-left:4px;}
.dg-wide{grid-column:1/-1;}
.dg-sels{display:flex;gap:10px;flex-wrap:wrap;}
.dg-orig{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,1fr);gap:22px;align-items:start;margin-top:8px;}
.dg-plot-orig{height:260px;}
.dg-orig-tab table{width:100%;border-collapse:collapse;font-size:12.5px;}
.dg-orig-tab th{font-size:10.5px;text-transform:uppercase;letter-spacing:.05em;color:var(--text-hint);text-align:left;padding:7px 8px;border-bottom:1px solid var(--border);}
.dg-orig-tab td{padding:7px 8px;border-bottom:1px solid #F1F4F8;}
.dg-orig-tab .num{text-align:right;font-family:var(--mono);}
.dg-orig-tab tr.dim{opacity:.45;}
.dg-orig-tab tr.on td{background:#EFF5FC;}
.dg-orig-tab .dg-total td{font-weight:800;border-top:1.5px solid var(--border-strong);border-bottom:none;}
.dg-orig-hint{font-size:11.5px;color:var(--text-hint);}
@media(max-width:900px){.dg-orig{grid-template-columns:1fr;}}

.dg-wide .dg-pipe{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));column-gap:32px;}
.dg-comp{display:flex;flex-direction:column;gap:10px;margin-top:14px;flex:1;}
.dg-comp-row{display:grid;grid-template-columns:minmax(0,190px) 1fr 90px 48px;align-items:center;gap:10px;font-size:12.5px;font-weight:600;color:var(--text-muted);}
.dg-comp-row .bar{height:10px;border-radius:999px;background:var(--surface-2);overflow:hidden;}
.dg-comp-row .bar i{display:block;height:100%;border-radius:999px;background:var(--accent);}
.dg-comp-row .v{font-family:var(--mono);font-weight:600;color:var(--text);text-align:right;font-size:12px;}
.dg-comp-row .p{font-family:var(--display);font-weight:800;color:var(--text);text-align:right;}
.dg-comp-split{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:auto;padding-top:12px;}
.dg-comp-split div{background:var(--surface-2);border-radius:14px;padding:10px 12px;}
.dg-comp-split span{display:block;font-size:11.5px;font-weight:600;color:var(--text-muted);}
.dg-comp-split strong{display:block;font-family:var(--display);font-size:18px;font-weight:800;color:var(--text);margin:2px 0;}
.dg-comp-split em{font-style:normal;font-size:11.5px;color:var(--text-hint);}
@media (max-width:900px){ .dg-wide .dg-pipe{grid-template-columns:1fr;} .dg-comp-row{grid-template-columns:110px 1fr 76px 42px;} }

/* Días en bodega */
.dg-pipe-row.warn .bar i{background:linear-gradient(90deg,#F5C451,#D98E04);}
.dg-pipe-row.warn .n{background:#D98E04;color:#fff;}
.dg-oldest{margin-top:6px;border-top:1px solid var(--border);padding-top:10px;display:flex;flex-direction:column;gap:6px;}
.dg-oldest>span{font-size:11.5px;font-weight:700;color:var(--text-hint);}
.dg-oldest div{display:grid;grid-template-columns:10px 1fr auto auto;align-items:center;gap:10px;font-size:12.5px;}
.dg-oldest i{width:8px;height:8px;border-radius:50%;}
.dg-oldest b{font-family:var(--mono);font-weight:600;color:var(--text);}
.dg-oldest em{font-style:normal;color:var(--text-hint);font-size:11.5px;}
.dg-oldest strong{font-family:var(--display);font-weight:800;color:var(--text);}
.dg-note{font-size:11.5px;color:var(--text-hint);margin-top:6px;}

/* Accesibilidad */
:focus-visible{outline:2px solid var(--blue-1);outline-offset:2px;}
@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important;}}
@media (max-width:820px){
  .header{height:64px;}
  .brand{width:auto;padding-right:.75rem;}
  .brand-name,.header-sub{display:none;}
  .header{padding-right:.75rem;}
  .header-title{font-size:15px;}
  .header-titles{padding-left:.75rem;}
  #edif-reloj-header,.header-actions .btn-ghost:last-child{display:none!important;}
  .layout{flex-direction:column;}
  .sidebar{width:100%;}
  .main{padding:1rem;}
}



/* ── Requisiciones de cheque ── */
.rc-num{display:inline-block;font-family:var(--mono);font-weight:800;font-size:13px;color:#0E2D57;background:#EAF1FD;border-radius:8px;padding:3px 9px;}
.rc-mfs{display:flex;flex-direction:column;gap:2px;font-size:12px;}
.rc-mfs b{font-family:var(--mono);font-size:11.5px;}
.rc-est{font:inherit;font-size:11px;font-weight:800;letter-spacing:.04em;border-radius:999px;padding:4px 10px;border:1.5px solid #CBD5E1;background:#fff;}
.rc-est.BORRADOR{border-color:#94A3B8;color:#475569;}
.rc-est.ENVIADA{border-color:#E8A317;color:#8A5A00;background:#FFF8E6;}
.rc-est.PAGADA{border-color:#16A34A;color:#166534;background:#ECFDF3;}
.rc-fp{display:block;font-size:10.5px;color:#6B7A90;margin-top:3px;font-family:var(--mono);}
.rc-acc{white-space:nowrap;}
.rc-acc .btn{margin-right:4px;}
.rc-del{color:#B91C1C;}
.rc-modal{width:980px;max-width:100%;}
.rc-mh{display:flex;justify-content:space-between;gap:16px;align-items:flex-start;margin-bottom:14px;}
.rc-mh h3{margin:0 0 4px;}
.rc-mh p{margin:0;font-size:12.5px;color:#6B7A90;}
.rc-mtotal{background:linear-gradient(135deg,#0E2D57,#1D4E8C);color:#fff;border-radius:14px;padding:10px 16px;text-align:right;min-width:190px;}
.rc-mtotal span{display:block;font-size:10px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:#AFC6E6;}
.rc-mtotal b{font-family:var(--mono);font-size:20px;}
.rc-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;}
.rc-add{display:flex;flex-wrap:wrap;gap:8px;align-items:center;background:#F5F8FC;border:1px dashed #C8D4E3;border-radius:12px;padding:10px;margin:6px 0 12px;}
.rc-add input{height:34px;border:1px solid #D5DCE6;border-radius:8px;padding:0 10px;font:inherit;font-size:13px;flex:0 1 240px;}
.rc-add small{font-size:12px;color:#B91C1C;flex-basis:100%;}
.rc-add small:empty{display:none;}
.rc-add small.rc-ok-msg{color:#166534;}
.rc-link{border:none;background:none;color:#2E6CB5;font:inherit;font-weight:800;text-decoration:underline;cursor:pointer;padding:0;}
.rc-bls{display:flex;flex-direction:column;gap:12px;margin-bottom:12px;}
.rc-vacio{padding:22px;text-align:center;color:#8A97AA;font-size:13px;border:1px solid #EEF1F5;border-radius:12px;}
.rc-bl{border:1px solid #E3E8EF;border-radius:14px;overflow:hidden;background:#fff;}
.rc-bl-h{display:grid;grid-template-columns:1.4fr 1fr 1fr auto;gap:10px;align-items:end;padding:12px 14px;background:#F8FAFD;border-bottom:1px solid #EEF1F5;}
.rc-bl-h .form-group{margin:0;}
.rc-bl-id span{display:block;font-size:10px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:#8A97AA;}
.rc-bl-id b{font-family:var(--mono);font-size:15px;color:#0E2D57;}
.rc-bl-id small{display:block;font-size:11.5px;color:#6B7A90;}
.rc-x{border:none;background:#fff;border:1px solid #E3E8EF;border-radius:50%;width:30px;height:30px;font-size:18px;line-height:1;color:#8A97AA;cursor:pointer;}
.rc-x:hover{color:#B91C1C;border-color:#FECACA;}
.rc-ct{width:100%;font-size:12.5px;}
.rc-ct th{font-size:10px;text-transform:uppercase;letter-spacing:.05em;color:#8A97AA;padding:7px 14px;text-align:left;border-bottom:1px solid #EEF1F5;}
.rc-ct td{padding:6px 14px;border-bottom:1px solid #F2F4F8;}
.rc-ct .num{text-align:right;font-family:var(--mono);}
.rc-ct tr.rc-po td{font-size:11.5px;color:var(--text-muted);background:#FAFBFD;padding-top:4px;padding-bottom:4px;}
.rc-ct tr.rc-po td:first-child{padding-left:30px;}
.rc-ct tr.rc-po small{font-size:10px;color:var(--text-hint);margin-left:4px;}
.rc-ct tr.rc-po b{color:var(--text);font-weight:700;}
.rc-po-l{font-size:9.5px;font-weight:800;color:#8A97AA;letter-spacing:.05em;}
.rc-ct tr.rc-po small.rc-ot{font-size:11px;color:var(--text-muted);margin-left:8px;}.rc-ct tr.rc-po small.rc-ot b{font-family:var(--mono);font-weight:600;}
.rc-in-cc{width:110px;height:30px;text-align:right;font-family:var(--mono);border:1px solid #D5DCE6;border-radius:8px;padding:0 8px;}
.rc-in-cc.man{border-color:#2E6CB5;background:#EFF5FC;}
.rc-bl-f{padding:8px 14px;font-size:12px;color:#166534;background:#F3FBF6;}
.rc-bl-f.bad{color:#991B1B;background:#FEF2F2;}
.rc-bl-f button{border:none;background:none;color:#2E6CB5;font:inherit;font-weight:700;cursor:pointer;padding:0;}
.rc-warn{font-style:normal;font-size:10.5px;font-weight:700;color:#9A4B07;background:#FFF3E6;border-radius:6px;padding:1px 6px;}
@media(max-width:760px){.rc-grid{grid-template-columns:1fr 1fr;}.rc-bl-h{grid-template-columns:1fr 1fr;}.rc-mh{flex-direction:column;}}



.edif-hist-tools{display:flex;align-items:center;gap:10px;}
.edif-hist-fecha{height:30px;border:1px solid var(--border);border-radius:8px;padding:0 8px;font:inherit;font-size:12px;color:var(--text);background:#fff;}
.edif-hist-del{border:1px solid #E3E8EF;background:#fff;border-radius:50%;width:24px;height:24px;line-height:1;font-size:15px;color:#8A97AA;cursor:pointer;}
.edif-hist-del:hover{color:#B91C1C;border-color:#FECACA;background:#FEF2F2;}

/* ── Reporte para seguro ── */
.ro-filtros{align-items:center;}
.ro-presets{display:flex;flex-wrap:wrap;gap:6px;}
.ro-presets button{border:1px solid var(--border);background:var(--surface);color:var(--text-muted);border-radius:999px;padding:6px 12px;font-family:inherit;font-size:12px;font-weight:600;cursor:pointer;}
.ro-presets button.on,.ro-presets button:hover{background:var(--deep,#0E2D57);border-color:var(--deep,#0E2D57);color:#fff;}
.ro-doc{background:var(--surface);border-radius:22px;box-shadow:var(--shadow-2);padding:24px 30px;}
.ro-palabras{font-size:11px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:var(--text-hint);margin-bottom:6px;}
.ro-leg span{display:inline-flex;align-items:center;gap:6px;}.ro-leg i{width:10px;height:10px;border-radius:3px;display:inline-block;}
.ro-tit{font-family:var(--display);font-size:21px;font-weight:800;letter-spacing:-.02em;margin:0 0 4px;color:var(--text);}
.ro-sub{font-size:12px;color:var(--text-hint);font-weight:600;margin-bottom:18px;}
.ro-sec{margin-bottom:20px;}
.ro-sec h4{display:flex;align-items:center;gap:8px;font-size:12px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;color:var(--accent-text,#2E6CB5);margin:0 0 8px;padding-bottom:6px;border-bottom:1px solid var(--border);}
.ro-sec h4 i{font-style:normal;font-size:11px;}
.ro-sec p{font-size:14.5px;line-height:1.65;margin:0 0 6px;color:var(--text);max-width:72ch;}
.ro-sec p b{font-weight:800;}
@media (max-width:820px){ .ro-doc{padding:18px;} }
.seg-gen{font-size:12px;font-weight:700;color:var(--text-muted);margin-right:4px;}
#seg-body tr.seg-total td{font-weight:800;background:#FFF8DC;border-top:1.5px solid var(--border-strong);}
.seg-et{display:flex;flex-direction:column;align-items:flex-start;gap:3px;text-align:left;background:var(--surface);border:1.5px solid transparent;border-radius:16px;padding:12px 14px;box-shadow:var(--shadow-1);cursor:pointer;font:inherit;color:var(--text);}
.seg-et span{font-size:11px;font-weight:800;letter-spacing:.04em;text-transform:uppercase;color:var(--text-hint);}
.seg-et b{font-family:var(--mono);font-size:17px;color:var(--deep);}
.seg-et small{font-size:11.5px;color:var(--text-muted);}
.seg-et.on{border-color:var(--accent);background:#EFF5FC;}
.seg-tag{display:inline-block;font-size:10.5px;font-weight:800;border-radius:999px;padding:2px 9px;white-space:nowrap;}
.seg-tag.blue{background:#E0F2FE;color:#0369A1;}.seg-tag.cont{background:#F3E8FF;color:#7E22CE;}.seg-tag.np{background:#FEF3C7;color:#92400E;}.seg-tag.desp{background:#DCFCE7;color:#166534;}
.seg-st{display:block;font-size:10px;color:var(--text-hint);margin-top:2px;}
.seg-falta{font-size:11px;font-weight:800;color:#B45309;background:#FFF3E6;border-radius:6px;padding:1px 6px;}
.seg-alerta b{color:#B45309;}
/* Fila que acaba de avanzar: resalta un momento al subir */
#cont-tbody tr.cont-recien > td{animation:contRecien 3s ease-out;}
@keyframes contRecien{0%,35%{background:#E6F0FB;}100%{background:transparent;}}
/* ── Trámites ── */
.tram-chips{display:inline-flex;gap:4px;align-items:center;flex-wrap:wrap;}
.tram-chip{border:1px solid #D5DCE6;background:#fff;color:#6B7A90;border-radius:999px;font:inherit;font-size:10.5px;font-weight:700;padding:2px 8px;cursor:pointer;white-space:nowrap;}
.tram-chip.on{background:#ECFDF3;border-color:#86EFAC;color:#166534;}
.tram-chip:disabled{cursor:default;}
.tram-ok{font-size:10.5px;font-weight:800;color:#1D4ED8;background:#EFF5FC;border-radius:999px;padding:2px 8px;white-space:nowrap;}
.tram-tabla td{vertical-align:middle;}
.tram-tabla td small{display:block;font-size:11px;color:var(--text-hint);margin-top:2px;}
.tram-ref{font-family:var(--mono);font-size:13px;color:var(--deep);}
.tram-in-ord{width:56px;height:34px;text-align:center;font-family:var(--mono);font-weight:800;font-size:15px;border:1.5px solid var(--accent);border-radius:10px;color:var(--deep);}
.tram-n{display:inline-flex;align-items:center;justify-content:center;width:34px;height:34px;border-radius:10px;background:#0E2D57;color:#fff;font-family:var(--mono);font-weight:800;font-size:15px;}
.tram-n.done{background:#16A34A;}
.tram-docs-ok{font-size:11px;font-weight:800;color:#166534;}
.tram-est{font:inherit;font-size:11.5px;font-weight:800;border-radius:999px;padding:5px 10px;border:1.5px solid #CBD5E1;background:#fff;}
.tram-est.pend{border-color:#94A3B8;color:#475569;}
.tram-est.proc{border-color:#E8A317;color:#8A5A00;background:#FFF8E6;}
.tram-est.listo{border-color:#16A34A;color:#166534;background:#ECFDF3;}
.tram-in-decl,.tram-in-nota{height:32px;border:1px solid var(--border);border-radius:8px;padding:0 9px;font:inherit;font-size:12px;width:150px;}
.tram-in-decl{font-family:var(--mono);}
.tram-in-nota{width:180px;}
.tram-btn{border:none;border-radius:999px;background:#0E2D57;color:#fff;font:inherit;font-size:12px;font-weight:800;padding:7px 14px;cursor:pointer;white-space:nowrap;}
.tram-btn:hover{background:#1D4E8C;}
.tram-btn.ok{background:#16A34A;}
.tram-btn.ok:hover{background:#15803D;}
.tram-row.proc td{background:#FFFCF2;}
.tram-ok.proc{color:#8A5A00;background:#FFF8E6;}
.tram-tabla td .tram-est + small{margin:3px 0 4px;}
.tram-undo{display:block;border:none;background:none;color:var(--text-hint);font:inherit;font-size:11px;text-decoration:underline;cursor:pointer;padding:2px 0 0;}
.tram-ok.done{color:#166534;background:#ECFDF3;}
.tram-row.listo td{background:#F3FBF6;opacity:.85;}
.tram-upd{white-space:nowrap;}
.tram-espera-card{background:var(--surface);border-radius:18px;box-shadow:var(--shadow-1);padding:16px 18px;margin-top:16px;}
.tram-espera-card h3{margin:0;font-size:14px;}
.tram-espera-card p{margin:2px 0 10px;font-size:12px;color:var(--text-hint);}
.tram-espera{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:8px;}
.tram-esp{border:1px solid var(--border);border-radius:12px;padding:9px 12px;display:flex;flex-direction:column;gap:2px;}
.tram-esp b{font-family:var(--mono);font-size:12.5px;color:var(--deep);}
.tram-esp small{font-size:11px;color:var(--text-hint);}
.tram-esp span{font-size:11.5px;color:#9A4B07;}
.tram-esp i{font-style:normal;font-weight:800;background:#FFF3E6;border-radius:6px;padding:1px 6px;}
.tram-esp-vacio{font-size:12.5px;color:#166534;}

/* Despacho: campos fijos */
.desp-fijo-nota{margin:-4px 0 12px;font-size:12px;color:var(--text-muted);background:#F5F8FC;border:1px solid #E3E8EF;border-radius:10px;padding:8px 11px;}
#modal-despacho.modo-fijo .form-grid .fg-edit{order:-1;}
#modal-despacho .campo-fijo{background:#F3F5F8 !important;color:#5B6B82 !important;cursor:not-allowed;border-style:dashed;}

.tp-btn{color:#0E2D57;border-color:#C8D4E3;}
.tp-btn.ok{color:#166534;border-color:#86EFAC;background:#F3FBF6;}
.desp-piloto{display:block;font-size:10.5px;color:var(--text-hint);font-family:var(--font, inherit);}
.tram-transp{line-height:1.5;}
.tram-falta{color:#B45309;}

/* Orden de carga */
.oc-btn.falta{color:#9A4B07;border-color:#FCD9A8;background:#FFF8EE;}
.oc-btn.ok{color:#fff;border-color:#0E2D57;background:#0E2D57;}
.oc-estado{border-radius:12px;padding:10px 12px;font-size:12.5px;margin:0 0 12px;line-height:1.7;}
.oc-estado.ok{background:#ECFDF3;color:#166534;border:1px solid #BBF7D0;}
.oc-estado.falta{background:#FFF8EE;color:#7A3E06;border:1px solid #FCD9A8;}
.oc-estado i{font-style:normal;font-weight:800;background:#fff;border:1px solid #FCD9A8;border-radius:6px;padding:1px 7px;margin:0 2px;white-space:nowrap;}
.oc-nota{color:#8A97AA;font-size:11.5px;}
#modal-oc .form-grid{grid-template-columns:minmax(0,1fr) minmax(0,1fr);}
#modal-oc .form-grid select,#modal-oc .form-grid input{width:100%;min-width:0;}
.oc-sec{font-size:10.5px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:#8A97AA;margin:6px 0 8px;}
#oc-imprimir:disabled{opacity:.45;cursor:not-allowed;}
/* ── Alertas ── */
.alr-wrap{position:relative;}
.alr-bell{position:relative;width:36px;height:36px;border-radius:50%;border:1px solid #E3E8EF;background:#fff;color:#0E2D57;display:flex;align-items:center;justify-content:center;cursor:pointer;box-shadow:0 2px 6px -3px rgba(14,45,87,.25);}
.alr-bell:hover{background:#F1F5FB;}
.alr-bell.late{color:#B91C1C;animation:alrPulse 2s infinite;}
@keyframes alrPulse{0%,100%{box-shadow:0 0 0 0 rgba(220,38,38,.35);}50%{box-shadow:0 0 0 6px rgba(220,38,38,0);}}
.alr-count{position:absolute;top:-4px;right:-4px;min-width:18px;height:18px;padding:0 5px;border-radius:999px;background:#DC2626;color:#fff;font-size:10.5px;font-weight:800;display:flex;align-items:center;justify-content:center;border:2px solid #fff;font-family:var(--mono);}
.alr-count[hidden]{display:none;}
.alr-panel{position:absolute;right:0;top:calc(100% + 8px);width:min(420px,calc(100vw - 32px));max-height:min(70vh,640px);display:flex;flex-direction:column;background:#fff;border:1px solid #E3E8EF;border-radius:16px;box-shadow:0 22px 50px -18px rgba(14,45,87,.4);z-index:9100;overflow:hidden;}
.alr-panel[hidden]{display:none;}
.alr-head{display:flex;align-items:center;gap:10px;padding:14px 16px;border-bottom:1px solid #EEF1F5;}
.alr-head b{font-family:Sora,sans-serif;font-size:15px;color:#0E2D57;}
.alr-head span{font-size:12px;color:#6B7A90;flex:1;}
.alr-head button{border:none;background:none;color:var(--accent,#2E6CB5);font:inherit;font-size:12px;font-weight:700;cursor:pointer;}
.alr-list{overflow-y:auto;padding:4px 8px 8px;}
.alr-sec{font-size:10.5px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;color:#8A97AA;padding:10px 8px 6px;}
.alr-sec span{background:#EEF1F5;color:#4A5A72;border-radius:999px;padding:1px 7px;margin-left:4px;}
.alr-item{display:flex;gap:10px;align-items:flex-start;padding:10px;border-radius:12px;border-left:3px solid #CBD5E1;margin-bottom:6px;background:#F8FAFC;}
.alr-item.late{border-left-color:#DC2626;background:#FEF2F2;}
.alr-item.warn{border-left-color:#F59E0B;background:#FFFBEB;}
.alr-item.info{border-left-color:#2E6CB5;background:#EFF5FC;}
.alr-item.ok{border-left-color:#16A34A;background:#F0FDF4;}
.alr-ico{font-size:17px;line-height:1.2;}
.alr-tx{flex:1;min-width:0;display:flex;flex-direction:column;gap:2px;}
.alr-tx b{font-size:13px;color:#1F2D44;}
.alr-tx small{font-size:12px;color:#4A5A72;}
.alr-tx em{font-style:normal;font-size:11px;color:#8A97AA;font-family:var(--mono);}
.alr-acc{display:flex;flex-direction:column;gap:4px;}
.alr-acc button{border:1px solid #D5DCE6;background:#fff;border-radius:8px;font:inherit;font-size:11.5px;font-weight:700;padding:4px 8px;cursor:pointer;white-space:nowrap;color:#1F2D44;}
.alr-acc .alr-ok{background:#0E2D57;color:#fff;border-color:#0E2D57;}
.alr-vacio{padding:28px 10px;text-align:center;color:#16A34A;font-weight:700;font-size:13px;}
.alr-hist{border-top:1px solid #EEF1F5;padding:4px 16px 12px;background:#FAFBFD;}
.alr-h{display:flex;justify-content:space-between;gap:10px;font-size:12px;color:#4A5A72;padding:3px 0;}
.alr-h small{color:#8A97AA;white-space:nowrap;}
#alr-toasts{position:fixed;right:18px;bottom:18px;z-index:10002;display:flex;flex-direction:column;gap:8px;width:min(360px,calc(100vw - 32px));}
.alr-toast{display:flex;gap:10px;align-items:flex-start;background:#fff;border:1px solid #E3E8EF;border-left:4px solid #2E6CB5;border-radius:12px;padding:11px 12px;box-shadow:0 16px 36px -14px rgba(14,45,87,.45);cursor:pointer;animation:alrIn .25s ease-out;}
.alr-toast.late{border-left-color:#DC2626;}.alr-toast.warn{border-left-color:#F59E0B;}.alr-toast.ok{border-left-color:#16A34A;}
.alr-toast button{border:none;background:none;font-size:18px;line-height:1;color:#8A97AA;cursor:pointer;}
@keyframes alrIn{from{transform:translateY(10px);opacity:0;}to{transform:none;opacity:1;}}

/* ── HUB en línea ── */
body.hub-bloqueado .layout, body.hub-bloqueado .header-actions, body.hub-bloqueado #desc-bar{visibility:hidden;}
#hub-login{position:fixed;inset:0;z-index:10000;display:flex;align-items:center;justify-content:center;padding:16px;background:radial-gradient(1200px 600px at 20% 0%,#DCE8F7 0,#EEF1F5 55%);}
#hub-login[hidden]{display:none;}
.hl-card{width:100%;max-width:360px;background:#fff;border:1px solid #E3E8EF;border-radius:18px;box-shadow:0 20px 50px -20px rgba(14,45,87,.35);padding:26px 24px;display:flex;flex-direction:column;gap:12px;}
.hl-brand{display:flex;align-items:center;gap:12px;margin-bottom:6px;}
.hl-brand b{display:block;font-family:Sora,sans-serif;font-size:15px;color:var(--deep,#0E2D57);}
.hl-brand small{font-size:11.5px;color:#6B7A90;}
.hl-card label{display:flex;flex-direction:column;gap:5px;font-size:11.5px;font-weight:700;color:#4A5A72;text-transform:uppercase;letter-spacing:.04em;}
.hl-card input{height:40px;border:1px solid #D5DCE6;border-radius:10px;padding:0 12px;font:inherit;font-size:14px;text-transform:none;letter-spacing:0;}
.hl-card input:focus{outline:2px solid var(--accent,#2E6CB5);outline-offset:1px;border-color:transparent;}
.hl-card .btn-accent{height:40px;justify-content:center;font-size:14px;}
.hl-err{background:#FEF2F2;color:#991B1B;border:1px solid #FECACA;border-radius:10px;padding:8px 10px;font-size:12.5px;}
.hl-crear{justify-content:center;}
.hl-crear[hidden],.hl-err[hidden]{display:none !important;}
.hl-nota{font-size:11.5px;color:#8A97AA;margin:4px 0 0;text-align:center;}
#hub-user-chip{position:relative;}
.huc-btn{display:flex;align-items:center;gap:8px;border:1px solid rgba(255,255,255,.18);background:rgba(255,255,255,.08);color:inherit;border-radius:999px;padding:3px 12px 3px 3px;cursor:pointer;font:inherit;}
.huc-av{width:26px;height:26px;border-radius:50%;background:var(--accent,#2E6CB5);color:#fff;font-size:11px;font-weight:800;display:flex;align-items:center;justify-content:center;}
.huc-tx{display:flex;flex-direction:column;align-items:flex-start;line-height:1.1;}
.huc-tx b{font-size:12px;}
.huc-tx small{font-size:10px;opacity:.7;}
.huc-menu{position:absolute;right:0;top:calc(100% + 6px);min-width:220px;background:#fff;border:1px solid #E3E8EF;border-radius:12px;box-shadow:0 14px 34px -12px rgba(14,45,87,.3);padding:6px;z-index:9000;display:flex;flex-direction:column;}
.huc-menu[hidden]{display:none;}
.huc-menu button{border:none;background:none;text-align:left;padding:9px 10px;border-radius:8px;font:inherit;font-size:13px;color:#1F2D44;cursor:pointer;}
.huc-menu button:hover{background:#F1F5FB;}
.hu-modal{max-width:980px;width:100%;}
.hu-head{display:flex;justify-content:space-between;gap:12px;align-items:flex-start;margin-bottom:12px;}
.hu-head h3{margin:0 0 4px;font-family:Sora,sans-serif;}
.hu-head p{margin:0;font-size:12.5px;color:#6B7A90;}
.hu-nuevo{display:flex;flex-wrap:wrap;gap:8px;align-items:center;background:#F5F8FC;border:1px solid #E3E8EF;border-radius:12px;padding:10px;margin-bottom:12px;}
.hu-nuevo input,.hu-nuevo select{height:34px;border:1px solid #D5DCE6;border-radius:8px;padding:0 10px;font:inherit;font-size:13px;flex:1 1 150px;min-width:0;}
.hu-nuevo small{flex-basis:100%;font-size:11.5px;color:#6B7A90;}
.hu-tabla-wrap{overflow-x:auto;}
.hu-tabla{width:100%;border-collapse:collapse;font-size:12.5px;}
.hu-tabla th{font-size:10.5px;text-transform:uppercase;letter-spacing:.04em;color:#6B7A90;text-align:left;padding:8px;border-bottom:1px solid #E3E8EF;white-space:nowrap;}
.hu-tabla td{padding:8px;border-bottom:1px solid #EEF1F5;vertical-align:middle;}
.hu-tabla td small{display:block;font-family:var(--mono);font-size:11px;color:#8A97AA;}
.hu-tabla select{height:30px;border:1px solid #D5DCE6;border-radius:8px;font:inherit;font-size:12.5px;}
.hu-c{text-align:center;}
.hu-c input{width:16px;height:16px;accent-color:var(--accent,#2E6CB5);}
.hu-inactivo{opacity:.5;}
.hu-nota{font-size:11.5px;color:#8A97AA;margin:10px 0 0;}
#hub-toast{position:fixed;left:50%;bottom:20px;transform:translateX(-50%);z-index:10001;background:#0E2D57;color:#fff;padding:10px 16px;border-radius:12px;font-size:13px;box-shadow:0 12px 30px -10px rgba(0,0,0,.4);max-width:min(560px,calc(100vw - 32px));}
#hub-toast.err{background:#991B1B;}
#hub-toast[hidden]{display:none;}
body.hub-online .foot-link{display:none;}
</style>
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-auth-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore-compat.js"></script>
</head>
<body>

<div class="header">
  <div class="header-left">
    <div class="brand">
      <div class="brand-mark">BL</div>
      <div class="brand-name">Blue Logistics<small>Operación Unilever</small></div>
    </div>
    <div class="header-titles">
      <div class="header-title">Control Logístico HUB UL</div>
      <div class="header-sub">Ingresos, despachos y andenes en tiempo real</div>
    </div>
  </div>
  <div class="header-actions">
    <div id="edif-reloj-header" style="font-size:12px;color:#A8A59C;font-family:var(--mono);display:flex;align-items:center;gap:6px;">
      <div style="width:6px;height:6px;border-radius:50%;background:#4ADE80;animation:pulse 2s infinite;"></div>
      <span id="edif-reloj-hdr">--:--</span>
    </div>
    <button onclick="gsSaveAll()" class="btn btn-ghost" style="height:28px;font-size:11px;padding:0 12px;">☁️ Guardar</button>
  </div>
</div>

<div id="desc-bar" class="desc-bar" hidden></div>
<div class="layout">

  <aside class="sidebar">
    <nav class="nav" aria-label="Secciones del HUB">
      <div class="nav-sec">Flujo Unilever</div>
      <button class="op-tab active" data-tab="contenedores" onclick="switchTab('contenedores',this)"><span class="nav-l"><i class="nav-n">1</i>Ingreso de equipo</span><span class="tab-badge" id="tab-count-cont">0</span></button>
      <button class="op-tab" data-tab="noprog" onclick="switchTab('noprog',this)"><span class="nav-l"><i class="nav-n">2</i>No programados</span><span class="tab-badge red" id="tab-count-noprog">0</span></button>
      <button class="op-tab" data-tab="despachos" onclick="switchTab('despachos',this)"><span class="nav-l"><i class="nav-n">3</i>Despacho</span><span class="tab-badge gray" id="tab-count-despachos">0</span></button>
      <button class="op-tab" data-tab="tramites" onclick="switchTab('tramites',this)"><span class="nav-l"><i class="nav-n">4</i>Trámites</span><span class="tab-badge gray" id="tab-count-tramites" title="Pendientes de tramitar">0</span></button>

      <div class="nav-sec">Pagos</div>
      <button class="op-tab" data-tab="rc" onclick="switchTab('rc',this)"><span class="nav-l">Requisiciones (RC)</span><span class="tab-badge gray" id="tab-count-rc" title="Por pagar">0</span></button>

      <div class="nav-sec">Bodega en vivo</div>
      <button class="op-tab" data-tab="edif12" onclick="switchTab('edif12',this)"><span class="nav-l"><i class="nav-live"></i>Edificio 12</span><span class="tab-badge gray" id="tab-count-edif12" title="Cortinas">3</span></button>
      <button class="op-tab" data-tab="edif6" onclick="switchTab('edif6',this)"><span class="nav-l"><i class="nav-live"></i>Edificio 6</span><span class="tab-badge gray" id="tab-count-edif6" title="Cortinas">8</span></button>

      <div class="nav-sec">Historial</div>
      <button class="op-tab" data-tab="historial" onclick="switchTab('historial',this)"><span class="nav-l">Despachos</span><span class="tab-badge gray" id="tab-count-historial">0</span></button>
      <button class="op-tab" data-tab="historial-cont" onclick="switchTab('historial-cont',this)"><span class="nav-l">Ingresos de equipo</span><span class="tab-badge gray" id="tab-count-histcont">0</span></button>

      <div class="nav-sec">Reportes</div>
      <button class="op-tab" data-tab="dashboard" onclick="switchTab('dashboard',this)"><span class="nav-l">Reporte ejecutivo</span></button>
      <button class="op-tab" data-tab="resumen" onclick="switchTab('resumen',this)"><span class="nav-l">Resumen operativo</span></button>
      <button class="op-tab" data-tab="buscar" onclick="switchTab('buscar',this)"><span class="nav-l">Buscar pedido</span></button>
      <button class="op-tab" data-tab="seguro" id="nav-seguro" onclick="switchTab('seguro',this)"><span class="nav-l">Reporte para seguro</span></button>
      <button class="op-tab" data-tab="mando" onclick="switchTab('mando',this);renderMando()"><span class="nav-l">Operaciones en vivo</span></button>
    </nav>
  </aside>

  <div class="content-col">

    <div class="main">

  <!-- DESPACHOS TAB -->
  <div class="tab-content" id="tab-despachos">
    <div class="pg-head"><div><h2>Despacho</h2><p>Referencias programadas, en carga y cargadas. Al estar cargada y con costos, se despacha y pasa al historial.</p></div><div class="pg-act"><label class="btn btn-sm" for="csv-input" id="drop-zone" title="Cargar despachos desde CSV">Cargar CSV</label><input type="file" id="csv-input" accept=".csv,text/csv" hidden>
        <button class="btn btn-sm" onclick="exportCSV()">Exportar CSV</button>
        <button class="btn btn-sm" onclick="posAbrir()">📊 Posicionamiento semanal</button>
        <button class="btn btn-sm btn-accent" onclick="openDespachoModal(null)">+ Nuevo registro</button></div></div>

    <div class="stat-strip">
      <div class="st"><span>Pedidos</span><b id="m-total">—</b></div>
      <div class="st"><span>Programados</span><b id="m-prog">—</b></div>
      <div class="st"><span>En carga</span><b id="m-enproceso">—</b></div>
      <div class="st"><span>Cargados</span><b id="m-cargado">—</b></div>
      <div class="st"><span>Peso</span><b><em id="m-peso">—</em> kg</b></div>
    </div>

    <div class="filters">
      <select id="filter-mes"><option value="">Todos los meses</option></select>
      <select id="filter-dest"><option value="">Todos los destinos</option></select>
      <select id="filter-status">
        <option value="">Todos los estatus</option>
        <option value="PROGRAMADO">Programado</option>
        <option value="EN PROCESO DE CARGA">En proceso de carga</option>
        <option value="CARGADO">Cargado</option>
        <option value="DESPACHADO">Despachado</option>
      </select>
      <input type="text" id="filter-q" placeholder="Buscar ref., DT, pedido...">
      <button class="btn btn-sm" onclick="clearFilters()">Limpiar</button>
    </div>

    <div class="table-card">
      <div class="table-header">
        <span class="table-title">Referencias</span>
        <span class="table-count" id="count-label">—</span>
      </div>
      <div class="table-wrap">
        <table style="min-width:1100px;">
          <thead><tr>
            <th>Mes</th><th>Referencia</th><th>DT</th><th>No. Pedido</th><th>Destino</th>
            <th class="num">Pallets</th><th>Remolque</th><th>Régimen</th><th>Edificio</th><th>Cortina</th>
            <th>F. Carga</th><th>F. Salida</th><th>Estatus</th>
            <th class="num">Peso (kg)</th><th class="num">Vol (m³)</th><th></th>
          </tr></thead>
          <tbody id="tbody">
            <tr><td colspan="16"><div class="empty"><strong>Sin datos</strong>Carga un CSV o agrega registros manualmente</div></td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- NO PROGRAMADOS TAB -->
  <!-- TRÁMITES -->
  <div class="tab-content" id="tab-tramites">
    <div class="pg-head"><div><h2>Trámites</h2><p>Referencias programadas, en carga o cargadas con documentos completos (Factura UL · DT · Carta porte), en el orden de prioridad definido. Trámites las inicia y las marca como tramitadas con su número de declaración; despachar es de tráfico.</p></div></div>
    <div class="stat-strip">
      <div class="st"><span>Por tramitar</span><b id="tram-k-listas">0</b></div>
      <div class="st"><span>En proceso de trámite</span><b id="tram-k-proc">0</b></div>
      <div class="st"><span>Tramitadas</span><b id="tram-k-ok">0</b></div>
      <div class="st"><span>En espera de documentos</span><b id="tram-k-espera">0</b></div>
    </div>
    <div class="table-card">
      <div class="table-header"><span class="table-title">Cola de trámites</span><span class="table-count" id="tram-count">0</span></div>
      <div class="table-wrap">
        <table class="tram-tabla" style="min-width:1150px;">
          <thead><tr><th>Orden</th><th>Referencia</th><th>Carga</th><th class="num">Pallets</th><th>Documentos</th><th>Trámite</th><th>N.º declaración</th><th>Actualizado</th><th>Nota</th></tr></thead>
          <tbody id="tram-body"></tbody>
        </table>
      </div>
    </div>
    <div class="tram-espera-card">
      <h3>En espera de documentos</h3>
      <p>Todas las referencias programadas, en carga o cargadas a las que tráfico aún no les marca todos los documentos.</p>
      <div id="tram-espera" class="tram-espera"></div>
    </div>
  </div>

  <div class="tab-content" id="tab-noprog">

    <div class="pg-head"><div><h2>No programados</h2><p>Pedidos agrupados por referencia. Con referencia, proveedor y fecha de solicitud completos, se programa la referencia entera.</p></div><div class="pg-act"><button class="btn btn-sm" onclick="document.getElementById('np-import-file').click()">Importar Excel</button>
        <input type="file" id="np-import-file" accept=".xlsx,.xls,.csv" style="display:none;" onchange="npImportarExcel(this)">
        <button class="btn btn-sm" onclick="npSugerirProgramacionActivo()" id="np-btn-sugerir" title="Selecciona un país primero">Sugerir</button>
        <button class="btn btn-accent btn-sm" onclick="openNpModal(null)">+ Agregar pedido</button></div></div>
    <div class="filters"><div style="display:flex;gap:6px;flex-wrap:wrap;" id="np-paises-btns"></div></div>

    <!-- Viñeta de capacidad 53 FT — sticky -->
    <div id="np-vinheta" style="display:none;position:sticky;top:0;z-index:40;margin-bottom:1rem;">
      <div style="background:var(--surface);border:1.5px solid var(--border);border-radius:12px;padding:12px 16px;display:flex;align-items:center;gap:16px;flex-wrap:wrap;box-shadow:0 2px 8px rgba(0,0,0,.06);">

        <!-- Equipo -->
        <div style="display:flex;align-items:center;gap:8px;flex-shrink:0;">
          <div style="font-size:22px;">🚛</div>
          <div>
            <div style="font-size:11px;font-weight:600;color:var(--text-muted);text-transform:uppercase;letter-spacing:.05em;">Equipo</div>
            <div style="font-size:14px;font-weight:700;color:var(--text);" id="np-equipo-label">53 FT</div>
          </div>
        </div>

        <div style="width:1px;height:40px;background:var(--border);flex-shrink:0;"></div>

        <!-- Pallets -->
        <div style="flex:1;min-width:140px;">
          <div style="display:flex;justify-content:space-between;align-items:baseline;margin-bottom:4px;">
            <span style="font-size:11px;font-weight:600;color:var(--text-muted);text-transform:uppercase;letter-spacing:.04em;">Pallets</span>
            <span style="font-size:12px;font-family:var(--mono);font-weight:600;" id="np-pallets-txt">0 / 30 pallets</span>
          </div>
          <div style="background:var(--bg);border-radius:999px;height:6px;overflow:hidden;">
            <div id="np-pallets-bar" style="height:6px;border-radius:999px;background:#3B82F6;width:0%;transition:width .3s,background .3s;"></div>
          </div>
        </div>

        <!-- Peso -->
        <div style="flex:1;min-width:140px;">
          <div style="display:flex;justify-content:space-between;align-items:baseline;margin-bottom:4px;">
            <span style="font-size:11px;font-weight:600;color:var(--text-muted);text-transform:uppercase;letter-spacing:.04em;">Peso</span>
            <span style="font-size:12px;font-family:var(--mono);font-weight:600;" id="np-peso-txt">0 / 21,000 kg</span>
          </div>
          <div style="background:var(--bg);border-radius:999px;height:6px;overflow:hidden;">
            <div id="np-peso-bar" style="height:6px;border-radius:999px;background:#3B82F6;width:0%;transition:width .3s,background .3s;"></div>
          </div>
        </div>

        <div style="width:1px;height:40px;background:var(--border);flex-shrink:0;"></div>

        <!-- Veredicto -->
        <div id="np-veredicto" style="min-width:160px;text-align:center;">
          <div id="np-verd-icon" style="font-size:20px;margin-bottom:2px;">—</div>
          <div id="np-verd-txt" style="font-size:12px;font-weight:600;color:var(--text-muted);">Selecciona pedidos</div>
          <div id="np-verd-sub" style="font-size:10px;color:var(--text-hint);margin-top:1px;"></div>
        </div>

        <!-- Botón programar -->
        <button id="np-btn-programar" onclick="npProgramarSeleccion()" style="display:none;height:34px;padding:0 16px;font-size:12px;font-family:var(--sans);font-weight:600;border-radius:8px;border:none;background:#1A5C3A;color:#fff;cursor:pointer;">
          ✓ Programar envío
        </button>

      </div>
    </div>

    <!-- Tabla de pedidos -->
    <div class="table-card">
      <div class="table-header">
        <div style="display:flex;align-items:center;gap:8px;">
          <span class="table-title" id="np-table-title">Todos los pedidos</span>
          <span class="table-count" id="np-count-label">0 registros</span>
        </div>
        <div style="display:flex;align-items:center;gap:8px;">
          <input type="text" id="np-q" placeholder="🔍 Buscar pedido, DT, RG..." oninput="renderNp()" style="height:28px;padding:0 10px;border-radius:6px;border:1px solid var(--border);font-size:12px;font-family:var(--sans);width:200px;">
          <span style="font-size:11px;color:var(--text-hint);" id="np-sel-count"></span>
        </div>
      </div>
      <div class="table-wrap">
        <table style="min-width:900px;">
          <thead><tr>
            <th style="width:36px;"><input type="checkbox" id="np-chk-all" onchange="npToggleAll(this.checked)" style="cursor:pointer;"></th>
            <th>País</th><th>No. Pedido</th><th>Doc. Transporte</th><th>RG</th><th>DT</th>
            <th>Origen</th><th>Referencia</th>
            <th class="num">Pallets</th><th class="num">Peso (kg)</th>
            <th>Equipo</th><th>Truck Fill</th>
            <th>Proveedor</th><th>F. Solicitud</th><th>F. Descarga</th>
            <th>Prioridad</th><th>Notas</th><th></th>
          </tr></thead>
          <tbody id="np-tbody">
            <tr><td colspan="12"><div class="empty"><strong>Sin pedidos</strong>Selecciona un país arriba o agrega pedidos manualmente</div></td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- CONTENEDORES TAB -->
  <div class="tab-content active" id="tab-contenedores">

    <!-- Sticky panel: info + metrics + filters -->
    <div class="cont-top">

    <div class="pg-head"><div><h2>Ingreso de equipo</h2><p>Cada contenedor con sus pedidos. Al llegar a Blue se asigna cortina; en 07 Notificado vacío pasa a No programados.</p></div><div class="pg-act"><input type="file" id="imp-file" accept=".xlsx,.xls" style="display:none" onchange="impLeer(this)">
        <button class="btn btn-sm" onclick="impElegir()">Importar ingresos</button>
        <button class="btn btn-sm" onclick="exportContCSV()">Exportar CSV</button>
        <button class="btn btn-sm" onclick="goToTab('rc');rcAbrir(null)">Requisición (RC)</button>
        <button class="btn btn-sm btn-accent" onclick="abrirModalCont(null)">+ Nuevo contenedor</button></div></div>
      <div class="flow-strip" id="cont-flow" aria-label="Contenedores por estado"></div>
      <div class="filters" style="margin-bottom:0;">
        <select id="cf-mes"><option value="">Todos los meses</option></select>
        <select id="cf-origen"><option value="">Todos los orígenes</option></select>
        <select id="cf-estado" hidden>
          <option value="">Estado contenedor (todos)</option>
          <option>01-TRÁNSITO MARÍTIMO</option>
          <option>02-TRAMITANDO EN PUERTO</option>
          <option>03-EN TRÁNSITO TERRESTRE</option>
          <option>04-POSICIONADO EN BLUE</option>
          <option>05-EN DESCARGA</option>
          <option>06-DESCARGADO</option>
          <option>07-NOTIFICADO VACÍO</option>
        </select>
        <select id="cf-flete">
          <option value="">Flete (todos)</option>
          <option>01-NO PAGADO</option>
          <option>02-PAGO SOLICITADO</option>
          <option>03-EN PROCESO DE PAGO</option>
          <option>04-PAGADO</option>
        </select>
        <input type="text" id="cf-q" placeholder="Contenedor, doc. transporte, LS..." style="width:180px;">
        <button class="btn btn-sm" onclick="clearContFilters()">Limpiar</button>
      </div>

    </div><!-- /sticky panel -->

    <div class="table-card">
      <div class="table-header">
        <span class="table-title">Contenedores activos</span>
        <span class="table-count" id="cont-count-label">—</span>
      </div>
      <!-- Top scrollbar mirror -->
      <div class="table-wrap" id="cont-table-wrap">
        <table style="min-width:1500px;" id="cont-table">
          <thead><tr>
            <th>Mes</th><th>Doc. Transporte</th><th>Contenedor</th>
            <th>ETA Puerto</th><th>ETA Blue</th>
            <th class="num">Cant.</th><th class="num">Peso kg</th>
            <th>Origen</th><th>Estado Cont.</th><th>Cortina</th><th>Flete</th><th>BL</th><th>REPORT ESA</th>
            <th>RG</th><th>RC</th><th>F. Descarga</th>
            <th style="color:#A32D2D;text-align:center;">SV</th>
            <th style="color:#7A1F5A;text-align:center;">HN</th>
            <th style="color:#185FA5;text-align:center;">CR</th>
            <th style="color:#3B6D11;text-align:center;">NI</th>
            <th style="color:#854F0B;text-align:center;">GT</th>
            <th style="color:#0F6E56;text-align:center;">PA</th>
            <th style="text-align:center;">Acción</th>
          </tr></thead>
          <tbody id="cont-tbody">
            <tr><td colspan="21"><div class="empty"><strong>Sin datos</strong>Carga el CSV de contenedores o agrégalos manualmente</div></td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>



