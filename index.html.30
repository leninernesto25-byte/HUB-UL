function gsSaveChunk(hoja, datos, campos, append){
  return new Promise((resolve)=>{
    try {
      const filas = gsSerialize(datos, campos);
      const cbName = 'gsSaveCb_'+hoja.replace(/[^a-z]/gi,'')+'_'+Date.now();
      const script = document.createElement('script');
      const json = JSON.stringify({accion: append?'append':'guardar', hoja, filas});
      const bytes = new TextEncoder().encode(json);
      let binary = '';
      bytes.forEach(b => binary += String.fromCharCode(b));
      const payload = btoa(binary);
      const timeout = setTimeout(()=>{
        delete window[cbName];
        try{if(script.parentNode)script.parentNode.removeChild(script);}catch(e){}
        resolve(false);
      }, 30000);
      window[cbName] = (data)=>{
        clearTimeout(timeout);
        delete window[cbName];
        try{if(script.parentNode)script.parentNode.removeChild(script);}catch(e){}
        resolve(data && data.ok);
      };
      script.src = GS_URL+'?action=save&payload='+encodeURIComponent(payload)+'&callback='+cbName;
      script.onerror = ()=>{ clearTimeout(timeout); delete window[cbName]; resolve(false); };
      document.body.appendChild(script);
    } catch(e){ console.error('gsSaveChunk error:',e); resolve(false); }
  });
}

// Load ALL data from Google Sheets on startup
async function gsLoadAll(){
  gsSyncIndicator('cargando');
  try {
    const [contResp, npResp, despResp, histDResp, histCResp] = await Promise.all([
      fetch(SHEETDB_URL+'?sheet=Contenedores').then(r=>r.json()).catch(()=>[]),
      fetch(SHEETDB_URL+'?sheet=PedidosNoProgramados').then(r=>r.json()).catch(()=>[]),
      fetch(SHEETDB_URL+'?sheet=PedidosDespacho').then(r=>r.json()).catch(()=>[]),
      fetch(SHEETDB_URL+'?sheet=HistorialDespachos').then(r=>r.json()).catch(()=>[]),
      fetch(SHEETDB_URL+'?sheet=HistorialContenedores').then(r=>r.json()).catch(()=>[]),
    ]);

    if(contResp&&contResp.length){ contenedores.length=0; contResp.forEach(r=>{ r.cant=Number(r.cant)||0; r.peso=Number(r.peso)||0; r.enviado=r.enviado==='true'||r.enviado===true; r.report_esa=r.report_esa||'03-NO APLICA'; contenedores.push(r); }); console.log('Contenedores:',contenedores.length); }
    else { console.warn('SheetDB: Contenedores vacío o falló'); }
    if(npResp&&npResp.length){ noProg.length=0; npResp.forEach(r=>noProg.push(r)); console.log('NoProg:',noProg.length); }
    if(despResp&&despResp.length){ despachos.length=0; despResp.forEach(r=>{ r.peso=Number(r.peso)||0; r.vol=Number(r.vol)||0; despachos.push(r); }); console.log('Despachos:',despachos.length); }
    if(histDResp&&histDResp.length){ historial.length=0; histDResp.forEach(r=>historial.push(r)); console.log('HistorialD:',historial.length); }
    if(histCResp&&histCResp.length){ historialCont.length=0; histCResp.forEach(r=>{ r.cant=Number(r.cant)||0; r.peso=Number(r.peso)||0; historialCont.push(r); }); console.log('HistorialC:',historialCont.length); }

    renderContenedores();
    renderNp(); npRenderPaisesBtns();
    populateFilters(); renderDespachos();
    renderHistorial(); renderHistorialCont();
    gsSyncIndicator('listo');
  } catch(e){
    gsSyncIndicator('error');
    console.error('GS loadAll error:', e);
  }
}

